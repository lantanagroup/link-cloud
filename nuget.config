<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    LantanaGroup.Thetis.* is published to Shared_BOTW_Feed (ADO pipeline 254).
    GitHub Actions does not have AZURE_ARTIFACTS_PAT, so tests.yaml packs Thetis
    1.0.0 into local-thetis-nupkgs/ and retargets this source to that folder.
    Local docker: set AZURE_ARTIFACTS_PAT, or pack into local-thetis-nupkgs/.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Shared_BOTW_Feed" value="https://pkgs.dev.azure.com/lantanagroup/nhsnlink/_packaging/Shared_BOTW_Feed/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Shared_BOTW_Feed">
      <package pattern="LantanaGroup.Thetis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
