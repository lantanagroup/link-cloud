{
  "ExternalConfigurationSource": "",
  "EnableSwagger": true,
  "AutoMigrate": true,
  "DatabaseProvider": "SqlServer",
  "SecretManagement": {
    "Manager": "Local",
    "ManagerUri": ""
  },
  "ConnectionStrings": {
    "DatabaseConnection": "Server=tcp:mssql,1433;Initial Catalog=link-nhsn-app-bff;Persist Security Info=False;User ID=sa;Password=${LINK_DB_PASS};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceUrl": "http://tenant:8074"
    },
    "CensusServiceUrl": "http://census:8064",
    "DataAcquisitionServiceUrl": "http://dataacq:8065",
    "NormalizationServiceUrl": "http://normalization:8068",
    "QueryDispatchServiceUrl": "http://querydispatch:8071",
    "ReportServiceUrl": "http://report:8072",
    "MeasureServiceUrl": "http://measureeval:8067",
    "ValidationServiceUrl": "http://validation:8075",
    "SubmissionServiceUrl": "http://submission:8073",
    "AdminBffServiceUrl": "http://admin-bff:8063",
    "TerminologyServiceUrl": "http://terminology:8076"
  },
  "Authentication": {
    "AllowAnonymous": true
  },
  "NhsnJwt": {
    "AccessRequestUrl": "https://example.org/request-nhsnlink-access"
  },
  "CORS": {
    "AllowAllOrigins": true,
    "AllowedOrigins": ["http://localhost:4300", "http://localhost:8090"]
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8079"
      }
    }
  }
}
