{
  "name": "nhsn-app-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack.app.config.js --mode development --port 4300",
    "build": "npm run build:app && npm run build:embed",
    "build:app": "webpack --config webpack.app.config.js --mode production",
    "build:embed": "webpack --config webpack.embed.config.js --mode production",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@nhsn/nhsn-react-core": "file:packages/nhsn-react-core-2.4.1.tgz",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
