{
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Account Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true
  },
  "DatabaseProvider": "SqlServer",
  "AutoMigrate": true,
  "ConnectionStrings": {
    "Redis": "redis_cache:6379,abortConnect=false,resolveDns=true,allowAdmin=true"
  },
  "Cache": {
    "Enabled": true
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "ServiceRegistry": {},
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "SecretManagement": {
    "Manager": "Local",
    "ManagerUri": ""
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8060"
      }
    }
  }
}
