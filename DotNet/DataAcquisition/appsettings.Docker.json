{
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Data Acquisition Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true
  },
  "DatabaseProvider": "SqlServer",
  "AutoMigrate": true,
  "ConnectionStrings": {
    "Redis": "redis_cache:6379,abortConnect=false,resolveDns=true,allowAdmin=true"
  },
  "Cache": {
    "Type": "Redis"
  },
  "SecretManagement": {
    "Manager": "Local",
    "ManagerUri": ""
  },
  "DistributedLockSettings": {
    "Expiration": 10,
    "RetryDelay": 5,
    "MaxRetryCount": 3
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "PatientTags": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceURL": "http://tenant:8074",
      "CheckIfTenantExists": false,
      "GetTenantRelativeEndpoint": "facility/"
    }
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8065"
      }
    }
  }
}
