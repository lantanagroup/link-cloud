{
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Normalization Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true
  },
  "DatabaseProvider": "SqlServer",
  "AutoMigrate": true,
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317",
    "PatientTags": true
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceURL": "http://tenant:8074",
      "CheckIfTenantExists": false,
      "GetTenantRelativeEndpoint": "facility/"
    }
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8068"
      }
    }
  }
}
