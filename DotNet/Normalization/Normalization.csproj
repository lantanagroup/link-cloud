<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>e59bc22a-9a18-47f1-a9c8-fd09c2bc3828</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<RootNamespace>LantanaGroup.Link.Normalization</RootNamespace>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
		<Version>0.7.0</Version>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Application\Interfaces\**" />
		<Compile Remove="Application\Models\Business\**" />
		<Compile Remove="Data\**" />
		<Content Remove="Application\Interfaces\**" />
		<Content Remove="Application\Models\Business\**" />
		<Content Remove="Data\**" />
		<EmbeddedResource Remove="Application\Interfaces\**" />
		<EmbeddedResource Remove="Application\Models\Business\**" />
		<EmbeddedResource Remove="Data\**" />
		<None Remove="Application\Interfaces\**" />
		<None Remove="Application\Models\Business\**" />
		<None Remove="Data\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Application\Services\FhirValidation\StructureDefinitions\hl7.fhir.r4.core-4.0.1.tgz" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
		<PackageReference Include="Azure.Identity" />
		<PackageReference Include="Confluent.Kafka" />
		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
		<PackageReference Include="Hl7.Fhir.Specification.R4" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Enrichers.Span" />
		<PackageReference Include="Serilog.Exceptions" />
		<PackageReference Include="Serilog.Expressions" />
		<PackageReference Include="Serilog.Sinks.Grafana.Loki" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinkSdk\LinkSdk.csproj" />
		<ProjectReference Include="..\Normalization.Engine\Normalization.Engine.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="nuget.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Scripts\" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="StructureDefinitions\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
