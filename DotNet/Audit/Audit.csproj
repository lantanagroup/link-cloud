<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>89e2822a-1e90-4904-9d40-8dc0fbea1ed4</UserSecretsId>
	<RootNamespace>LantanaGroup.Link.Audit</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Version>0.7.1</Version>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Presentation\Services\**" />
	  <Content Remove="Presentation\Services\**" />
	  <EmbeddedResource Remove="Presentation\Services\**" />
	  <None Remove="Presentation\Services\**" />
	</ItemGroup>

  <ItemGroup>
	<PackageReference Include="Azure.Identity" />
	<PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
	<PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
	<PackageReference Include="Microsoft.Extensions.Telemetry" />
	<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
	<PackageReference Include="Serilog.AspNetCore" />
	<PackageReference Include="Serilog.Enrichers.Span" />
	<PackageReference Include="Serilog.Exceptions" />
	<PackageReference Include="Serilog.Expressions" />
	<PackageReference Include="Serilog.Sinks.Grafana.Loki" />
	<PackageReference Include="Swashbuckle.AspNetCore" />
	<PackageReference Include="System.IdentityModel.Tokens.Jwt" />	
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Application\Factory\" />
    <Folder Include="Infrastructure\Extensions\" />
    <Folder Include="Migrations\" />
    <Folder Include="Presentation\Models\" />
  </ItemGroup>

</Project>

