{
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Audit Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9094"
    ],
    "SaslProtocolEnabled": true
  },
  "DatabaseProvider": "SqlServer",
  "AutoMigrate": true,
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8062"
      }
    }
  }
}
