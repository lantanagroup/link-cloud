{
  "useNdJson": true,
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Submission Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true
  },
  "DatabaseProvider": "SqlServer",
  "AutoMigrate": true,
  "ServiceRegistry": {
    "ReportServiceUrl": "http://report:8072"
  },
  "SubmissionServiceConfig": {
    "SubmissionDirectory": "/data/submission",
    "PatientBundleBatchSize": 5,
    "MeasureNames": [
      {
        "Url": "http://www.cdc.gov/nhsn/fhirportal/dqm/ig/Measure/NHSNAcuteCareHospitalMonthlyInitialPopulation",
        "MeasureId": "NHSNAcuteCareHospitalMonthlyInitialPopulation",
        "ShortName": "ACHM"
      },
      {
        "Url": "http://www.cdc.gov/nhsn/fhirportal/dqm/ig/Measure/NHSNGlycemicControlHypoglycemicInitialPopulation",
        "MeasureId": "NHSNGlycemicControlHypoglycemicInitialPopulation",
        "ShortName": "HYPO"
      },
      {
        "Url": "http://www.cdc.gov/nhsn/fhirportal/dqm/ig/Measure/NHSNAcuteCareHospitalDailyInitialPopulation",
        "MeasureId": "NHSNAcuteCareHospitalDailyInitialPopulation",
        "ShortName": "ACHD"
      }
    ]
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Features": {
    "DownloadReportEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "LantanaGroup.Link": "DEBUG"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8073"
      }
    }
  }
}
