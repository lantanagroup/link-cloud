<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LantanaGroup.Link.PatientFlowSimulator</RootNamespace>
    <AssemblyName>PatientFlowSimulator</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="scenarios\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
