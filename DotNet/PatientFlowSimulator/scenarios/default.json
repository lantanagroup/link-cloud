{
  // Three facilities, 100 new patients a month, 20 qualifying per measure.
  // Patients are regenerated every month with new names and ids; the mix below stays the same.
  "name": "three-facility-monthly-flow",
  "seed": "link-spike-2026",
  "crossMonth": {
    "admitWithinHoursOfMonthEnd": 72,
    "dischargeWithinHoursOfMonthStart": 72
  },
  "facilities": [
    {
      "facilityId": "sim-mercy-general",
      "name": "Mercy General Hospital",
      "timeZone": "America/Chicago",
      "patientIdPrefix": "MG",
      "measures": [
        "NHSNAcuteCareHospitalMonthlyInitialPopulation",
        "NHSNAcuteCareHospitalDailyInitialPopulation"
      ],
      "cohorts": [
        {
          "name": "acute-inpatients",
          "template": "acute-inpatient",
          "count": 20,
          "crossMonthCount": 3,
          "qualifiesFor": [
            "NHSNAcuteCareHospitalMonthlyInitialPopulation",
            "NHSNAcuteCareHospitalDailyInitialPopulation"
          ]
        },
        {
          "name": "clinic-visits",
          "template": "outpatient-visit",
          "count": 20,
          "crossMonthCount": 0,
          "qualifiesFor": []
        }
      ]
    },
    {
      "facilityId": "sim-riverside-medical",
      "name": "Riverside Medical Center",
      "timeZone": "America/Chicago",
      "patientIdPrefix": "RM",
      "measures": [
        "NHSNGlycemicControlHypoglycemicInitialPopulation"
      ],
      "cohorts": [
        {
          "name": "insulin-inpatients",
          "template": "acute-inpatient-insulin",
          "count": 20,
          "crossMonthCount": 3,
          "qualifiesFor": [
            "NHSNGlycemicControlHypoglycemicInitialPopulation"
          ]
        },
        {
          "name": "inpatients-without-insulin",
          "template": "acute-inpatient",
          "count": 7,
          "crossMonthCount": 1,
          "qualifiesFor": []
        },
        {
          "name": "clinic-visits",
          "template": "outpatient-visit",
          "count": 13,
          "crossMonthCount": 0,
          "qualifiesFor": []
        }
      ]
    },
    {
      // The LTC initial population is every encounter overlapping the period, whatever its class, so
      // this facility only gets qualifying residents: a clinic visit here would qualify as well.
      "facilityId": "sim-lakeside-ltc",
      "name": "Lakeside Long-Term Care",
      "timeZone": "America/Chicago",
      "patientIdPrefix": "LL",
      "measures": [
        "NHSNLongTermCareMonthlyInitialPopulation"
      ],
      "cohorts": [
        {
          "name": "residents",
          "template": "ltc-resident",
          "count": 20,
          "crossMonthCount": 0,
          "qualifiesFor": [
            "NHSNLongTermCareMonthlyInitialPopulation"
          ]
        }
      ]
    }
  ],
  "templates": {
