{
  "EnableSwagger": true,
  "Terminology": {
    "Path": "/data",
    "EnableCodeUploadEndpoint": true
  },
  "ServiceInformation": {
    "Name": "Link Terminology",
    "ProductVersion": "dev"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8076"
      }
    }
  }
}
