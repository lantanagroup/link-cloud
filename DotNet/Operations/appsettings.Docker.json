{
  "EnableSwagger": true,
  "ServiceInformation": {
    "Name": "Link Operations Service",
    "ProductVersion": "dev"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "KafkaOps": {
    "BrokerLifecycleEnabled": false,
    "TwoPersonApproval": false,
    "RequireDifferentApprover": false
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true,
    "ClientId": "operations"
  },
  "ConnectionStrings": {
    "Redis": "redis_cache:6379,abortConnect=false,resolveDns=true,allowAdmin=true"
  },
  "Cache": {
    "Type": "Redis"
  },
  "Authentication": {
    "EnableAnonymousAccess": true,
    "Schemas": {
      "LinkBearer": {
        "Authority": "LinkServiceAdmin",
        "ValidateToken": true
      }
    }
  },
  "DataProtection": {
    "Enabled": false,
    "KeyRing": "Link"
  },
  "LinkTokenService": {
    "Authority": "LinkServiceAdmin",
    "LinkAdminEmail": "linkadmin@lantanagroup.com",
    "TokenLifespan": 10
  },
  "CORS": {
    "AllowAllOrigins": false,
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowCredentials": true
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8079"
      }
    }
  }
}
