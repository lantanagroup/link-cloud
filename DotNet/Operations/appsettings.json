{
  "ServiceInformation": {
    "Name": "Link Operations Service",
    "Version": "0.1.0-dev",
    "GitCommit": "git_value"
  },
  "EnableSwagger": false,
  "ExternalConfigurationSource": "",
  "DatabaseProvider": "SqlServer",
  "ConnectionStrings": {
    "AzureAppConfiguration": "",
    "DatabaseConnection": "",
    "Redis": ""
  },
  "AutoMigrate": true,
  "Cache": {
    "Type": "InMemory"
  },
  "KafkaConnection": {
    "BootstrapServers": [],
    "ClientId": ""
  },
  "KafkaOps": {
    "MaxPartitionsPerTopic": 24,
    "BrokerLifecycleEnabled": false,
    "TwoPersonApproval": true,
    "MetadataRefreshIntervalMs": 30000,
    "ExpectedConfigVersion": 1,
    "CacheSeconds": 8,
    "VerificationWindowSeconds": 900,
    "RateLimitMinutes": 30,
    "ConvergenceAlertMultiple": 3,
    "InfraProvider": "Disabled",
    "ScaleTimeoutSeconds": 180,
    "ExtraBrokerProfile": "extra-broker",
    "ExtraBrokerService": "broker-3",
    "BrokerServicePrefix": "broker-",
    "BrokerService": "broker-0",
    "KafkaToolsPath": "/opt/kafka/bin",
    "BrokerInternalPort": 9092,
    "BrokerServices": "",
    "AllowTopicMigration": false,
    "MigrationBackupRetentionHours": 168,
    "MigrationMaxBackupMinutes": 15,
    "MigrationHoldMinutes": 15,
    "MigrationUnknownDiskMaxBytes": 1073741824,
    "TopicOperatorManagesLinkTopics": false,
    "Workloads": "",
    "WorkloadNamespace": "",
    "ManualChecklist": false,
    "Connection": {
      "BootstrapServers": "",
      "SaslProtocolEnabled": false
    },
    "ReconcileExecutingAfterSeconds": 300,
    "HistoryRetentionDays": 30
  },
  "CORS": {
    "AllowAllOrigins": false,
    "AllowedOrigins": [],
    "AllowAllMethods": true,
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowAllHeaders": true,
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "Accept",
      "Origin",
      "Access-Control-Allow-Origin",
      "User-Agent",
      "X-Requested-With"
    ],
    "AllowedExposedHeaders": [
      "X-Pagination"
    ],
    "AllowCredentials": true,
    "MaxAge": 600
  },
  "Authentication": {
    "EnableAnonymousAccess": false,
    "Schemas": {
      "LinkBearer": {
        "Authority": "",
        "ValidateToken": true
      }
    }
  },
  "DataProtection": {
    "Enabled": true,
    "KeyRing": ""
  },
  "LinkTokenService": {
    "Authority": "",
    "LinkAdminEmail": "",
    "TokenLifespan": 10,
    "SigningKey": ""
  },
  "Telemetry": {
    "EnableTelemetry": false,
    "EnableRuntimeInstrumentation": false,
    "EnableOtelCollector": false,
    "OtelCollectorEndpoint": "",
    "EnableAzureMonitor": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "",
          "labels": [
            {
              "key": "app",
              "value": "link-cloud"
            },
            {
              "key": "component",
              "value": "Operations"
            }
          ],
          "propertiesAsLabels": [
            "app",
            "component"
          ]
        }
      },
      {
        "Name": "Console"
      }
    ]
  }
}
