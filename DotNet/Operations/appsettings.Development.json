{
  "EnableSwagger": true,
  "ConnectionStrings": {
    "DatabaseConnection": "Server=localhost;Database=link-operations;Integrated Security=True;TrustServerCertificate=True"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "localhost:9092/"
    ],
    "SaslProtocolEnabled": true,
    "ClientId": "operations"
  },
  "KafkaOps": {
    "BrokerLifecycleEnabled": false,
    "TwoPersonApproval": false,
    "RequireDifferentApprover": false
  },
  "CORS": {
    "AllowAllOrigins": true,
    "AllowedOrigins": [
      "http://localhost:5218",
      "http://localhost:4200"
    ]
  },
  "Authentication": {
    "EnableAnonymousAccess": true,
    "Schemas": {
      "LinkBearer": {
        "Authority": "https://localhost:7004",
        "ValidateToken": true
      }
    }
  },
  "DataProtection": {
    "Enabled": false,
    "KeyRing": "Link"
  },
  "LinkTokenService": {
    "Authority": "https://localhost:7004",
    "LinkAdminEmail": "linkadmin@lantanagroup.com",
    "TokenLifespan": 10
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://localhost:55690"
  },
  "PipelineAbort": {
    "AllowInMemory": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "link-cloud"
            },
            {
              "key": "component",
              "value": "Operations"
            }
          ],
          "propertiesAsLabels": [
            "app",
            "component"
          ]
        }
      },
      {
        "Name": "Console"
      }
    ]
  }
}
