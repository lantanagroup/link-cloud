{
  "EnableSwagger": true,
  "ServiceInformation": {
    "ServiceName": "Link Report Service",
    "ProductVersion": "dev"
  },
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9094"
    ],
    "SaslProtocolEnabled": true
  },
  "MongoDB": {
    "ConnectionString": "mongodb://mongo:27017",
    "DatabaseName": "link-report"
  },
  "ConnectionStrings": {
    "Redis": "redis_cache:6379"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceUrl": "http://tenant:8074"
    },
    "CensusServiceUrl": "http://census:8064"
  },
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "Logging": {
    "LogLevel": {
      "LantanaGroup.Link.Report": "DEBUG"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8072"
      }
    }
  }
}
