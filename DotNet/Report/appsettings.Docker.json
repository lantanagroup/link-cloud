{
  "Authentication": {
    "EnableAnonymousAccess": true
  },
  "EnhancedQueryLoggingSettings": {
    "EnableEnhancedQueryLogging": true
  },
  "ConnectionStrings": {
    "DatabaseConnection": "Server=tcp:mssql,1433;Initial Catalog=link-report;Persist Security Info=False;User ID=sa;Password=${LINK_DB_PASS};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "EnableSwagger": true,
  "KafkaConnection": {
    "BootstrapServers": [
      "kafka_b:9092"
    ],
    "SaslProtocolEnabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:8072"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "LantanaGroup.Link.Report": "DEBUG"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100"
        }
      }
    ]
  },
  "ServiceInformation": {
    "ServiceName": "Link Report Service",
    "ProductVersion": "dev"
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceUrl": "http://tenant:8074"
    },
    "CensusServiceUrl": "http://census:8064"
  },
  "PatientAggregator": {
    "IncludeOrganizationResource": true
  },
  "Telemetry": {
    "EnableTelemetry": true,
    "EnableTracing": true,
    "EnableOtelCollector": true,
    "OtelCollectorEndpoint": "http://otel-collector:4317"
  }
}