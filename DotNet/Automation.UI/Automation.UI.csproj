<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Exceptions" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Automation.Link\Automation.Link.csproj" />
    <ProjectReference Include="..\LinkSdk\LinkSdk.csproj" />
    <ProjectReference Include="..\Normalization.Engine\Normalization.Engine.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- The run engine lives in Link.UI. This host still compiles those files so the
       old web project builds until it is removed. Link.UI does not reference this project. -->
  <ItemGroup>
    <Compile Include="..\Link.UI\Engine\**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Engine calls AutomationRules, which lives outside Engine with its models. -->
    <Compile Include="..\Link.UI\Services\AutomationRules.cs" Link="LinkServices\AutomationRules.cs" />
    <Compile Include="..\Link.UI\Models\AutomationModels.cs" Link="LinkModels\AutomationModels.cs" />
    <Compile Include="..\Link.UI\Models\AdminBffUser.cs" Link="LinkModels\AdminBffUser.cs" />
    <Compile Include="..\Link.UI\Services\AdminBffUserService.cs" Link="LinkServices\AdminBffUserService.cs" />
    <!-- Run start now resolves a named EHR system. Those types live beside the engine. -->
    <Compile Include="..\Link.UI\Services\EhrSystems\EhrSystemCatalog.cs" Link="LinkServices\EhrSystemCatalog.cs" />
    <Compile Include="..\Link.UI\Services\EhrSystems\EhrSystemRunSelector.cs" Link="LinkServices\EhrSystemRunSelector.cs" />
  </ItemGroup>
</Project>
