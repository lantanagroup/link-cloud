@model TestScenarioDefinition
@{
    ViewData["Title"] = Model.Id == Guid.Empty || string.IsNullOrWhiteSpace(Model.Name)
        ? "New Scenario"
        : $"Edit: {Model.Name}";

    var savedScenarios = (List<TestScenarioDefinition>?)ViewBag.SavedScenarios ?? [];
    var queryPlanTemplates = (List<QueryPlanTemplate>?)ViewBag.QueryPlanTemplates ?? [];
    var clinicalScenarios = ClinicalScenarioInfo.GetAll(Enum.GetValues<ProfiledMeasureType>().ToList());

    var editorModel = new RunsIndexViewModel
    {
        Runs = new AutomationRunIndexViewModel(),
        SavedScenarios = savedScenarios,
        ClinicalScenarios = clinicalScenarios,
        QueryPlanTemplates = queryPlanTemplates
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Scenarios</a>
    </div>

    @await Html.PartialAsync("_ScenarioEditorFields", editorModel)
</div>

@await Html.PartialAsync("_ScenarioEditorScripts", editorModel)
