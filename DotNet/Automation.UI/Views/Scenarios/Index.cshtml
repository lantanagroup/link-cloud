@model List<TestScenarioDefinition>
@{
    ViewData["Title"] = "Scenarios";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-collection-fill me-2"></i>Scenarios</h2>
    <p class="text-muted mb-3">Create, edit, clone, and manage reusable test configurations.</p>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>All Scenarios</span>
            <button type="button" class="btn btn-sm btn-success" id="btnNewScenario">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <div class="card-body p-0" data-au-table>

            <div class="table-responsive">
                <table class="table au-table mb-0" id="scenarioTable">
                    <thead>
                        <tr>
                            <th data-sort="name">Name</th>
                            <th data-sort="method">Method</th>
                            <th data-sort="measures">Measures</th>
                            <th data-sort="patients" data-sort-type="number">Patients</th>
                            <th data-sort="resources">Resources</th>
                            <th data-sort="seed">Seed</th>
                            <th data-sort="type">Type</th>
                            <th data-sort="updated" data-sort-type="number" data-sort-default="desc">Updated</th>
                            <th style="width:180px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var patientCount = s.PatientCohorts.Count > 0
                                ? s.PatientCohorts.Sum(c => c.PatientCount)
                                : s.PatientCount;
                            var resourceRange = s.PatientCohorts.Count > 0
                                ? string.Join(", ",
                                    s.PatientCohorts
                                        .Select(c => c.ResourcesPerPatientMin == c.ResourcesPerPatientMax
                                            ? c.ResourcesPerPatientMin.ToString()
                                        :   $"{c.ResourcesPerPatientMin}\u2013{c.ResourcesPerPatientMax}")
                                        .Distinct())
                                : "-";

                            <tr data-id="@s.Id"
                                data-name="@s.Name"
                                data-description="@(s.Description ?? "")"
                                data-method="@s.ReportMethod"
                                data-type="@(s.IsSystemScenario ? "System" : "Custom")"
                                data-measures="@string.Join(" ", s.SelectedMeasures.Select(ProfiledMeasureCatalog.GetDisplayName))"
                                data-seed="@s.Seed"
                                data-patients="@patientCount"
                                data-resources="@resourceRange"
                                data-updated="@s.UpdatedAt.ToUnixTimeMilliseconds()">
                                <td>
                                    <strong>@s.Name</strong>
                                    @if (s.IsMetricsRun)
                                    {
                                        <span class="badge rounded-pill au-badge-active ms-1">Metrics</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <br /><small class="text-muted">@s.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@s.ReportMethod</span></td>
                                <td>
                                    @foreach (var m in s.SelectedMeasures)
                                    {
                                        <span class="badge bg-secondary">@ProfiledMeasureCatalog.GetDisplayName(m)</span>
                                    }
                                </td>
                                <td>@patientCount</td>
                                <td>@resourceRange</td>
                                <td><code>@s.Seed</code></td>
                                <td>
                                    @if (s.IsSystemScenario)
                                    {
                                        <span class="badge bg-dark">System</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Custom</span>
                                    }
                                </td>
                                <td class="small text-muted">@s.UpdatedAt.LocalDateTime.ToString("g")</td>
                                <td class="text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-scenario-open" data-id="@s.Id" data-mode="@(s.IsSystemScenario ? "view" : "edit")">
                                            @(s.IsSystemScenario ? "View" : "Edit")
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-scenario-clone" data-id="@s.Id">Clone</button>
                                        @if (!s.IsSystemScenario)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-scenario-delete" data-id="@s.Id">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="au-table-empty text-center text-muted py-4" hidden>
                    No matching scenarios found.
                </div>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-4">No scenarios yet. Click <strong>+</strong> to create one.</div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_ScenarioEditorModal")

<script>
    (function () {

        // The shared editor fires this event after a successful save/clone/delete.
        // On the Scenarios list page we reload so the table reflects the change.

        document.addEventListener('scenario-editor:changed', function () {
            location.reload();
        });

        // Open a scenario passed from Quick Launch directly in the editor.
        var editScenarioId = new URLSearchParams(window.location.search).get('editScenarioId');

        if (editScenarioId && typeof window.openScenarioEditor === 'function') {
            window.openScenarioEditor(editScenarioId, 'edit');

            // Remove the one-time navigation parameter so saving/reloading the
            // Scenarios page does not automatically reopen the editor.
            var url = new URL(window.location.href);
            url.searchParams.delete('editScenarioId');
            window.history.replaceState(null, '', url.toString());
        }
    })();
</script>
