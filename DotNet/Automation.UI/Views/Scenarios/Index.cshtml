@model List<TestScenarioDefinition>
@{
    ViewData["Title"] = "Scenarios";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-collection-fill me-2"></i>Scenarios</h2>
    <p class="text-muted mb-3">Create, edit, clone, and manage reusable test configurations.</p>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>All Scenarios</span>
            <button type="button" class="btn btn-sm btn-success" id="btnNewScenario">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <div class="card-body">

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="scenarioSearch">Search</label>
                    <input type="text"
                           id="scenarioSearch"
                           class="form-control"
                           placeholder="Search scenarios..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="scenarioTypeFilter">Scenario type</label>
                    <select id="scenarioTypeFilter" class="form-select">
                        <option value="">All types</option>
                        <option value="Custom">Custom</option>
                        <option value="System">System</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="scenarioSort">Sort by</label>
                    <select id="scenarioSort" class="form-select">
                        <option value="name">Alphabetical (A–Z)</option>
                        <option value="updated">Recently Modified</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table au-table mb-0" id="scenarioTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Method</th>
                            <th>Measures</th>
                            <th>Patients</th>
                            <th>Resources</th>
                            <th>Seed</th>
                            <th>Type</th>
                            <th>Updated</th>
                            <th style="width:180px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var patientCount = s.PatientCohorts.Count > 0
                                ? s.PatientCohorts.Sum(c => c.PatientCount)
                                : s.PatientCount;
                            var resourceRange = s.PatientCohorts.Count > 0
                                ? string.Join(", ",
                                    s.PatientCohorts
                                        .Select(c => c.ResourcesPerPatientMin == c.ResourcesPerPatientMax
                                            ? c.ResourcesPerPatientMin.ToString()
                                        :   $"{c.ResourcesPerPatientMin}\u2013{c.ResourcesPerPatientMax}")
                                        .Distinct())
                                : "-";

                            <tr data-id="@s.Id"
                                data-name="@s.Name"
                                data-description="@(s.Description ?? "")"
                                data-method="@s.ReportMethod"
                                data-type="@(s.IsSystemScenario ? "System" : "Custom")"
                                data-measures="@string.Join(" ", s.SelectedMeasures.Select(ProfiledMeasureCatalog.GetDisplayName))"
                                data-seed="@s.Seed"
                                data-patients="@patientCount"
                                data-resources="@resourceRange"
                                data-updated="@s.UpdatedAt.ToUnixTimeMilliseconds()">
                                <td>
                                    <strong>@s.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <br /><small class="text-muted">@s.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@s.ReportMethod</span></td>
                                <td>
                                    @foreach (var m in s.SelectedMeasures)
                                    {
                                        <span class="badge bg-secondary">@ProfiledMeasureCatalog.GetDisplayName(m)</span>
                                    }
                                </td>
                                <td>@patientCount</td>
                                <td>@resourceRange</td>
                                <td><code>@s.Seed</code></td>
                                <td>
                                    @if (s.IsSystemScenario)
                                    {
                                        <span class="badge bg-dark">System</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Custom</span>
                                    }
                                </td>
                                <td class="small text-muted">@s.UpdatedAt.LocalDateTime.ToString("g")</td>
                                <td class="text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-scenario-open" data-id="@s.Id" data-mode="@(s.IsSystemScenario ? "view" : "edit")">
                                            @(s.IsSystemScenario ? "View" : "Edit")
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-scenario-clone" data-id="@s.Id">Clone</button>
                                        @if (!s.IsSystemScenario)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-scenario-delete" data-id="@s.Id">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="noScenarioResults"
                     class="text-center text-muted py-4"
                     style="display:none;">
                    No matching scenarios found.
                </div>
            </div>
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-4">No scenarios yet. Click <strong>+</strong> to create one.</div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_ScenarioEditorModal")

<script>
    (function () {

        // The shared editor fires this event after a successful save/clone/delete.
        // On the Scenarios list page we reload so the table reflects the change.

        // Reload after edits
        document.addEventListener('scenario-editor:changed', function () {
            location.reload();
        });

        // Scenario search
        var search = document.getElementById('scenarioSearch');
        var typeFilter = document.getElementById('scenarioTypeFilter');
        var sort = document.getElementById('scenarioSort');
        var tableBody = document.querySelector('#scenarioTable tbody');
        var noResults = document.getElementById('noScenarioResults');

        function getScenarioRows() {
            return Array.from(
                document.querySelectorAll('#scenarioTable tbody tr[data-id]')
            );
        }

        function applyScenarioView() {
            if (!tableBody) return;

            var searchValue = search
                ? search.value.trim().toLowerCase()
                : '';

            var selectedType = typeFilter
                ? typeFilter.value
                : '';

            var sortValue = sort
                ? sort.value
                : 'name';

            var rows = getScenarioRows();

            rows.forEach(function (row) {
                var searchableText = (
                    (row.dataset.name || '') + ' ' +
                    (row.dataset.description || '') + ' ' +
                    (row.dataset.method || '') + ' ' +
                    (row.dataset.type || '') + ' ' +
                    (row.dataset.measures || '') + ' ' +
                    (row.dataset.seed || '') + ' ' +
                    (row.dataset.patients || '') + ' ' +
                    (row.dataset.resources || '')
                ).toLowerCase();

                var matchesSearch =
                    !searchValue ||
                    searchableText.includes(searchValue);

                var matchesType =
                    !selectedType ||
                    row.dataset.type === selectedType;

                row.hidden = !(matchesSearch && matchesType);
            });

            rows.sort(function (a, b) {
                if (sortValue === 'updated') {
                    return Number(b.dataset.updated || 0) -
                        Number(a.dataset.updated || 0);
                }

                return (a.dataset.name || '').localeCompare(
                    b.dataset.name || '',
                    undefined,
                    { sensitivity: 'base' }
                );
            });

            rows.forEach(function (row) {
                tableBody.appendChild(row);
            });

            var visibleCount = rows.filter(function (row) {
                return !row.hidden;
            }).length;

            if (noResults) {
                noResults.style.display =
                    rows.length > 0 && visibleCount === 0 ? '' : 'none';
            }
        }

        if (search) {
            search.addEventListener('input', applyScenarioView);
        }

        if (typeFilter) {
            typeFilter.addEventListener('change', applyScenarioView);
        }

        if (sort) {
            sort.addEventListener('change', applyScenarioView);
        }

        applyScenarioView();
    })();
</script>
