@model Automation.UI.Models.AboutViewModel

@{
    ViewData["Title"] = "About";
}

<div class="mb-4">
    <h1>
        <i class="bi bi-info-circle me-2"></i>About
    </h1>
    <p class="text-muted">
        Configuration information for the current Automation UI environment.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bi bi-server me-2"></i>FHIR Server
        </h5>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Hostname</dt>
            <dd class="col-sm-9">
                @Model.FhirServerHostname
            </dd>

            <dt class="col-sm-3">Base URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.FhirServerBaseUrl))
                {
                    <code class="text-break">@Model.FhirServerBaseUrl</code>
                }
                else
                {
                    <span class="text-muted">Not configured</span>
                }
            </dd>
        </dl>
    </div>
</div>