@model List<Automation.UI.Models.QueryPlanTemplate>
@{
    ViewData["Title"] = "Query Plans";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3 me-2"></i>Query Plans</h2>
    <p class="text-muted mb-3">Manage which FHIR resource types are acquired during data acquisition. The <strong>default</strong> plan is used for new scenarios unless overridden.</p>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>All Query Plans</span>
            <button type="button" class="btn btn-sm btn-success" id="btnNewQp">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table au-table mb-0" id="qpTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Resource Types</th>
                        <th>EHR</th>
                        <th>LookBack</th>
                        <th>Queries</th>
                        <th>Type</th>
                        <th>Updated</th>
                        <th style="width:220px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var acquiredTypes = t.GetAcquiredResourceTypes();
                        <tr data-id="@t.Id">
                            <td>
                                <strong>@t.Name</strong>
                                @if (t.IsDefault)
                                {
                                    <span class="badge bg-success ms-1">Default</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <br /><small class="text-muted">@t.Description</small>
                                }
                            </td>
                            <td>
                                <small class="text-muted" title="@string.Join(", ", acquiredTypes.OrderBy(x => x))">
                                    @acquiredTypes.Count types
                                </small>
                            </td>
                            <td><small>@t.EhrDescription</small></td>
                            <td><code class="small">@t.LookBack</code></td>
                            <td>
                                <small class="text-muted">@t.InitialQueries.Count init, @t.SupplementalQueries.Count supp</small>
                            </td>
                            <td>
                                @if (t.IsSystem)
                                {
                                    <span class="badge bg-dark">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Custom</span>
                                }
                            </td>
                            <td class="small text-muted">@t.UpdatedAt.LocalDateTime.ToString("g")</td>
                            <td class="text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-qp-open" data-id="@t.Id" data-mode="@(t.IsSystem ? "view" : "edit")">
                                        @(t.IsSystem ? "View" : "Edit")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-qp-clone" data-id="@t.Id">Clone</button>
                                    @if (!t.IsDefault)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success btn-qp-default" data-id="@t.Id" title="Set as default">
                                            <i class="bi bi-star"></i>
                                        </button>
                                    }
                                    @if (!t.IsSystem)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-qp-delete" data-id="@t.Id">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-4">No query plans yet. Click <strong>+</strong> to create one.</div>
            }
        </div>
    </div>
</div>

@* ========== Query Plan Editor Modal ========== *@
<div id="qpModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:1100px;display:flex;flex-direction:column;max-height:90vh;">
            @* ---- Modal Header ---- *@
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="modalTitle"><i class="bi bi-diagram-3 me-2"></i>Query Plan</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnModalSave" style="display:none;">
                        <i class="bi bi-floppy me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnModalClose">Close</button>
                </div>
            </div>
            <div id="qpFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            @* ---- Modal Body ---- *@
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="modalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="QpId" />
                <input type="hidden" id="QpIsSystem" value="false" />

                @* ---- Tabs: Visual Editor / JSON Import ---- *@
                <ul class="nav nav-tabs mb-3" id="qpEditorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-visual" data-bs-toggle="tab" data-bs-target="#pane-visual" type="button" role="tab">
                            <i class="bi bi-pencil-square me-1"></i>Visual Editor
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-json" data-bs-toggle="tab" data-bs-target="#pane-json" type="button" role="tab">
                            <i class="bi bi-filetype-json me-1"></i>Import JSON
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    @* ===== Visual Editor Pane ===== *@
                    <div class="tab-pane fade show active" id="pane-visual" role="tabpanel">
                        <div id="qpConfigArea" class="position-relative">
                            <div class="row g-3">
                                <div class="col-md-5">
                                    <label class="form-label" for="QpName">Name</label>
                                    <input class="form-control" id="QpName" maxlength="120" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="QpEhr">
                                        EHR
                                        <span class="au-info-icon" data-bs-toggle="tooltip" title="EHR vendor identifier sent to DataAcquisition (e.g. Epic, Cerner)."><i class="bi bi-info-circle"></i></span>
                                    </label>
                                    <input class="form-control" id="QpEhr" maxlength="60" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label" for="QpLookBack">
                                        LookBack
                                        <span class="au-info-icon" data-bs-toggle="tooltip" title="ISO 8601 duration. How far before the report start date to begin querying. P0D = same day, P30D = 30 days before."><i class="bi bi-info-circle"></i></span>
                                    </label>
                                    <input class="form-control" id="QpLookBack" maxlength="20" placeholder="P0D" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <div class="small text-muted" id="qpResourceTypeSummary"></div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="QpDescription">Description</label>
                                    <input class="form-control" id="QpDescription" maxlength="500" />
                                </div>

                                @* ---- Initial Queries ---- *@
                                <div class="col-12">
                                    <div class="au-card mb-0">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <span>
                                                <i class="bi bi-search me-1"></i>Initial Queries
                                                <span class="au-info-icon" data-bs-toggle="tooltip" title="Patient-scoped queries that fetch core clinical data (Encounter, MedicationRequest, etc.) using the patient ID and report date range."><i class="bi bi-info-circle"></i></span>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-success qp-add-query-btn" data-target="initialQueryRows">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div id="initialQueryRows" class="qp-query-list"></div>
                                        </div>
                                    </div>
                                </div>

                                @* ---- Supplemental Queries ---- *@
                                <div class="col-12 mt-3">
                                    <div class="au-card mb-0">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <span>
                                                <i class="bi bi-link-45deg me-1"></i>Supplemental Queries
                                                <span class="au-info-icon" data-bs-toggle="tooltip" title="Supplemental queries run after initial queries. Reference queries follow references from acquired resources to fetch related data (e.g. Medication from MedicationRequest.medicationReference)."><i class="bi bi-info-circle"></i></span>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-success qp-add-query-btn" data-target="supplementalQueryRows">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div id="supplementalQueryRows" class="qp-query-list"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="systemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                        </div>
                    </div>

                    @* ===== JSON Import Pane ===== *@
                    <div class="tab-pane fade" id="pane-json" role="tabpanel">
                        <div class="mb-3">
                            <p class="text-muted small mb-2">
                                Paste or upload a query plan JSON document. This will <strong>overwrite</strong> the entire query plan configuration.
                                The JSON should match the DataAcquisition query plan format (with <code>InitialQueries</code> and <code>SupplementalQueries</code> as numbered objects or arrays).
                            </p>
                            <div class="d-flex gap-2 mb-2">
                                <label class="btn btn-sm btn-outline-primary mb-0" for="jsonFileInput">
                                    <i class="bi bi-upload me-1"></i>Upload File
                                </label>
                                <input type="file" id="jsonFileInput" accept=".json,application/json" class="d-none" />
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnJsonClear">
                                    <i class="bi bi-x-lg me-1"></i>Clear
                                </button>
                            </div>
                            <textarea id="jsonImportArea" class="form-control font-monospace" rows="16" placeholder='Paste JSON here or upload a file...' spellcheck="false" style="font-size:.82rem;tab-size:2;"></textarea>
                        </div>
                        <div id="jsonImportError" class="alert alert-danger py-2 small" style="display:none;"></div>
                        <div id="jsonImportSuccess" class="alert alert-success py-2 small" style="display:none;"></div>
                        <button type="button" class="btn btn-au-action" id="btnJsonApply">
                            <i class="bi bi-check-lg me-1"></i>Apply to Editor
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="qpModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

@* ---- Inline styles for query editor cards ---- *@
<style>
    .qp-query-list { display:flex; flex-direction:column; gap:.5rem; }
    .qp-query-card {
        border:1px solid #dee2e6; border-radius:var(--au-radius); background:#fafbfc;
        overflow:hidden; transition: box-shadow .15s;
    }
    .qp-query-card:hover { box-shadow:0 2px 8px rgba(0,0,0,.08); }
    .qp-query-header {
        display:flex; align-items:center; gap:.5rem; padding:.5rem .75rem;
        background:#f0f1f3; border-bottom:1px solid #e9ecef; flex-wrap:wrap;
    }
    .qp-query-header .qp-idx {
        width:22px; height:22px; border-radius:50%; background:var(--au-dark); color:#fff;
        font-size:.7rem; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }
    .qp-query-header input, .qp-query-header select { max-width:180px; }
    .qp-query-body { padding:.5rem .75rem; }
    .qp-param-row {
        display:flex; align-items:center; gap:.4rem; padding:.3rem 0; flex-wrap:wrap;
        border-bottom:1px solid #f0f0f0;
    }
    .qp-param-row:last-child { border-bottom:none; }
    .qp-param-row input, .qp-param-row select { font-size:.82rem; }
    .qp-param-row .form-control, .qp-param-row .form-select { padding:.25rem .5rem; height:auto; }
    .qp-param-type-badge {
        font-size:.7rem; font-weight:600; padding:.15rem .4rem; border-radius:3px;
        text-transform:uppercase; letter-spacing:.03em; flex-shrink:0;
        width:80px; text-align:center; display:inline-block;
    }
    .qp-param-type-badge.variable { background:#e3f2fd; color:#1565c0; }
    .qp-param-type-badge.literal { background:#fff3e0; color:#e65100; }
    .qp-param-type-badge.resourceids { background:#e8f5e9; color:#2e7d32; }
    .qp-ref-options { display:flex; align-items:center; gap:.75rem; padding:.4rem 0; }
    .qp-ref-options label { font-size:.78rem; color:var(--au-muted); margin-bottom:0; white-space:nowrap; }
    .qp-ref-options input { width:70px; font-size:.82rem; }
</style>

<script>
(function () {
    'use strict';

    // ---- DOM refs ----
    var modal = document.getElementById('qpModal');
    var backdrop = document.getElementById('qpModalBackdrop');
    var modalTitle = document.getElementById('modalTitle');
    var btnSave = document.getElementById('btnModalSave');
    var overlay = document.getElementById('systemOverlay');
    var idInput = document.getElementById('QpId');
    var isSystemInput = document.getElementById('QpIsSystem');

    // ---- URLs ----
    var saveUrl = '@Url.Action("SaveInline", "QueryPlans")';
    var deleteUrl = '@Url.Action("DeleteInline", "QueryPlans")';
    var cloneUrl = '@Url.Action("CloneInline", "QueryPlans")';
    var setDefaultUrl = '@Url.Action("SetDefaultInline", "QueryPlans")';
    var getJsonUrl = '@Url.Action("GetJson", "QueryPlans")';
    var getDefaultsUrl = '@Url.Action("GetDefaults", "QueryPlans")';

    // ---- Helpers ----
    function af() { var t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
    function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    function openModal() { modal.style.display = ''; backdrop.style.display = ''; }
    function closeModal() { modal.style.display = 'none'; backdrop.style.display = 'none'; }

    document.getElementById('btnModalClose').addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    var currentEditable = false;
    function setEditable(e) {
        currentEditable = e;
        overlay.style.display = e ? 'none' : '';
        btnSave.style.display = e ? '' : 'none';
        document.querySelectorAll('.qp-add-query-btn').forEach(function (b) { b.style.display = e ? '' : 'none'; });
        document.querySelectorAll('.qp-remove-query-btn, .qp-add-param-btn, .qp-remove-param-btn').forEach(function (b) { b.style.display = e ? '' : 'none'; });
        // Hide JSON import tab when view-only
        document.getElementById('tab-json').style.display = e ? '' : 'none';
    }

    // ===================================================================
    //  PARAMETER ROW BUILDER
    // ===================================================================
    function buildParamRow(container, p) {
        var row = document.createElement('div');
        row.className = 'qp-param-row';

        var typeBadgeClass = (p.parameterType || 'variable').toLowerCase();
        var typeLabel = p.parameterType || 'Variable';

        row.innerHTML =
            '<span class="qp-param-type-badge ' + typeBadgeClass + '">' + esc(typeLabel) + '</span>' +
            '<select class="form-select qp-p-type" style="width:110px;" title="Parameter type">' +
                '<option value="Variable"' + (typeLabel === 'Variable' ? ' selected' : '') + '>Variable</option>' +
                '<option value="Literal"' + (typeLabel === 'Literal' ? ' selected' : '') + '>Literal</option>' +
                '<option value="ResourceIds"' + (typeLabel === 'ResourceIds' ? ' selected' : '') + '>ResourceIds</option>' +
            '</select>' +
            '<input class="form-control qp-p-name" placeholder="name" value="' + esc(p.name) + '" style="width:110px;" title="Parameter name (e.g. patient, date, category)" />' +
            '<input class="form-control qp-p-variable" placeholder="var#" value="' + (p.variable != null ? p.variable : '') + '" style="width:55px;" type="number" title="Variable index (0=patient, 1=periodStart, 3=periodEnd)" />' +
            '<input class="form-control qp-p-format" placeholder="format" value="' + esc(p.format) + '" style="width:90px;" title="Format string (e.g. ge{0}, le{0})" />' +
            '<input class="form-control qp-p-literal" placeholder="literal value" value="' + esc(p.literal) + '" style="flex:1;min-width:100px;" title="Literal value (e.g. order, imaging,laboratory)" />' +
            '<input class="form-control qp-p-resource" placeholder="resource" value="' + esc(p.resource) + '" style="width:95px;" title="Resource type for ResourceIds (e.g. Encounter)" />' +
            '<input class="form-control qp-p-paged" placeholder="paged" value="' + esc(p.pagedValue) + '" style="width:60px;" title="Page size for ResourceIds" />' +
            '<button type="button" class="btn btn-sm btn-outline-danger qp-remove-param-btn" title="Remove parameter">&times;</button>';

        container.appendChild(row);

        // Show/hide fields based on type
        function syncFields() {
            var type = row.querySelector('.qp-p-type').value;
            var badge = row.querySelector('.qp-param-type-badge');
            badge.textContent = type;
            badge.className = 'qp-param-type-badge ' + type.toLowerCase();

            row.querySelector('.qp-p-variable').style.display = type === 'Variable' ? '' : 'none';
            row.querySelector('.qp-p-format').style.display = type === 'Variable' ? '' : 'none';
            row.querySelector('.qp-p-literal').style.display = type === 'Literal' ? '' : 'none';
            row.querySelector('.qp-p-resource').style.display = type === 'ResourceIds' ? '' : 'none';
            row.querySelector('.qp-p-paged').style.display = type === 'ResourceIds' ? '' : 'none';
        }
        syncFields();
        row.querySelector('.qp-p-type').addEventListener('change', syncFields);

        row.querySelector('.qp-remove-param-btn').addEventListener('click', function () { row.remove(); });

        return row;
    }

    // ===================================================================
    //  QUERY CARD BUILDER
    // ===================================================================
    function buildQueryCard(q, container) {
        var card = document.createElement('div');
        card.className = 'qp-query-card';

        var idx = container.children.length + 1;
        var isRef = (q.queryConfigType || '').toLowerCase() === 'reference';

        // Header
        var header = document.createElement('div');
        header.className = 'qp-query-header';
        header.innerHTML =
            '<span class="qp-idx">' + idx + '</span>' +
            '<input class="form-control form-control-sm qe-resource" value="' + esc(q.resourceType) + '" placeholder="ResourceType" style="width:160px;" title="FHIR resource type" />' +
            '<select class="form-select form-select-sm qe-configtype" style="width:120px;" title="Query config type">' +
                '<option value="Parameter"' + (!isRef ? ' selected' : '') + '>Parameter</option>' +
                '<option value="Reference"' + (isRef ? ' selected' : '') + '>Reference</option>' +
            '</select>' +
            '<div style="flex:1;"></div>' +
            '<button type="button" class="btn btn-sm btn-outline-danger qp-remove-query-btn" title="Remove query"><i class="bi bi-trash"></i></button>';
        card.appendChild(header);

        // Body
        var body = document.createElement('div');
        body.className = 'qp-query-body';
        card.appendChild(body);

        // Reference options area
        var refArea = document.createElement('div');
        refArea.className = 'qp-ref-options';
        refArea.innerHTML =
            '<label>OperationType</label>' +
            '<input class="form-control form-control-sm qe-optype" type="number" value="' + (q.operationType != null ? q.operationType : '') + '" title="Operation type (numeric)" />' +
            '<label>Paged</label>' +
            '<input class="form-control form-control-sm qe-paged" type="number" value="' + (q.paged != null ? q.paged : '') + '" title="Page size for paginated results" />';
        body.appendChild(refArea);

        // Parameter list area
        var paramArea = document.createElement('div');
        paramArea.className = 'qp-param-area';
        body.appendChild(paramArea);

        var paramFooter = document.createElement('div');
        paramFooter.className = 'mt-1';
        paramFooter.innerHTML = '<button type="button" class="btn btn-sm btn-outline-primary qp-add-param-btn"><i class="bi bi-plus me-1"></i>Add Parameter</button>';
        body.appendChild(paramFooter);

        // Populate parameters
        (q.parameters || []).forEach(function (p) { buildParamRow(paramArea, p); });

        // Show/hide based on config type
        function syncConfigType() {
            var type = card.querySelector('.qe-configtype').value;
            var showRef = type === 'Reference';
            refArea.style.display = showRef ? 'flex' : 'none';
            paramArea.style.display = showRef ? 'none' : '';
            paramFooter.style.display = showRef ? 'none' : '';
        }
        syncConfigType();
        card.querySelector('.qe-configtype').addEventListener('change', syncConfigType);

        // Events
        card.querySelector('.qp-remove-query-btn').addEventListener('click', function () {
            card.remove();
            reindexContainer(container);
            updateTypeSummary();
        });
        card.querySelector('.qe-resource').addEventListener('input', updateTypeSummary);
        paramFooter.querySelector('.qp-add-param-btn').addEventListener('click', function () {
            buildParamRow(paramArea, { parameterType: 'Variable', name: '', variable: null, format: null, literal: null, resource: null, pagedValue: null });
        });

        container.appendChild(card);
        return card;
    }

    function reindexContainer(container) {
        Array.prototype.forEach.call(container.querySelectorAll('.qp-idx'), function (el, i) {
            el.textContent = i + 1;
        });
    }

    function updateTypeSummary() {
        var types = new Set();
        document.querySelectorAll('#initialQueryRows .qe-resource, #supplementalQueryRows .qe-resource').forEach(function (inp) {
            var v = (inp.value || '').trim();
            if (v) types.add(v);
        });
        document.getElementById('qpResourceTypeSummary').textContent = types.size + ' resource type' + (types.size !== 1 ? 's' : '');
    }

    // ===================================================================
    //  READ / COLLECT MODEL
    // ===================================================================
    function readQueriesFromContainer(containerId) {
        var cards = document.getElementById(containerId).querySelectorAll('.qp-query-card');
        return Array.prototype.map.call(cards, function (card) {
            var configType = card.querySelector('.qe-configtype').value;
            var entry = {
                resourceType: card.querySelector('.qe-resource').value || '',
                queryConfigType: configType
            };
            if (configType === 'Reference') {
                var opVal = card.querySelector('.qe-optype').value;
                var pgVal = card.querySelector('.qe-paged').value;
                entry.operationType = opVal ? parseInt(opVal) : null;
                entry.paged = pgVal ? parseInt(pgVal) : null;
                entry.parameters = [];
            } else {
                entry.operationType = null;
                entry.paged = null;
                entry.parameters = [];
                card.querySelectorAll('.qp-param-row').forEach(function (row) {
                    var pType = row.querySelector('.qp-p-type').value;
                    var p = { parameterType: pType, name: row.querySelector('.qp-p-name').value };
                    if (pType === 'Variable') {
                        var v = row.querySelector('.qp-p-variable').value;
                        p.variable = v !== '' ? parseInt(v) : null;
                        p.format = row.querySelector('.qp-p-format').value || null;
                    } else if (pType === 'Literal') {
                        p.literal = row.querySelector('.qp-p-literal').value || null;
                    } else if (pType === 'ResourceIds') {
                        p.resource = row.querySelector('.qp-p-resource').value || null;
                        p.pagedValue = row.querySelector('.qp-p-paged').value || null;
                    }
                    entry.parameters.push(p);
                });
            }
            return entry;
        });
    }

    function collectModel() {
        return {
            id: idInput.value,
            name: document.getElementById('QpName').value,
            description: document.getElementById('QpDescription').value || null,
            ehrDescription: document.getElementById('QpEhr').value || 'Epic',
            lookBack: document.getElementById('QpLookBack').value || 'P0D',
            isSystem: false,
            isDefault: false,
            initialQueries: readQueriesFromContainer('initialQueryRows'),
            supplementalQueries: readQueriesFromContainer('supplementalQueryRows')
        };
    }

    // ===================================================================
    //  POPULATE FROM DATA
    // ===================================================================
    function populate(data) {
        idInput.value = data.id || '';
        isSystemInput.value = data.isSystem ? 'true' : 'false';
        document.getElementById('QpName').value = data.name || '';
        document.getElementById('QpEhr').value = data.ehrDescription || 'Epic';
        document.getElementById('QpLookBack').value = data.lookBack || 'P0D';
        document.getElementById('QpDescription').value = data.description || '';

        var initContainer = document.getElementById('initialQueryRows');
        var suppContainer = document.getElementById('supplementalQueryRows');
        initContainer.innerHTML = '';
        suppContainer.innerHTML = '';

        (data.initialQueries || []).forEach(function (q) { buildQueryCard(q, initContainer); });
        (data.supplementalQueries || []).forEach(function (q) { buildQueryCard(q, suppContainer); });

        updateTypeSummary();
    }

    // ===================================================================
    //  ADD QUERY BUTTONS
    // ===================================================================
    document.querySelectorAll('.qp-add-query-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = btn.getAttribute('data-target');
            var container = document.getElementById(target);
            var defaultType = target === 'supplementalQueryRows' ? 'Reference' : 'Parameter';
            var q = defaultType === 'Reference'
                ? { resourceType: '', queryConfigType: 'Reference', operationType: 2, paged: 100, parameters: [] }
                : { resourceType: '', queryConfigType: 'Parameter', parameters: [{ parameterType: 'Variable', name: 'patient', variable: 0 }] };
            buildQueryCard(q, container);
            updateTypeSummary();
        });
    });

    // ===================================================================
    //  JSON IMPORT
    // ===================================================================
    var jsonArea = document.getElementById('jsonImportArea');
    var jsonFileInput = document.getElementById('jsonFileInput');
    var jsonError = document.getElementById('jsonImportError');
    var jsonSuccess = document.getElementById('jsonImportSuccess');

    document.getElementById('btnJsonClear').addEventListener('click', function () {
        jsonArea.value = '';
        jsonError.style.display = 'none';
        jsonSuccess.style.display = 'none';
    });

    jsonFileInput.addEventListener('change', function () {
        var file = this.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (e) { jsonArea.value = e.target.result; };
        reader.readAsText(file);
        this.value = '';
    });

    document.getElementById('btnJsonApply').addEventListener('click', function () {
        jsonError.style.display = 'none';
        jsonSuccess.style.display = 'none';

        var raw = jsonArea.value.trim();
        if (!raw) { jsonError.textContent = 'No JSON provided.'; jsonError.style.display = ''; return; }

        var parsed;
        try { parsed = JSON.parse(raw); }
        catch (e) { jsonError.textContent = 'Invalid JSON: ' + e.message; jsonError.style.display = ''; return; }

        // Normalize: support both numbered-object and array formats for queries
        var initial = normalizeQueries(parsed.InitialQueries || parsed.initialQueries);
        var supplemental = normalizeQueries(parsed.SupplementalQueries || parsed.supplementalQueries);

        if (initial.length === 0 && supplemental.length === 0) {
            jsonError.textContent = 'No InitialQueries or SupplementalQueries found in the JSON.';
            jsonError.style.display = '';
            return;
        }

        // Apply metadata if present
        var name = parsed.PlanName || parsed.planName || parsed.Name || parsed.name;
        var ehr = parsed.EHRDescription || parsed.ehrDescription || parsed.EhrDescription;
        var lookBack = parsed.LookBack || parsed.lookBack;

        if (name) document.getElementById('QpName').value = name;
        if (ehr) document.getElementById('QpEhr').value = ehr;
        if (lookBack) document.getElementById('QpLookBack').value = lookBack;

        // Rebuild
        var initContainer = document.getElementById('initialQueryRows');
        var suppContainer = document.getElementById('supplementalQueryRows');
        initContainer.innerHTML = '';
        suppContainer.innerHTML = '';

        initial.forEach(function (q) { buildQueryCard(normalizeQueryEntry(q), initContainer); });
        supplemental.forEach(function (q) { buildQueryCard(normalizeQueryEntry(q), suppContainer); });

        updateTypeSummary();
        jsonSuccess.textContent = 'Applied ' + initial.length + ' initial + ' + supplemental.length + ' supplemental queries.';
        jsonSuccess.style.display = '';

        // Switch to visual editor tab
        var visualTab = document.getElementById('tab-visual');
        if (visualTab) bootstrap.Tab.getOrCreateInstance(visualTab).show();
    });

    function normalizeQueries(obj) {
        if (!obj) return [];
        if (Array.isArray(obj)) return obj;
        // Numbered-object format: { "0": {...}, "1": {...} }
        var keys = Object.keys(obj).sort(function (a, b) { return parseInt(a) - parseInt(b); });
        return keys.map(function (k) { return obj[k]; });
    }

    function normalizeQueryEntry(raw) {
        return {
            resourceType: raw.resourceType || raw.ResourceType || '',
            queryConfigType: raw.queryConfigType || raw.QueryConfigType || 'Parameter',
            operationType: raw.operationType != null ? raw.operationType : (raw.OperationType != null ? raw.OperationType : null),
            paged: raw.paged != null ? raw.paged : (raw.Paged != null ? raw.Paged : null),
            parameters: (raw.parameters || raw.Parameters || []).map(function (p) {
                return {
                    parameterType: p.parameterType || p.ParameterType || 'Variable',
                    name: p.name || p.Name || '',
                    variable: p.variable != null ? p.variable : (p.Variable != null ? p.Variable : null),
                    format: p.format || p.Format || null,
                    literal: p.literal || p.Literal || null,
                    resource: p.resource || p.Resource || null,
                    pagedValue: p.pagedValue || p.PagedValue || p.paged || null
                };
            })
        };
    }

    // ===================================================================
    //  ERROR HANDLING
    // ===================================================================
    var qpFormErrors = document.getElementById('qpFormErrors');
    function showQpError(msg) { qpFormErrors.textContent = msg; qpFormErrors.style.display = ''; }
    function clearQpErrors() { qpFormErrors.style.display = 'none'; qpFormErrors.textContent = ''; clearQpFieldErrors(); }
    function markQpFieldError(id, msg) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.add('is-invalid');
        var fb = el.parentElement.querySelector('.invalid-feedback');
        if (!fb) { fb = document.createElement('div'); fb.className = 'invalid-feedback'; el.parentElement.appendChild(fb); }
        fb.textContent = msg; fb.style.display = 'block';
    }
    function clearQpFieldErrors() {
        document.querySelectorAll('#qpConfigArea .is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
        document.querySelectorAll('#qpConfigArea .invalid-feedback').forEach(function (el) { el.style.display = 'none'; });
    }

    // ===================================================================
    //  API HELPERS
    // ===================================================================
    async function qpPostJson(url, body) {
        var res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': af() },
            body: JSON.stringify(body)
        });
        if (!res.ok) {
            var errText = '';
            try { errText = await res.text(); } catch (_) {}
            throw new Error(errText || ('Server returned ' + res.status));
        }
        var ct = res.headers.get('content-type') || '';
        return ct.indexOf('json') >= 0 ? res.json() : null;
    }

    // ===================================================================
    //  OPEN EDITOR
    // ===================================================================
    async function openEditor(id, mode) {
        clearQpErrors();
        jsonArea.value = '';
        document.getElementById('jsonImportError').style.display = 'none';
        document.getElementById('jsonImportSuccess').style.display = 'none';

        var url = id ? (getJsonUrl + '?id=' + encodeURIComponent(id)) : getDefaultsUrl;
        try {
            var res = await fetch(url);
            if (!res.ok) throw new Error('Server returned ' + res.status);
            var data = await res.json();
            populate(data);

            var isSystem = data.isSystem === true;
            var isView = mode === 'view' || isSystem;
            modalTitle.innerHTML = '<i class="bi bi-diagram-3 me-2"></i>' + (isView ? 'View Query Plan' : id ? 'Edit Query Plan' : 'New Query Plan');
            setEditable(!isView);

            // Reset to visual tab
            var visualTab = document.getElementById('tab-visual');
            if (visualTab) bootstrap.Tab.getOrCreateInstance(visualTab).show();

            openModal();
        } catch (err) {
            showQpError('Failed to load query plan: ' + (err.message || 'Unknown error'));
            openModal();
        }
    }

    // ===================================================================
    //  SAVE
    // ===================================================================
    btnSave.addEventListener('click', async function () {
        clearQpErrors();
        var model = collectModel();
        var valid = true;
        if (!model.name.trim()) { markQpFieldError('QpName', 'Name is required.'); valid = false; }
        if (!valid) return;
        try {
            await qpPostJson(saveUrl, model);
            location.reload();
        } catch (err) {
            showQpError('Save failed: ' + (err.message || 'Unknown error'));
        }
    });

    // ===================================================================
    //  TABLE BUTTON HANDLERS
    // ===================================================================
    document.getElementById('btnNewQp').addEventListener('click', function () { openEditor(null, 'edit'); });

    document.querySelectorAll('.btn-qp-open').forEach(function (btn) {
        btn.addEventListener('click', function () { openEditor(btn.getAttribute('data-id'), btn.getAttribute('data-mode')); });
    });

    document.querySelectorAll('.btn-qp-clone').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            try { await qpPostJson(cloneUrl, { id: btn.getAttribute('data-id') }); location.reload(); }
            catch (err) { showQpError('Clone failed: ' + (err.message || 'Unknown error')); openModal(); }
        });
    });

    document.querySelectorAll('.btn-qp-delete').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            if (!confirm('Delete this query plan?')) return;
            try { await qpPostJson(deleteUrl, { id: btn.getAttribute('data-id') }); location.reload(); }
            catch (err) { showQpError('Delete failed: ' + (err.message || 'Unknown error')); openModal(); }
        });
    });

    document.querySelectorAll('.btn-qp-default').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            try { await qpPostJson(setDefaultUrl, { id: btn.getAttribute('data-id') }); location.reload(); }
            catch (err) { showQpError('Set default failed: ' + (err.message || 'Unknown error')); openModal(); }
        });
    });

    // Init tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) { new bootstrap.Tooltip(el); });
})();
</script>
