@model Automation.UI.Models.QueryPlanTemplate
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Name) ? "New Query Plan" : $"Edit: {Model.Name}";
}

<h2><i class="bi bi-diagram-3 me-2"></i>@ViewData["Title"]</h2>

<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsSystem" />
    <input type="hidden" asp-for="IsDefault" />

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label asp-for="EhrDescription" class="form-label">EHR Description</label>
            <input asp-for="EhrDescription" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="LookBack" class="form-label">LookBack <span class="au-info-icon" data-bs-toggle="tooltip" title="ISO 8601 duration that defines how far back data acquisition looks from the report period start. Example: P0D = same day, P30D = 30 days before. Affects the date range filter on FHIR queries."><i class="bi bi-info-circle"></i></span></label>
            <input asp-for="LookBack" class="form-control" placeholder="P0D" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>

    <h4 class="mt-4">Initial Queries <span class="au-info-icon" data-bs-toggle="tooltip" title="Initial queries run first during data acquisition. They are patient-scoped Parameter queries that fetch core clinical data (Encounter, Condition, Observation, etc.) directly from the FHIR server using the patient ID and report period."><i class="bi bi-info-circle"></i></span></h4>
    <p class="text-muted small">These queries run first during data acquisition.</p>
    <div id="initial-queries">
        @for (var i = 0; i < Model.InitialQueries.Count; i++)
        {
            await Html.RenderPartialAsync("_QueryEntryEditor", Model.InitialQueries[i],
                new ViewDataDictionary(ViewData) { { "prefix", $"InitialQueries[{i}]" }, { "index", i } });
        }
    </div>

    <h4 class="mt-4">Supplemental Queries <span class="au-info-icon" data-bs-toggle="tooltip" title="Supplemental queries run after initial queries complete. They are typically Reference queries that discover and fetch resources referenced by initial results (e.g. Location referenced by Encounter.location, Medication referenced by MedicationRequest.medication)."><i class="bi bi-info-circle"></i></span></h4>
    <p class="text-muted small">These queries run after initial queries complete.</p>
    <div id="supplemental-queries">
        @for (var i = 0; i < Model.SupplementalQueries.Count; i++)
        {
            await Html.RenderPartialAsync("_QueryEntryEditor", Model.SupplementalQueries[i],
                new ViewDataDictionary(ViewData) { { "prefix", $"SupplementalQueries[{i}]" }, { "index", i } });
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>
