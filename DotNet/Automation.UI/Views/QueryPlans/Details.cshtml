@model Automation.UI.Models.QueryPlanTemplate
@{
    ViewData["Title"] = $"Query Plan: {Model.Name}";
    var acquiredTypes = Model.GetAcquiredResourceTypes();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-diagram-3 me-2"></i>@Model.Name</h2>
    <div>
        @if (Model.IsSystem)
        {
            <span class="badge bg-secondary me-2">System (Read-Only)</span>
        }
        @if (Model.IsDefault)
        {
            <span class="badge bg-success me-2">Default</span>
        }
        <form asp-action="Clone" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-copy me-1"></i>Clone</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="text-muted">@Model.Description</p>
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">@acquiredTypes.Count</h5>
                <small class="text-muted">Resource Types Acquired</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">@Model.InitialQueries.Count</h5>
                <small class="text-muted">Initial Queries</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">@Model.SupplementalQueries.Count</h5>
                <small class="text-muted">Supplemental Queries</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">@Model.EhrDescription</h5>
                <small class="text-muted">EHR Description</small>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <strong>Acquired Resource Types:</strong>
    <div class="mt-1">
        @foreach (var t in acquiredTypes.OrderBy(x => x))
        {
            <span class="badge bg-info text-dark me-1">@t</span>
        }
        <span class="badge bg-primary me-1">Patient</span>
        <small class="text-muted ms-2">(Patient is always implicitly included)</small>
    </div>
</div>

<div class="mb-3">
    <strong>LookBack:</strong> <code>@Model.LookBack</code>
</div>

<h4 class="mt-4">Initial Queries <span class="au-info-icon" data-bs-toggle="tooltip" title="Patient-scoped Parameter queries that fetch core clinical data (Encounter, Condition, Observation, etc.) directly from the FHIR server using the patient ID and report date range."><i class="bi bi-info-circle"></i></span></h4>
@await Html.PartialAsync("_QueryEntryTable", Model.InitialQueries)

<h4 class="mt-4">Supplemental Queries <span class="au-info-icon" data-bs-toggle="tooltip" title="Reference queries that run after initial queries complete. They discover and fetch resources referenced by initial results (e.g. Location from Encounter.location, Medication from MedicationRequest.medication)."><i class="bi bi-info-circle"></i></span></h4>
@await Html.PartialAsync("_QueryEntryTable", Model.SupplementalQueries)
