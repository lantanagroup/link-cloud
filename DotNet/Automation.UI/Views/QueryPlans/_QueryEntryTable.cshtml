@model List<Automation.UI.Models.QueryEntry>

<div class="table-responsive">
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Resource Type</th>
                <th>Config Type</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            var entry = Model[i];
            <tr>
                <td>@i</td>
                <td><code>@entry.ResourceType</code></td>
                <td><span class="badge @(entry.QueryConfigType == "Reference" ? "bg-warning text-dark" : "bg-primary")">@entry.QueryConfigType</span></td>
                <td>
                    @if (string.Equals(entry.QueryConfigType, "Reference", StringComparison.OrdinalIgnoreCase))
                    {
                        <small>OperationType=@entry.OperationType, Paged=@entry.Paged</small>
                    }
                    else
                    {
                        @foreach (var p in entry.Parameters)
                        {
                            <span class="badge bg-light text-dark border me-1" title="@p.ParameterType">
                                @p.Name
                                @if (p.ParameterType == "Variable")
                                {
                                    <text>: var(@p.Variable)</text>
                                    @if (!string.IsNullOrWhiteSpace(p.Format))
                                    {
                                        <text> fmt=@p.Format</text>
                                    }
                                }
                                else if (p.ParameterType == "Literal")
                                {
                                    <text>: "@p.Literal"</text>
                                }
                                else if (p.ParameterType == "ResourceIds")
                                {
                                    <text>: @(p.Resource)/@(p.PagedValue)</text>
                                }
                            </span>
                        }
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-muted text-center">No queries defined.</td></tr>
        }
        </tbody>
    </table>
</div>
