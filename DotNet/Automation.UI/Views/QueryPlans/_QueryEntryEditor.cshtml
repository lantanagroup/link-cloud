@model Automation.UI.Models.QueryEntry
@{
    var prefix = (string)ViewData["prefix"]!;
    var index = (int)ViewData["index"]!;
}

<div class="card mb-2">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-md-1 text-muted">
                <small>#@index</small>
            </div>
            <div class="col-md-3">
                <input name="@(prefix).ResourceType" value="@Model.ResourceType" class="form-control form-control-sm" placeholder="Resource Type" />
            </div>
            <div class="col-md-2">
                <select name="@(prefix).QueryConfigType" class="form-select form-select-sm" title="Parameter: direct patient-scoped search query. Reference: follows references from other acquired resources to fetch related data.">
                    <option value="Parameter" selected="@(Model.QueryConfigType == "Parameter")">Parameter</option>
                    <option value="Reference" selected="@(Model.QueryConfigType == "Reference")">Reference</option>
                </select>
            </div>
            <div class="col-md-2">
                <input name="@(prefix).OperationType" value="@Model.OperationType" class="form-control form-control-sm" placeholder="OpType" title="Operation Type: how to fetch the referenced resource. Typically 'Read' for Reference queries. Only applicable when Config Type is Reference." />
            </div>
            <div class="col-md-2">
                <input name="@(prefix).Paged" value="@Model.Paged" class="form-control form-control-sm" placeholder="Paged" title="Page size for paginated FHIR search results. Only applicable for Reference queries. Leave empty to use the server default." />
            </div>
        </div>
        @if (Model.Parameters.Count > 0)
        {
            <div class="mt-2 ms-4">
                <small class="text-muted">Parameters:</small>
                @for (var p = 0; p < Model.Parameters.Count; p++)
                {
                    var param = Model.Parameters[p];
                    var paramPrefix = $"{prefix}.Parameters[{p}]";
                    <div class="row g-1 align-items-center mt-1">
                        <div class="col-auto">
                            <select name="@(paramPrefix).ParameterType" class="form-select form-select-sm" style="width:auto">
                                <option value="Variable" selected="@(param.ParameterType == "Variable")">Variable</option>
                                <option value="Literal" selected="@(param.ParameterType == "Literal")">Literal</option>
                                <option value="ResourceIds" selected="@(param.ParameterType == "ResourceIds")">ResourceIds</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).Name" value="@param.Name" class="form-control form-control-sm" placeholder="Name" style="width:100px" />
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).Variable" value="@param.Variable" class="form-control form-control-sm" placeholder="Var" style="width:60px" title="Variable index" />
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).Format" value="@param.Format" class="form-control form-control-sm" placeholder="Format" style="width:100px" />
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).Literal" value="@param.Literal" class="form-control form-control-sm" placeholder="Literal" style="width:140px" />
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).Resource" value="@param.Resource" class="form-control form-control-sm" placeholder="Resource" style="width:100px" />
                        </div>
                        <div class="col-auto">
                            <input name="@(paramPrefix).PagedValue" value="@param.PagedValue" class="form-control form-control-sm" placeholder="Paged" style="width:70px" />
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
