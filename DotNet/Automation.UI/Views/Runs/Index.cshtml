@model Automation.UI.Models.AutomationRunIndexViewModel
@{
    ViewData["Title"] = "Automation Runs";
    var qualifyingValue = (int)MeasureEligibility.Qualifying;
    var nonQualifyingValue = (int)MeasureEligibility.NonQualifying;
}

<div class="container mt-4">
    <h2>Automation UI</h2>
    <p class="text-muted">Kick off automation scenarios and monitor live run output.</p>

    <div class="card mb-4">
        <div class="card-header">Start Scenario</div>
        <div class="card-body">
            <form asp-action="Start" method="post" class="row g-3" id="scenarioForm">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label" for="scenarioSelect">Scenario</label>
                    <select class="form-select" id="scenarioSelect" name="Scenario">
                        <option value="@AutomationScenarioKind.SmokeTest">SmokeTest</option>
                        <option value="@AutomationScenarioKind.MultiPatientTest">MultiPatientTest</option>
                        <option value="@AutomationScenarioKind.MegaPatientTest">MegaPatientTest</option>
                        <option value="@AutomationScenarioKind.Custom">Custom</option>
                    </select>
                </div>

                <div id="customScenarioOptions" class="row g-3" style="display:none;">
                    <div class="col-12">
                        <hr class="my-1" />
                        <h6 class="mb-0">Custom Scenario Configuration</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Measures</label>
                        <div class="form-text mb-2">Select one or more measures. For multi-measure runs, qualifying patients must qualify for <strong>all</strong> selected measures.</div>
                        <div class="form-check">
                            <input class="form-check-input measure-checkbox" type="checkbox" id="measure_ach_monthly"
                                   name="SelectedMeasures" value="@ProfiledMeasureType.NhsnAcuteCareHospitalMonthlyInitialPopulation" checked />
                            <label class="form-check-label" for="measure_ach_monthly">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnAcuteCareHospitalMonthlyInitialPopulation)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input measure-checkbox" type="checkbox" id="measure_ach_daily"
                                   name="SelectedMeasures" value="@ProfiledMeasureType.NhsnAcuteCareHospitalDailyInitialPopulation" />
                            <label class="form-check-label" for="measure_ach_daily">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnAcuteCareHospitalDailyInitialPopulation)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input measure-checkbox" type="checkbox" id="measure_hypo"
                                   name="SelectedMeasures" value="@ProfiledMeasureType.NhsnGlycemicControlHypoglycemicInitialPopulation" />
                            <label class="form-check-label" for="measure_hypo">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnGlycemicControlHypoglycemicInitialPopulation)</label>
                        </div>
                    </div>

                    <div class="col-md-3" id="patientCountGroup">
                        <label class="form-label" for="PatientCount">Patient Count</label>
                        <input class="form-control" type="number" min="1" max="10000" id="PatientCount" name="PatientCount" value="10" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ResourcesPerPatient">Resources / Patient</label>
                        <input class="form-control" type="number" min="1" max="10000" id="ResourcesPerPatient" name="ResourcesPerPatient" value="250" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="PatientPrefix">Patient Prefix</label>
                        <input class="form-control" type="text" id="PatientPrefix" name="PatientPrefix" value="CustomPatient" maxlength="64" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="Seed">Seed</label>
                        <input class="form-control" type="number" min="1" id="Seed" name="Seed" value="20260329" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="RemoveFacilityConfig" name="RemoveFacilityConfig" value="true" checked />
                                <input type="hidden" name="RemoveFacilityConfig" value="false" />
                                <label class="form-check-label" for="RemoveFacilityConfig">Remove Facility Config</label>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="CleanupTestData" name="CleanupTestData" value="true" />
                                <input type="hidden" name="CleanupTestData" value="false" />
                                <label class="form-check-label" for="CleanupTestData">Cleanup Test Data</label>
                            </div>
                        </div>
                    </div>

                    <!-- Data Generation Mode -->
                    <div class="col-12 mt-3">
                        <hr class="my-1" />
                        <h6 class="mb-2">Data Generation Mode</h6>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="generationMode" id="modeStandard" value="standard" checked />
                            <label class="form-check-label" for="modeStandard">Standard (random)</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="generationMode" id="modeMeasure" value="measure" />
                            <label class="form-check-label" for="modeMeasure">Measure Eligibility (per-patient profiles)</label>
                        </div>
                    </div>

                    <!-- Measure Eligibility Profile Builder -->
                    <div id="profileBuilder" class="col-12" style="display:none;">
                        <div class="card bg-light mt-2">
                            <div class="card-body py-2">
                                <p class="text-muted small mb-2">
                                    Each row defines one patient. For multi-measure runs, qualifying patients
                                    must satisfy <strong>all</strong> selected measures simultaneously.
                                    <strong>Qualifying</strong> patients are generated to meet initial-population criteria.
                                    <strong>Non-Qualifying</strong> patients are generated to miss initial-population criteria.
                                    The patient count field above is ignored when profiles are defined &mdash; patient count
                                    is determined by the number of rows here.
                                </p>
                                <table class="table table-sm table-bordered mb-2" id="profileTable">
                                    <thead>
                                        <tr>
                                            <th style="width:50px">#</th>
                                            <th>Eligibility</th>
                                            <th style="width:160px">Seed Offset (optional)</th>
                                            <th style="width:50px"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="profileRows">
                                    </tbody>
                                </table>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-success" id="addQualifying">+ Qualifying</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning" id="addNonQualifying">+ Non-Qualifying</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="addPreset">+ Preset (2Q / 2NQ)</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary" type="submit">Start Run</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Recent Runs</div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Run Id</th>
                        <th>Run</th>
                        <th>Scenario</th>
                        <th>Patients</th>
                        <th>Resources/Patient</th>
                        <th>Seed</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Finished</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr>
                        <td><code>@run.RunId</code></td>
                        <td>@run.RunName</td>
                        <td>@run.Scenario</td>
                        <td>@run.PatientCount</td>
                        <td>@run.ResourcesPerPatient</td>
                        <td>@run.Seed</td>
                        <td>
                            <span class="badge @(run.Status == AutomationRunStatus.Succeeded ? "bg-success" : run.Status == AutomationRunStatus.Failed ? "bg-danger" : "bg-secondary")">@run.Status</span>
                        </td>
                        <td>@run.CreatedAt.LocalDateTime</td>
                        <td>@(run.FinishedAt?.LocalDateTime.ToString() ?? "-")</td>
                        <td class="text-nowrap">
                            <div class="d-inline-flex gap-1 align-items-center">
                                <a asp-action="Details" asp-route-id="@run.RunId" class="btn btn-sm btn-outline-primary">Open</a>
                                @if (run.Status is AutomationRunStatus.Succeeded or AutomationRunStatus.Failed)
                                {
                                    <form asp-action="Delete" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@run.RunId" />
                                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this final run and all persisted data?');">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total run(s))</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Pagination">
                <a class="btn btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Math.Max(1, Model.PageNumber - 1))"
                   asp-route-pageSize="@Model.PageSize">Previous</a>
                <a class="btn btn-outline-secondary @((Model.PageNumber >= Model.TotalPages) ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Math.Min(Model.TotalPages, Model.PageNumber + 1))"
                   asp-route-pageSize="@Model.PageSize">Next</a>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var CUSTOM_VALUE = '@AutomationScenarioKind.Custom';
        var QUALIFYING = '@qualifyingValue';
        var NON_QUALIFYING = '@nonQualifyingValue';

        var scenarioSelect = document.getElementById('scenarioSelect');
        var customOptions = document.getElementById('customScenarioOptions');
        var profileBuilder = document.getElementById('profileBuilder');
        var patientCountGroup = document.getElementById('patientCountGroup');
        var profileRows = document.getElementById('profileRows');
        var modeRadios = document.querySelectorAll('input[name="generationMode"]');

        function toggleCustomOptions() {
            if (scenarioSelect.value === CUSTOM_VALUE) {
                customOptions.style.display = 'flex';
                toggleProfileBuilder();
            } else {
                customOptions.style.display = 'none';
                profileBuilder.style.display = 'none';
            }
        }

        function toggleProfileBuilder() {
            var checked = document.querySelector('input[name="generationMode"]:checked');
            var mode = checked ? checked.value : 'standard';
            var isMeasureMode = (mode === 'measure');

            profileBuilder.style.display = isMeasureMode ? 'block' : 'none';
            if (patientCountGroup) {
                patientCountGroup.style.display = isMeasureMode ? 'none' : '';
            }
        }

        for (var i = 0; i < modeRadios.length; i++) {
            modeRadios[i].addEventListener('change', toggleProfileBuilder);
        }
        scenarioSelect.addEventListener('change', toggleCustomOptions);

        function addProfileRow(eligibility, seedOffset) {
            var idx = profileRows.children.length;
            var isQ = (eligibility === QUALIFYING);
            var label = isQ ? 'Qualifying' : 'Non-Qualifying';
            var badgeClass = isQ ? 'bg-success' : 'bg-warning text-dark';
            var seedVal = (seedOffset != null) ? seedOffset : '';

            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td class="align-middle text-center">' + (idx + 1) + '</td>' +
                '<td class="align-middle">' +
                    '<span class="badge ' + badgeClass + '">' + label + '</span>' +
                    '<input type="hidden" name="PatientProfiles[' + idx + '].Eligibility" value="' + eligibility + '" />' +
                '</td>' +
                '<td><input class="form-control form-control-sm" type="number" name="PatientProfiles[' + idx + '].SeedOffset" value="' + seedVal + '" placeholder="auto" /></td>' +
                '<td class="align-middle text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-row">&times;</button></td>';
            profileRows.appendChild(tr);
            reindexRows();
        }

        function reindexRows() {
            var rows = profileRows.children;
            for (var i = 0; i < rows.length; i++) {
                var tr = rows[i];
                tr.querySelector('td:first-child').textContent = i + 1;
                var eligInput = tr.querySelector('input[type="hidden"]');
                var seedInput = tr.querySelector('input[type="number"]');
                eligInput.name = 'PatientProfiles[' + i + '].Eligibility';
                seedInput.name = 'PatientProfiles[' + i + '].SeedOffset';
            }
        }

        profileRows.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove-row')) {
                e.target.closest('tr').remove();
                reindexRows();
            }
        });

        document.getElementById('addQualifying').addEventListener('click', function () {
            addProfileRow(QUALIFYING, null);
        });
        document.getElementById('addNonQualifying').addEventListener('click', function () {
            addProfileRow(NON_QUALIFYING, null);
        });
        document.getElementById('addPreset').addEventListener('click', function () {
            addProfileRow(QUALIFYING, null);
            addProfileRow(QUALIFYING, null);
            addProfileRow(NON_QUALIFYING, null);
            addProfileRow(NON_QUALIFYING, null);
        });

        document.getElementById('scenarioForm').addEventListener('submit', function (e) {
            var checked = document.querySelector('input[name="generationMode"]:checked');
            var mode = checked ? checked.value : 'standard';
            if (mode !== 'measure') {
                profileRows.innerHTML = '';
            }

            // Ensure at least one measure is checked for Custom scenarios
            if (scenarioSelect.value === CUSTOM_VALUE) {
                var checkedMeasures = document.querySelectorAll('.measure-checkbox:checked');
                if (checkedMeasures.length === 0) {
                    e.preventDefault();
                    alert('Please select at least one measure.');
                    return false;
                }
            }
        });

        toggleCustomOptions();
    })();
</script>
