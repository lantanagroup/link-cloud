@model LantanaGroup.Link.Automation.Link.Models.AutomationRunSummary
@{
    ViewData["Title"] = "Run Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="fw-bold mb-0" id="runName">@Model.RunName</h3>
            <code class="text-muted small">@Model.RunId</code>
        </div>
        <div class="d-flex gap-2 align-items-center" id="runHeaderActions">
            @if (Model.Status is AutomationRunStatus.Queued or AutomationRunStatus.Running)
            {
                <button type="button" class="btn btn-warning btn-sm" id="btnCancelRun"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            }
            @if (Model.Status is AutomationRunStatus.Succeeded or AutomationRunStatus.Failed or AutomationRunStatus.Cancelled)
            {
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteRun"><i class="bi bi-trash me-1"></i>Delete</button>
                <a asp-action="Export" asp-route-id="@Model.RunId" class="btn btn-sm" style="background:var(--au-accent);color:#fff;font-weight:600;">
                    <i class="bi bi-download me-1"></i>Export Diagnostics
                </a>
            }
            <a asp-action="Index" class="btn btn-sm btn-au-action"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="au-card">
        <div class="card-header"><i class="bi bi-clipboard-data me-2"></i>Run Summary</div>
        <div class="card-body">
            <div class="row g-3" id="runSummaryGrid">
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Status</span><span class="au-value" id="status">@Model.Status</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Facility</span><code class="au-value" id="facilityId">@(Model.FacilityId ?? "-")</code></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">NHSN Organization ID</span><code class="au-value" id="nhsnOrganizationIdSummary">-</code></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Started</span><span class="au-value" id="started">@(Model.StartedAt?.ToString("u") ?? "-")</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Finished</span><span class="au-value" id="finished">@(Model.FinishedAt?.ToString("u") ?? "-")</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Pipeline Duration</span><span class="au-value" id="pipelineDuration">@(Model.Duration ?? "-")</span></div></div>
            </div>
            <div id="errorRow" class="mt-3" style="display:none;"><div class="alert alert-danger mb-0 py-2 small"><i class="bi bi-exclamation-triangle-fill me-1"></i><span id="error">@(Model.Error ?? "-")</span></div></div>
            <span id="finalizingBadge" class="badge rounded-pill bg-secondary text-white mt-2" style="display:none;">
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width:.7rem;height:.7rem;"></span>
                Finalizing…
            </span>
        </div>
    </div>

    <div class="au-card" id="testConfigCard" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-gear me-2"></i>Test Configuration</span>
            <a href="#" class="btn btn-sm" id="btnViewManifest" style="display:none; background:var(--au-accent); color:#fff; font-weight:600;">
                <i class="bi bi-card-checklist me-1"></i>Generation Manifest
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3" id="runConfigProps"></div>
            <div id="cohortSummaryCard" class="mt-3" style="display:none;">
                <div class="fw-semibold small mb-1"><i class="bi bi-people-fill me-1"></i>Cohorts</div>
                <div id="cohortSummaryBody"></div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="runDetailsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">Overview</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs-pane" type="button" role="tab" aria-controls="logs-pane" aria-selected="false">Logs</button>
        </li>
    </ul>

    <div class="tab-content" id="runDetailsTabContent">
        <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
            <div class="au-card">
                <div class="card-header"><i class="bi bi-file-earmark-medical me-2"></i>Report</div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Milestones</div>
                        <div id="reportMilestones" class="d-flex flex-wrap justify-content-center gap-2" style="min-height: 42px;"></div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted mb-2">Report Schedule</div>
                                <div class="row g-2">
                                    <div class="col-md-12"><strong>Facility ID:</strong> <code id="scheduleFacilityId">@(Model.FacilityId ?? "-")</code></div>
                                    <div class="col-md-6"><strong>Test:</strong> <span id="scheduleReportName">-</span></div>
                                    <div class="col-md-6"><strong>Frequency:</strong> <span id="scheduleFrequency">-</span></div>
                                    <div class="col-md-6"><strong>Start:</strong> <span id="scheduleStart">-</span></div>
                                    <div class="col-md-6"><strong>End:</strong> <span id="scheduleEnd">-</span></div>
                                    <div class="col-md-6"><strong>Adhoc Type:</strong> <span id="scheduleAdhoc">-</span></div>
                                    <div class="col-md-6"><strong>Status:</strong> <span id="scheduleStatusPill" class="badge bg-secondary">-</span></div>
                                    <div class="col-md-6"><strong>Report Created:</strong> <span id="scheduleCreated">-</span></div>
                                    <div class="col-md-6"><strong>Submitted:</strong> <span id="scheduleSubmitted">-</span></div>
                                    <div class="col-md-6"><strong>Duration:</strong> <span id="scheduleDuration" class="fw-semibold">-</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted mb-2">Report Entries by Submission Status</div>
                                    <canvas id="entriesDonut" height="150" style="height:150px;max-height:150px;"></canvas>
                                <div id="entriesLegend" class="small mt-2"></div>
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mt-3">
                        <div class="small text-muted mb-1">Report Populations</div>
                        <div id="populationSummary">No population data yet.</div>
                    </div>
                </div>
            </div>

            <div class="au-card" id="validatorResultsCard" style="display:none;">
                <div class="card-header"><i class="bi bi-check2-square me-2"></i>Automation Validator Results</div>
                <div class="card-body">
                    <div id="validatorResultsSummary" class="small text-muted mb-2"></div>
                    <div class="row g-2" id="validatorResultsGrid"></div>
                </div>
            </div>

            <div class="au-card" id="serviceErrorSummaryCard">
                <div class="card-header"><i class="bi bi-bug me-2"></i>Service Error Summary</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Data Acquisition</div>
                                <button type="button" id="serviceErrorBtnDataAcq" class="btn w-100 text-center service-error-btn" data-service="Data Acquisition" disabled>
                                    <div id="serviceErrorCountDataAcq" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Normalization</div>
                                <button type="button" id="serviceErrorBtnNormalization" class="btn w-100 text-center service-error-btn" data-service="Normalization" disabled>
                                    <div id="serviceErrorCountNormalization" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Measure Eval</div>
                                <button type="button" id="serviceErrorBtnMeasureEval" class="btn w-100 text-center service-error-btn" data-service="Measure Eval" disabled>
                                    <div id="serviceErrorCountMeasureEval" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Validation</div>
                                <button type="button" id="serviceErrorBtnValidation" class="btn w-100 text-center service-error-btn" data-service="Validation" disabled>
                                    <div id="serviceErrorCountValidation" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Report</div>
                                <button type="button" id="serviceErrorBtnReport" class="btn w-100 text-center service-error-btn" data-service="Report" disabled>
                                    <div id="serviceErrorCountReport" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header" role="button" data-bs-toggle="modal" data-bs-target="#dataAcqLogModal" style="cursor:pointer;">
                    <i class="bi bi-download me-2"></i>Data Acquisition
                    <span class="badge bg-light text-dark ms-2" id="dataAcqTotalLogs">0</span>
                    <span class="small ms-1" style="opacity:.7;">logs (click to drill down)</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="dataAcqResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="dataAcqResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="dataAcqRate">0.00</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="dataAcqErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Logs by Status</div>
                            <canvas id="dataAcqDonut" height="160" style="height:160px;max-height:160px;max-width: 220px;"></canvas>
                            <div id="dataAcqLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="dataAcqTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="dataAcqResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-arrow-repeat me-2"></i>Normalization</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="normalizationResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="normalizationResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="normalizationRate">0.00</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="normalizationErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="normalizationTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="normalizationResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-bar-chart-line me-2"></i>Measure Eval</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="measureResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="measureResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="measureRate">0.00</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="measureErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Measure Report Patient States</div>
                            <canvas id="measureStageChart" height="170" style="height:170px;max-height:170px;"></canvas>
                            <div id="measureStageLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="measureTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="measureResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-shield-check me-2"></i>Validation</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Patients</div><div class="fs-4 fw-semibold" id="validationPatientCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Passed</div><div class="fs-4 fw-semibold text-success" id="validationPassedCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Failed</div><div class="fs-4 fw-semibold text-danger" id="validationFailedCount">0</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="validationErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Validation Patient States</div>
                            <canvas id="validationStageChart" height="170" style="height:170px;max-height:170px;"></canvas>
                            <div id="validationStageLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="validationTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="logs-pane" role="tabpanel" aria-labelledby="logs-tab" tabindex="0">
            <div class="au-card">
                <div class="card-header"><i class="bi bi-terminal me-2"></i>Console</div>
                <div class="card-body p-0">
                    <pre id="logBox" class="au-log-console mb-0">@string.Join("\n", Model.Logs)</pre>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="errorFlyout" style="position:fixed; top:0; right:-480px; width:460px; height:100%; background:#fff; box-shadow:-4px 0 20px rgba(0,0,0,.2); z-index:1055; transition:right .2s ease;">
    <div class="d-flex justify-content-between align-items-center border-bottom p-3">
        <h6 class="mb-0" id="errorFlyoutTitle">Errors</h6>
        <button class="btn btn-sm btn-outline-secondary" id="closeFlyout">Close</button>
    </div>
    <div class="p-3" id="errorFlyoutBody" style="overflow:auto; height: calc(100% - 60px);"></div>
</div>

<div class="modal fade" id="serviceExceptionModal" tabindex="-1" aria-labelledby="serviceExceptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:900px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="serviceExceptionModalLabel">Service Exceptions</h5>
                    <small class="text-muted" id="serviceExceptionSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="sticky-top bg-white border-bottom px-3 py-2" style="z-index:2;">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <input type="text" class="form-control form-control-sm" id="exModalSearch" placeholder="Search exceptions…">
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-secondary" id="exModalVisibleCount">0</span>
                            <span class="small text-muted">shown</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-2" id="exModalGroupChips"></div>
                </div>
                <div id="exModalAccordion" class="accordion accordion-flush" style="min-height:200px;"></div>
                <div id="exModalEmpty" class="text-center text-muted p-4" style="display:none;">No exceptions match the current filter.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dataAcqLogModal" tabindex="-1" aria-labelledby="dataAcqLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content au-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-download me-2"></i><span id="dataAcqLogModalLabel">Data Acquisition Logs</span></span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                    <input type="search"
                           id="daLogSearch"
                           class="form-control form-control-sm"
                           style="max-width:360px;"
                           placeholder="Filter all logs (Id, patient, status, phase, resource types…)"
                           autocomplete="off" />
                    <span class="small text-muted" id="daLogFilterInfo"></span>
                </div>
                <div class="table-responsive">
                    <table class="table au-table mb-0" id="dataAcqLogTable">
                        <thead>
                            <tr>
                                <th role="button" class="user-select-none" data-sortby="Id">Id <span id="sortIconId" class="text-white-50"></span></th>
                                <th role="button" class="user-select-none" data-sortby="PatientId">Patient <span id="sortIconPatientId" class="text-white-50"></span></th>
                                <th role="button" class="user-select-none" data-sortby="Status">Status <span id="sortIconStatus" class="text-white-50"></span></th>
                                <th role="button" class="user-select-none" data-sortby="QueryPhase">Phase <span id="sortIconQueryPhase" class="text-white-50"></span></th>
                                <th>Reference</th>
                                <th>Resource Types</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="dataAcqLogTableBody">
                        </tbody>
                    </table>
                </div>

<div id="daLogFlyout" class="au-card" style="position:fixed; top:0; right:-720px; width:700px; max-width:96vw; height:100%; z-index:1060; transition:right .2s ease; border-radius:0; margin-bottom:0;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <div id="daLogFlyoutTitle"><i class="bi bi-file-text me-2"></i>Data Acquisition Log Details</div>
            <div class="small" id="daLogFlyoutSubtitle" style="opacity:.85;font-weight:400;"></div>
        </div>
        <button type="button" class="btn-close btn-close-white" id="closeDaLogFlyout" aria-label="Close"></button>
    </div>
    <div class="p-3" id="daLogFlyoutBody" style="overflow:auto; height: calc(100% - 56px); background:#fff;"></div>
</div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="small text-muted" id="dataAcqLogPaginationInfo"></span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-au-action" id="dataAcqLogPrev" disabled>Previous</button>
                        <button class="btn btn-au-action" id="dataAcqLogNext" disabled>Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    (function () {
        const runId = '@Model.RunId';
        const runConfigurationJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RunConfigurationJson ?? string.Empty));
        const snapshotUrl = '@Url.Action("PipelineSnapshot", "Runs")';
        const manifestUrl = '@Url.Action("ManifestData", "Runs")';
        const logBox = document.getElementById('logBox');
        let dataAcqErrors = [];
        let measureErrors = [];
        let validationErrors = [];
        let normalizationErrors = [];
        let lastDataAcqSnapshot = null;
        const serviceErrorLines = {
            'Data Acquisition': [],
            'Normalization': [],
            'Measure Eval': [],
            'Validation': [],
            'Report': []
        };
        const charts = {};
        let currentRunStatus = '@Model.Status';
        let currentFinishedAt = '@(Model.FinishedAt?.ToString("O") ?? string.Empty)';
        let runCompletedAtMs = currentFinishedAt ? (Date.parse(currentFinishedAt) || Date.now()) : null;
        let snapshotTimer = null;

        function antiforgeryToken() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            return token ? token.value : '';
        }

        function swapCancelToDelete() {
            var cancelBtn = document.getElementById('btnCancelRun');
            if (cancelBtn) cancelBtn.remove();

            var actionsDiv = document.getElementById('runHeaderActions');
            if (!actionsDiv) return;

            var backLink = actionsDiv.querySelector('a.btn-au-action');

            if (!document.getElementById('btnDeleteRun')) {
                var deleteBtn = document.createElement('button');
                deleteBtn.type = 'button';
                deleteBtn.className = 'btn btn-danger btn-sm';
                deleteBtn.id = 'btnDeleteRun';
                deleteBtn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
                if (backLink) actionsDiv.insertBefore(deleteBtn, backLink);
                else actionsDiv.appendChild(deleteBtn);
            }

            if (!document.getElementById('btnExportRun')) {
                var exportLink = document.createElement('a');
                exportLink.id = 'btnExportRun';
                exportLink.className = 'btn btn-sm';
                exportLink.style.background = 'var(--au-accent)';
                exportLink.style.color = '#fff';
                exportLink.style.fontWeight = '600';
                exportLink.href = '@Url.Action("Export", "Runs", new { id = Model.RunId })';
                exportLink.innerHTML = '<i class="bi bi-download me-1"></i>Export Diagnostics';
                if (backLink) actionsDiv.insertBefore(exportLink, backLink);
                else actionsDiv.appendChild(exportLink);
            }
        }

        function handleDeleteClick(btn) {
            if (!confirm('Delete this run and all persisted data?')) return;

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Deleting…';

            fetch('@Url.Action("DeleteJson", "Runs")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiforgeryToken()
                },
                body: JSON.stringify({ id: runId })
            })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (result.success) {
                    window.location.href = '@Url.Action("Index", "Runs")';
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
                    alert('Unable to delete the run. It may still be active.');
                }
            })
            .catch(function (err) {
                console.error('Delete failed', err);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-trash me-1"></i>Delete';
                alert('Unable to delete the run. Please try again.');
            });
        }

        // Use event delegation so dynamically-created delete buttons also work
        document.getElementById('runHeaderActions').addEventListener('click', function (e) {
            var deleteBtn = e.target.closest('#btnDeleteRun');
            if (deleteBtn) {
                handleDeleteClick(deleteBtn);
                return;
            }
        });

        var cancelBtn = document.getElementById('btnCancelRun');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', function () {
                if (!confirm('Cancel this running test and cleanup all related service/FHIR data?')) return;

                cancelBtn.disabled = true;
                cancelBtn.textContent = 'Cancelling…';

                fetch('@Url.Action("CancelJson", "Runs")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiforgeryToken()
                    },
                    body: JSON.stringify({ id: runId })
                })
                .then(function (r) { return r.json(); })
                .then(function () {
                    swapCancelToDelete();
                })
                .catch(function (err) {
                    console.error('Cancel failed', err);
                    cancelBtn.disabled = false;
                    cancelBtn.textContent = 'Cancel';
                    alert('Unable to cancel the run. Please try again.');
                });
            });
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/runs')
            .withAutomaticReconnect()
            .build();

        function appendLog(line) {
            if (!line) return;
            logBox.textContent += (logBox.textContent ? '\n' : '') + line;
            logBox.scrollTop = logBox.scrollHeight;
        }

        function formatNumber(value) {
            return Number(value || 0).toFixed(2);
        }

        function escapeHtml(value) {
            const s = String(value || '');
            return s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
        }

        function toLabel(key) {
            if (!key) return '';
            const spaced = String(key)
                .replaceAll('_', ' ')
                .replace(/([a-z])([A-Z])/g, '$1 $2');
            return spaced.charAt(0).toUpperCase() + spaced.slice(1);
        }

        const measureShortNames = {
            NhsnAcuteCareHospitalMonthlyInitialPopulation: 'ACH Monthly',
            NhsnAcuteCareHospitalDailyInitialPopulation: 'ACH Daily',
            NhsnGlycemicControlHypoglycemicInitialPopulation: 'Hypoglycemic'
        };

        function renderConfigProperties(rawJson) {
            const container = document.getElementById('runConfigProps');
            if (!container) return;
            container.innerHTML = '';

            const summaryOrgIdEl = document.getElementById('nhsnOrganizationIdSummary');
            if (summaryOrgIdEl) summaryOrgIdEl.textContent = '-';

            const cohortCard = document.getElementById('cohortSummaryCard');
            const cohortBody = document.getElementById('cohortSummaryBody');
            if (cohortCard) cohortCard.style.display = 'none';
            if (cohortBody) cohortBody.innerHTML = '';

            const errorRow = document.getElementById('errorRow');
            const errorSpan = document.getElementById('error');

            if (!rawJson) return;

            let parsed;
            try { parsed = JSON.parse(rawJson); } catch { return; }
            if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return;

            if (summaryOrgIdEl) {
                const orgId = (parsed.nhsnOrganizationId ?? parsed.NhsnOrganizationId ?? '').toString().trim();
                summaryOrgIdEl.textContent = orgId || '-';
            }

            const importedIdCount = Array.isArray(parsed.importedPatientIds) ? parsed.importedPatientIds.length : 0;
            const importedBundleCount = Array.isArray(parsed.importedPatientBundles) ? parsed.importedPatientBundles.length : 0;
            const rawPatientCount = parsed.patientCount;
            const parsedPatientCount = typeof rawPatientCount === 'number'
                ? rawPatientCount
                : Number.parseFloat(String(rawPatientCount ?? '0'));
            const basePatientCount = Number.isFinite(parsedPatientCount) ? parsedPatientCount : 0;
            const effectivePatientCount = basePatientCount + importedIdCount + importedBundleCount;

            function formatArrayItem(item, key, index) {
                if (item === null || item === undefined) return '';
                if (typeof item !== 'object') return escapeHtml(String(item));

                if (key === 'importedPatientIds') {
                    const patientId = item.patientId || item.PatientId;
                    return escapeHtml(String(patientId || `Patient ${index + 1}`));
                }

                if (key === 'importedPatientBundles') {
                    const fileName = item.fileName || item.FileName;
                    const patientId = item.patientId || item.PatientId;
                    return escapeHtml(String(fileName || patientId || `Bundle ${index + 1}`));
                }

                const fallback = item.name ?? item.id ?? item.patientId ?? item.fileName;
                if (fallback !== undefined && fallback !== null)
                    return escapeHtml(String(fallback));

                try { return escapeHtml(JSON.stringify(item)); }
                catch { return escapeHtml(String(item)); }
            }

            // Keys rendered elsewhere or otherwise not surfaced as plain key/value pairs.
            const skip = new Set([
                'id', 'isSystemScenario',
                'patientCohorts',
                'resourcesPerPatientMin', 'resourcesPerPatientMax',
                'queryPlanTemplateId', 'updatedAt'
            ]);

            const labels = {
                name: 'Test Name',
                description: 'Description',
                reportMethod: 'Report Method',
                selectedMeasures: 'Measures',
                seed: 'Seed',
                patientCount: 'Patients',
                importedPatientIds: 'Imported Patient IDs',
                importedPatientBundles: 'Imported Patient Bundles',
                nhsnOrganizationId: 'NHSN Organization ID',
                queryPlanTemplateName: 'Query Plan',
                cleanupServiceData: 'Cleanup Service Data',
                cleanupFhirData: 'Cleanup FHIR Data'
            };

            Object.entries(parsed).forEach(([k, v]) => {
                if (skip.has(k)) return;
                if (v === null || v === undefined || v === '') return;

                let display;
                if (Array.isArray(v)) {
                    if (v.length === 0) return;
                    if (k === 'selectedMeasures') {
                        display = v.map(m => escapeHtml(measureShortNames[m] || toLabel(m))).join(', ');
                    } else {
                        display = v.map((item, index) => formatArrayItem(item, k, index)).join(', ');
                    }
                } else if (k === 'patientCount') {
                    display = escapeHtml(String(effectivePatientCount));
                } else if (typeof v === 'boolean') {
                    display = v ? '<i class="bi bi-check-circle-fill text-success"></i> Yes' : '<i class="bi bi-x-circle text-muted"></i> No';
                } else if (typeof v === 'object') {
                    return;
                } else {
                    display = escapeHtml(String(v));
                }

                const label = labels[k] || toLabel(k);
                const col = document.createElement('div');
                col.className = 'col-md-3';
                col.innerHTML = `<div class="au-summary-item"><span class="au-label">${escapeHtml(label)}</span><span class="au-value">${display}</span></div>`;
                container.appendChild(col);
            });

            // Show error row only if there is an actual error.
            if (errorRow && errorSpan) {
                const hasError = errorSpan.textContent && errorSpan.textContent !== '-';
                errorRow.style.display = hasError ? '' : 'none';
            }

            // Show the test config card if any properties were rendered.
            const testConfigCard = document.getElementById('testConfigCard');
            if (testConfigCard && container.children.length > 0) {
                testConfigCard.style.display = '';
            }

            // Render cohort summary as a compact table.
            if (cohortCard && cohortBody && Array.isArray(parsed.patientCohorts) && parsed.patientCohorts.length > 0) {
                const allMeasures = [...new Set(parsed.patientCohorts.flatMap(c => c.measureEligibilities ? Object.keys(c.measureEligibilities) : []))];
                const measureCols = allMeasures.map(m => `<th>${escapeHtml(measureShortNames[m] || toLabel(m))}</th>`).join('');

                const rows = parsed.patientCohorts.map((c, idx) => {
                    const eligCells = allMeasures.map(m => {
                        const v = c.measureEligibilities?.[m];
                        const isQ = v === 'Qualifying' || v === 0 || v === '0';
                        return `<td><span class="badge ${isQ ? 'au-badge-success' : 'au-badge-muted'}">${isQ ? 'Q' : 'NQ'}</span></td>`;
                    }).join('');
                    const min = c?.resourcesPerPatientMin ?? '-';
                    const max = c?.resourcesPerPatientMax ?? '-';
                    return `<tr><td class="fw-semibold">${idx + 1}</td><td>${c?.patientCount ?? '-'}</td><td>${escapeHtml(String(min))}\u2013${escapeHtml(String(max))}</td>${eligCells}</tr>`;
                }).join('');

                cohortBody.innerHTML =
                    `<table class="au-cohort-summary-table"><thead><tr><th>#</th><th>Patients</th><th>Resources</th>${measureCols}</tr></thead><tbody>${rows}</tbody></table>`;
                cohortCard.style.display = '';
            }
        }

        function upsertChart(canvasId, config) {
            if (charts[canvasId]) {
                charts[canvasId].data = config.data;
                charts[canvasId].options = config.options;
                charts[canvasId].update('none');
                return;
            }

            charts[canvasId] = new Chart(document.getElementById(canvasId), config);
        }

        function renderStageChart(canvasId, legendId, counts, colorMap) {
            renderDoughnut(canvasId, legendId, counts, colorMap);
        }

        function renderResourceMix(canvasId, counts) {
            const items = counts || [];
