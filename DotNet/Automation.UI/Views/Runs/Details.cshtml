        function animateCounter(elementId, targetValue) {
            const el = document.getElementById(elementId);
            const startValue = Number(el.dataset.current || 0);
            const endValue = Number(targetValue || 0);

            if (startValue === endValue) {
                el.textContent = String(endValue);
                return;
            }

            const durationMs = 350;
            const startTs = performance.now();

            function step(ts) {
                const progress = Math.min(1, (ts - startTs) / durationMs);
                const eased = 1 - Math.pow(1 - progress, 3);
                const value = Math.round(startValue + ((endValue - startValue) * eased));
                el.textContent = String(value);
                if (progress < 1) {
                    requestAnimationFrame(step);
                } else {
                    el.textContent = String(endValue);
                    el.dataset.current = String(endValue);
                }
            }

            requestAnimationFrame(step);
        }

        function renderServiceErrorSummary(summaryItems) {
            if (!serviceErrorLines._summaries) serviceErrorLines._summaries = {};

            const targets = [
                { name: 'Data Acquisition', countId: 'serviceErrorCountDataAcq', buttonId: 'serviceErrorBtnDataAcq' },
                { name: 'Normalization', countId: 'serviceErrorCountNormalization', buttonId: 'serviceErrorBtnNormalization' },
                { name: 'Measure Eval', countId: 'serviceErrorCountMeasureEval', buttonId: 'serviceErrorBtnMeasureEval' },
                { name: 'Validation', countId: 'serviceErrorCountValidation', buttonId: 'serviceErrorBtnValidation' },
                { name: 'Report', countId: 'serviceErrorCountReport', buttonId: 'serviceErrorBtnReport' }
            ];

            for (const target of targets) {
                const service = getServiceError(summaryItems, target.name);
                const total = Number(service?.totalErrors ?? service?.TotalErrors ?? 0);
                const errorLines = service?.errorLines || service?.ErrorLines || [];
                serviceErrorLines[target.name] = errorLines;
                serviceErrorLines._summaries[target.name] = service || { errorLines: [], errorGroups: [], totalErrors: 0 };

                animateCounter(target.countId, total);

                const btn = document.getElementById(target.buttonId);
                btn.disabled = total <= 0;
                btn.classList.toggle('text-danger', total > 0);
            }
        }

        function renderMilestones(milestones) {
            const host = document.getElementById('reportMilestones');
            const orderedMilestones = [
                'Report Scheduled',
                'Data Acquired',
                'Measure Evaluated',
                'Validation',
                'Submitted',
                'Test Validation'
            ];
            const normalized = new Map();
            for (const m of (milestones || [])) {
                const name = m.name || m.Name;
                if (!name) continue;
                normalized.set(name, {
                    name,
                    completed: m.completed === true || m.Completed === true,
                    failed: m.failed === true || m.Failed === true
                });
            }

            host.innerHTML = '';
            for (const stepName of orderedMilestones) {
                const m = normalized.get(stepName) || { name: stepName, completed: false, failed: false };
                const div = document.createElement('span');
                const failed = m.failed === true;
                const completed = m.completed === true;
                div.className = `rounded-pill d-inline-flex align-items-center justify-content-center ${failed ? 'bg-danger text-white' : completed ? 'bg-success text-white' : 'bg-light border text-dark'}`;
                div.style.width = '136px';
                div.style.height = '30px';
                div.style.fontSize = '0.8rem';
                div.style.fontWeight = '600';
                div.style.lineHeight = '1';
                div.style.whiteSpace = 'nowrap';
                div.textContent = m.name;
                host.appendChild(div);
            }
        }

        function setFlyout(title, errors) {
            const flyout = document.getElementById('errorFlyout');
            document.getElementById('errorFlyoutTitle').textContent = title;
            const body = document.getElementById('errorFlyoutBody');
            if (!errors || errors.length === 0) {
                body.innerHTML = '<div class="text-muted">No errors.</div>';
            } else {
                body.innerHTML = errors.map(x => `<div class="border-bottom py-2 small">${x.replaceAll('<', '&lt;').replaceAll('>', '&gt;')}</div>`).join('');
            }
            flyout.style.right = '0';
        }

        // --- Service Exception Modal ---
        let _exModalAllItems = [];
        let _exModalGroups = [];
        let _exModalActiveGroup = null;

        function openServiceExceptionModal(serviceName) {
            const summary = (serviceErrorLines._summaries || {})[serviceName];
            if (!summary) return;

            const lines = summary.errorLines || summary.ErrorLines || [];
            const groups = (summary.errorGroups || summary.ErrorGroups || []).map(g => ({
                label: g.status || g.Status || 'Unknown',
                count: g.count ?? g.Count ?? 0
            })).sort((a, b) => b.count - a.count);
            const totalErrors = summary.totalErrors ?? summary.TotalErrors ?? lines.length;

            document.getElementById('serviceExceptionModalLabel').textContent = `${serviceName} Exceptions`;
            document.getElementById('serviceExceptionSubtitle').textContent = `${totalErrors} total exception(s) captured`;

            _exModalAllItems = lines.map((line, i) => {
                const parsed = parseExceptionLine(line);
                return { id: i, raw: line, ...parsed };
            });
            _exModalGroups = groups;
            _exModalActiveGroup = null;

            renderExModalGroupChips();
            applyExModalFilter();

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('serviceExceptionModal'));
            modal.show();
        }

        function parseExceptionLine(line) {
            let cleaned = line;
            const componentMatch = cleaned.match(/^\[([^\]]+)\]\s*/);
            const component = componentMatch ? componentMatch[1] : '';
            if (componentMatch) cleaned = cleaned.slice(componentMatch[0].length);

            let level = 'ERROR';
            const levelMatch = cleaned.match(/^(ERROR|WARN|WARNING|FATAL|INFO)\b\s*\|?\s*/i);
            if (levelMatch) {
                level = levelMatch[1].toUpperCase();
                cleaned = cleaned.slice(levelMatch[0].length);
            }

            // Split on ||| delimiter — left side is summary, right side is full detail
            let summary = cleaned;
            let detail = '';
            const tripleIdx = cleaned.indexOf('|||');
            if (tripleIdx >= 0) {
                summary = cleaned.slice(0, tripleIdx).trim();
                detail = cleaned.slice(tripleIdx + 3).trim();
            }

            let headline = summary;
            if (!detail) {
                // No triple-pipe detail — try splitting on first pipe for headline/detail
                const pipeIdx = summary.indexOf(' | ');
                if (pipeIdx > 0) {
                    headline = summary.slice(0, pipeIdx).trim();
                    detail = summary.slice(pipeIdx + 3).trim();
                } else if (summary.length > 120) {
                    headline = summary.slice(0, 120).trim() + '…';
                    detail = summary;
                }
            } else {
                // Shorten the summary for the collapsed header
                if (summary.length > 160) {
                    headline = summary.slice(0, 160).trim() + '…';
                }
            }

            return { component, level, headline, detail, full: line };
        }

        function renderExModalGroupChips() {
            const host = document.getElementById('exModalGroupChips');
            if (!_exModalGroups.length) { host.innerHTML = ''; return; }

            const allActive = _exModalActiveGroup === null;
            let html = `<button class="btn btn-sm ${allActive ? 'btn-dark' : 'btn-outline-secondary'} ex-group-chip" data-group="">All</button>`;
            for (const g of _exModalGroups) {
                const active = _exModalActiveGroup === g.label;
                html += `<button class="btn btn-sm ${active ? 'btn-dark' : 'btn-outline-secondary'} ex-group-chip" data-group="${escapeHtml(g.label)}" title="${escapeHtml(g.label)}">${truncate(g.label, 50)} <span class="badge bg-light text-dark ms-1">${g.count}</span></button>`;
            }
            host.innerHTML = html;

            for (const btn of host.querySelectorAll('.ex-group-chip')) {
                btn.addEventListener('click', () => {
                    _exModalActiveGroup = btn.dataset.group || null;
                    renderExModalGroupChips();
                    applyExModalFilter();
                });
            }
        }

        function applyExModalFilter() {
            const searchTerm = (document.getElementById('exModalSearch').value || '').toLowerCase();
            const accordion = document.getElementById('exModalAccordion');
            const emptyMsg = document.getElementById('exModalEmpty');

            let filtered = _exModalAllItems;
            if (_exModalActiveGroup) {
                const groupLower = _exModalActiveGroup.toLowerCase();
                filtered = filtered.filter(item => item.raw.toLowerCase().includes(groupLower));
            }
            if (searchTerm) {
                filtered = filtered.filter(item => item.raw.toLowerCase().includes(searchTerm));
            }

            document.getElementById('exModalVisibleCount').textContent = String(filtered.length);

            if (!filtered.length) {
                accordion.innerHTML = '';
                emptyMsg.style.display = '';
                return;
            }
            emptyMsg.style.display = 'none';

            const maxRender = 200;
            const items = filtered.slice(0, maxRender);

            accordion.innerHTML = items.map(item => {
                const levelBadge = item.level === 'FATAL' || item.level === 'ERROR'
                    ? 'bg-danger' : item.level === 'WARN' || item.level === 'WARNING'
                    ? 'bg-warning text-dark' : 'bg-secondary';
                const collapseId = `exCollapse${item.id}`;
                const headerId = `exHeader${item.id}`;
                const hasDetail = !!item.detail;

                return `<div class="accordion-item">
                    <h2 class="accordion-header" id="${headerId}">
                        <button class="accordion-button collapsed py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#${collapseId}" aria-expanded="false" aria-controls="${collapseId}" style="font-size:.82rem;">
                            <span class="badge ${levelBadge} me-2" style="font-size:.65rem;">${item.level}</span>
                            <span class="text-muted me-2" style="flex-shrink:0;font-size:.72rem;">${escapeHtml(item.component)}</span>
                            <span class="text-truncate">${escapeHtml(item.headline)}</span>
                        </button>
                    </h2>
                    <div id="${collapseId}" class="accordion-collapse collapse" aria-labelledby="${headerId}">
                        <div class="accordion-body p-3" style="background:#f8f9fa;">
                            ${hasDetail
                                ? `<pre class="mb-0 small" style="white-space:pre-wrap;word-break:break-all;max-height:400px;overflow:auto;">${escapeHtml(item.detail)}</pre>`
                                : `<pre class="mb-0 small" style="white-space:pre-wrap;word-break:break-all;max-height:400px;overflow:auto;">${escapeHtml(item.full)}</pre>`}
                        </div>
                    </div>
                </div>`;
            }).join('') + (filtered.length > maxRender ? `<div class="text-center text-muted small p-3">${filtered.length - maxRender} more items not shown. Use the search filter to narrow results.</div>` : '');
        }

        function truncate(str, len) {
            return str.length > len ? str.slice(0, len) + '…' : str;
        }

        document.getElementById('exModalSearch').addEventListener('input', applyExModalFilter);

        async function refreshSnapshot() {
            try {
                const response = await fetch(`${snapshotUrl}?id=${encodeURIComponent(runId)}`);
                if (response.status === 204) {
                    appendLog('[snapshot] no snapshot content yet (204).');
                    return;
                }
                if (response.status === 404) {
                    appendLog('[snapshot] snapshot endpoint returned 404.');
                    return;
                }
                if (!response.ok) {
                    appendLog(`[snapshot] HTTP error ${response.status}.`);
                    throw new Error(`Snapshot HTTP ${response.status}`);
                }
                const snapshot = await response.json();
                if (!snapshot) {
                    appendLog('[snapshot] empty snapshot payload.');
                    return;
                }

                const snapshotIsFinal = snapshot.isFinal === true || snapshot.IsFinal === true;

                probeManifest();
                renderMilestones(snapshot.report?.milestones || []);
                renderValidatorResults(snapshot.validatorResults || []);

                const schedule = snapshot.report?.schedule;
                const effectiveFacilityId = snapshot.facilityId || snapshot.FacilityId || schedule?.reportName || '-';
                document.getElementById('scheduleFacilityId').textContent = effectiveFacilityId;
                document.getElementById('scheduleReportName').textContent = schedule?.reportName || '-';
                document.getElementById('scheduleFrequency').textContent = schedule?.frequency || '-';
                document.getElementById('scheduleStart').textContent = schedule?.startDate || '-';
                document.getElementById('scheduleEnd').textContent = schedule?.endDate || '-';
                document.getElementById('scheduleAdhoc').textContent = schedule?.adHocType || '-';
                document.getElementById('scheduleCreated').textContent = schedule?.reportCreated || '-';
                document.getElementById('scheduleSubmitted').textContent = schedule?.submittedAt || '-';
                document.getElementById('scheduleDuration').textContent = schedule?.duration || '-';

                const statusPill = document.getElementById('scheduleStatusPill');
                statusPill.className = `badge ${getScheduleStatusClass(schedule?.scheduleStatus)}`;
                statusPill.textContent = schedule?.scheduleStatus || '-';

                renderDoughnut('entriesDonut', 'entriesLegend', snapshot.report?.entrySubmissionStatuses || [], {
                    submitted: '#198754',
                    submitting: '#06b6d4',
                    noteligable: '#f59e0b',
                    failedsubmission: '#ef4444',
                    pendingvalidation: '#94a3b8',
                    unknown: '#cbd5e1'
                });

                document.getElementById('populationSummary').textContent = snapshot.report?.populationSummary || 'No population data yet.';

                const dataAcqCandidate = snapshot.dataAcquisition || {};
                const dataAcqHasData = (dataAcqCandidate.statusCounts || []).length > 0
                    || (dataAcqCandidate.resourceTypeCounts || []).length > 0
                    || (dataAcqCandidate.throughputBuckets || []).length > 0
                    || Number(dataAcqCandidate.resourceCount || 0) > 0;

                if (dataAcqHasData) {
                    lastDataAcqSnapshot = dataAcqCandidate;
                }

                const dataAcq = lastDataAcqSnapshot || dataAcqCandidate;

                renderDoughnut('dataAcqDonut', 'dataAcqLegend', dataAcq.statusCounts || [], {
                    completed: '#198754',
                    processing: '#06b6d4',
                    failed: '#ef4444',
                    pending: '#f59e0b',
                    unknown: '#94a3b8'
                }, true);

                document.getElementById('dataAcqRate').textContent = formatNumber(dataAcq.completionRatePerSecond);
                document.getElementById('dataAcqResourceCount').textContent = dataAcq.resourceCount || 0;
                document.getElementById('dataAcqResPerSec').textContent = formatNumber(dataAcq.averageResourcesPerSecond);
                renderTimeline('dataAcqTimeline', dataAcq.throughputBuckets || [], '#06b6d4');
                renderResourceMix('dataAcqResourceMixChart', dataAcq.resourceTypeCounts || []);
                dataAcqErrors = dataAcq.errors || [];
                document.getElementById('dataAcqErrorsBtn').style.display = dataAcqErrors.length > 0 ? '' : 'none';

                const totalLogCount = (dataAcq.statusCounts || []).reduce((sum, x) => sum + (x.count || 0), 0);
                document.getElementById('dataAcqTotalLogs').textContent = totalLogCount;

                renderServiceErrorSummary(snapshot.serviceErrorSummary || snapshot.ServiceErrorSummary || []);

                document.getElementById('normalizationRate').textContent = formatNumber(snapshot.normalization?.completionRatePerSecond);
                document.getElementById('normalizationResourceCount').textContent = snapshot.normalization?.resourceCount || 0;
                document.getElementById('normalizationResPerSec').textContent = formatNumber(snapshot.normalization?.averageResourcesPerSecond);
                renderResourceMix('normalizationResourceMixChart', snapshot.normalization?.resourceTypeCounts || []);
                renderTimeline('normalizationTimeline', snapshot.normalization?.throughputBuckets || [], '#6f42c1');

                normalizationErrors = snapshot.normalization?.errors || [];
                document.getElementById('normalizationErrorsBtn').style.display = normalizationErrors.length > 0 ? '' : 'none';

                document.getElementById('measureRate').textContent = formatNumber(snapshot.measureEval?.completionRatePerSecond);
                document.getElementById('measureResourceCount').textContent = snapshot.measureEval?.resourceCount || 0;
                document.getElementById('measureResPerSec').textContent = formatNumber(snapshot.measureEval?.averageResourcesPerSecond);
                renderStageChart('measureStageChart', 'measureStageLegend', snapshot.measureEval?.funnelCounts || [], {
                    'no measure report': '#94a3b8',
                    notreportable: '#f59e0b',
                    readyforvalidation: '#198754'
                });
                renderResourceMix('measureResourceMixChart', snapshot.measureEval?.resourceTypeCounts || []);
                renderTimeline('measureTimeline', snapshot.measureEval?.throughputBuckets || [], '#0d6efd');

                measureErrors = snapshot.measureEval?.errors || [];
                document.getElementById('measureErrorsBtn').style.display = measureErrors.length > 0 ? '' : 'none';

                const validationFunnel = snapshot.validation?.funnelCounts || [];
                const validationTotal = validationFunnel.reduce((acc, item) => acc + (item.count || 0), 0);
                const validationPassed = (validationFunnel.find(f => (f.status || '').toLowerCase() === 'passedvalidation') || {}).count || 0;
                const validationFailed = (validationFunnel.find(f => (f.status || '').toLowerCase() === 'failedvalidation') || {}).count || 0;

                document.getElementById('validationPatientCount').textContent = validationTotal;
                document.getElementById('validationPassedCount').textContent = validationPassed;
                document.getElementById('validationFailedCount').textContent = validationFailed;
                renderStageChart('validationStageChart', 'validationStageLegend', validationFunnel, {
                    notvalidated: '#94a3b8',
                    failedvalidation: '#ef4444',
                    passedvalidation: '#198754'
                });
                renderTimeline('validationTimeline', snapshot.validation?.throughputBuckets || [], '#198754');

                validationErrors = snapshot.validation?.errors || [];
                document.getElementById('validationErrorsBtn').style.display = validationErrors.length > 0 ? '' : 'none';

                const runIsComplete = isRunComplete(currentRunStatus) || !!currentFinishedAt;
                if (runIsComplete && !runCompletedAtMs) {
                    runCompletedAtMs = Date.now();
                }

                if (runIsComplete) {
                    const elapsedMs = runCompletedAtMs ? (Date.now() - runCompletedAtMs) : 0;
                    const settled = isReportSettled(snapshot);

                    setFinalizingBadge(!settled);

                    // Keep polling briefly after completion so final persisted schedule/milestones
                    // can catch up in the UI.
                    if ((snapshotIsFinal && settled && elapsedMs >= 2000) || elapsedMs >= 30000) {
                        setFinalizingBadge(false);
                        stopSnapshotPolling();
                    }
                } else {
                    setFinalizingBadge(false);
                }
            } catch (err) {
                const message = err && err.message ? err.message : String(err || 'Unknown snapshot error');
                appendLog(`[snapshot] ERROR: ${message}`);
                console.error('refreshSnapshot failed', err);
            }
        }

        connection.on('log', appendLog);
        connection.on('status', (run) => {
            currentRunStatus = run.status || currentRunStatus;
            document.getElementById('runName').textContent = run.runName;
            document.getElementById('facilityId').textContent = run.facilityId || '-';
            document.getElementById('scheduleFacilityId').textContent = run.facilityId || '-';
            document.getElementById('status').textContent = run.status;
            document.getElementById('error').textContent = run.error || '-';
            document.getElementById('started').textContent = run.startedAt || '-';
            document.getElementById('finished').textContent = run.finishedAt || '-';
            document.getElementById('pipelineDuration').textContent = run.duration || '-';
            currentFinishedAt = run.finishedAt || currentFinishedAt;

            if ((isRunComplete(currentRunStatus) || !!currentFinishedAt) && !runCompletedAtMs) {
                runCompletedAtMs = Date.now();
            }

            if (isRunComplete(currentRunStatus)) {
                swapCancelToDelete();
            }

            refreshSnapshot();
        });

        document.getElementById('measureErrorsBtn').addEventListener('click', () => openServiceExceptionModal('Measure Eval'));
        document.getElementById('validationErrorsBtn').addEventListener('click', () => openServiceExceptionModal('Validation'));
        document.getElementById('dataAcqErrorsBtn').addEventListener('click', () => openServiceExceptionModal('Data Acquisition'));
        document.getElementById('normalizationErrorsBtn').addEventListener('click', () => openServiceExceptionModal('Normalization'));
        for (const btn of document.querySelectorAll('.service-error-btn')) {
            btn.addEventListener('click', () => {
                const service = btn.getAttribute('data-service');
                openServiceExceptionModal(service);
            });
        }
        document.getElementById('closeFlyout').addEventListener('click', () => {
            document.getElementById('errorFlyout').style.right = '-480px';
        });

        connection.start()
            .then(() => connection.invoke('SubscribeRun', runId))
            .catch(err => appendLog('[signalr] ' + err));

        renderConfigProperties(runConfigurationJson);
        refreshSnapshot();
        if (!isRunComplete(currentRunStatus) && !currentFinishedAt)
            snapshotTimer = setInterval(refreshSnapshot, 2000);

        // Probe for manifest availability (repeated until found).
        let manifestButtonVisible = false;
        function probeManifest() {
            if (manifestButtonVisible) return;
            fetch(`${manifestUrl}?id=${runId}`).then(r => {
                if (r.ok && r.status !== 204) {
                    manifestButtonVisible = true;
                    tryShowManifestButton();
                }
            }).catch(() => {});
        }
        probeManifest();

        // --- DA Log Drill-Down Modal ---
        const dataAcqLogsUrl = '@Url.Action("DataAcquisitionLogs", "Runs")';
        const dataAcqLogDetailUrl = '@Url.Action("DataAcquisitionLogDetail", "Runs")';
        let daLogPage = 1;
        const daLogPageSize = 50;
        let daSortBy = 'Id';
        let daSortOrder = 'Ascending';
        // Current free-text search term, sent to the server on every fetch. Server
        // applies the filter and returns paged results just like the unfiltered case,
        // so pagination stays straightforward and works the same in either mode.
        let daSearchTerm = '';

        function updateDaSortIcons() {
            const map = {
                Id: 'sortIconId',
                PatientId: 'sortIconPatientId',
                Status: 'sortIconStatus',
                QueryPhase: 'sortIconQueryPhase'
            };

            for (const key of Object.keys(map)) {
                const el = document.getElementById(map[key]);
                if (!el) continue;
                if (key !== daSortBy) {
                    el.textContent = '';
                    continue;
                }

                el.textContent = daSortOrder === 'Ascending' ? '\u25B2' : '\u25BC';
            }
        }

        async function loadDataAcqLogs(page) {
            daLogPage = page;
            const tbody = document.getElementById('dataAcqLogTableBody');
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Loading...</td></tr>';

            try {
                let url = `${dataAcqLogsUrl}?id=${encodeURIComponent(runId)}&pageNumber=${page}&pageSize=${daLogPageSize}&sortBy=${encodeURIComponent(daSortBy)}&sortOrder=${encodeURIComponent(daSortOrder)}`;
                if (daSearchTerm) {
                    url += `&searchTerm=${encodeURIComponent(daSearchTerm)}`;
                }

                const res = await fetch(url);
                if (!res.ok) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Failed to load logs.</td></tr>';
                    return;
                }

                const data = await res.json();
                const records = data.records || data.Records || [];
                const totalCount = data.metadata?.totalCount || data.Metadata?.TotalCount || 0;
                const totalPages = Math.max(1, Math.ceil(totalCount / daLogPageSize));

                document.getElementById('dataAcqLogPaginationInfo').textContent = daSearchTerm
                    ? `Page ${page} of ${totalPages} (${totalCount} match(es), filtered)`
                    : `Page ${page} of ${totalPages} (${totalCount} total)`;

                document.getElementById('dataAcqLogPrev').disabled = page <= 1;
                document.getElementById('dataAcqLogNext').disabled = page >= totalPages;

                renderDaLogRows(records, daSearchTerm ? 'No matching logs.' : 'No logs found.');
            } catch {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading logs.</td></tr>';
            }
        }

        // Renders the table body for a list of records and (re-)wires the per-row
        // detail buttons. Hoisted out of loadDataAcqLogs so future server-paged
        // call sites have a single rendering contract.
        function renderDaLogRows(records, emptyMessage) {
            const tbody = document.getElementById('dataAcqLogTableBody');
            if (!records.length) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">${escapeHtml(emptyMessage || 'No logs found.')}</td></tr>`;
                return;
            }

            tbody.innerHTML = records.map(r => {
                const status = r.status ?? r.Status ?? '-';
                const phase = r.queryPhase ?? r.QueryPhase ?? '-';
                const isReference = r.isReferenceLog === true || r.IsReferenceLog === true;
                const refCount = r.referenceResourceCount ?? r.ReferenceResourceCount ?? 0;
                const resourceTypes = r.resourceTypes || r.ResourceTypes || [];
                const patient = r.patientId ?? r.PatientId ?? '-';
                const logId = r.id ?? r.Id;
                const statusKey = String(status).toLowerCase();
                const statusBadge = statusKey === 'completed' ? 'au-badge-success'
                    : statusKey === 'failed' ? 'au-badge-danger'
                    : statusKey === 'processing' ? 'au-badge-muted'
                    : 'au-badge-muted';
                return `<tr>
                    <td class="small">${logId ?? '-'}</td>
                    <td class="small">${escapeHtml(patient)}</td>
                    <td><span class="badge ${statusBadge}">${escapeHtml(status)}</span></td>
                    <td class="small">${escapeHtml(phase)}</td>
                    <td class="small">${refCount > 0 ? `<span class="badge" style="background:var(--au-accent);color:#fff;">${refCount} ref</span>` : isReference ? '<span class="badge au-badge-muted">Ref</span>' : '<span class="text-muted">-</span>'}</td>
                    <td class="small" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escapeHtml(resourceTypes.join(', '))}">${escapeHtml(resourceTypes.join(', ') || '-')}</td>
                    <td class="small text-end">
                        <button type="button" class="btn btn-sm btn-au-action da-detail-btn" data-logid="${logId}" title="View details"><i class="bi bi-file-text"></i></button>
                    </td>
                </tr>`;
            }).join('');

            for (const btn of tbody.querySelectorAll('.da-detail-btn')) {
                btn.addEventListener('click', () => openDaLogDetails(btn.getAttribute('data-logid')));
            }
        }

        async function openDaLogDetails(logId) {
            if (!logId) return;

            const flyout = document.getElementById('daLogFlyout');
            const title = document.getElementById('daLogFlyoutTitle');
            const subtitle = document.getElementById('daLogFlyoutSubtitle');
            const body = document.getElementById('daLogFlyoutBody');

            title.innerHTML = `<i class="bi bi-file-text me-2"></i>Data Acquisition Log ${logId}`;
            subtitle.textContent = 'Loading…';
            body.innerHTML = '<div class="text-muted">Loading details…</div>';
            flyout.style.right = '0';

            try {
                const res = await fetch(`${dataAcqLogDetailUrl}?id=${encodeURIComponent(runId)}&logId=${encodeURIComponent(logId)}`);
                if (!res.ok) {
                    subtitle.textContent = '';
                    body.innerHTML = '<div class="text-danger">Failed to load log details.</div>';
                    return;
                }

                const d = await res.json();
                const notes = d.notes || d.Notes || [];
                const resources = d.resourceAcquiredIds || d.ResourceAcquiredIds || [];
                const referenceResources = d.referenceResourceIds || d.ReferenceResourceIds || [];
                const resourceTypes = d.resourceTypes || d.ResourceTypes || [];
                const isReference = d.isReferenceLog === true || d.IsReferenceLog === true;
                const referenceResourceCount = d.referenceResourceCount ?? d.ReferenceResourceCount ?? 0;
                const status = d.status ?? d.Status ?? '-';
                const phase = d.queryPhase ?? d.QueryPhase ?? '-';
                const patient = d.patientId ?? d.PatientId ?? '-';
                const traceId = d.traceId ?? d.TraceId ?? '';
                const correlationId = d.correlationId ?? d.CorrelationId ?? '';
                const queryType = d.queryType ?? d.QueryType ?? '';
                const queries = d.queries || d.Queries || [];
                const fhirVersion = d.fhirVersion ?? d.FhirVersion ?? '';
                const priority = d.priority ?? d.Priority ?? '';
                const retryAttempts = d.retryAttempts ?? d.RetryAttempts ?? 0;

                const statusKey = String(status).toLowerCase();
                const statusBadge = statusKey === 'completed' ? 'au-badge-success'
                    : statusKey === 'failed' ? 'au-badge-danger'
                    : statusKey === 'processing' ? 'au-badge-muted'
                    : 'au-badge-muted';

                subtitle.innerHTML = `Patient <code class="text-white">${escapeHtml(patient)}</code> &middot; <span class="badge ${statusBadge}">${escapeHtml(status)}</span> &middot; Phase ${escapeHtml(phase)}`;
                body.innerHTML = `
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <div class="au-summary-item"><span class="au-label">Trace Id</span><code class="au-value text-break">${escapeHtml(traceId || '-')}</code></div>
                        </div>
                        <div class="col-12">
                            <div class="au-summary-item"><span class="au-label">Correlation Id</span><code class="au-value text-break">${escapeHtml(correlationId || '-')}</code></div>
                        </div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">Query Type</span><span class="au-value">${escapeHtml(queryType || '-')}</span></div></div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">FHIR Version</span><span class="au-value">${escapeHtml(fhirVersion || '-')}</span></div></div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">Priority</span><span class="au-value">${escapeHtml(String(priority) || '-')}</span></div></div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">Retry Attempts</span><span class="au-value">${retryAttempts}</span></div></div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">Reference Workflow</span><span class="au-value">${isReference ? `Yes (${referenceResourceCount})` : 'No'}</span></div></div>
                        <div class="col-6"><div class="au-summary-item"><span class="au-label">Completion</span><span class="au-value">${escapeHtml(String(d.completionTimeMilliseconds ?? d.CompletionTimeMilliseconds ?? '-'))} ms</span><span class="small text-muted">${escapeHtml(String(d.completionDate ?? d.CompletionDate ?? '-'))}</span></div></div>
                    </div>

                    <div class="au-summary-item mb-2"><span class="au-label">Queries (${queries.length})</span></div>
                    <pre class="small" style="max-height:160px;overflow:auto;background:#f5f6f8;border:1px solid #e3e6ea;border-radius:.35rem;padding:.5rem .65rem;">${escapeHtml(queries.join('\n') || '(none)')}</pre>

                    <div class="au-summary-item mb-2"><span class="au-label">Resource Types</span><span class="au-value">${escapeHtml(resourceTypes.join(', ') || '-')}</span></div>

                    <div class="au-summary-item mb-2 mt-3"><span class="au-label">Resources (${resources.length})</span></div>
                    <pre class="small" style="max-height:200px;overflow:auto;background:#f5f6f8;border:1px solid #e3e6ea;border-radius:.35rem;padding:.5rem .65rem;">${escapeHtml(resources.join('\n') || '(none)')}</pre>

                    ${referenceResources.length > 0 ? `<div class="au-summary-item mb-2 mt-3"><span class="au-label"><span class="badge au-badge-muted me-1">Ref</span>Reference Resources (${referenceResources.length})</span></div>
                    <pre class="small" style="max-height:200px;overflow:auto;background:#eef5ff;border:1px solid #cfe1fb;border-radius:.35rem;padding:.5rem .65rem;">${escapeHtml(referenceResources.join('\n'))}</pre>` : ''}

                    <div class="au-summary-item mb-2 mt-3"><span class="au-label">Notes (${notes.length})</span></div>
                    <pre class="small" style="max-height:260px;overflow:auto;background:#f5f6f8;border:1px solid #e3e6ea;border-radius:.35rem;padding:.5rem .65rem;">${escapeHtml(notes.join('\n') || '(none)')}</pre>
                `;
            } catch {
                subtitle.textContent = '';
                body.innerHTML = '<div class="text-danger">Error loading log details.</div>';
            }
        }

        for (const th of document.querySelectorAll('#dataAcqLogTable thead th[data-sortby]')) {
            th.addEventListener('click', () => {
                const nextSortBy = th.getAttribute('data-sortby');
                if (!nextSortBy) return;

                if (daSortBy === nextSortBy) {
                    daSortOrder = daSortOrder === 'Ascending' ? 'Descending' : 'Ascending';
                } else {
                    daSortBy = nextSortBy;
                    daSortOrder = 'Ascending';
                }

                updateDaSortIcons();
                loadDataAcqLogs(1);
            });
        }

        updateDaSortIcons();

        document.getElementById('dataAcqLogModal').addEventListener('show.bs.modal', () => loadDataAcqLogs(1));
        document.getElementById('dataAcqLogPrev').addEventListener('click', () => { if (daLogPage > 1) loadDataAcqLogs(daLogPage - 1); });
        document.getElementById('dataAcqLogNext').addEventListener('click', () => loadDataAcqLogs(daLogPage + 1));

        // Search input updates the server-side search term. Each fetch passes the term
        // along; the server applies it as PatientId LIKE %term% (and Id/ResourceType
        // exact matches when applicable), then returns a normally-paged result. So
        // pagination behaves identically to the unfiltered case — page 1 is page 1
        // of the filtered set, no client-side row hiding, no bulk pre-fetch.
        (function () {
            const input = document.getElementById('daLogSearch');
            if (!input) return;

            let timer = null;
            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    daSearchTerm = (input.value || '').trim();
                    loadDataAcqLogs(1);
                }, 250);
            });
        })();

        document.getElementById('closeDaLogFlyout').addEventListener('click', () => {
            document.getElementById('daLogFlyout').style.right = '-720px';
        });

        // --- Generation Manifest ---
        const manifestPageUrl = '@Url.Action("Manifest", "Runs")';

        function tryShowManifestButton() {
            var btn = document.getElementById('btnViewManifest');
            if (btn) {
                btn.style.display = '';
                btn.href = `${manifestPageUrl}?id=${runId}`;
            }
            // Ensure the parent card is visible even if no config properties were rendered.
            var card = document.getElementById('testConfigCard');
            if (card) card.style.display = '';
        }
    })();
</script>
