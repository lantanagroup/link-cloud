            var census = pcEditor.patternExpectedInReport
                ? pcEditor.patternExpectedInReport(pattern)
                : patternExpectedInReport(pattern);
            cell.innerHTML = pcEditor.renderQualificationBadges(prediction, selectedMeasureTypes(), census);
        }

