        // ---- AJAX helper ----
        async function postJson(url, body) {
            var res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': af() },
                body: JSON.stringify(body)
            });
            if (!res.ok) {
                var errText = '';
                try { errText = await res.text(); } catch (_) {}
                throw new Error(errText || ('Server returned ' + res.status));
            }
            var ct = res.headers.get('content-type') || '';
            return ct.indexOf('json') >= 0 ? res.json() : null;
        }

        async function waitForPatientReplacement(statusUrl, patientId) {
            var startedAt = Date.now();
            var controller = new AbortController();
            activePatientReplacementPollController = controller;

            function delayWithSignal(ms, signal) {
                return new Promise(function (resolve, reject) {
                    if (signal.aborted) {
                        reject(new DOMException('Polling canceled.', 'AbortError'));
                        return;
                    }

                    var timeoutId = window.setTimeout(function () {
                        signal.removeEventListener('abort', onAbort);
                        resolve();
                    }, ms);

                    function onAbort() {
                        window.clearTimeout(timeoutId);
                        signal.removeEventListener('abort', onAbort);
                        reject(new DOMException('Polling canceled.', 'AbortError'));
                    }

                    signal.addEventListener('abort', onAbort);
                });
            }

            try {
                while (Date.now() - startedAt < patientReplacementPollTimeoutMs) {
                    if (!isScenarioEditorModalOpen()) {
                        throw new DOMException('Scenario editor modal closed.', 'AbortError');
                    }

                    var response = await fetch(statusUrl, {
                        headers: { 'Accept': 'application/json' },
                        signal: controller.signal
                    });
                    if (!response.ok) {
                        throw new Error(await response.text() || 'Could not retrieve replacement status.');
                    }

                    var status = await response.json();
                    setImportedUploadStatus(
                        status.message || 'Replacing FHIR-server data for Patient/' + patientId + '...',
                        !status.isComplete);

                    if (status.isComplete) {
                        if (!status.succeeded) {
                            throw new Error(status.message || 'FHIR-server replacement failed.');
                        }

                        return status;
                    }

                    var elapsed = Date.now() - startedAt;
                    var remaining = patientReplacementPollTimeoutMs - elapsed;
                    if (remaining <= 0) {
                        break;
                    }

                    if (!isScenarioEditorModalOpen()) {
                        throw new DOMException('Scenario editor modal closed.', 'AbortError');
                    }

                    await delayWithSignal(Math.min(2000, remaining), controller.signal);
                }
            } catch (err) {
                if (err && err.name === 'AbortError') {
                    throw new Error('FHIR-server replacement status polling was canceled.');
                }

                throw err;
            } finally {
                if (activePatientReplacementPollController === controller) {
                    activePatientReplacementPollController = null;
                }
            }

            throw new Error('Timed out waiting for FHIR-server replacement status for Patient/' + patientId + '.');
        }

        async function postForm(url, formData) {
            var res = await fetch(url, {
                method: 'POST',
                headers: { 'RequestVerificationToken': af() },
                body: formData
            });
            if (!res.ok) {
                var errText = '';
                try { errText = await res.text(); } catch (_) { }
                throw new Error(errText || ('Server returned ' + res.status));
            }
            var ct = res.headers.get('content-type') || '';
            return ct.indexOf('json') >= 0 ? res.json() : null;
        }

        // ---- Measure helpers ----
        function selectedMeasureTypes() {
            var seen = {};
            var out = [];
            document.querySelectorAll('.measure-checkbox:checked').forEach(function (cb) {
                var family = cb.getAttribute('data-family') || cb.value;
                if (!seen[family]) { seen[family] = true; out.push(family); }
            });
            return out;
        }
        function selectedMeasureIds() {
            return Array.prototype.map.call(document.querySelectorAll('.measure-checkbox:checked'), function (cb) { return cb.value; });
        }
        function measureCheckboxForFamily(family) {
            return document.querySelector('.measure-checkbox[data-family="' + family + '"]');
        }
        function sid(v) { return String(v || '').toLowerCase(); }

        function defaultElig(isQ) {
            var m = {}; selectedMeasureTypes().forEach(function (t) { m[t] = isQ ? QUALIFYING : NON_QUALIFYING; }); return m;
        }
        function normElig(raw) {
            var n = {};
            selectedMeasureTypes().forEach(function (m) {
                if (!raw || !Object.prototype.hasOwnProperty.call(raw, m)) { n[m] = QUALIFYING; return; }
                var v = raw[m]; n[m] = (v === QUALIFYING || v === 0 || v === '0') ? QUALIFYING : NON_QUALIFYING;
            });
            return n;
        }
        function cohortMatchesScenario(sc, elig) {
            return selectedMeasureTypes().every(function (m) {
                var d = Object.prototype.hasOwnProperty.call(elig, m) ? elig[m] : QUALIFYING;
                var q = (sc.qualifiesForMeasureTypes || []).indexOf(m) >= 0;
                return d === QUALIFYING ? q : !q;
            });
        }
        function eligIds(elig) {
            var n = normElig(elig);
            return clinicalScenarioCatalog.filter(function (sc) { return cohortMatchesScenario(sc, n); }).map(function (sc) { return sid(sc.scenarioId); });
        }

        function normalizeScheduledPattern(value) {
            var raw = String(value || '').trim();
            if (!raw) return DEFAULT_SCHEDULED_PATTERN;
            var direct = scheduledPatternOptions.find(function (o) { return o.value === raw; });
            if (direct) return direct.value;

            var lowered = raw.toLowerCase();
            var byCaseInsensitiveName = scheduledPatternOptions.find(function (o) { return o.value.toLowerCase() === lowered; });
            if (byCaseInsensitiveName) return byCaseInsensitiveName.value;

            var numeric = parseInt(raw, 10);
            if (!isNaN(numeric) && numeric >= 0 && numeric < scheduledPatternOptions.length)
                return scheduledPatternOptions[numeric].value;

            return DEFAULT_SCHEDULED_PATTERN;
        }

        function normalizeCohortQualification(value) {
            var raw = String(value || '').trim();
            if (!raw) return QUALIFYING;
            var lowered = raw.toLowerCase();
            if (lowered === 'nonqualifying' || lowered === 'non_qualifying' || lowered === 'non-qualifying' || lowered === '1')
                return NON_QUALIFYING;
            return QUALIFYING;
        }

        function inferCohortQualification(elig) {
            var n = normElig(elig);
            var measures = selectedMeasureTypes();
            var allNonQualifying = measures.length > 0 && measures.every(function (m) { return n[m] === NON_QUALIFYING; });
            return allNonQualifying ? NON_QUALIFYING : QUALIFYING;
        }

        function allowedScheduledPatternsForQualification(qualification) {
            var normalized = normalizeCohortQualification(qualification);
            return scheduledPatternOptions.filter(function (o) {
                return normalized === QUALIFYING ? !!o.expectedInReport : !o.expectedInReport;
            });
        }

        function buildScheduledPatternEditor(pattern, qualification) {
            var allowed = allowedScheduledPatternsForQualification(qualification);
            var normalized = normalizeScheduledPattern(pattern);
            var selected = allowed.some(function (o) { return o.value === normalized; })
                ? normalized
                : (allowed[0] ? allowed[0].value : DEFAULT_SCHEDULED_PATTERN);
            var options = allowed.map(function (o) {
                return '<option value="' + o.value + '" title="' + escAttr(o.hint || o.label) + '" ' + (o.value === selected ? 'selected' : '') + '>' + esc(o.label) + '</option>';
            }).join('');
            return '<select class="form-select form-select-sm cohort-scheduled-pattern">' + options + '</select>';
        }

        function buildCohortQualificationEditor(value) {
            var selected = normalizeCohortQualification(value);
            return '<select class="form-select form-select-sm cohort-qualification">' +
                '<option value="' + QUALIFYING + '" ' + (selected === QUALIFYING ? 'selected' : '') + '>Qualifying</option>' +
                '<option value="' + NON_QUALIFYING + '" ' + (selected === NON_QUALIFYING ? 'selected' : '') + '>Non-Qualifying</option>' +
                '</select>';
        }

        function readCohortQualification(row) {
            var select = row.querySelector('.cohort-qualification');
            return normalizeCohortQualification(select ? select.value : QUALIFYING);
        }

        function syncScheduledPatternEditorForRow(row) {
            var cell = row.querySelector('.cohort-pattern-cell');
            if (!cell) return;
            var qualification = readCohortQualification(row);
            var current = row.querySelector('.cohort-scheduled-pattern');
            cell.innerHTML = buildScheduledPatternEditor(current ? current.value : DEFAULT_SCHEDULED_PATTERN, qualification);
        }

        function syncPatternColumns() {
            document.querySelectorAll('.cohort-pattern-col').forEach(function (el) { el.style.display = ''; });
            cohortRows.querySelectorAll('.cohort-pattern-cell').forEach(function (el) { el.style.display = ''; });
        }

        // ---- Cohort row builders ----
        function buildEligEditor(elig) {
            var sel = selectedMeasureTypes();
            if (!sel.length) return '<span class="text-muted small">Select measures</span>';
            return sel.map(function (m) {
                var cb = measureCheckboxForFamily(m);
                var lbl = cb ? (document.querySelector('label[for="' + cb.id + '"]') || { textContent: m }).textContent : m;
                var cur = (Object.prototype.hasOwnProperty.call(elig, m) ? elig[m] : QUALIFYING);
                return '<div class="form-check form-check-inline me-2 mb-1"><input class="form-check-input cohort-measure-eligibility" type="checkbox" data-measure="' + m + '" ' + (cur === QUALIFYING ? 'checked' : '') + ' /><label class="form-check-label small">' + esc(lbl) + '</label></div>';
            }).join('');
        }

        function buildScenarioSelect(ids) {
            var set = new Set((ids || []).map(sid));
            var all = set.size === 0;

            var opts = clinicalScenarioCatalog.map(function (sc) {
                var id = sid(sc.scenarioId),
                    lbl = sc.primaryDiagnosis + ' (' + sc.icdCode + ')';

                return '<div class="form-check mb-1 cohort-scenario-item">' +
                    '<label class="form-check-label small">' +
                    '<input class="form-check-input cohort-scenario-option me-1" ' +
                    'type="checkbox" value="' + id + '" ' +
                    ((all || set.has(id)) ? 'checked' : '') + ' />' +
                    esc(lbl) +
                    '</label></div>';
            }).join('');

            return '<div class="dropdown cohort-scenarios-dropdown">' +
                '<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start cohort-scenarios-toggle" ' +
                'data-bs-toggle="dropdown" data-bs-auto-close="outside">All</button>' +
                '<div class="dropdown-menu p-2 w-100" style="max-height:200px;overflow:auto;">' +
                    '<div class="d-flex gap-2 mb-2">' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary cohort-scenarios-select-all">Select All</button>' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary cohort-scenarios-deselect-all">Deselect All</button>' +
                    '</div>' +
                    opts +
                '</div>' +
            '</div>';
        }

        function findPatientConfig(id) {
            if (!id) return null;
            return patientConfigurationCatalog.find(function (c) { return c.id === id; }) || null;
        }
        function intentHasOverlays(intent) {
            if (!intent || typeof intent !== 'object') return false;
            return Object.keys(intent).some(function (k) {
                var v = intent[k];
                if (v == null || v === '' || v === 'Inherit' || v === 0) return false;
                if (Array.isArray(v)) return v.length > 0;
                if (typeof v === 'object') return Object.keys(v).length > 0;
                return true;
            });
        }
        function buildPatientConfigSelect(selectedId, customized) {
            var opts = '<option value="">Quick setup</option>' +
                patientConfigurationCatalog.map(function (c) {
                    return '<option value="' + c.id + '" ' + (c.id === selectedId ? 'selected' : '') + '>' + esc(c.name) + (c.isSystem ? ' (system)' : '') + '</option>';
                }).join('');
            var customizeClass = customized ? 'btn-primary' : 'btn-outline-secondary';
            var customizeLabel = customized ? 'Customized' : 'Customize';
            return '<div class="d-flex gap-1 pc-cohort-config-cell">' +
                '<select class="form-select form-select-sm cohort-patient-config">' + opts + '</select>' +
                '<button type="button" class="btn btn-sm ' + customizeClass + ' btn-cohort-customize" title="Customize this cohort">' + customizeLabel + '</button>' +
                '</div>';
        }
        function syncPatientConfigLock(row, applyDefaults) {
            var select = row.querySelector('.cohort-patient-config');
            var config = findPatientConfig(select && select.value);
            var minEl = row.querySelector('.cohort-min');
            var maxEl = row.querySelector('.cohort-max');
            var storyOptions = row.querySelectorAll('.cohort-scenario-option');
            var locked = !!config;
            if (minEl) minEl.disabled = locked;
            if (maxEl) maxEl.disabled = locked;
            storyOptions.forEach(function (cb) { cb.disabled = locked; });
            if (!config) {
                updateSummary(row);
                return;
            }
            if (applyDefaults) {
                if (minEl) minEl.value = config.resourcesPerPatientMin || minEl.value;
                if (maxEl) maxEl.value = config.resourcesPerPatientMax || maxEl.value;
                var stories = config.clinicalScenarioIds || [];
                var all = stories.length === 0;
                storyOptions.forEach(function (cb) { cb.checked = all || stories.indexOf(cb.value) >= 0; });
                if (config.cohortQualification) {
                    var qEl = row.querySelector('.cohort-qualification');
                    if (qEl) qEl.value = normalizeCohortQualification(config.cohortQualification);
                    enforceCohortMeasureRules(row);
                    if (config.measureEligibilities && readCohortQualification(row) === QUALIFYING) {
                        row.querySelectorAll('.cohort-measure-eligibility').forEach(function (cb) {
                            var m = cb.getAttribute('data-measure');
                            var v = config.measureEligibilities[m];
                            cb.checked = v === QUALIFYING || v === 0 || v === '0';
                        });
                        enforceDeps(row);
                        enforceCohortMeasureRules(row);
                    }
                    syncScheduledPatternEditorForRow(row);
                }
            }
            updateSummary(row);
        }
        function refreshCustomizeButton(row) {
            var btn = row.querySelector('.btn-cohort-customize');
            if (!btn) return;
            var intent = null;
            try { intent = row.dataset.intentJson ? JSON.parse(row.dataset.intentJson) : null; } catch (_) { intent = null; }
            var on = intentHasOverlays(intent);
            btn.textContent = on ? 'Customized' : 'Customize';
            btn.classList.toggle('btn-primary', on);
            btn.classList.toggle('btn-outline-secondary', !on);
        }
        function addCohortRow(count, elig, scenarios, rMin, rMax, scheduledPattern, cohortQualification, patientConfigurationId, intent) {
            var idx = cohortRows.children.length, ne = normElig(elig);
            var sel = (scenarios && scenarios.length > 0) ? scenarios : eligIds(ne);
            var normalizedQualification = normalizeCohortQualification(cohortQualification || inferCohortQualification(ne));
            var effectivePattern = normalizeScheduledPattern(scheduledPattern);
            var tr = document.createElement('tr');
            tr.innerHTML = '<td class="text-center align-middle">' + (idx + 1) + '</td>' +
                '<td><input type="number" class="form-control form-control-sm cohort-count" min="1" value="' + (count || 1) + '" /></td>' +
                '<td>' + buildCohortQualificationEditor(normalizedQualification) + '</td>' +
                '<td><div class="cohort-measure-editor">' + buildEligEditor(ne) + '</div></td>' +
                '<td><input type="number" class="form-control form-control-sm cohort-min" min="1" value="' + (rMin || 50) + '" /></td>' +
                '<td><input type="number" class="form-control form-control-sm cohort-max" min="1" value="' + (rMax || rMin || 100) + '" /></td>' +
                '<td>' + buildScenarioSelect(sel) + '</td>' +
                '<td>' + buildPatientConfigSelect(patientConfigurationId || '', intentHasOverlays(intent)) + '</td>' +
                '<td class="cohort-pattern-cell">' + buildScheduledPatternEditor(effectivePattern, normalizedQualification) + '</td>' +
                '<td class="text-center align-middle"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-cohort">&times;</button></td>';
            if (intent) tr.dataset.intentJson = JSON.stringify(intent);
            if (patientConfigurationId) tr.dataset.patientConfigurationId = patientConfigurationId;
            cohortRows.appendChild(tr);
            enforceCohortMeasureRules(tr);
            enforceDeps(tr);
            enforceCohortMeasureRules(tr);
            applyFilter(tr, readElig(tr));
            updateSummary(tr);
            syncPatientConfigLock(tr, false);
            refreshCustomizeButton(tr);
            reindex();
            syncCount();
            syncPatternColumns();
        }
        function addDefault(count, isQ, rMin, rMax) {
            var qualification = isQ ? QUALIFYING : NON_QUALIFYING;
            addCohortRow(count, defaultElig(!!isQ), null, rMin, rMax, DEFAULT_SCHEDULED_PATTERN, qualification);
        }

        function mergeIntent(under, over) {
            var out = Object.assign({}, under || {});
            Object.keys(over || {}).forEach(function (k) {
                var v = over[k];
                if (v === null || v === undefined || v === '') return;
                if (Array.isArray(v) && v.length === 0) return;
                out[k] = v;
            });
            return out;
        }
        function showPcCohortErr(msg) {
            var el = document.getElementById('pcCohortErrors');
            if (!el) return;
            el.textContent = msg || '';
            el.style.display = msg ? '' : 'none';
        }
        function closeCohortCustomize() {
            document.getElementById('pcCohortModal').style.display = 'none';
            pcCohortRow = null;
            showPcCohortErr('');
        }
        function openCohortCustomize(row) {
            if (!pcEditor || !row) return;
            pcCohortRow = row;
            var select = row.querySelector('.cohort-patient-config');
            var configId = select && select.value;
            var config = findPatientConfig(configId);
            var intent = null;
            try { intent = row.dataset.intentJson ? JSON.parse(row.dataset.intentJson) : null; } catch (_) { intent = null; }
            var banner = config
                ? 'Overlays apply on top of “' + config.name + '”. Empty fields still inherit that configuration and its story pack.'
                : 'Overlays apply on top of Quick setup. Empty fields inherit the clinical story pack.';
            pcEditor.ensureCatalog().then(function () {
                pcEditor.setMode('cohort');
                pcEditor.setReadOnly(false);
                pcEditor.setBanner(banner);
                pcEditor.populate({ intent: intent || {}, name: '' });
                var saveAs = document.getElementById('PcSaveAsName');
                if (saveAs) saveAs.value = config ? (config.name + ' (custom)') : '';
                showPcCohortErr('');
                document.getElementById('pcCohortModal').style.display = '';
            });
        }
        function applyCohortCustomize() {
            if (!pcEditor || !pcCohortRow) return;
            var intent = pcEditor.collectIntent();
            pcCohortRow.dataset.intentJson = JSON.stringify(intent);
            refreshCustomizeButton(pcCohortRow);
            closeCohortCustomize();
        }
        function saveCohortAsConfiguration() {
            if (!pcEditor || !pcCohortRow) return;
            var nameEl = document.getElementById('PcSaveAsName');
            var name = nameEl && nameEl.value ? nameEl.value.trim() : '';
            if (!name) { showPcCohortErr('Name is required to save as a configuration.'); return; }
            var select = pcCohortRow.querySelector('.cohort-patient-config');
            var configId = select && select.value;
            var overlay = pcEditor.collectIntent();
            var tokenEl = document.querySelector('#scenarioModal input[name="__RequestVerificationToken"]') || document.querySelector('input[name="__RequestVerificationToken"]');
            var headerToken = tokenEl ? tokenEl.value : '';
            function persist(mergedIntent, defaults) {
                var model = {
                    id: crypto.randomUUID(),
                    name: name,
                    description: '',
                    isSystem: false,
                    cohortQualification: (defaults && defaults.cohortQualification) || readCohortQualification(pcCohortRow),
                    measureEligibilities: (defaults && defaults.measureEligibilities) || readElig(pcCohortRow),
                    clinicalScenarioIds: (defaults && defaults.clinicalScenarioIds) || Array.prototype.map.call(pcCohortRow.querySelectorAll('.cohort-scenario-option:checked'), function (cb) { return cb.value; }),
                    resourcesPerPatientMin: parseInt((defaults && defaults.resourcesPerPatientMin) || pcCohortRow.querySelector('.cohort-min').value || '50', 10),
                    resourcesPerPatientMax: parseInt((defaults && defaults.resourcesPerPatientMax) || pcCohortRow.querySelector('.cohort-max').value || '100', 10),
                    intent: mergedIntent
                };
                return fetch(patientConfigSaveUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': headerToken },
                    body: JSON.stringify(model)
                }).then(function (r) {
                    if (!r.ok) return r.text().then(function (t) { throw new Error(t || r.statusText); });
                    return r.json().then(function (body) {
                        var id = body.id || model.id;
                        patientConfigurationCatalog.push({
                            id: id,
                            name: model.name,
                            isSystem: false,
                            clinicalScenarioIds: model.clinicalScenarioIds,
                            resourcesPerPatientMin: model.resourcesPerPatientMin,
                            resourcesPerPatientMax: model.resourcesPerPatientMax,
                            cohortQualification: model.cohortQualification,
                            measureEligibilities: model.measureEligibilities
                        });
                        Array.prototype.forEach.call(cohortRows.querySelectorAll('.cohort-patient-config'), function (sel) {
                            var opt = document.createElement('option');
                            opt.value = id;
                            opt.textContent = model.name;
                            sel.appendChild(opt);
                        });
                        select.value = id;
                        pcCohortRow.dataset.patientConfigurationId = id;
                        pcCohortRow.dataset.intentJson = '';
                        syncPatientConfigLock(pcCohortRow, true);
                        refreshCustomizeButton(pcCohortRow);
                        closeCohortCustomize();
                    });
                }).catch(function (e) { showPcCohortErr(e.message); });
            }
            if (!configId) return persist(overlay, null);
            return fetch(patientConfigGetUrl + '?id=' + encodeURIComponent(configId)).then(function (r) { return r.json(); }).then(function (cfg) {
                return persist(mergeIntent(cfg.intent || {}, overlay), cfg);
            }).catch(function (e) { showPcCohortErr(e.message); });
        }
        document.getElementById('btnPcCohortClose').addEventListener('click', closeCohortCustomize);
        document.getElementById('btnPcCohortApply').addEventListener('click', applyCohortCustomize);
        document.getElementById('btnPcCohortSaveAs').addEventListener('click', saveCohortAsConfiguration);

        function readElig(row) {
            var v = {}; row.querySelectorAll('.cohort-measure-eligibility').forEach(function (cb) { v[cb.getAttribute('data-measure')] = cb.checked ? QUALIFYING : NON_QUALIFYING; });
            return normElig(v);
        }
        function enforceDeps(row, ch) {
            var hypo = row.querySelector('.cohort-measure-eligibility[data-measure="NhsnGlycemicControlHypoglycemicInitialPopulation"]');
            var ach = row.querySelector('.cohort-measure-eligibility[data-measure="NhsnAcuteCareHospitalMonthlyInitialPopulation"]');
            if (!hypo || !ach) return;
            if (ch === 'NhsnGlycemicControlHypoglycemicInitialPopulation' && hypo.checked && !ach.checked) { ach.checked = true; return; }
            if (ch === 'NhsnAcuteCareHospitalMonthlyInitialPopulation' && !ach.checked && hypo.checked) { hypo.checked = false; return; }
            if (hypo.checked && !ach.checked) ach.checked = true;
        }
        function enforceCohortMeasureRules(row, changedMeasure) {
            var qualification = readCohortQualification(row);
            var boxes = Array.prototype.slice.call(row.querySelectorAll('.cohort-measure-eligibility'));
            if (!boxes.length) return;

            if (qualification === NON_QUALIFYING) {
                boxes.forEach(function (cb) { cb.checked = false; cb.disabled = true; });
                return;
            }

            boxes.forEach(function (cb) { cb.disabled = false; });

            if (boxes.length === 1) {
                boxes[0].checked = true;
                boxes[0].disabled = true;
                return;
            }

            var checked = boxes.filter(function (cb) { return cb.checked; });
            if (!checked.length) {
                var fallback = changedMeasure
                    ? row.querySelector('.cohort-measure-eligibility[data-measure="' + changedMeasure + '"]')
                    : null;
                (fallback || boxes[0]).checked = true;
            }
        }
        function rerenderEditor(row) {
            var ed = row.querySelector('.cohort-measure-editor'); if (!ed) return;
            ed.innerHTML = buildEligEditor(readElig(row));
            enforceCohortMeasureRules(row);
            enforceDeps(row);
            applyFilter(row, readElig(row));
        }
        function applyFilter(row, elig) {
            // Story pack is independent of Q/NQ. Qualification drives prediction, not which
            // clinical stories are available (otherwise ACH NQ had an empty picker).
            updateSummary(row);
        }

        function updateSummary(row) {
            var dd = row.querySelector('.cohort-scenarios-dropdown');
            if (!dd) return;

            var toggle = dd.querySelector('.cohort-scenarios-toggle');
            var all = dd.querySelectorAll('.cohort-scenario-option:not(:disabled)');
            var sel = dd.querySelectorAll('.cohort-scenario-option:checked:not(:disabled)');

            toggle.textContent =
                !all.length || !sel.length
                    ? 'None'
                    : sel.length === all.length
                        ? 'All'
                        : sel.length + ' selected';
        }

        function reindex() { Array.prototype.forEach.call(cohortRows.children, function (r, i) { r.querySelector('td:first-child').textContent = i + 1; }); }
        
        function syncCount() {
            var t = getCohorts().reduce(function (s, c) { return s + (c.patientCount || 0); }, 0);
            var importedCount = importedRows ? importedRows.children.length : 0;
            document.getElementById('PatientCount').value = (t + importedCount) > 0 ? (t + importedCount) : 0;
        }
        function getCohorts() {
            return Array.prototype.map.call(cohortRows.children, function (row) {
                var min = parseInt(row.querySelector('.cohort-min').value || '50', 10);
                var max = parseInt(row.querySelector('.cohort-max').value || String(min), 10);
                if (max < min) { max = min; row.querySelector('.cohort-max').value = String(max); }
                var patternSelect = row.querySelector('.cohort-scheduled-pattern');
                var qualification = readCohortQualification(row);
                var configSelect = row.querySelector('.cohort-patient-config');
                var intent = null;
                try { intent = row.dataset.intentJson ? JSON.parse(row.dataset.intentJson) : null; } catch (_) { intent = null; }
                return {
                    patientCount: parseInt(row.querySelector('.cohort-count').value || '0', 10),
                    cohortQualification: qualification,
                    measureEligibilities: readElig(row),
                    eligibleClinicalScenarioIds: Array.prototype.map.call(row.querySelectorAll('.cohort-scenario-option:checked:not(:disabled)'), function (cb) { return sid(cb.value); }).filter(Boolean),
                    resourcesPerPatientMin: min, resourcesPerPatientMax: max,
                    scheduledInpatientPattern: normalizeScheduledPattern(patternSelect ? patternSelect.value : DEFAULT_SCHEDULED_PATTERN),
                    patientConfigurationId: configSelect && configSelect.value ? configSelect.value : null,
                    intent: intent
                };
            }).filter(function (c) { return c.patientCount > 0; });
        }

        // ---- Cohort event handlers ----
        document.getElementById('addQualifyingCohort').addEventListener('click', function () { addDefault(10, true, 50, 100); });
        document.getElementById('addNonQualifyingCohort').addEventListener('click', function () { addDefault(10, false, 50, 100); });
        cohortRows.addEventListener('click', function (e) {
            var row = e.target.closest('tr');
            if (!row) return;

            if (e.target.closest('.btn-remove-cohort')) {
                row.remove();
                reindex();
                syncCount();
                return;
            }

            var customize = e.target.closest('.btn-cohort-customize');
            if (customize) {
                openCohortCustomize(row);
                return;
            }

            if (e.target.closest('.cohort-scenarios-select-all')) {
                row.querySelectorAll('.cohort-scenario-option:not(:disabled)')
                    .forEach(function (cb) {
                        cb.checked = true;
                    });
                updateSummary(row);
                return;
            }

            if (e.target.closest('.cohort-scenarios-deselect-all')) {
                row.querySelectorAll('.cohort-scenario-option:not(:disabled)')
                    .forEach(function (cb) {
                        cb.checked = false;
                    });
                updateSummary(row);
            }
        });
        cohortRows.addEventListener('change', function (e) {
            if (e.target.classList.contains('cohort-measure-eligibility')) {
                var r1 = e.target.closest('tr');
                enforceCohortMeasureRules(r1, e.target.getAttribute('data-measure'));
                enforceDeps(r1, e.target.getAttribute('data-measure'));
                enforceCohortMeasureRules(r1, e.target.getAttribute('data-measure'));
                applyFilter(r1, readElig(r1));
            }
            if (e.target.classList.contains('cohort-qualification')) {
                var r2 = e.target.closest('tr');
                enforceCohortMeasureRules(r2);
                enforceDeps(r2);
                enforceCohortMeasureRules(r2);
                applyFilter(r2, readElig(r2));
                syncScheduledPatternEditorForRow(r2);
            }
            if (e.target.classList.contains('cohort-scenario-option')) updateSummary(e.target.closest('tr'));
            if (e.target.classList.contains('cohort-count')) syncCount();
            if (e.target.classList.contains('cohort-patient-config')) {
                var r3 = e.target.closest('tr');
                r3.dataset.intentJson = '';
                if (e.target.value) r3.dataset.patientConfigurationId = e.target.value;
                else delete r3.dataset.patientConfigurationId;
                syncPatientConfigLock(r3, true);
                refreshCustomizeButton(r3);
            }
        });
        cohortRows.addEventListener('input', function () { syncCount(); });
        document.querySelectorAll('.measure-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () { Array.prototype.forEach.call(cohortRows.children, function (r) { rerenderEditor(r); }); });
        });
        document.getElementById('ReportMethod').addEventListener('change', function () {
            syncPatternColumns();
            syncReportPeriodPolicyUi();
            syncLiveSimulationUi();
        });
        document.getElementById('IsLiveSimulation').addEventListener('change', function () {
            syncLiveSimulationUi();
            syncReportPeriodPolicyUi();
        });
        document.getElementById('IsMetricsRun').addEventListener('change', function () {
            syncMetricsRunUi();
        });
        var reportingWindowEl = document.getElementById('ReportingWindowMinutes');
        if (reportingWindowEl) {
            reportingWindowEl.addEventListener('change', function () {
                if (isScheduledLikeMethod()) syncReportPeriodPolicyUi();
            });
        }

        function syncLiveSimulationUi() {
            var fields = document.getElementById('liveSimulationFields');
            var options = document.getElementById('liveSimulationOptions');
            var liveToggle = document.getElementById('IsLiveSimulation');
            if (!fields || !options || !liveToggle) return;
            var scheduled = (document.getElementById('ReportMethod').value || '') === 'ScheduledReport';
            fields.style.display = scheduled ? '' : 'none';
            if (!scheduled) liveToggle.checked = false;
            options.style.display = liveToggle.checked ? '' : 'none';
        }

        function syncMetricsRunUi() {
            var options = document.getElementById('metricsRunOptions');
            var toggle = document.getElementById('IsMetricsRun');
            if (!options || !toggle) return;
            options.style.display = toggle.checked ? '' : 'none';
        }

        function parseOptionalInt(value) {
            if (value == null || String(value).trim() === '') return null;
            var n = parseInt(value, 10);
            return isNaN(n) ? null : n;
        }

        // ---- Imported Patients ----
        var importedRows = document.getElementById('importedRows');
        var importedSummary = document.getElementById('importedSummary');
        var importedUploadStatus = document.getElementById('importedUploadStatus');

        function setImportedUploadStatus(message, isBusy) {
            if (!importedUploadStatus) return;
            if (!message) {
                importedUploadStatus.style.display = 'none';
                importedUploadStatus.textContent = '';
                importedUploadStatus.className = 'small text-muted';
                return;
            }

            importedUploadStatus.style.display = '';
            importedUploadStatus.textContent = (isBusy ? '⏳ ' : '') + message;
            importedUploadStatus.className = isBusy ? 'small text-primary' : 'small text-muted';
        }

        function hasImportedRows() {
            return importedRows && importedRows.children && importedRows.children.length > 0;
        }

        function isScheduledLikeMethod() {
            var method = (document.getElementById('ReportMethod').value || '').trim();
            // Regenerated reports are Adhoc in Report, but this Automation scenario first
            // produces a Scheduled source report (short window + census), then regenerates.
            return method === 'ScheduledReport' || method === 'RegenerateReport';
        }

        function scheduledWindowExtraMinutes() {
            var liveToggle = document.getElementById('IsLiveSimulation');
            if (liveToggle && liveToggle.checked) {
                var raw = parseInt((document.getElementById('ReportingWindowMinutes') || {}).value || '10', 10);
                return isNaN(raw) || raw <= 0 ? 10 : raw;
            }
            // Keep in sync with ReportExecution.NonLiveScheduledCloseMinutes.
            return 2;
        }

        function formatUtcDateInput(d) {
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate());
        }

        function computeScheduledEndUtc() {
            return new Date(Date.now() + scheduledWindowExtraMinutes() * 60000);
        }

        function applyScheduledEndLock() {
            var endEl = document.getElementById('ReportPeriodEnd');
            if (!endEl) return;
            endEl.value = formatUtcDateInput(computeScheduledEndUtc());
        }

        function ensureScheduledStartDefault() {
            var startEl = document.getElementById('ReportPeriodStart');
            if (!startEl || (startEl.value || '').trim()) return;
            var start = new Date(Date.now());
            start.setUTCDate(start.getUTCDate() - 5);
            startEl.value = formatUtcDateInput(start);
        }

        function syncReportPeriodPolicyUi() {
            var startEl = document.getElementById('ReportPeriodStart');
            var endEl = document.getElementById('ReportPeriodEnd');
            var hintEl = document.getElementById('reportPeriodPolicyHint');
            if (!startEl || !endEl || !hintEl) return;

            var scheduledLike = isScheduledLikeMethod();

            if (!scheduledLike) {
                startEl.disabled = false;
                endEl.disabled = false;
                startEl.required = false;
                endEl.required = false;
                hintEl.textContent = 'Optional. When empty, default period behavior is used for this run type.';
                return;
            }

            ensureScheduledStartDefault();
            applyScheduledEndLock();
            startEl.disabled = false;
            endEl.disabled = true;
            startEl.required = false;
            endEl.required = false;
            var extra = scheduledWindowExtraMinutes();
            var live = !!(document.getElementById('IsLiveSimulation') || {}).checked;
            hintEl.textContent = live
                ? ('End is locked to today plus the live inject window (' + extra + ' minutes). Start is editable. Importing a patient whose data is entirely outside this window will ask to push Start back; End never moves.')
                : ('End is locked to today plus the scheduled close window (' + extra + ' minutes). Start is editable. Importing a patient whose data is entirely outside this window will ask to push Start back; End never moves.');
        }

        // Adhoc: fill empty start/end from encounter dates (month snap, never overwrite).
        // Scheduled: if the encounter range is entirely outside the locked window, ask to
        // push Start back to the earliest encounter day. End stays locked.
        function suggestPeriodFromEncounter(encStartIso, encEndIso) {
            var startEl = document.getElementById('ReportPeriodStart');
            var endEl = document.getElementById('ReportPeriodEnd');
            if (!startEl || !endEl) return;

            if (isScheduledLikeMethod()) {
                offerToExtendScheduledStart(encStartIso, encEndIso);
                return;
            }

            var hasStart = !!(startEl.value || '').trim();
            var hasEnd = !!(endEl.value || '').trim();
            if (hasStart && hasEnd) return;

            var s = encStartIso ? new Date(encStartIso) : null;
            var e = encEndIso ? new Date(encEndIso) : s;
            if (!s && !e) return;
            if (!s) s = e;
            if (!e) e = s;

            var monthStart = new Date(Date.UTC(s.getUTCFullYear(), s.getUTCMonth(), 1));
            var monthEnd = new Date(Date.UTC(e.getUTCFullYear(), e.getUTCMonth() + 1, 0));

            if (!hasStart) startEl.value = formatUtcDateInput(monthStart);
            if (!hasEnd) endEl.value = formatUtcDateInput(monthEnd);
        }

        function offerToExtendScheduledStart(encStartIso, encEndIso) {
            ensureScheduledStartDefault();
            applyScheduledEndLock();
            var startEl = document.getElementById('ReportPeriodStart');
            if (!startEl) return;

            var status = compareEncounterToPeriod(encStartIso, encEndIso);
            if (status === 'overlap' || status === 'unknown') return;

            if (status === 'outside-after') {
                showWarning('Imported patient data starts after the locked report end (' +
                    (document.getElementById('ReportPeriodEnd').value || 'today') +
                    '). End is not moved. This patient will stay outside the reporting window.');
                return;
            }

            var encS = encStartIso ? new Date(encStartIso) : null;
            if (!encS || isNaN(encS.getTime())) return;
            var proposed = formatUtcDateInput(encS);
            var current = (startEl.value || '').trim();
            if (current && proposed >= current) return;

            var endVal = (document.getElementById('ReportPeriodEnd').value || '').trim();
            var msg = 'This patient\'s data is entirely before the current report period'
                + (current ? ' (starts ' + current + ')' : '')
                + '. Push Report Start back to ' + proposed
                + ' so the patient is inside the window? End stays '
                + (endVal || 'locked') + '.';
            if (!window.confirm(msg)) return;

            startEl.value = proposed;
            rerenderImportedEncounterCells();
        }

        function importedRowEligEditor(elig) {
            var sel = selectedMeasureTypes();
            if (!sel.length) return '<span class="text-muted small">Select measures</span>';
            return sel.map(function (m) {
                var cb = measureCheckboxForFamily(m);
                var lbl = cb ? (document.querySelector('label[for="' + cb.id + '"]') || { textContent: m }).textContent : m;
                var cur = (elig && Object.prototype.hasOwnProperty.call(elig, m)) ? elig[m] : NON_QUALIFYING;
                return '<div class="form-check form-check-inline me-2 mb-1"><input class="form-check-input imp-elig" type="checkbox" data-measure="' + m + '" ' + (cur === QUALIFYING ? 'checked' : '') + ' /><label class="form-check-label small">' + esc(lbl) + '</label></div>';
            }).join('');
        }
        function readImportedElig(row) {
            var v = {};
            row.querySelectorAll('.imp-elig').forEach(function (cb) {
                v[cb.getAttribute('data-measure')] = cb.checked ? QUALIFYING : NON_QUALIFYING;
            });
            // Make sure every selected measure has an explicit entry.
            selectedMeasureTypes().forEach(function (m) { if (!Object.prototype.hasOwnProperty.call(v, m)) v[m] = NON_QUALIFYING; });
            return v;
        }
        function updateImportedSummary() {
            var rows = importedRows.children;
            if (!rows.length) {
                importedSummary.textContent = '';
            } else {
                var qCount = 0;
                Array.prototype.forEach.call(rows, function (r) {
                    var elig = readImportedElig(r);
                    var any = selectedMeasureTypes().some(function (m) { return elig[m] === QUALIFYING; });
                    if (any) qCount++;
                });
                importedSummary.textContent = '(' + rows.length + ' total, ' + qCount + ' Q / ' + (rows.length - qCount) + ' NQ)';
            }
            // Imported rows feed the total Patient Count alongside cohort sums, so any change
            // to the imported list must re-sync the read-only Patient Count field.
            syncCount();
            syncReportPeriodPolicyUi();
        }
        function reindexImported() {
            Array.prototype.forEach.call(importedRows.children, function (r, i) { r.querySelector('td:first-child').textContent = i + 1; });
        }
        function rerenderImportedEligEditors() {
            Array.prototype.forEach.call(importedRows.children, function (r) {
                var elig = readImportedElig(r);
                var ed = r.querySelector('.imp-elig-editor');
                if (ed) ed.innerHTML = importedRowEligEditor(elig);
            });
            updateImportedSummary();
        }
        function addImportedRow(row) {
            // row = { source, patientId, fileName, bundleJson, autoDetect, measureEligibilities, detectedClinicalScenarioId, encounterStart, encounterEnd }
            var elig = row.measureEligibilities || {};
            var orgId = (row.organizationId || '').trim();
            var organizationConflict = Array.isArray(row.organizationIds) && row.organizationIds.length > 1;
            var organizationConflictMessage = organizationConflict
                ? 'Uploaded bundle contains multiple Organization ids (' + row.organizationIds.join(', ') + '). Only one Organization id is supported per uploaded patient.'
                : '';

            if (!orgId && row.source === 'Bundle' && row.bundleJson) {
                try {
                    var parsedBundle = JSON.parse(row.bundleJson);
                    var orgIds = (parsedBundle && parsedBundle.entry || [])
                        .map(function (e) { return e && e.resource; })
                        .filter(function (r) { return r && r.resourceType === 'Organization' && (r.id || '').trim(); })
                        .map(function (r) { return String(r.id).trim(); });
                    var uniqueOrgIds = Array.from(new Set(orgIds));
                    if (uniqueOrgIds.length === 1) orgId = uniqueOrgIds[0];
                    if (uniqueOrgIds.length > 1) {
                        organizationConflict = true;
                        organizationConflictMessage = 'Uploaded bundle contains multiple Organization ids (' + uniqueOrgIds.join(', ') + '). Only one Organization id is supported per uploaded patient.';
                    }
                } catch (_) { }
            }

            var sourceLabel = row.source === 'Bundle'
                ? '<span class="badge bg-info text-dark"><i class="bi bi-file-earmark-arrow-up me-1"></i>Bundle</span>'
                : '<span class="badge bg-secondary"><i class="bi bi-cloud-arrow-down me-1"></i>By ID</span>';
            var fileLabel = row.source === 'Bundle' && row.fileName ? '<div class="small text-muted">' + esc(row.fileName) + '</div>' : '';
            var detectBtn = '<button type="button" class="btn btn-sm btn-outline-secondary btn-detect-imported" title="Re-run auto-detection"><i class="bi bi-magic"></i></button>';
            var tr = document.createElement('tr');
            tr.dataset.source = row.source || 'ExistingId';
            tr.dataset.uploadedBundleId = row.uploadedBundleId || '';
            tr.dataset.bundleJson = row.bundleJson || '';
            tr.dataset.fileName = row.fileName || '';
            tr.dataset.detectedClinicalScenarioId = row.detectedClinicalScenarioId || '';
            tr.dataset.autoDetect = String(row.autoDetect !== false);
            tr.dataset.encounterStart = row.encounterStart || '';
            tr.dataset.encounterEnd = row.encounterEnd || '';
            tr.dataset.organizationId = orgId;
            tr.dataset.organizationConflict = organizationConflict ? 'true' : 'false';
            tr.dataset.organizationConflictMessage = organizationConflictMessage;
            tr.innerHTML =
                '<td class="text-center align-middle">' + (importedRows.children.length + 1) + '</td>' +
                '<td class="align-middle">' + sourceLabel + '</td>' +
                '<td class="align-middle"><input type="text" class="form-control form-control-sm imp-pid" maxlength="128" value="' + escAttr(row.patientId || '') + '" ' + (row.source === 'Bundle' ? 'readonly' : '') + ' />' + fileLabel + '</td>' +
                '<td><div class="imp-elig-editor">' + importedRowEligEditor(elig) + '</div></td>' +
                '<td class="imp-encounter-cell align-middle small"></td>' +
                '<td class="align-middle text-center">' + detectBtn + '</td>' +
                '<td class="text-center align-middle"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-imported">&times;</button></td>';
            importedRows.appendChild(tr);
            renderImportedEncounterCell(tr);
            reindexImported();
            updateImportedSummary();
            syncNhsnOrganizationFromUploadedPatients();
        }

        // Renders the encounter-dates cell with an in/out-of-period indicator. Called whenever
        // the row's encounter dates change OR the Report Period inputs change.
        function renderImportedEncounterCell(row) {
            var cell = row.querySelector('.imp-encounter-cell');
            if (!cell) return;
            var s = row.dataset.encounterStart || '';
            var e = row.dataset.encounterEnd || '';
            if (!s && !e) { cell.innerHTML = '<span class="text-muted">unknown</span>'; return; }

            function fmt(iso) {
                if (!iso) return '?';
                var d = new Date(iso);
                if (isNaN(d.getTime())) return iso;
                function pad(n) { return n < 10 ? '0' + n : '' + n; }
                return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate());
            }

            var label = fmt(s) + (e && e !== s ? ' &rarr; ' + fmt(e) : '');
            var status = compareEncounterToPeriod(s, e);
            var badge = status === 'overlap'
                ? '<span class="badge rounded-pill au-badge-success mt-1 px-2 py-1" title="Encounter overlaps the report period">&#10003; overlaps period</span>'
                : status === 'outside-before'
                    ? '<span class="badge rounded-pill au-badge-warning mt-1 px-2 py-1" title="Encounter ends before report period start">&#9888; before period</span>'
                    : status === 'outside-after'
                        ? '<span class="badge rounded-pill au-badge-warning mt-1 px-2 py-1" title="Encounter starts after report period end">&#9888; after period</span>'
                        : '';
            cell.innerHTML = '<div>' + label + '</div>' + (badge ? '<div>' + badge + '</div>' : '');
        }

        function compareEncounterToPeriod(encStartIso, encEndIso) {
            var ps = (document.getElementById('ReportPeriodStart').value || '').trim();
            var pe = (document.getElementById('ReportPeriodEnd').value || '').trim();
            if (!ps && !pe) return 'unknown';
            var encS = encStartIso ? new Date(encStartIso) : null;
            var encE = encEndIso ? new Date(encEndIso) : null;
            if (!encS) return 'unknown';
            var pStart = ps ? new Date(ps + 'T00:00:00Z') : null;
            var pEnd = pe ? new Date(pe + 'T23:59:59Z') : null;

            // Overlap semantics:
            // - Outside-before: encounter has a known end that is before period start.
            // - Outside-after: encounter starts after period end.
            // - Otherwise overlap/possibly-overlap (including in-progress with no end).
            if (pStart && encE && encE < pStart) return 'outside-before';
            if (pEnd && encS > pEnd) return 'outside-after';
            return 'overlap';
        }

        function rerenderImportedEncounterCells() {
            Array.prototype.forEach.call(importedRows.children, function (r) { renderImportedEncounterCell(r); });
        }

        async function classifyImportedRow(row) {
            var pid = (row.querySelector('.imp-pid').value || '').trim();
            var src = row.dataset.source;
            if (src === 'ExistingId' && !pid) { showError('Patient ID is required to classify.'); return; }
            try {
                var body = {
                    source: src,
                    patientId: pid,
                    bundleJson: src === 'Bundle' && !row.dataset.uploadedBundleId ? row.dataset.bundleJson : null,
                    uploadedBundleId: src === 'Bundle' && row.dataset.uploadedBundleId ? row.dataset.uploadedBundleId : null,
                    measures: selectedMeasureTypes()
                };
                var res = await postJson(classifyImportedUrl, body);
                if (res && res.measureEligibilities) {
                    // Rebuild the eligibility editor with returned values.
                    var ed = row.querySelector('.imp-elig-editor');
                    ed.innerHTML = importedRowEligEditor(res.measureEligibilities);
                    if (res.detectedClinicalScenarioId) row.dataset.detectedClinicalScenarioId = res.detectedClinicalScenarioId;
                    if (src === 'ExistingId' && res.patientId && !pid) row.querySelector('.imp-pid').value = res.patientId;
                    row.dataset.autoDetect = 'true';
                    if (res.encounterStart) row.dataset.encounterStart = res.encounterStart;
                    if (res.encounterEnd) row.dataset.encounterEnd = res.encounterEnd;
                    if (res.encounterStart || res.encounterEnd) {
                        suggestPeriodFromEncounter(res.encounterStart, res.encounterEnd);
                    }
                    var orgIds = Array.isArray(res.organizationIds) ? res.organizationIds : [];
                    row.dataset.organizationConflict = orgIds.length > 1 ? 'true' : 'false';
                    row.dataset.organizationConflictMessage = orgIds.length > 1
                        ? ('Imported patient classification found multiple Organization ids (' + orgIds.join(', ') + ').')
                        : '';
                    row.dataset.organizationId = orgIds.length === 1
                        ? String(orgIds[0] || '').trim()
                        : (res.organizationId ? String(res.organizationId).trim() : '');
                    renderImportedEncounterCell(row);
                    updateImportedSummary();
                    syncNhsnOrganizationFromUploadedPatients();
                }
            } catch (err) {
                showError('Classification failed: ' + (err.message || 'Unknown error'));
            }
        }

        document.getElementById('btnAddImportedById').addEventListener('click', async function () {
            var input = document.getElementById('newImportedPatientId');
            var pid = (input.value || '').trim();
            if (!pid) { showError('Enter a Patient ID first.'); return; }
            addImportedRow({ source: 'ExistingId', patientId: pid, autoDetect: true, measureEligibilities: {} });
            input.value = '';
            // Best-effort auto-classify the new row.
            var row = importedRows.lastElementChild;
            if (row) await classifyImportedRow(row);
        });

        document.getElementById('importedBundleFile').addEventListener('change', async function (ev) {
            var files = Array.prototype.slice.call(ev.target.files || []);
            var allImportedCleanly = files.length > 0;
            var lastSpecialOutcomeMessage = '';

            async function tryDiscardUploadedBundle(uploadedBundleId, fileName, contextLabel) {
                try {
                    await postJson(discardUploadedBundleUrl, {
                        uploadedBundleId: uploadedBundleId
                    });
                    return true;
                } catch (discardErr) {
                    var discardMessage = 'Failed to discard uploaded bundle for "' + fileName + '" after ' + contextLabel + ': ' + (discardErr.message || 'Unknown error');
                    showError(discardMessage);
                    setImportedUploadStatus(discardMessage, false);
                    lastSpecialOutcomeMessage = discardMessage;
                    allImportedCleanly = false;
                    return false;
                }
            }

            if (files.length > 0) {
                setImportedUploadStatus('Uploading and classifying ' + files.length + ' file(s)...', true);
            }
            for (var i = 0; i < files.length; i++) {
                var file = files[i];
                try {
                    setImportedUploadStatus('Processing "' + file.name + '" (' + (i + 1) + '/' + files.length + ')...', true);
                    var fd = new FormData();
                    fd.append('file', file);
                    var uploaded = await postForm(uploadImportedBundleUrl, fd);

                    if (uploaded && uploaded.patientExistsOnServer && uploaded.bundleId && uploaded.patientId) {
                        var decision = await promptReplaceFhirPatient(
                            uploaded.patientId,
                            !!uploaded.canUseServerData,
                            !!uploaded.requiresReplaceForLargePatient);

                        if (decision === 'cancel') {
                            var discardedAfterCancel = await tryDiscardUploadedBundle(uploaded.bundleId, file.name, 'canceling replacement choice');
                            if (!discardedAfterCancel) {
                                continue;
                            }
                            lastSpecialOutcomeMessage = 'Skipped import for "' + file.name + '" because no action was selected.';
                            setImportedUploadStatus(lastSpecialOutcomeMessage, false);
                            allImportedCleanly = false;
                            continue;
                        }

                        if (decision === 'use-server') {
                            var discardedForServerUse = await tryDiscardUploadedBundle(uploaded.bundleId, file.name, 'choosing "Use FHIR Server Data"');
                            if (!discardedForServerUse) {
                                continue;
                            }

                            addImportedRow({ source: 'ExistingId', patientId: uploaded.patientId, autoDetect: true, measureEligibilities: {} });
                            var serverRow = importedRows.lastElementChild;
                            if (serverRow) await classifyImportedRow(serverRow);
                            lastSpecialOutcomeMessage = 'Imported Patient/' + uploaded.patientId + ' from FHIR server data.';
                            setImportedUploadStatus(lastSpecialOutcomeMessage, false);
                            allImportedCleanly = false;
                            continue;
                        }

                        if (decision === 'replace') {
                            allImportedCleanly = false;
                            setImportedUploadStatus('Replacing FHIR-server data for Patient/' + uploaded.patientId + '...', true);
                            try {
                                var replaceRes = await postJson(replacePatientOnFhirServerUrl, {
                                    uploadedBundleId: uploaded.bundleId,
                                    patientId: uploaded.patientId
                                });
                                if (!replaceRes || !replaceRes.statusUrl) {
                                    throw new Error('FHIR-server replacement did not return a status endpoint.');
                                }

                                var replacementStatus = await waitForPatientReplacement(replaceRes.statusUrl, uploaded.patientId);
                                lastSpecialOutcomeMessage = replacementStatus.message || 'Successfully replaced FHIR-server data for Patient/' + uploaded.patientId + '.';
                                if (replacementStatus.deletedFailed > 0) {
                                    showWarning('FHIR purge completed with ' + replacementStatus.deletedFailed + ' failed delete request(s).');
                                }
                                if (lastSpecialOutcomeMessage) {
                                    setImportedUploadStatus(lastSpecialOutcomeMessage, false);
                                }
                            } catch (replaceErr) {
                                var replaceMessage = 'Failed to replace FHIR-server patient data for "' + uploaded.patientId + '": ' + (replaceErr.message || 'Unknown error');
                                showError(replaceMessage);
                                setImportedUploadStatus(replaceMessage, false);
                                lastSpecialOutcomeMessage = replaceMessage;
                                await tryDiscardUploadedBundle(uploaded.bundleId, file.name, 'replace failure');
                                continue;
                            }
                        }
                    }

                    if (uploaded && uploaded.warningMessage && !uploaded.patientExistsOnServer) {
                        showWarning(uploaded.warningMessage);
                    }

                    addImportedRow({
                        source: 'Bundle',
                        patientId: uploaded && uploaded.patientId ? uploaded.patientId : '',
                        fileName: uploaded && uploaded.fileName ? uploaded.fileName : file.name,
                        uploadedBundleId: uploaded && uploaded.bundleId ? uploaded.bundleId : null,
                        organizationId: uploaded && uploaded.organizationId ? uploaded.organizationId : null,
                        organizationIds: uploaded && uploaded.organizationIds ? uploaded.organizationIds : [],
                        bundleJson: null,
                        autoDetect: true,
                        measureEligibilities: {},
                        encounterStart: null,
                        encounterEnd: null
                    });
                    var row = importedRows.lastElementChild;
                    if (row) await classifyImportedRow(row);
                } catch (err) {
                    var readMessage = 'Failed to read "' + file.name + '": ' + (err.message || 'Unknown error');
                    showError(readMessage);
                    setImportedUploadStatus(readMessage, false);
                    lastSpecialOutcomeMessage = readMessage;
                    allImportedCleanly = false;
                }
            }

            if (files.length > 0) {
                if (!allImportedCleanly && lastSpecialOutcomeMessage) {
                    setImportedUploadStatus(lastSpecialOutcomeMessage, false);
                } else {
                    setImportedUploadStatus('Completed upload processing for ' + files.length + ' file(s). Use Suggest from patient data to build location matching and cleanup from this upload.', false);
                }
            }
            ev.target.value = '';
        });

        importedRows.addEventListener('click', function (e) {
            var rm = e.target.closest('.btn-remove-imported');
            if (rm) { rm.closest('tr').remove(); reindexImported(); updateImportedSummary(); syncNhsnOrganizationFromUploadedPatients(); return; }
            var det = e.target.closest('.btn-detect-imported');
            if (det) { classifyImportedRow(det.closest('tr')); return; }
        });
        importedRows.addEventListener('change', function (e) {
            if (e.target.classList.contains('imp-elig')) {
                // User override — turn off auto-detect implicitly.
                e.target.closest('tr').dataset.autoDetect = 'false';
                updateImportedSummary();
            }
        });

        function getImportedPatients() {
            return Array.prototype.map.call(importedRows.children, function (r) {
                return {
                    source: r.dataset.source || 'ExistingId',
                    patientId: (r.querySelector('.imp-pid').value || '').trim(),
                    fileName: r.dataset.fileName || null,
                    uploadedBundleId: r.dataset.source === 'Bundle' ? (r.dataset.uploadedBundleId || null) : null,
                    bundleJson: r.dataset.source === 'Bundle' && !r.dataset.uploadedBundleId ? (r.dataset.bundleJson || null) : null,
                    autoDetect: r.dataset.autoDetect !== 'false',
                    measureEligibilities: readImportedElig(r),
                    detectedClinicalScenarioId: r.dataset.detectedClinicalScenarioId || null
                };
            });
        }

        // Re-render imported eligibility editors when measure selection changes (parallels cohorts).
        document.querySelectorAll('.measure-checkbox').forEach(function (cb) {
            cb.addEventListener('change', rerenderImportedEligEditors);
        });

        // Recompute the in/out-of-period indicator on every imported row whenever the
        // Report Period inputs change (so the user gets immediate feedback when adjusting it).
        ['ReportPeriodStart', 'ReportPeriodEnd'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('change', function () {
                if (isScheduledLikeMethod()) {
                    applyScheduledEndLock();
                    var startEl = document.getElementById('ReportPeriodStart');
                    var endEl = document.getElementById('ReportPeriodEnd');
                    if (startEl && endEl && startEl.value && endEl.value && startEl.value > endEl.value) {
                        showWarning('Report Start cannot be after the locked End. Start was set to End.');
                        startEl.value = endEl.value;
                    }
                }
                rerenderImportedEncounterCells();
            });
        });

        // ---- Collect form into JSON payload ----
        function collectModel() {
            var cohorts = getCohorts();
            var imported = getImportedPatients();
            var importedIds = imported.filter(function (p) { return p.source === 'ExistingId'; });
            var importedBundles = imported.filter(function (p) { return p.source === 'Bundle'; });
            if (isScheduledLikeMethod()) applyScheduledEndLock();
            var startVal = (document.getElementById('ReportPeriodStart').value || '').trim();
            var endVal = (document.getElementById('ReportPeriodEnd').value || '').trim();
            return {
                id: idInput.value || null,
                name: document.getElementById('ScenarioName').value,
                description: document.getElementById('ScenarioDescription').value,
                isSystemScenario: false,
                reportMethod: document.getElementById('ReportMethod').value,
                selectedMeasures: selectedMeasureTypes(),
                selectedMeasureIds: selectedMeasureIds(),
                seed: parseInt(document.getElementById('Seed').value || '20260329', 10),
                // Submit the cohort-only sum (NOT the displayed total). The runtime uses
                // patientCount as a fallback cohort-generation target when no cohorts are
                // configured; including imported patients here would inflate that fallback.
                patientCount: cohorts.reduce(function (s, c) { return s + (c.patientCount || 0); }, 0),
                patientCohorts: cohorts,
                nhsnOrganizationId: (document.getElementById('NhsnOrganizationId').value || '').trim(),
                cleanupServiceData: document.getElementById('CleanupServiceData').checked,
                cleanupFhirData: document.getElementById('CleanupFhirData').checked,
                queryPlanTemplateId: document.getElementById('QueryPlanTemplate').value || null,
                normalizationSuiteId: document.getElementById('NormalizationSuite').value || null,
                organizationResourceMapTemplateId: document.getElementById('OrganizationResourceMap').value || null,
                reportPeriodStart: startVal ? (startVal + 'T00:00:00Z') : null,
                reportPeriodEnd: endVal ? (endVal + 'T23:59:59Z') : null,
                importedPatientIds: importedIds,
                importedPatientBundles: importedBundles,
                isLiveSimulation: !!document.getElementById('IsLiveSimulation').checked,
                reportingWindowMinutes: parseInt(document.getElementById('ReportingWindowMinutes').value || '10', 10),
                isMetricsRun: !!document.getElementById('IsMetricsRun').checked,
                benchmarkKey: (document.getElementById('BenchmarkKey').value || '').trim() || null,
                targetDurationSeconds: parseOptionalInt(document.getElementById('TargetDurationSeconds').value),
                concurrency: parseOptionalInt(document.getElementById('Concurrency').value),
                failRunOnBenchmark: !!document.getElementById('FailRunOnBenchmark').checked
            };
        }

        // ---- Populate form from JSON ----
        function populate(data) {
            idInput.value = data.id || '';
            isSystemInput.value = data.isSystemScenario ? 'true' : 'false';
            document.getElementById('ScenarioName').value = data.name || '';
            document.getElementById('ScenarioDescription').value = data.description || '';
            document.getElementById('ReportMethod').value = data.reportMethod || 'Adhoc';
            document.getElementById('IsLiveSimulation').checked = !!data.isLiveSimulation;
            document.getElementById('ReportingWindowMinutes').value = String(data.reportingWindowMinutes || 10);
            document.getElementById('IsMetricsRun').checked = !!data.isMetricsRun;
            document.getElementById('BenchmarkKey').value = data.benchmarkKey || '';
            document.getElementById('TargetDurationSeconds').value = data.targetDurationSeconds != null ? String(data.targetDurationSeconds) : '';
            document.getElementById('Concurrency').value = data.concurrency != null ? String(data.concurrency) : '';
            document.getElementById('FailRunOnBenchmark').checked = !!data.failRunOnBenchmark;
            document.getElementById('Seed').value = data.seed || 20260329;
            document.getElementById('CleanupFhirData').checked = data.cleanupFhirData !== false;
            document.getElementById('CleanupServiceData').checked = !!data.cleanupServiceData;
            document.getElementById('NhsnOrganizationId').value = (data.nhsnOrganizationId || '').trim() || generateRandomNhsnOrganizationId();
            // Report Period (yyyy-MM-dd from any ISO-ish input the server returns).
            function isoToDateValue(s) {
                if (!s) return '';
                var d = new Date(s);
                if (isNaN(d.getTime())) return '';
                function pad(n) { return n < 10 ? '0' + n : '' + n; }
                return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate());
            }
            document.getElementById('ReportPeriodStart').value = isoToDateValue(data.reportPeriodStart);
            document.getElementById('ReportPeriodEnd').value = isoToDateValue(data.reportPeriodEnd);
            var qp = document.getElementById('QueryPlanTemplate');
            if (data.queryPlanTemplateId) qp.value = data.queryPlanTemplateId;
            else { var d = qp.querySelector('[data-is-default="true"]'); if (d) qp.value = d.value; }
            var ns = document.getElementById('NormalizationSuite');
            if (data.normalizationSuiteId) ns.value = data.normalizationSuiteId;
            else selectDefaultNormalizationSuite();
            var orm = document.getElementById('OrganizationResourceMap');
            if (data.organizationResourceMapTemplateId) orm.value = data.organizationResourceMapTemplateId;
            else selectDefaultOrganizationResourceMap();
            document.querySelectorAll('.measure-checkbox').forEach(function (cb) { cb.checked = false; });
            var ids = data.selectedMeasureIds || [];
            if (ids.length) {
                ids.forEach(function (id) {
                    var cb = document.querySelector('.measure-checkbox[value="' + id + '"]');
                    if (cb) cb.checked = true;
                });
            } else {
                (data.selectedMeasures || []).forEach(function (m) {
                    var cb = measureCheckboxForFamily(String(m));
                    if (cb) cb.checked = true;
                });
            }
            cohortRows.innerHTML = '';
            if (data.patientCohorts && data.patientCohorts.length > 0) {
                data.patientCohorts.forEach(function (c) {
                    addCohortRow(
                        c.patientCount,
                        c.measureEligibilities || defaultElig(true),
                        c.eligibleClinicalScenarioIds || [],
                        c.resourcesPerPatientMin || data.resourcesPerPatientMin || 50,
                        c.resourcesPerPatientMax || data.resourcesPerPatientMax || 100,
                        c.scheduledInpatientPattern || DEFAULT_SCHEDULED_PATTERN,
                        c.cohortQualification || inferCohortQualification(c.measureEligibilities),
                        c.patientConfigurationId || '',
                        c.intent || null);
                });
            }
            syncPatternColumns();
            // Imported patients
            importedRows.innerHTML = '';
            (data.importedPatientIds || []).forEach(function (p) {
                addImportedRow({
                    source: 'ExistingId',
                    patientId: p.patientId || '',
                    autoDetect: p.autoDetect !== false,
                    measureEligibilities: p.measureEligibilities || {},
                    detectedClinicalScenarioId: p.detectedClinicalScenarioId || null
                });
            });
            (data.importedPatientBundles || []).forEach(function (p) {
                // Sniff encounter dates from the saved bundle JSON for the in/out-of-period
                // indicator (best effort; classifier will refresh on Detect).
                var encS = null, encE = null;
                if (p.bundleJson) {
                    try {
                        var parsed = JSON.parse(p.bundleJson);
                        var encs = (parsed && parsed.entry || []).map(function (e) { return e && e.resource; }).filter(function (r) { return r && r.resourceType === 'Encounter' && r.period; });
                        encs.forEach(function (enc) {
                            if (enc.period.start && (!encS || enc.period.start < encS)) encS = enc.period.start;
                            var pe = enc.period.end || enc.period.start;
                            if (pe && (!encE || pe > encE)) encE = pe;
                        });
                    } catch (_) { /* ignore — sniffing is best-effort */ }
                }
                addImportedRow({
                    source: 'Bundle',
                    patientId: p.patientId || '',
                    fileName: p.fileName || null,
                    uploadedBundleId: p.uploadedBundleId || null,
                    bundleJson: p.bundleJson || '',
                    autoDetect: p.autoDetect !== false,
                    measureEligibilities: p.measureEligibilities || {},
                    detectedClinicalScenarioId: p.detectedClinicalScenarioId || null,
                    encounterStart: encS,
                    encounterEnd: encE
                });
            });
            updateImportedSummary();
            syncCount();
            syncNhsnOrganizationFromUploadedPatients();
            syncReportPeriodPolicyUi();
            syncLiveSimulationUi();
            syncMetricsRunUi();
        }

        // ---- Open modal ----
        async function openEditor(id, mode) {
            clearErrors();
            clearWarnings();
            cfgGenFingerprint = null;
            cfgGenLastOrmId = null;
            cfgGenLastSuiteId = null;
            if (id) {
                try {
                    var res = await fetch(getJsonUrl + '?id=' + encodeURIComponent(id));
                    if (!res.ok) throw new Error('Server returned ' + res.status);
                    var data = await res.json();
                    populate(data);
                    var isSystem = data.isSystemScenario === true;
                    var isView = mode === 'view' || isSystem;
                    modalTitle.innerHTML = '<i class="bi bi-' + (isView ? 'eye' : 'pencil-square') + ' me-2"></i>' + (isView ? 'View' : 'Edit') + ': ' + esc(data.name || 'Scenario') + (isSystem ? ' <span class="badge bg-secondary ms-2">System</span>' : '');
                    setEditable(!isView);
                    openModal();
                } catch (err) {
                    showError('Failed to load scenario: ' + (err.message || 'Unknown error'));
                    openModal();
                }
            } else {
                idInput.value = '';
                isSystemInput.value = 'false';
                modalTitle.innerHTML = '<i class="bi bi-plus-lg me-2"></i>New Scenario';
                setEditable(true);
                document.getElementById('ScenarioName').value = '';
                document.getElementById('ScenarioDescription').value = '';
                document.getElementById('ReportMethod').value = 'Adhoc';
                document.getElementById('IsLiveSimulation').checked = false;
                document.getElementById('ReportingWindowMinutes').value = '10';
                document.getElementById('IsMetricsRun').checked = false;
                document.getElementById('BenchmarkKey').value = '';
                document.getElementById('TargetDurationSeconds').value = '';
                document.getElementById('Concurrency').value = '';
                document.getElementById('FailRunOnBenchmark').checked = false;
                document.getElementById('Seed').value = 20260329;
                document.getElementById('CleanupFhirData').checked = true;
                document.getElementById('CleanupServiceData').checked = false;
                document.getElementById('NhsnOrganizationId').value = generateRandomNhsnOrganizationId();
                document.getElementById('ReportPeriodStart').value = '';
                document.getElementById('ReportPeriodEnd').value = '';
                selectDefaultQueryPlanTemplate();
                selectDefaultNormalizationSuite();
                selectDefaultOrganizationResourceMap();
                document.querySelectorAll('.measure-checkbox').forEach(function (cb) { cb.checked = false; });
                var defaultMonthly = document.querySelector('.measure-checkbox[data-family="NhsnAcuteCareHospitalMonthlyInitialPopulation"][data-is-system="true"]')
                    || document.querySelector('.measure-checkbox[data-family="NhsnAcuteCareHospitalMonthlyInitialPopulation"]');
                if (defaultMonthly) defaultMonthly.checked = true;
                cohortRows.innerHTML = '';
                addDefault(10, true, 50, 100);
                importedRows.innerHTML = '';
                updateImportedSummary();
                syncCount();
                syncNhsnOrganizationFromUploadedPatients();
                syncReportPeriodPolicyUi();
                syncLiveSimulationUi();
                syncMetricsRunUi();
                openModal();
            }
        }

        // Public API — any page can open the editor via this global.
        window.openScenarioEditor = function (id, mode) { return openEditor(id || null, mode || 'edit'); };

        // ---- Save ----
        btnSave.addEventListener('click', async function () {
            clearErrors();
            var model = collectModel();
            var valid = true;

            if (!(model.name || '').trim()) {
                markFieldError('ScenarioName', 'Name is required.');
                valid = false;
            }

            if (!(model.nhsnOrganizationId || '').trim()) {
                markFieldError('NhsnOrganizationId', 'NHSN Organization ID is required.');
                valid = false;
            }

            if (!model.selectedMeasures.length) {
                showError('At least one measure must be selected.');
                valid = false;
            }

            var hasImported = (model.importedPatientIds && model.importedPatientIds.length > 0)
                || (model.importedPatientBundles && model.importedPatientBundles.length > 0);

            if (!model.patientCohorts.length && !hasImported) {
                showError('At least one cohort with patients > 0 (or one imported patient) is required.');
                valid = false;
            }
            if (model.concurrency != null && (model.concurrency < 1 || model.concurrency > 8)) {
                markFieldError('Concurrency', 'FHIR query parallelism must be between 1 and 8.');
                valid = false;
            }
            if (model.targetDurationSeconds != null && model.targetDurationSeconds < 1) {
                markFieldError('TargetDurationSeconds', 'Time budget must be a positive number of seconds.');
                valid = false;
            }

            var invalidClinicalProfileCohort = Array.prototype.findIndex.call(
                cohortRows.children,
                function (row) {
                    var patientCount = parseInt(
                        row.querySelector('.cohort-count').value || '0',
                        10);

                    if (patientCount <= 0) return false;

                    return !row.querySelector(
                        '.cohort-scenario-option:checked:not(:disabled)');
                });

            if (invalidClinicalProfileCohort >= 0) {
                showError(
                    'Cohort ' + (invalidClinicalProfileCohort + 1) +
                    ' must have at least one Clinical Profile selected.');
                valid = false;
            }

            if (hasImported) {
                if (!model.reportPeriodStart) {
                    markFieldError(
                        'ReportPeriodStart',
                        'Report Period Start is required when imported patients are used.');
                    valid = false;
                }

                if (!model.reportPeriodEnd) {
                    markFieldError(
                        'ReportPeriodEnd',
                        'Report Period End is required when imported patients are used.');
                    valid = false;
                }
            }
            // Imported-by-ID rows must have a non-empty patient id.
            var badId = (model.importedPatientIds || []).find(function (p) {
                return !(p.patientId || '').trim();
            });

            if (badId) {
                showError('Every imported-by-ID row must have a Patient ID.');
                valid = false;
            }

            if (!valid) return;

            model.id = idInput.value || crypto.randomUUID();

            try {
                await postJson(saveUrl, model);
                closeModal();
                notifyChanged('saved', model.id, model.name);
            } catch (err) {
                showError('Save failed: ' + (err.message || 'Unknown error'));
            }
        });

        // ---- Table button handlers (only present on the Scenarios list page) ----
        var btnNew = document.getElementById('btnNewScenario');
        if (btnNew) btnNew.addEventListener('click', function () { openEditor(null, 'edit'); });

        document.querySelectorAll('.btn-scenario-open').forEach(function (btn) {
            btn.addEventListener('click', function () { openEditor(btn.getAttribute('data-id'), btn.getAttribute('data-mode')); });
        });

        document.querySelectorAll('.btn-scenario-clone').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                try {
                    var res = await postJson(cloneUrl, { id: btn.getAttribute('data-id') });
                    notifyChanged('cloned', res && res.id, null);
                }
                catch (err) { showError('Clone failed: ' + (err.message || 'Unknown error')); }
            });
        });

        var cfgGenAnalyzeUrl = '@Url.Action("Analyze", "ConfigurationGeneration")';
        var cfgGenApplyOrmUrl = '@Url.Action("ApplyOrm", "ConfigurationGeneration")';
        var cfgGenApplyNormUrl = '@Url.Action("ApplyNormalization", "ConfigurationGeneration")';
        var cfgGenFingerprint = null;
        var cfgGenLastOrmId = null;
        var cfgGenLastSuiteId = null;

        function upsertSelectOption(selectId, id, name) {
            var sel = document.getElementById(selectId);
            if (!sel || !id) return;
            var existing = Array.prototype.find.call(sel.options, function (o) { return o.value === String(id); });
            if (!existing) {
                var opt = document.createElement('option');
                opt.value = String(id);
                opt.textContent = name || String(id);
                sel.appendChild(opt);
            }
            sel.value = String(id);
        }

        function collectImportedAnalyzeRequest() {
            var rows = importedRows ? importedRows.children : [];
            var sources = [];
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                if (row.dataset.source === 'Bundle' && (row.dataset.uploadedBundleId || row.dataset.bundleJson)) {
                    sources.push({
                        source: 'Bundle',
                        uploadedBundleId: row.dataset.uploadedBundleId || null,
                        bundleJson: row.dataset.uploadedBundleId ? null : (row.dataset.bundleJson || null)
                    });
                    continue;
                }
                if (row.dataset.source === 'ExistingId') {
                    var pid = (row.querySelector('.imp-pid') || {}).value;
                    if (pid) sources.push({ source: 'ExistingId', patientId: pid });
                }
            }
            if (!sources.length) return null;
            return {
                sources: sources,
                priorFingerprint: cfgGenFingerprint,
                refineOrmId: cfgGenLastOrmId,
                refineSuiteId: cfgGenLastSuiteId
            };
        }

        var btnSuggest = document.getElementById('btnSuggestFromImported');
        if (btnSuggest) {
            btnSuggest.addEventListener('click', async function () {
                if (!window.BundleConfigGeneration) {
                    showError('Configuration generator script failed to load.');
                    return;
                }
                var req = collectImportedAnalyzeRequest();
                if (!req) {
                    showError('Add or upload at least one imported patient first.');
                    return;
                }
                try {
                    btnSuggest.disabled = true;
                    var proposal = await window.BundleConfigGeneration.analyzeAndShow(
                        { analyze: cfgGenAnalyzeUrl, applyOrm: cfgGenApplyOrmUrl, applyNorm: cfgGenApplyNormUrl },
                        req,
                        {
                            selectOrmLabel: 'Save new ORM and select it',
                            selectSuiteLabel: 'Save new suite and select it',
                            namePrefix: (document.getElementById('ScenarioName') || {}).value || '',
                            onSelectOrm: function (id, name) {
                                upsertSelectOption('OrganizationResourceMap', id, name);
                            },
                            onSelectSuite: function (id, name) {
                                upsertSelectOption('NormalizationSuite', id, name);
                            },
                            onSavedOrm: function (id) { cfgGenLastOrmId = id; },
                            onSavedSuite: function (id) { cfgGenLastSuiteId = id; },
                            onExtendOrm: async function (id) {
                                var refined = await window.BundleConfigGeneration.postJson(cfgGenAnalyzeUrl, Object.assign({}, req, { refineOrmId: id }));
                                cfgGenFingerprint = refined.fingerprint || refined.Fingerprint || cfgGenFingerprint;
                                var saved = await window.BundleConfigGeneration.postJson(cfgGenApplyOrmUrl, {
                                    proposal: refined.orm || refined.Orm,
                                    updateExistingId: id
                                });
                                cfgGenLastOrmId = saved.id || saved.Id;
                                upsertSelectOption('OrganizationResourceMap', saved.id || saved.Id, saved.name || saved.Name);
                            },
                            onExtendSuite: async function (id) {
                                var refined = await window.BundleConfigGeneration.postJson(cfgGenAnalyzeUrl, Object.assign({}, req, { refineSuiteId: id }));
                                cfgGenFingerprint = refined.fingerprint || refined.Fingerprint || cfgGenFingerprint;
                                var saved = await window.BundleConfigGeneration.postJson(cfgGenApplyNormUrl, {
                                    proposal: refined.normalization || refined.Normalization,
                                    updateExistingSuiteId: id
                                });
                                cfgGenLastSuiteId = saved.id || saved.Id;
                                upsertSelectOption('NormalizationSuite', saved.id || saved.Id, saved.name || saved.Name);
                            }
                        });
                    cfgGenFingerprint = proposal.fingerprint || proposal.Fingerprint || cfgGenFingerprint;
                } catch (err) {
                    showError(err.message || 'Suggestion failed.');
                } finally {
                    btnSuggest.disabled = false;
                }
            });
        }

        document.querySelectorAll('.btn-scenario-delete').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                if (!confirm('Delete this scenario?')) return;
                try {
                    await postJson(deleteUrl, { id: btn.getAttribute('data-id') });
                    notifyChanged('deleted', btn.getAttribute('data-id'), null);
                }
                catch (err) { showError('Delete failed: ' + (err.message || 'Unknown error')); }
            });
        });
    })();
</script>
