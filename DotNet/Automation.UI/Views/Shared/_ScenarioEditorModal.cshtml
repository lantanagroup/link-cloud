            renderRowPredicted(row);
        }
        function refreshCustomizeButton(row) {
            var btn = row.querySelector('.btn-cohort-customize');
            if (!btn) return;
            btn.textContent = 'Configure';
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-outline-secondary');
        }
        function addCohortRow(count, patientConfigurationId, intent, rMin, rMax) {
            var idx = cohortRows.children.length;
            var tr = document.createElement('tr');
            tr.innerHTML = '<td class="text-center align-middle">' + (idx + 1) + '</td>' +
                '<td><input type="number" class="form-control form-control-sm cohort-count" min="1" value="' + (count || 1) + '" /></td>' +
                '<td>' + buildPatientConfigSelect(patientConfigurationId || '') + '</td>' +
                '<td class="cohort-predicted-cell align-middle"></td>' +
                '<td class="text-center align-middle"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-cohort">&times;</button></td>';
            if (intent) tr.dataset.intentJson = JSON.stringify(intent);
            if (patientConfigurationId) tr.dataset.patientConfigurationId = patientConfigurationId;
            var cfg = findPatientConfig(patientConfigurationId);
            tr.dataset.resourcesMin = String((cfg && cfg.resourcesPerPatientMin) || rMin || 50);
            tr.dataset.resourcesMax = String((cfg && cfg.resourcesPerPatientMax) || rMax || rMin || 100);
            cohortRows.appendChild(tr);
            refreshCustomizeButton(tr);
            renderRowPredicted(tr);
