@*
    Reusable scenario editor modal.
    Can be dropped on any page by calling `@await Html.PartialAsync("_ScenarioEditorModal")`.

    Consumers open the editor with:        window.openScenarioEditor(scenarioId /* or null for new */, 'edit' | 'view');

    On a successful save/clone/delete the partial dispatches a DOM event on `document`:
        'scenario-editor:changed'  detail: { id, name, action }
    where action is 'saved' | 'cloned' | 'deleted'.

    Pages decide how to respond (reload, refresh a dropdown, update a list, etc.).
*@
@{
    var queryPlanTemplates = (List<QueryPlanTemplate>?)ViewBag.QueryPlanTemplates ?? [];
    var normalizationSuites = (List<NormalizationSuiteDefinition>?)ViewBag.NormalizationSuites ?? [];
    var organizationResourceMaps = (List<OrganizationResourceMapTemplate>?)ViewBag.OrganizationResourceMaps ?? [];
    var patientConfigurations = (List<PatientConfiguration>?)ViewBag.PatientConfigurations ?? [];
    var measureTemplates = (List<MeasureTemplate>?)ViewBag.MeasureTemplates ?? [];
    var clinicalScenarios = ClinicalScenarioInfo.GetAll(Enum.GetValues<ProfiledMeasureType>().ToList());
    var scheduledPatternOptions = Enum.GetValues<ScheduledInpatientPattern>()
        .Select(p =>
        {
            return new
            {
                Value = p.ToString(),
                Label = p.GetUiShortLabel(),
                Hint = p.GetUiHint(),
                ExpectedInReport = p.GetCensusBehavior().ExpectedInReport
            };
        })
        .ToList();
}

@* ========== Scenario Editor Modal ========== *@
<div id="scenarioModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div class="au-scenario-modal-dialog" style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="modalTitle"><i class="bi bi-pencil-square me-2"></i>Scenario</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnModalSave" style="display:none;">
                        <i class="bi bi-floppy me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnModalClose">Close</button>
                </div>
            </div>
            <div id="formErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div id="formWarnings" class="alert alert-warning m-3 mb-0 py-2 small" style="display:none;white-space:pre-line;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="modalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ScenarioId" value="" />
                <input type="hidden" id="IsSystemScenario" value="false" />

                <div id="scenarioConfigArea" class="position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ScenarioName">Name</label>
                            <input class="form-control" id="ScenarioName" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ScenarioDescription">Description</label>
                            <input class="form-control" id="ScenarioDescription" maxlength="500" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="ReportMethod">Report Method</label>
                            <select class="form-select" id="ReportMethod">
                                <option value="Adhoc">Adhoc</option>
                                <option value="ScheduledReport">Scheduled Report</option>
                                <option value="RegenerateReport">Regenerate Report</option>
                            </select>
                        </div>
                        <div class="col-md-8" id="liveSimulationFields" style="display:none;">
                            <label class="form-label d-block">Live Scheduled Simulation</label>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="IsLiveSimulation" />
                                <label class="form-check-label" for="IsLiveSimulation">Hold a short reporting window. Inpatient patterns admit/discharge automatically; interactive inject is optional. Scheduled reports only.</label>
                            </div>
                            <div class="row g-2" id="liveSimulationOptions" style="display:none;">
                                <div class="col-md-6">
                                    <label class="form-label" for="ReportingWindowMinutes">Reporting Window</label>
                                    <select class="form-select" id="ReportingWindowMinutes">
                                        <option value="5">5 minutes</option>
                                        <option value="10" selected>10 minutes</option>
                                        <option value="15">15 minutes</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Measures</label>
                            @if (measureTemplates.Count == 0)
                            {
                                <div class="small text-muted">No measures are available yet. Add them under Configurations → Measures.</div>
                            }
                            @foreach (var mt in measureTemplates)
                            {
                                var cbId = "measure_" + mt.Id.ToString("N");
                                var isDefaultMonthly = mt.IsSystem && mt.GenerationFamily == ProfiledMeasureType.NhsnAcuteCareHospitalMonthlyInitialPopulation;
                                <div class="form-check">
                                    <input class="form-check-input measure-checkbox" type="checkbox" id="@cbId"
                                           value="@mt.Id"
                                           data-family="@mt.GenerationFamily"
                                           data-is-system="@(mt.IsSystem ? "true" : "false")"
                                           @(isDefaultMonthly ? "checked" : null) />
                                    <label class="form-check-label" for="@cbId">
                                        @mt.Name
                                        @if (mt.IsSystem)
                                        {
                                            <span class="badge bg-dark ms-1">System</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(mt.Version))
                                        {
                                            <small class="text-muted">@mt.Version</small>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="QueryPlanTemplate">Query Plan</label>
                            <select class="form-select" id="QueryPlanTemplate">
                                @foreach (var qp in queryPlanTemplates)
                                {
                                    var defaultLabel = qp.IsDefault ? " (Default)" : "";
                                    var systemLabel = qp.IsSystem ? " [System]" : "";
                                    <option value="@qp.Id" data-name="@qp.Name" data-is-default="@qp.IsDefault.ToString().ToLower()">@qp.Name@defaultLabel@systemLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="NormalizationSuite">Normalization Suite</label>
                            <select class="form-select" id="NormalizationSuite">
                                @foreach (var ns in normalizationSuites)
                                {
                                    var nsDefaultLabel = ns.IsDefault ? " (Default)" : "";
                                    var nsSystemLabel = ns.IsSystem ? " [System]" : "";
                                    <option value="@ns.Id" data-name="@ns.Name" data-is-default="@ns.IsDefault.ToString().ToLower()">@ns.Name@nsDefaultLabel@nsSystemLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="OrganizationResourceMap">Organization Resource Map</label>
                            <select class="form-select" id="OrganizationResourceMap">
                                @foreach (var orm in organizationResourceMaps)
                                {
                                    var ormDefaultLabel = orm.IsDefault ? " (Default)" : "";
                                    var ormSystemLabel = orm.IsSystem ? " [System]" : "";
                                    <option value="@orm.Id" data-name="@orm.Name" data-is-default="@orm.IsDefault.ToString().ToLower()">@orm.Name@ormDefaultLabel@ormSystemLabel</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="Seed">Seed</label>
                            <input class="form-control" type="number" min="1" id="Seed" value="20260329" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="PatientCount">Total Patients</label>
                            <input class="form-control" type="number" id="PatientCount" value="10" readonly title="Sum of cohort patients + imported patients (read-only)." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="NhsnOrganizationId">NHSN Organization ID</label>
                            <input class="form-control" type="text" id="NhsnOrganizationId" maxlength="64" />
                            <div id="nhsnOrganizationHint" class="form-text"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="ReportPeriodStart">Report Period Start</label>
                            <input class="form-control" type="date" id="ReportPeriodStart" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="ReportPeriodEnd">Report Period End</label>
                            <input class="form-control" type="date" id="ReportPeriodEnd" />
                        </div>
                        <div class="col-12">
                            <div id="reportPeriodPolicyHint" class="small text-muted"></div>
                        </div>
                        <div class="col-12 d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="CleanupFhirData" checked />
                                <label class="form-check-label" for="CleanupFhirData">Cleanup FHIR Data</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="CleanupServiceData" />
                                <label class="form-check-label" for="CleanupServiceData">Cleanup Service Data</label>
                            </div>
                        </div>
                        <div class="col-12 au-help-scope">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="IsMetricsRun" />
                                <label class="form-check-label" for="IsMetricsRun">Metrics run</label>
                                <button type="button" class="au-info-toggle" data-help="metricsRunHelp" aria-label="About metrics runs" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                            </div>
                            <div id="metricsRunHelp" class="au-help-text mb-2" hidden>
                                Includes this scenario on the Metrics dashboard and gathers extra performance data: step timings, throughput, and related measurements. Changing patient count, seed, or concurrency starts a new setup version there.
                            </div>
                            <div class="row g-2" id="metricsRunOptions" style="display:none;">
                                <div class="col-md-4">
                                    <label class="form-label" for="BenchmarkKey">
                                        Benchmark name
                                        <button type="button" class="au-info-toggle" data-help="benchmarkKeyHelp" aria-label="About benchmark name" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                    </label>
                                    <input class="form-control" id="BenchmarkKey" maxlength="120" placeholder="e.g. monthly-150-patients" />
                                    <div class="form-text">Optional. Same name on every run that should share one saved set of limits.</div>
                                    <div id="benchmarkKeyHelp" class="au-help-text mt-1" hidden>
                                        A benchmark is a named bag of pass/fail limits (for example max total time, min patients per minute, max validation p95). Leaving this blank still records the run on the Metrics page and still applies the time budget below. Filling it in attaches this run to that named bag so later runs can be compared, and so “fail the run if it misses…” can use those stored limits. Without a matching saved benchmark, the name is just a label on the snapshot.
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="TargetDurationSeconds">
                                        Time budget (seconds)
                                        <button type="button" class="au-info-toggle" data-help="targetDurationHelp" aria-label="About time budget" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                    </label>
                                    <input class="form-control" type="number" id="TargetDurationSeconds" min="1" step="1" placeholder="e.g. 1800" />
                                    <div class="form-text">Checked after the run finishes. Does not stop the run when time is up.</div>
                                    <div id="targetDurationHelp" class="au-help-text mt-1" hidden>
                                        This is a goal, not a timeout. The run still generates and processes every patient even if it takes longer. When it ends we compare wall-clock duration to this number and mark the Metrics snapshot pass or fail. Empty means no duration goal. (A soak would keep the system under load for a fixed period and then stop; this does not do that.)
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="Concurrency">
                                        FHIR query parallelism (1–8)
                                        <button type="button" class="au-info-toggle" data-help="concurrencyHelp" aria-label="About FHIR query parallelism" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                    </label>
                                    <input class="form-control" type="number" id="Concurrency" min="1" max="8" step="1" placeholder="default 8" />
                                    <div class="form-text">How many Data Acquisition FHIR queries may run at once. Hard cap is 8.</div>
                                    <div id="concurrencyHelp" class="au-help-text mt-1" hidden>
                                        This sets Data Acquisition’s max concurrent FHIR requests for this run’s facility. Higher values finish querying faster but put more load on the FHIR server and downstream services. 8 is also the acquisition worker cap, so 16 is silently treated as 8. Leave blank to keep the default of 8. This does not change how many patients Thetis generates.
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="FailRunOnBenchmark" />
                                        <label class="form-check-label" for="FailRunOnBenchmark">
                                            Fail the run if it misses the time budget or saved benchmark
                                            <button type="button" class="au-info-toggle" data-help="failOnBenchmarkHelp" aria-label="About failing the run on missed budget" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                        </label>
                                    </div>
                                    <div id="failOnBenchmarkHelp" class="au-help-text mt-1" hidden>
                                        Off (default): validators still decide Succeeded vs Failed; a missed time budget is only recorded on the Metrics page. On: after a successful functional run, if duration or the named benchmark’s limits are missed, the run is marked Failed. Leave this off until you have a baseline you actually want to enforce.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="cohortBuilder" class="col-12">
                            <div class="au-cohort-card mt-1 au-help-scope">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <span class="fw-semibold"><i class="bi bi-people-fill me-1"></i>Cohorts</span>
                                        <button type="button" class="btn btn-link btn-sm py-0 au-info-toggle" data-help="cohortHelpPanel" aria-label="About cohorts" aria-expanded="false"><i class="bi bi-info-circle me-1"></i>How cohorts work</button>
                                    </div>
                                    <div id="cohortHelpPanel" class="au-help-text" hidden>
                                        <p>Each row is <strong>how many</strong> of one saved Patient Configuration to generate. Stay timing, encounter, and clinical content live on that configuration so you can configure a patient once and reuse it.</p>
                                        <ul>
                                            <li>Each cohort uses <strong>one Patient Configuration</strong>, and each configuration uses <strong>one Clinical Profile</strong>.</li>
                                            <li><strong>Configure</strong> opens the profile → form pipeline: pick a Clinical Profile, see admit/discharge dates against this scenario’s report period, edit, and save.</li>
                                            <li><strong>+ Inpatient pneumonia</strong> / <strong>+ Ambulatory pneumonia</strong> attach starter kits. They do not set a qualifying flag.</li>
                                        </ul>
                                    </div>
                                    <div id="cohortHelpPredicted" class="au-help-text" hidden>
                                        Green check / red X is predicted from the attached configuration (encounter class, insulin, stay timing) against the measures and report period on this scenario. Out of window means the stay does not overlap the report period.
                                    </div>
                                    <div id="cohortHelpConfig" class="au-help-text" hidden>
                                        This cohort’s patient. Pick a saved configuration, or click Configure, name it, and save. Count is the only thing this row owns.
                                    </div>
                                    <div class="table-responsive au-table-wrap au-cohort-table-wrap mt-2 mb-2">
                                        <table class="table table-sm table-bordered au-table au-cohort-table mb-0" id="cohortTable">
                                            <thead>
                                                <tr>
                                                    <th style="width:40px">#</th>
                                                    <th style="width:100px">Patients</th>
                                                    <th style="min-width:280px">
                                                        Patient configuration
                                                        <button type="button" class="au-info-toggle" data-help="cohortHelpConfig" aria-label="About patient configuration" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                                    </th>
                                                    <th style="min-width:220px">
                                                        Predicted
                                                        <button type="button" class="au-info-toggle" data-help="cohortHelpPredicted" aria-label="About predicted qualification" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                                                    </th>
                                                    <th style="width:40px"></th>
                                                </tr>
                                            </thead>
                                            <tbody id="cohortRows"></tbody>
                                        </table>
                                    </div>
                                    <div class="d-flex gap-2" id="cohortActions">
                                        <button type="button" class="btn btn-sm btn-outline-success" id="addQualifyingCohort">+ Inpatient pneumonia</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning" id="addNonQualifyingCohort">+ Ambulatory pneumonia</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="importedPatientsBuilder" class="col-12">
                            <div class="au-cohort-card mt-1">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-semibold"><i class="bi bi-cloud-arrow-down-fill me-1"></i>Imported Patients <small class="text-muted ms-1" id="importedSummary"></small></span>
                                    </div>
                                    <div class="small text-muted mb-2">
                                        Supplements the random/cohort generation above. ID-based patients are fetched from the configured FHIR server at run time and are <em>not</em> expunged on cleanup. Bundle uploads are uploaded to the FHIR server during the run and <em>are</em> expunged on cleanup.
                                    </div>
                                    <div class="table-responsive au-table-wrap mb-2">
                                        <table class="table table-sm table-bordered au-table au-imported-table mb-0" id="importedTable">
                                            <thead>
                                                <tr>
                                                    <th style="width:40px">#</th>
                                                    <th style="width:90px">Source</th>
                                                    <th>Patient ID / File</th>
                                                    <th>Predicted</th>
                                                    <th style="width:170px">Encounter Dates</th>
                                                    <th style="width:90px">Detected</th>
                                                    <th style="width:40px"></th>
                                                </tr>
                                            </thead>
                                            <tbody id="importedRows"></tbody>
                                        </table>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center flex-wrap" id="importedActions">
                                        <div class="input-group input-group-sm" style="width:auto;">
                                            <span class="input-group-text">Patient ID</span>
                                            <input type="text" class="form-control" id="newImportedPatientId" placeholder="e.g. patient-123" maxlength="128" style="width:200px;" />
                                            <button type="button" class="btn btn-outline-primary" id="btnAddImportedById">+ Add by ID</button>
                                        </div>
                                        <label class="btn btn-outline-primary btn-sm mb-0">
                                            <i class="bi bi-upload me-1"></i>Upload Bundle JSON
                                            <input type="file" id="importedBundleFile" accept="application/json,.json" multiple hidden />
                                        </label>
                                        <button type="button" class="btn btn-sm btn-au-action" id="btnSuggestFromImported">
                                            <i class="bi bi-magic me-1"></i>Suggest from patient data
                                        </button>
                                        <span id="importedUploadStatus" class="small text-muted" style="display:none;" role="status" aria-live="polite"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="systemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="scenarioModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

<div id="replaceFhirModal" role="dialog" aria-modal="true" aria-labelledby="replaceFhirModalTitle" style="display:none;position:fixed;inset:0;z-index:1065;overflow-y:auto;">
    <div id="replaceFhirBackdrop" style="position:absolute;inset:0;background:rgba(0,0,0,.45);"></div>
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;position:relative;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:700px;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;" class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0" id="replaceFhirModalTitle"><i class="bi bi-exclamation-triangle me-2"></i>Patient Already Exists on FHIR Server</h6>
                <button type="button" class="btn btn-sm btn-outline-light" id="btnReplaceFhirClose">Close</button>
            </div>
            <div class="p-3">
                <p class="mb-2">This patient already exists on the FHIR server.</p>
                <p class="mb-2">Choose one action:</p>
                <ol class="mb-3">
                    <li><strong>Purge + Replace</strong>: expunge matching server resources, then replay this uploaded bundle.</li>
                    <li><strong>Use FHIR Server Data</strong>: discard this upload and import by Patient ID using server data.</li>
                </ol>
                <div class="alert alert-warning py-2 small mb-3">This is a destructive server operation. Only proceed if you intentionally want uploaded content to become authoritative on the FHIR server.</div>
                <div id="replaceFhirLargeHint" class="alert alert-info py-2 small mb-3" style="display:none;">
                    This bundle is considered large. For now, use <strong>Purge + Replace</strong> because pulling full patient data from the server can be incomplete for large patients.
                </div>
                <div class="small text-muted mb-1">Patient</div>
                <div class="fw-semibold mb-2" id="replaceFhirPatientLabel"></div>
                <div id="replaceFhirHoldHint" class="small text-muted mb-2">Press and hold the button to confirm destructive replace.</div>
                <div class="progress mb-2" style="height:8px;">
                    <div id="replaceFhirHoldFill" class="progress-bar bg-danger" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width:0%"></div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnReplaceFhirCancel">Cancel</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnUseServerData">Use FHIR Server Data</button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnReplaceFhirConfirm">
                        <i class="bi bi-arrow-repeat me-1"></i>Purge + Replace
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="pcCohortModal" style="display:none;position:fixed;inset:0;z-index:1070;overflow-y:auto;">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;background:rgba(0,0,0,.35);">
        <div class="au-help-scope" style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:980px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-person-gear me-2"></i>Patient configuration
                    <button type="button" class="au-info-toggle au-info-toggle-on-dark" data-help="pcCohortActionsHelp" aria-label="About saving a configuration" aria-expanded="false"><i class="bi bi-info-circle"></i></button>
                </h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-success" id="btnPcCohortSaveAs">Save configuration</button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnPcCohortClose">Close</button>
                </div>
            </div>
            <div id="pcCohortErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" class="au-help-scope">
                <div id="pcCohortActionsHelp" class="au-help-text" hidden>
                    <ul class="mb-0">
                        <li>Pick a <strong>Clinical Profile</strong> first. The form fills with that pack so you can see the diagnosis, labs, and meds.</li>
                        <li>Give the configuration a <strong>name</strong> and click <strong>Save configuration</strong>. This cohort then uses that one configuration.</li>
                        <li>Count stays on the cohort row. Stay timing and qualification are saved on this configuration.</li>
                    </ul>
                </div>
                @await Html.PartialAsync("_PatientConfigurationEditor")
            </div>
        </div>
    </div>
