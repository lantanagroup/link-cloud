        // ---- Imported Patients ----
        var importedRows = document.getElementById('importedRows');
        var importedSummary = document.getElementById('importedSummary');
        var importedUploadStatus = document.getElementById('importedUploadStatus');

        function setImportedUploadStatus(message, isBusy) {
            if (!importedUploadStatus) return;
            if (!message) {
                importedUploadStatus.style.display = 'none';
                importedUploadStatus.textContent = '';
                importedUploadStatus.className = 'small text-muted';
                return;
            }

            importedUploadStatus.style.display = '';
            importedUploadStatus.textContent = (isBusy ? '⏳ ' : '') + message;
            importedUploadStatus.className = isBusy ? 'small text-primary' : 'small text-muted';
