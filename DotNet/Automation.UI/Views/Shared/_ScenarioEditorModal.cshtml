                includeHypoglycemicInsulin: intent.includeHypoglycemicInsulin != null ? intent.includeHypoglycemicInsulin : intent.IncludeHypoglycemicInsulin,
                medicationAdministrationRxNorm: intent.medicationAdministrationRxNorm || intent.MedicationAdministrationRxNorm,
