        function intentHasOverlays(intent) {
            if (!intent || typeof intent !== 'object') return false;
            return Object.keys(intent).some(function (k) {
                var v = intent[k];
                if (v == null || v === '' || v === 'Inherit' || v === 0) return false;
                if (Array.isArray(v)) return v.length > 0;
                if (typeof v === 'object') return Object.keys(v).length > 0;
                return true;
            });
        }
        function buildPatientConfigSelect(selectedId) {
            var opts = '<option value="">Select a configuration…</option>' +
                patientConfigurationCatalog.map(function (c) {
                    return '<option value="' + c.id + '" ' + (c.id === selectedId ? 'selected' : '') + '>' + esc(c.name) + (c.isSystem ? ' (system)' : '') + '</option>';
                }).join('');
            return '<div class="d-flex gap-1 pc-cohort-config-cell">' +
                '<select class="form-select form-select-sm cohort-patient-config">' + opts + '</select>' +
                '<button type="button" class="btn btn-sm btn-outline-secondary btn-cohort-customize" title="Configure this patient">Configure</button>' +
                '</div>';
        }
