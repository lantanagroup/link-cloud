        function af() { var t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
        function generateRandomNhsnOrganizationId() {
            var arr = new Uint32Array(1);
            if (window.crypto && window.crypto.getRandomValues) {
                window.crypto.getRandomValues(arr);
                return String(10000 + (arr[0] % 90000));
