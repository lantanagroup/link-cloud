        async function promptReplaceFhirPatient(patientId, canUseServerData, requiresReplaceForLargePatient) {
            return new Promise(function (resolve) {
                if (!replaceFhirModal || !btnReplaceFhirConfirm || !replaceFhirPatientLabel || !btnUseServerData) {
                    resolve('cancel');
                    return;
                }

                var holdDurationMs = 1500;
                var holdStart = 0;
                var holdTimer = null;
                var holdAnimationFrame = 0;
                var holdCompleted = false;
                var postConfirmVisualDelayMs = 1000;
                var keyboardHoldActive = false;

                replaceFhirPatientLabel.textContent = String(patientId || '').trim();
                btnReplaceFhirConfirm.disabled = false;
                btnReplaceFhirConfirm.classList.remove('btn-success');
                btnReplaceFhirConfirm.classList.add('btn-danger');
                if (replaceFhirHoldHint) replaceFhirHoldHint.textContent = 'Press and hold the button to confirm destructive replace.';
                if (replaceFhirHoldFill) {
                    replaceFhirHoldFill.style.width = '0%';
                    replaceFhirHoldFill.setAttribute('aria-valuenow', '0');
                }
                btnUseServerData.disabled = !canUseServerData;
                if (replaceFhirLargeHint) replaceFhirLargeHint.style.display = requiresReplaceForLargePatient ? '' : 'none';
                replaceFhirModal.style.display = '';
                btnReplaceFhirConfirm.focus();

                function stopHold(resetVisual) {
                    if (holdTimer) {
                        clearInterval(holdTimer);
                        holdTimer = null;
                    }
                    if (holdAnimationFrame) {
                        cancelAnimationFrame(holdAnimationFrame);
                        holdAnimationFrame = 0;
                    }
                    if (resetVisual && !holdCompleted) {
                        if (replaceFhirHoldFill) {
                            replaceFhirHoldFill.style.width = '0%';
                            replaceFhirHoldFill.setAttribute('aria-valuenow', '0');
                        }
                        if (replaceFhirHoldHint) replaceFhirHoldHint.textContent = 'Press and hold the button to confirm destructive replace.';
                    }
                }

                function completeHold() {
                    if (holdCompleted) return;
                    holdCompleted = true;
                    stopHold(false);
                    if (replaceFhirHoldFill) {
                        replaceFhirHoldFill.style.width = '100%';
                        replaceFhirHoldFill.setAttribute('aria-valuenow', '100');
                    }
                    btnReplaceFhirConfirm.classList.remove('btn-danger');
                    btnReplaceFhirConfirm.classList.add('btn-success');
                    if (replaceFhirHoldHint) replaceFhirHoldHint.textContent = 'Confirmed. Starting purge + replace...';

                    // Give the user a visible completion moment (full bar + green button)
                    // before closing the modal and starting server-side work.
                    setTimeout(function () { cleanup('replace'); }, postConfirmVisualDelayMs);
                }

                function startHold(ev) {
                    if (ev) ev.preventDefault();
                    if (btnReplaceFhirConfirm.disabled || holdCompleted) return;
                    holdStart = Date.now();
                    if (replaceFhirHoldHint) replaceFhirHoldHint.textContent = 'Keep holding...';
                    stopHold(false);

                    // Keep a short interval for legacy environments where RAF timing can be throttled,
                    // but use RAF for smoother visual updates and reliable "fill to 100%" rendering.
                    holdTimer = setInterval(function () {
                        if (holdCompleted) return;
                        var elapsed = Date.now() - holdStart;
                        var pct = Math.min(100, Math.round((elapsed / holdDurationMs) * 100));
                        if (replaceFhirHoldFill) {
                            replaceFhirHoldFill.style.width = pct + '%';
                            replaceFhirHoldFill.setAttribute('aria-valuenow', String(pct));
                        }
                        if (pct >= 100) completeHold();
                    }, 30);

                    (function animateHold() {
                        if (holdCompleted) return;
                        var elapsed = Date.now() - holdStart;
                        var pct = Math.min(100, Math.round((elapsed / holdDurationMs) * 100));
                        if (replaceFhirHoldFill) {
                            replaceFhirHoldFill.style.width = pct + '%';
                            replaceFhirHoldFill.setAttribute('aria-valuenow', String(pct));
                        }
                        if (pct >= 100) {
                            completeHold();
                            return;
                        }
                        holdAnimationFrame = requestAnimationFrame(animateHold);
                    })();
                }

                function cancelHold(ev) {
                    if (ev) ev.preventDefault();
                    if (holdCompleted) return;
                    stopHold(true);
                }

                function cleanup(result) {
                    stopHold(false);
                    replaceFhirModal.style.display = 'none';
                    btnReplaceFhirConfirm.removeEventListener('pointerdown', startHold);
                    btnReplaceFhirConfirm.removeEventListener('pointerup', cancelHold);
                    btnReplaceFhirConfirm.removeEventListener('pointerleave', cancelHold);
                    btnReplaceFhirConfirm.removeEventListener('pointercancel', cancelHold);
                    btnUseServerData.removeEventListener('click', onUseServerData);
                    btnReplaceFhirCancel.removeEventListener('click', onCancel);
                    btnReplaceFhirClose.removeEventListener('click', onCancel);
                    document.removeEventListener('keydown', onDocumentKeyDown, true);
                    document.removeEventListener('keyup', onDocumentKeyUp, true);
                    if (replaceFhirBackdrop) replaceFhirBackdrop.removeEventListener('click', onCancel);
                    resolve(result);
                }

                function onUseServerData() { cleanup('use-server'); }
                function onCancel() { cleanup('cancel'); }
                function onDocumentKeyDown(ev) {
                    if (replaceFhirModal.style.display === 'none') return;

                    if (ev.key === 'Escape') {
                        ev.preventDefault();
                        onCancel();
                        return;
                    }

                    if (holdCompleted) return;
                    if (document.activeElement !== btnReplaceFhirConfirm) return;
                    if (ev.repeat) return;
                    if (ev.key !== ' ' && ev.key !== 'Enter') return;

                    keyboardHoldActive = true;
                    startHold(ev);
                }

                function onDocumentKeyUp(ev) {
                    if (!keyboardHoldActive) return;
                    if (ev.key !== ' ' && ev.key !== 'Enter') return;

                    keyboardHoldActive = false;
                    cancelHold(ev);
                }

                btnReplaceFhirConfirm.addEventListener('pointerdown', startHold);
                btnReplaceFhirConfirm.addEventListener('pointerup', cancelHold);
                btnReplaceFhirConfirm.addEventListener('pointerleave', cancelHold);
                btnReplaceFhirConfirm.addEventListener('pointercancel', cancelHold);
                btnUseServerData.addEventListener('click', onUseServerData);
                btnReplaceFhirCancel.addEventListener('click', onCancel);
                btnReplaceFhirClose.addEventListener('click', onCancel);
                document.addEventListener('keydown', onDocumentKeyDown, true);
                document.addEventListener('keyup', onDocumentKeyUp, true);
                if (replaceFhirBackdrop) replaceFhirBackdrop.addEventListener('click', onCancel);
            });
        }

