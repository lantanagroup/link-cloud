        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }
        function escAttr(s) {
            return esc(s)
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
