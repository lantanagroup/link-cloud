        function syncCount() {
            var t = getCohorts().reduce(function (s, c) { return s + (c.patientCount || 0); }, 0);
            var importedCount = importedRows ? importedRows.children.length : 0;
            document.getElementById('PatientCount').value = (t + importedCount) > 0 ? (t + importedCount) : 0;
        }
        function getCohorts() {
            return Array.prototype.map.call(cohortRows.children, function (row) {
                var configSelect = row.querySelector('.cohort-patient-config');
                var cfg = findPatientConfig(configSelect && configSelect.value);
                var min = (cfg && cfg.resourcesPerPatientMin) || parseInt(row.dataset.resourcesMin || '50', 10);
                var max = (cfg && cfg.resourcesPerPatientMax) || parseInt(row.dataset.resourcesMax || String(min), 10);
                if (max < min) max = min;
                var intent = null;
                try { intent = row.dataset.intentJson ? JSON.parse(row.dataset.intentJson) : null; } catch (_) { intent = null; }
                var predicted = predictedEligForRow(row);
                var anyQ = selectedMeasureTypes().some(function (m) { return predicted[m] === QUALIFYING; });
                var ids = cfg && cfg.clinicalScenarioIds ? cfg.clinicalScenarioIds : [];
                return {
                    patientCount: parseInt(row.querySelector('.cohort-count').value || '0', 10),
                    cohortQualification: anyQ ? QUALIFYING : NON_QUALIFYING,
                    measureEligibilities: predicted,
                    eligibleClinicalScenarioIds: ids.length ? [ids[0]] : [],
                    resourcesPerPatientMin: min, resourcesPerPatientMax: max,
                    scheduledInpatientPattern: normalizeScheduledPattern((cfg && cfg.scheduledInpatientPattern) || DEFAULT_SCHEDULED_PATTERN),
                    patientConfigurationId: configSelect && configSelect.value ? configSelect.value : null,
                    intent: intent
                };
            }).filter(function (c) { return c.patientCount > 0; });
        }

