        // Public API — any page can open the editor via this global.
        window.openScenarioEditor = function (id, mode) { return openEditor(id || null, mode || 'edit'); };

        // ---- Save ----
        btnSave.addEventListener('click', async function () {
            clearErrors();
            var model = collectModel();
            var valid = true;

            if (!(model.name || '').trim()) {
                markFieldError('ScenarioName', 'Name is required.');
                valid = false;
            }

            if (!(model.nhsnOrganizationId || '').trim()) {
                markFieldError('NhsnOrganizationId', 'NHSN Organization ID is required.');
                valid = false;
            }

            if (!model.selectedMeasures.length) {
                showError('At least one measure must be selected.');
                valid = false;
            }

            var hasImported = (model.importedPatientIds && model.importedPatientIds.length > 0)
                || (model.importedPatientBundles && model.importedPatientBundles.length > 0);

            if (!model.patientCohorts.length && !hasImported) {
                showError('At least one cohort with patients > 0 (or one imported patient) is required.');
                valid = false;
            }
            if (model.concurrency != null && (model.concurrency < 1 || model.concurrency > 8)) {
                markFieldError('Concurrency', 'FHIR query parallelism must be between 1 and 8.');
                valid = false;
            }
            if (model.targetDurationSeconds != null && model.targetDurationSeconds < 1) {
                markFieldError('TargetDurationSeconds', 'Time budget must be a positive number of seconds.');
                valid = false;
            }

            var missingConfig = Array.prototype.findIndex.call(
                cohortRows.children,
                function (row) {
                    var patientCount = parseInt(row.querySelector('.cohort-count').value || '0', 10);
                    if (patientCount <= 0) return false;
                    var sel = row.querySelector('.cohort-patient-config');
                    return !sel || !sel.value;
                });
            if (missingConfig >= 0) {
                showError(
                    'Cohort ' + (missingConfig + 1) +
                    ' needs a Patient Configuration. Click Configure, pick a Clinical Profile, and save it.');
                valid = false;
            }

            if (!model.reportPeriodStart) {
                markFieldError('ReportPeriodStart', 'Report Period Start is required. Generated stays are placed against this window.');
                valid = false;
            }
            if (!model.reportPeriodEnd) {
                markFieldError('ReportPeriodEnd', 'Report Period End is required. Generated stays are placed against this window.');
                valid = false;
            }
            // Imported-by-ID rows must have a non-empty patient id.
            var badId = (model.importedPatientIds || []).find(function (p) {
                return !(p.patientId || '').trim();
            });

            if (badId) {
                showError('Every imported-by-ID row must have a Patient ID.');
                valid = false;
            }

            if (!valid) return;

            model.id = idInput.value || crypto.randomUUID();

            try {
                await postJson(saveUrl, model);
                closeModal();
                notifyChanged('saved', model.id, model.name);
            } catch (err) {
                showError('Save failed: ' + (err.message || 'Unknown error'));
            }
        });

        // ---- Table button handlers (only present on the Scenarios list page) ----
        var btnNew = document.getElementById('btnNewScenario');
        if (btnNew) btnNew.addEventListener('click', function () { openEditor(null, 'edit'); });

        document.querySelectorAll('.btn-scenario-open').forEach(function (btn) {
            btn.addEventListener('click', function () { openEditor(btn.getAttribute('data-id'), btn.getAttribute('data-mode')); });
        });

        document.querySelectorAll('.btn-scenario-clone').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                try {
                    var res = await postJson(cloneUrl, { id: btn.getAttribute('data-id') });
                    notifyChanged('cloned', res && res.id, null);
                }
                catch (err) { showError('Clone failed: ' + (err.message || 'Unknown error')); }
            });
        });

        var cfgGenAnalyzeUrl = '@Url.Action("Analyze", "ConfigurationGeneration")';
        var cfgGenApplyOrmUrl = '@Url.Action("ApplyOrm", "ConfigurationGeneration")';
        var cfgGenApplyNormUrl = '@Url.Action("ApplyNormalization", "ConfigurationGeneration")';
        var cfgGenFingerprint = null;
        var cfgGenLastOrmId = null;
        var cfgGenLastSuiteId = null;

        function upsertSelectOption(selectId, id, name) {
            var sel = document.getElementById(selectId);
            if (!sel || !id) return;
            var existing = Array.prototype.find.call(sel.options, function (o) { return o.value === String(id); });
            if (!existing) {
                var opt = document.createElement('option');
                opt.value = String(id);
                opt.textContent = name || String(id);
                sel.appendChild(opt);
            }
            sel.value = String(id);
        }

        function collectImportedAnalyzeRequest() {
            var rows = importedRows ? importedRows.children : [];
            var sources = [];
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                if (row.dataset.source === 'Bundle' && (row.dataset.uploadedBundleId || row.dataset.bundleJson)) {
                    sources.push({
                        source: 'Bundle',
                        uploadedBundleId: row.dataset.uploadedBundleId || null,
                        bundleJson: row.dataset.uploadedBundleId ? null : (row.dataset.bundleJson || null)
                    });
                    continue;
                }
                if (row.dataset.source === 'ExistingId') {
                    var pid = (row.querySelector('.imp-pid') || {}).value;
                    if (pid) sources.push({ source: 'ExistingId', patientId: pid });
                }
            }
            if (!sources.length) return null;
            return {
                sources: sources,
                priorFingerprint: cfgGenFingerprint,
                refineOrmId: cfgGenLastOrmId,
                refineSuiteId: cfgGenLastSuiteId
            };
        }

        var btnSuggest = document.getElementById('btnSuggestFromImported');
        if (btnSuggest) {
            btnSuggest.addEventListener('click', async function () {
                if (!window.BundleConfigGeneration) {
                    showError('Configuration generator script failed to load.');
                    return;
                }
                var req = collectImportedAnalyzeRequest();
                if (!req) {
                    showError('Add or upload at least one imported patient first.');
                    return;
                }
                try {
                    btnSuggest.disabled = true;
                    var proposal = await window.BundleConfigGeneration.analyzeAndShow(
                        { analyze: cfgGenAnalyzeUrl, applyOrm: cfgGenApplyOrmUrl, applyNorm: cfgGenApplyNormUrl },
                        req,
                        {
                            selectOrmLabel: 'Save new ORM and select it',
                            selectSuiteLabel: 'Save new suite and select it',
                            namePrefix: (document.getElementById('ScenarioName') || {}).value || '',
                            onSelectOrm: function (id, name) {
                                upsertSelectOption('OrganizationResourceMap', id, name);
                            },
                            onSelectSuite: function (id, name) {
                                upsertSelectOption('NormalizationSuite', id, name);
                            },
                            onSavedOrm: function (id) { cfgGenLastOrmId = id; },
                            onSavedSuite: function (id) { cfgGenLastSuiteId = id; },
                            onExtendOrm: async function (id) {
                                var refined = await window.BundleConfigGeneration.postJson(cfgGenAnalyzeUrl, Object.assign({}, req, { refineOrmId: id }));
                                cfgGenFingerprint = refined.fingerprint || refined.Fingerprint || cfgGenFingerprint;
                                var saved = await window.BundleConfigGeneration.postJson(cfgGenApplyOrmUrl, {
                                    proposal: refined.orm || refined.Orm,
                                    updateExistingId: id
                                });
                                cfgGenLastOrmId = saved.id || saved.Id;
                                upsertSelectOption('OrganizationResourceMap', saved.id || saved.Id, saved.name || saved.Name);
                            },
                            onExtendSuite: async function (id) {
                                var refined = await window.BundleConfigGeneration.postJson(cfgGenAnalyzeUrl, Object.assign({}, req, { refineSuiteId: id }));
                                cfgGenFingerprint = refined.fingerprint || refined.Fingerprint || cfgGenFingerprint;
                                var saved = await window.BundleConfigGeneration.postJson(cfgGenApplyNormUrl, {
                                    proposal: refined.normalization || refined.Normalization,
                                    updateExistingSuiteId: id
                                });
                                cfgGenLastSuiteId = saved.id || saved.Id;
                                upsertSelectOption('NormalizationSuite', saved.id || saved.Id, saved.name || saved.Name);
                            }
                        });
                    cfgGenFingerprint = proposal.fingerprint || proposal.Fingerprint || cfgGenFingerprint;
                } catch (err) {
                    showError(err.message || 'Suggestion failed.');
                } finally {
                    btnSuggest.disabled = false;
                }
            });
        }

        document.querySelectorAll('.btn-scenario-delete').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                if (!confirm('Delete this scenario?')) return;
                try {
                    await postJson(deleteUrl, { id: btn.getAttribute('data-id') });
                    notifyChanged('deleted', btn.getAttribute('data-id'), null);
                }
                catch (err) { showError('Delete failed: ' + (err.message || 'Unknown error')); }
            });
        });
    })();
</script>
