            var ct = res.headers.get('content-type') || '';
            return ct.indexOf('json') >= 0 ? res.json() : null;
        }

        // ---- Measure helpers ----
        function selectedMeasureTypes() {
            var seen = {};
            var out = [];
            document.querySelectorAll('.measure-checkbox:checked').forEach(function (cb) {
                var family = cb.getAttribute('data-family') || cb.value;
                if (!seen[family]) { seen[family] = true; out.push(family); }
            });
            return out;
        }
        function selectedMeasureIds() {
            return Array.prototype.map.call(document.querySelectorAll('.measure-checkbox:checked'), function (cb) { return cb.value; });
        }
        function measureCheckboxForFamily(family) {
            return document.querySelector('.measure-checkbox[data-family="' + family + '"]');
        }
        function sid(v) { return String(v || '').toLowerCase(); }

        function normalizeEligMap(raw) {
            var n = {};
            selectedMeasureTypes().forEach(function (m) {
                if (!raw || !Object.prototype.hasOwnProperty.call(raw, m)) { n[m] = NON_QUALIFYING; return; }
                var v = raw[m]; n[m] = (v === QUALIFYING || v === 0 || v === '0') ? QUALIFYING : NON_QUALIFYING;
            });
            return n;
        }

        function normalizeScheduledPattern(value) {
            var raw = String(value || '').trim();
            if (!raw) return DEFAULT_SCHEDULED_PATTERN;
            var direct = scheduledPatternOptions.find(function (o) { return o.value === raw; });
            if (direct) return direct.value;

            var lowered = raw.toLowerCase();
            var byCaseInsensitiveName = scheduledPatternOptions.find(function (o) { return o.value.toLowerCase() === lowered; });
            if (byCaseInsensitiveName) return byCaseInsensitiveName.value;

            var numeric = parseInt(raw, 10);
            if (!isNaN(numeric) && numeric >= 0 && numeric < scheduledPatternOptions.length)
                return scheduledPatternOptions[numeric].value;

            return DEFAULT_SCHEDULED_PATTERN;
        }

        function patternExpectedInReport(pattern) {
            var normalized = normalizeScheduledPattern(pattern);
            var match = scheduledPatternOptions.find(function (o) { return o.value === normalized; });
            return match ? !!match.expectedInReport : true;
        }

        function buildScheduledPatternEditor(pattern) {
            var selected = normalizeScheduledPattern(pattern);
            var options = scheduledPatternOptions.map(function (o) {
                return '<option value="' + o.value + '" title="' + escAttr(o.hint || o.label) + '" ' + (o.value === selected ? 'selected' : '') + '>' + esc(o.label) + '</option>';
            }).join('');
            return '<select class="form-select form-select-sm cohort-scheduled-pattern">' + options + '</select>';
        }

        function qualificationInputsFromIntent(intent, clinicalScenarioId) {
