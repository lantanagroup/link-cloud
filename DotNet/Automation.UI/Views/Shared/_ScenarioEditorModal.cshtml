            showPcCohortErr('');
        }
        function openCohortCustomize(row) {
            if (!pcEditor || !row) return;
            pcCohortRow = row;
            var select = row.querySelector('.cohort-patient-config');
            var configId = select && select.value;
            pcEditor.ensureCatalog().then(function () {
                pcEditor.setMode('cohort');
                syncEditorReportPeriod();
                showPcCohortErr('');
                function show() { document.getElementById('pcCohortModal').style.display = ''; }
                if (!configId) {
                    pcEditor.setReadOnly(false);
                    pcEditor.setBanner('Pick a Clinical Profile to fill this form, then name and save the configuration onto this cohort.');
                    pcEditor.populate({
                        id: crypto.randomUUID(),
                        name: '',
                        resourcesPerPatientMin: 50,
                        resourcesPerPatientMax: 100,
                        scheduledInpatientPattern: DEFAULT_SCHEDULED_PATTERN,
                        intent: {}
                    });
                    show();
                    return;
                }
                return fetch(patientConfigGetUrl + '?id=' + encodeURIComponent(configId)).then(function (r) { return r.json(); }).then(function (model) {
                    var system = !!model.isSystem;
                    if (system) {
                        model.id = crypto.randomUUID();
                        model.isSystem = false;
                        model.name = (model.name || 'Configuration') + ' (custom)';
                    }
                    pcEditor.setReadOnly(false);
                    pcEditor.setBanner(system
                        ? 'This started from a system kit. Saving creates your own named configuration on this cohort.'
                        : 'Editing “' + (model.name || 'this configuration') + '”. Save writes back to the library and this cohort.');
                    return pcEditor.populate(model);
                }).then(show).catch(function (e) { showPcCohortErr(e.message); });
            });
        }
        function saveCohortAsConfiguration() {
            if (!pcEditor || !pcCohortRow) return;
            var model = pcEditor.collect();
            if (!(model.name || '').trim()) { showPcCohortErr('Name is required.'); return; }
            if (!model.clinicalScenarioIds || !model.clinicalScenarioIds.length) {
                showPcCohortErr('Select a Clinical Profile. That fills the rest of this configuration.');
                return;
            }
            model.isSystem = false;
            if (!model.id) model.id = crypto.randomUUID();
            var tokenEl = document.querySelector('#scenarioModal input[name="__RequestVerificationToken"]') || document.querySelector('input[name="__RequestVerificationToken"]');
            var headerToken = tokenEl ? tokenEl.value : '';
            fetch(patientConfigSaveUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': headerToken },
                body: JSON.stringify(model)
            }).then(function (r) {
                if (!r.ok) return r.text().then(function (t) { throw new Error(t || r.statusText); });
                return r.json().then(function (body) {
                    var id = body.id || model.id;
                    var existing = findPatientConfig(id);
                    if (existing) {
                        existing.name = model.name;
                        existing.clinicalScenarioIds = model.clinicalScenarioIds;
                        existing.resourcesPerPatientMin = model.resourcesPerPatientMin;
                        existing.resourcesPerPatientMax = model.resourcesPerPatientMax;
                        existing.scheduledInpatientPattern = model.scheduledInpatientPattern || DEFAULT_SCHEDULED_PATTERN;
                        existing.qualificationInputs = qualificationInputsFromIntent(
                            model.intent,
                            model.clinicalScenarioIds && model.clinicalScenarioIds[0]);
                    } else {
                        patientConfigurationCatalog.push({
                            id: id,
                            name: model.name,
                            isSystem: false,
                            clinicalScenarioIds: model.clinicalScenarioIds,
                            resourcesPerPatientMin: model.resourcesPerPatientMin,
                            resourcesPerPatientMax: model.resourcesPerPatientMax,
                            scheduledInpatientPattern: model.scheduledInpatientPattern || DEFAULT_SCHEDULED_PATTERN,
                            qualificationInputs: qualificationInputsFromIntent(
                                model.intent,
                                model.clinicalScenarioIds && model.clinicalScenarioIds[0])
                        });
                        Array.prototype.forEach.call(cohortRows.querySelectorAll('.cohort-patient-config'), function (sel) {
                            var opt = document.createElement('option');
                            opt.value = id;
                            opt.textContent = model.name;
                            sel.appendChild(opt);
                        });
                    }
                    var select = pcCohortRow.querySelector('.cohort-patient-config');
                    if (select) select.value = id;
                    pcCohortRow.dataset.patientConfigurationId = id;
                    pcCohortRow.dataset.intentJson = '';
                    syncPatientConfigLock(pcCohortRow, true);
                    renderRowPredicted(pcCohortRow);
                    closeCohortCustomize();
                });
            }).catch(function (e) { showPcCohortErr(e.message); });
        }
