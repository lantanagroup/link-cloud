@model Automation.UI.Models.RunsIndexViewModel
@{
    var initialScenarioId = ((Guid?)ViewBag.InitialScenarioId)?.ToString() ?? string.Empty;
}

<script>
(function () {
    var initialScenarioId = '@initialScenarioId';
    var clinicalScenarioCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ClinicalScenarios,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    var QUALIFYING = 'Qualifying';
    var NON_QUALIFYING = 'NonQualifying';
    var runForm = document.getElementById('runForm');
    var selector = document.getElementById('savedScenarioSelect');
    var scenarioIdInput = document.getElementById('ScenarioId');
    var isSystemInput = document.getElementById('IsSystemScenario');
    var scenarioNameHidden = document.getElementById('ScenarioNameHidden');
    var runConfigurationJsonHidden = document.getElementById('RunConfigurationJson');
    var title = document.getElementById('scenarioHeaderTitle');
    var headerActions = document.getElementById('scenarioHeaderActions');
    var saveButton = document.getElementById('btnSaveScenario');
    var deleteButton = document.getElementById('btnDeleteScenario');
    var runButton = document.getElementById('runButton');
    var systemScenarioOverlay = document.getElementById('systemScenarioOverlay');
    var cohortRows = document.getElementById('cohortRows');

    function setConfigEditable(editable) {
        systemScenarioOverlay.style.display = editable ? 'none' : '';
    }

    function antiforgeryToken() {
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        return token ? token.value : '';
    }

    function ensureVisible() {
        runForm.style.display = '';
    }

    function resetToNewScenario() {
        ensureVisible();
        scenarioIdInput.value = '';
        isSystemInput.value = 'false';
        title.textContent = 'New Test';
        headerActions.style.display = '';
        saveButton.disabled = false;
        deleteButton.style.display = 'none';
        setConfigEditable(true);

        document.getElementById('ScenarioName').value = 'New Scenario';
        document.getElementById('ScenarioDescription').value = '';
        document.getElementById('ReportMethod').value = 'Adhoc';
        document.getElementById('Seed').value = 20260329;
        document.getElementById('PatientCount').value = 10;
        document.getElementById('ResourcesPerPatient').value = 250;
        document.getElementById('PatientPrefix').value = 'CustomPatient';
        document.getElementById('CleanupFhirData').checked = true;
        document.getElementById('CleanupServiceData').checked = false;

        document.querySelectorAll('.measure-checkbox').forEach(function (cb) { cb.checked = false; });
        document.getElementById('measure_monthly').checked = true;

        cohortRows.innerHTML = '';
        addDefaultCohort(10, true, 50, 100);
        syncPatientCountFromCohorts();
        validateRunForm();
    }

    function scenarioQualifiesForMeasure(scenario, measureType) {
        var q = scenario.qualifiesForMeasureTypes || [];
        return q.indexOf(measureType) >= 0;
    }

    function selectedMeasureTypes() {
        return Array.prototype.map.call(document.querySelectorAll('.measure-checkbox:checked'), function (cb) { return cb.value; });
    }

    function scenarioIdFromValue(v) {
        return String(v || '').toLowerCase();
    }

    function defaultMeasureEligibilities(isQualifying) {
        var map = {};
        selectedMeasureTypes().forEach(function (m) {
            map[m] = isQualifying ? QUALIFYING : NON_QUALIFYING;
        });
        return map;
    }

    function normalizeMeasureEligibilities(raw) {
        var normalized = {};
        selectedMeasureTypes().forEach(function (m) {
            if (!raw || !Object.prototype.hasOwnProperty.call(raw, m)) {
                normalized[m] = QUALIFYING;
                return;
            }
            var v = raw[m];
            if (v === QUALIFYING || v === 0 || v === '0') {
                normalized[m] = QUALIFYING;
            } else {
                normalized[m] = NON_QUALIFYING;
            }
        });
        return normalized;
    }

    function cohortQualifiesForScenario(scenario, measureEligibilities) {
        var selected = selectedMeasureTypes();
        return selected.every(function (m) {
            var desired = Object.prototype.hasOwnProperty.call(measureEligibilities, m)
                ? measureEligibilities[m]
                : QUALIFYING;
            var scenarioQualifies = scenarioQualifiesForMeasure(scenario, m);
            return desired === QUALIFYING ? scenarioQualifies : !scenarioQualifies;
        });
    }

    function eligibleScenarioIdsForMeasureEligibilities(measureEligibilities) {
        var normalized = normalizeMeasureEligibilities(measureEligibilities);
        return clinicalScenarioCatalog
            .filter(function (sc) { return cohortQualifiesForScenario(sc, normalized); })
            .map(function (sc) { return scenarioIdFromValue(sc.scenarioId); });
    }

    function buildMeasureEligibilityEditor(measureEligibilities) {
        var selected = selectedMeasureTypes();
        if (selected.length === 0)
            return '<span class="text-muted small">Select one or more measures</span>';

        return selected.map(function (m) {
            var checkbox = document.querySelector('.measure-checkbox[value="' + m + '"]');
            var label = checkbox
                ? (document.querySelector('label[for="' + checkbox.id + '"]') || { textContent: m }).textContent
                : m;
            var current = Object.prototype.hasOwnProperty.call(measureEligibilities, m)
                ? measureEligibilities[m]
                : QUALIFYING;
            return '<div class="form-check form-check-inline me-3 mb-1">' +
                '<input class="form-check-input cohort-measure-eligibility" type="checkbox" data-measure="' + m + '" ' + (current === QUALIFYING ? 'checked' : '') + ' />' +
                '<label class="form-check-label small">' + label + '</label>' +
            '</div>';
        }).join('');
    }

    function buildScenarioMultiSelect(selectedIndices) {
        var selectedSet = new Set((selectedIndices || []).map(scenarioIdFromValue));
        var selectAllByDefault = selectedSet.size === 0;

        var options = clinicalScenarioCatalog.map(function (sc) {
            var id = scenarioIdFromValue(sc.scenarioId);
            var label = sc.primaryDiagnosis + ' (' + sc.icdCode + ')';
            var checked = (selectAllByDefault || selectedSet.has(id)) ? 'checked' : '';
            return '<div class="form-check mb-1 cohort-scenario-item">' +
                '<label class="form-check-label small">' +
                '<input class="form-check-input cohort-scenario-option me-2" type="checkbox" value="' + id + '" ' + checked + ' />' +
                label +
                '</label>' +
                '</div>';
        }).join('');

        return '<div class="dropdown cohort-scenarios-dropdown">' +
            '<button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start cohort-scenarios-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside">All scenarios selected</button>' +
            '<div class="dropdown-menu p-2 w-100 cohort-scenarios-menu" style="max-height:220px;overflow:auto;">' + options + '</div>' +
            '</div>';
    }

    function addCohortRow(patientCount, measureEligibilities, scenarios, resourcesMin, resourcesMax) {
        var idx = cohortRows.children.length;
        var normalizedEligibilities = normalizeMeasureEligibilities(measureEligibilities);
        var scenarioSelection = (scenarios && scenarios.length > 0)
            ? scenarios
            : eligibleScenarioIdsForMeasureEligibilities(normalizedEligibilities);
        var tr = document.createElement('tr');
        tr.innerHTML =
            '<td class="text-center align-middle">' + (idx + 1) + '</td>' +
            '<td><input type="number" class="form-control form-control-sm cohort-count" min="1" value="' + (patientCount || 1) + '" /></td>' +
            '<td><div class="cohort-measure-editor">' + buildMeasureEligibilityEditor(normalizedEligibilities) + '</div></td>' +
            '<td><input type="number" class="form-control form-control-sm cohort-min" min="1" value="' + (resourcesMin || 50) + '" /></td>' +
            '<td><input type="number" class="form-control form-control-sm cohort-max" min="1" value="' + (resourcesMax || resourcesMin || 100) + '" /></td>' +
            '<td>' + buildScenarioMultiSelect(scenarioSelection) + '</td>' +
            '<td class="text-center align-middle"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-cohort">&times;</button></td>';
        cohortRows.appendChild(tr);
        enforceEligibilityDependencies(tr);
        applyEligibilityFilterToRow(tr, readRowMeasureEligibilities(tr));
        updateScenarioDropdownSummary(tr);
        reindexCohorts();
        syncPatientCountFromCohorts();
        validateRunForm();
    }

    function selectedOptionsAsStrings(containerElement) {
        if (!containerElement) return [];
        return Array.prototype.map.call(
            containerElement.querySelectorAll('.cohort-scenario-option:checked:not(:disabled)'),
            function (cb) { return scenarioIdFromValue(cb.value); })
            .filter(function (v) { return !!v; });
    }

    function updateScenarioDropdownSummary(row) {
        var dropdown = row.querySelector('.cohort-scenarios-dropdown');
        if (!dropdown) return;

        var toggle = dropdown.querySelector('.cohort-scenarios-toggle');
        var allowed = dropdown.querySelectorAll('.cohort-scenario-option:not(:disabled)');
        var selected = dropdown.querySelectorAll('.cohort-scenario-option:checked:not(:disabled)');

        if (allowed.length === 0) {
            toggle.textContent = 'No eligible scenarios';
            return;
        }

        if (selected.length === 0) {
            toggle.textContent = 'Select scenarios';
            return;
        }

        if (selected.length === allowed.length) {
            toggle.textContent = 'All scenarios selected';
            return;
        }

        toggle.textContent = selected.length + ' scenario(s) selected';
    }

    function readRowMeasureEligibilities(row) {
        var values = {};
        row.querySelectorAll('.cohort-measure-eligibility').forEach(function (cb) {
            var measure = cb.getAttribute('data-measure');
            values[measure] = cb.checked ? QUALIFYING : NON_QUALIFYING;
        });
        return normalizeMeasureEligibilities(values);
    }

    function enforceEligibilityDependencies(row, changedMeasure) {
        var hypo = row.querySelector('.cohort-measure-eligibility[data-measure="NhsnGlycemicControlHypoglycemicInitialPopulation"]');
        var ach = row.querySelector('.cohort-measure-eligibility[data-measure="NhsnAcuteCareHospitalMonthlyInitialPopulation"]');

        if (!hypo || !ach) return;

        // Directional UX rules:
        // - checking Hypo auto-checks ACH
        // - unchecking ACH auto-unchecks Hypo
        if (changedMeasure === 'NhsnGlycemicControlHypoglycemicInitialPopulation' && hypo.checked && !ach.checked) {
            ach.checked = true;
            return;
        }

        if (changedMeasure === 'NhsnAcuteCareHospitalMonthlyInitialPopulation' && !ach.checked && hypo.checked) {
            hypo.checked = false;
            return;
        }

        // General safety normalization.
        if (hypo.checked && !ach.checked)
            ach.checked = true;
    }

    function rerenderCohortMeasureEditor(row) {
        var editor = row.querySelector('.cohort-measure-editor');
        if (!editor) return;
        var current = readRowMeasureEligibilities(row);
        editor.innerHTML = buildMeasureEligibilityEditor(current);
        enforceEligibilityDependencies(row);
        applyEligibilityFilterToRow(row, readRowMeasureEligibilities(row));
    }

    function applyEligibilityFilterToRow(row, measureEligibilities) {
        var allowed = new Set(eligibleScenarioIdsForMeasureEligibilities(measureEligibilities));
        var dropdown = row.querySelector('.cohort-scenarios-dropdown');
        var options = dropdown.querySelectorAll('.cohort-scenario-option');

        Array.prototype.forEach.call(options, function (opt) {
            var id = scenarioIdFromValue(opt.value);
            var isAllowed = allowed.has(id);
            var wrapper = opt.closest('.cohort-scenario-item');
            opt.disabled = !isAllowed;
            if (wrapper) {
                wrapper.style.display = isAllowed ? '' : 'none';
            }
            if (!isAllowed) {
                opt.checked = false;
            }
        });

        if (selectedOptionsAsStrings(dropdown).length === 0) {
            Array.prototype.forEach.call(options, function (opt) {
                if (!opt.disabled) {
                    opt.checked = true;
                }
            });
        }

        updateScenarioDropdownSummary(row);
    }

    function addDefaultCohort(patientCount, isQualifying, resourcesMin, resourcesMax) {
        var eligibilities = defaultMeasureEligibilities(!!isQualifying);
        addCohortRow(patientCount, eligibilities, eligibleScenarioIdsForMeasureEligibilities(eligibilities), resourcesMin, resourcesMax);
    }

    function reindexCohorts() {
        Array.prototype.forEach.call(cohortRows.children, function (row, i) {
            row.querySelector('td:first-child').textContent = i + 1;
        });
    }

    function getCohorts() {
        return Array.prototype.map.call(cohortRows.children, function (row) {
            var min = parseInt(row.querySelector('.cohort-min').value || '50', 10);
            var max = parseInt(row.querySelector('.cohort-max').value || String(min), 10);
            if (max < min) {
                max = min;
                row.querySelector('.cohort-max').value = String(max);
            }
            var measureEligibilities = readRowMeasureEligibilities(row);
            return {
                patientCount: parseInt(row.querySelector('.cohort-count').value || '0', 10),
                measureEligibilities: measureEligibilities,
                eligibleClinicalScenarioIds: selectedOptionsAsStrings(row.querySelector('.cohort-scenarios-dropdown')),
                resourcesPerPatientMin: min,
                resourcesPerPatientMax: max
            };
        }).filter(function (c) { return c.patientCount > 0; });
    }

    function validateCohortEligibilityGraph(cohorts) {
        var errors = [];
        var hypo = 'NhsnGlycemicControlHypoglycemicInitialPopulation';
        var ach = 'NhsnAcuteCareHospitalMonthlyInitialPopulation';

        cohorts.forEach(function (cohort, index) {
            var map = cohort.measureEligibilities || {};
            if (Object.prototype.hasOwnProperty.call(map, hypo)
                && Object.prototype.hasOwnProperty.call(map, ach)
                && map[hypo] === QUALIFYING
                && map[ach] !== QUALIFYING) {
                errors.push('Cohort ' + (index + 1) + ': Cannot qualify for Hypoglycemic while non-qualifying for ACH Monthly (ACH is a prerequisite).');
            }
        });

        return errors;
    }

    function renderCohortValidationErrors(errors) {
        var container = document.getElementById('cohortValidationErrors');
        if (!container) return;
        if (!errors || errors.length === 0) {
            container.textContent = '';
            return;
        }
        container.innerHTML = errors.map(function (e) { return '<div>' + e + '</div>'; }).join('');
    }

    function syncPatientCountFromCohorts() {
        var total = getCohorts().reduce(function (sum, c) { return sum + (c.patientCount || 0); }, 0);
        document.getElementById('PatientCount').value = total > 0 ? total : 0;
    }

    function isRunFormValid() {
        if (isSystemInput.value === 'true') {
            renderCohortValidationErrors([]);
            return true;
        }

        var testName = (document.getElementById('ScenarioName').value || '').trim();
        var prefix = (document.getElementById('PatientPrefix').value || '').trim();
        var seed = parseInt(document.getElementById('Seed').value || '0', 10);
        var cohorts = getCohorts();
        var hasMeasures = selectedMeasureTypes().length > 0;
        var hasPatients = cohorts.reduce(function (sum, c) { return sum + (c.patientCount || 0); }, 0) > 0;
        var graphErrors = validateCohortEligibilityGraph(cohorts);
        var cohortsHaveScenarioSelection = Array.prototype.every.call(cohortRows.children, function (row) {
            var selectedIds = selectedOptionsAsStrings(row.querySelector('.cohort-scenarios-dropdown'));
            return selectedIds.length > 0;
        });

        renderCohortValidationErrors(graphErrors);

        return testName.length > 0
            && prefix.length > 0
            && Number.isFinite(seed)
            && seed > 0
            && hasMeasures
            && hasPatients
            && cohortsHaveScenarioSelection
            && graphErrors.length === 0;
    }

    function validateRunForm() {
        var isValid = isRunFormValid();
        runButton.disabled = !isValid;
        return isValid;
    }

    function loadScenario(id) {
        if (!id) return;

        fetch('@Url.Action("GetJson", "Scenarios")' + '?id=' + encodeURIComponent(id))
            .then(function (r) { return r.json(); })
            .then(function (s) {
                ensureVisible();
                scenarioIdInput.value = s.id;
                isSystemInput.value = s.isSystemScenario ? 'true' : 'false';
                title.textContent = s.name || 'Test';
                if (s.isSystemScenario) {
                    headerActions.style.display = 'none';
                    saveButton.disabled = true;
                    deleteButton.style.display = 'none';
                    setConfigEditable(false);
                } else {
                    headerActions.style.display = '';
                    saveButton.disabled = false;
                    deleteButton.style.display = '';
                    setConfigEditable(true);
                }

                document.getElementById('ScenarioName').value = s.name || '';
                document.getElementById('ScenarioDescription').value = s.description || '';
                document.getElementById('ReportMethod').value = s.reportMethod || 'Adhoc';
                document.getElementById('Seed').value = s.seed || 20260329;
                document.getElementById('PatientCount').value = s.patientCount || 10;
                document.getElementById('ResourcesPerPatient').value = s.resourcesPerPatientMin || 250;
                document.getElementById('PatientPrefix').value = s.patientPrefix || 'CustomPatient';
                document.getElementById('CleanupFhirData').checked = s.cleanupFhirData !== false;
                document.getElementById('CleanupServiceData').checked = !!s.cleanupServiceData;

                // Query Plan Template
                var qpSelect = document.getElementById('QueryPlanTemplate');
                if (s.queryPlanTemplateId) {
                    qpSelect.value = s.queryPlanTemplateId;
                } else {
                    // Select the default option
                    var defaultOpt = qpSelect.querySelector('[data-is-default="true"]');
                    if (defaultOpt) qpSelect.value = defaultOpt.value;
                }

                document.querySelectorAll('.measure-checkbox').forEach(function (cb) { cb.checked = false; });
                (s.selectedMeasures || []).forEach(function (m) {
                    var key = String(m);
                    var idMap = {
                        'NhsnAcuteCareHospitalMonthlyInitialPopulation': 'measure_monthly',
                        'NhsnAcuteCareHospitalDailyInitialPopulation': 'measure_daily',
                        'NhsnGlycemicControlHypoglycemicInitialPopulation': 'measure_hypo'
                    };
                    var cb = document.getElementById(idMap[key]);
                    if (cb) cb.checked = true;
                });

                cohortRows.innerHTML = '';
                if (s.patientCohorts && s.patientCohorts.length > 0) {
                    s.patientCohorts.forEach(function (c) {
                        addCohortRow(
                            c.patientCount,
                            c.measureEligibilities || defaultMeasureEligibilities(true),
                            c.eligibleClinicalScenarioIds || [],
                            c.resourcesPerPatientMin || s.resourcesPerPatientMin || 50,
                            c.resourcesPerPatientMax || s.resourcesPerPatientMax || 100);
                    });
                } else {
                    addDefaultCohort(
                        s.patientCount || 10,
                        true,
                        s.resourcesPerPatientMin || 50,
                        s.resourcesPerPatientMax || 100);
                }
                syncPatientCountFromCohorts();
                validateRunForm();
            });
    }

    function selectedMeasures() {
        return Array.prototype.map.call(document.querySelectorAll('.measure-checkbox:checked'), function (cb) { return cb.value; });
    }

    function buildScenarioPayload() {
        var cohorts = getCohorts();
        var cohortMins = cohorts.map(function (c) { return c.resourcesPerPatientMin || 50; });
        var cohortMaxes = cohorts.map(function (c) { return c.resourcesPerPatientMax || 100; });
        var queryPlanSelect = document.getElementById('QueryPlanTemplate');
        var selectedQueryPlanOption = queryPlanSelect && queryPlanSelect.selectedOptions && queryPlanSelect.selectedOptions.length > 0
            ? queryPlanSelect.selectedOptions[0]
            : null;

        return {
            id: scenarioIdInput.value || null,
            name: document.getElementById('ScenarioName').value,
            description: document.getElementById('ScenarioDescription').value,
            isSystemScenario: isSystemInput.value === 'true',
            reportMethod: document.getElementById('ReportMethod').value,
            selectedMeasures: selectedMeasures(),
            seed: parseInt(document.getElementById('Seed').value || '20260329', 10),
            patientCount: parseInt(document.getElementById('PatientCount').value || '0', 10),
            resourcesPerPatientMin: cohortMins.length > 0 ? Math.min.apply(null, cohortMins) : 50,
            resourcesPerPatientMax: cohortMaxes.length > 0 ? Math.max.apply(null, cohortMaxes) : 100,
            patientPrefix: document.getElementById('PatientPrefix').value,
            useMeasureEligibilityProfiles: true,
            patientProfiles: [],
            patientCohorts: cohorts,
            selectedClinicalScenarioIds: [],
            dischargeCount: 0,
            dischargeQualifyingCount: 0,
            dischargeNonQualifyingCount: 0,
            cleanupServiceData: document.getElementById('CleanupServiceData').checked,
            cleanupFhirData: document.getElementById('CleanupFhirData').checked,
            queryPlanTemplateId: document.getElementById('QueryPlanTemplate').value || null,
            queryPlanTemplateName: selectedQueryPlanOption
                ? (selectedQueryPlanOption.getAttribute('data-name') || selectedQueryPlanOption.textContent || '').trim()
                : null
        };
    }

    function upsertScenario(notifyOnSuccess) {
        var id = scenarioIdInput.value || crypto.randomUUID();
        var payload = buildScenarioPayload();
        payload.id = id;
        payload.isSystemScenario = false;

        return fetch('@Url.Action("SaveInline", "Scenarios")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiforgeryToken()
            },
            body: JSON.stringify(payload)
        })
        .then(function (r) {
            if (!r.ok) throw new Error('Failed to save scenario');
            return r.json();
        })
        .then(function (res) {
            scenarioIdInput.value = res.id;
            headerActions.style.display = '';
            saveButton.disabled = false;
            deleteButton.style.display = '';
            setConfigEditable(true);
            var currentId = res.id;
            var existing = Array.prototype.find.call(selector.options, function (o) { return o.value === currentId; });
            if (!existing) {
                var opt = document.createElement('option');
                opt.value = currentId;
                opt.textContent = document.getElementById('ScenarioName').value;
                selector.appendChild(opt);
            } else {
                existing.textContent = document.getElementById('ScenarioName').value;
            }
            selector.value = currentId;
            title.textContent = document.getElementById('ScenarioName').value;
            if (notifyOnSuccess) {
                alert('Test saved.');
            }
            return res.id;
        });
    }

    function saveScenario() {
        upsertScenario(true)
            .catch(function (e) {
                console.error(e);
                alert('Unable to save test.');
            });
    }

    function deleteScenario() {
        var id = scenarioIdInput.value;
        if (!id) return;
        if (isSystemInput.value === 'true') {
            alert('System scenarios cannot be deleted.');
            return;
        }
        if (!confirm('Delete this scenario?')) return;

        fetch('@Url.Action("DeleteInline", "Scenarios")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiforgeryToken()
            },
            body: JSON.stringify({ id: id })
        })
        .then(function (r) {
            if (!r.ok) throw new Error('Failed to delete scenario');
            Array.prototype.forEach.call(selector.options, function (o) {
                if (o.value === id) o.remove();
            });
            selector.value = '';
            resetToNewScenario();
        })
        .catch(function (e) {
            console.error(e);
            alert('Unable to delete scenario.');
        });
    }

    function buildPatientProfilesForRun() {
        // Patient profiles are expanded server-side from cohort definitions
        // (see ResolveRunOptions / ExpandProfilesFromCohorts). No per-patient
        // hidden inputs are needed — the cohort data travels inside
        // RunConfigurationJson, and PatientCount / ResourcesPerPatient cover
        // the top-level values.
        syncPatientCountFromCohorts();
    }

    document.getElementById('btnNewScenario').addEventListener('click', resetToNewScenario);
    selector.addEventListener('change', function () { loadScenario(selector.value); });
    document.getElementById('btnSaveScenario').addEventListener('click', saveScenario);
    document.getElementById('btnDeleteScenario').addEventListener('click', deleteScenario);

    document.getElementById('addQualifyingCohort').addEventListener('click', function () {
        addDefaultCohort(10, true, 50, 100);
    });
    document.getElementById('addNonQualifyingCohort').addEventListener('click', function () {
        addDefaultCohort(10, false, 50, 100);
    });

    cohortRows.addEventListener('click', function (e) {
        if (e.target.closest('.btn-remove-cohort')) {
            e.target.closest('tr').remove();
            reindexCohorts();
            syncPatientCountFromCohorts();
        }
    });

    cohortRows.addEventListener('change', function (e) {
        if (e.target.classList.contains('cohort-measure-eligibility')) {
            var row = e.target.closest('tr');
            enforceEligibilityDependencies(row, e.target.getAttribute('data-measure'));
            applyEligibilityFilterToRow(row, readRowMeasureEligibilities(row));
        }
        if (e.target.classList.contains('cohort-scenario-option')) {
            var optionRow = e.target.closest('tr');
            updateScenarioDropdownSummary(optionRow);
        }
        if (e.target.classList.contains('cohort-count')) {
            syncPatientCountFromCohorts();
        }
        validateRunForm();
    });

    cohortRows.addEventListener('input', function () {
        syncPatientCountFromCohorts();
        validateRunForm();
    });

    document.querySelectorAll('.measure-checkbox').forEach(function (cb) {
        cb.addEventListener('change', function () {
            Array.prototype.forEach.call(cohortRows.children, function (row) {
                rerenderCohortMeasureEditor(row);
            });
            validateRunForm();
        });
    });

    ['ScenarioName', 'PatientPrefix', 'Seed'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', validateRunForm);
            el.addEventListener('change', validateRunForm);
        }
    });

    runForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (!validateRunForm()) {
            alert('Please complete all required fields before running.');
            return;
        }

        // Derive ResourcesPerPatient from cohort max values (cohorts own min/max now).
        var cohorts = getCohorts();
        var cohortMaxes = cohorts.map(function (c) { return c.resourcesPerPatientMax || 100; });
        var effectiveResources = cohortMaxes.length > 0 ? Math.max.apply(null, cohortMaxes) : 250;
        document.getElementById('ResourcesPerPatient').value = effectiveResources;
        buildPatientProfilesForRun();

        var runtimePayload = buildScenarioPayload();
        runtimePayload.id = scenarioIdInput.value || null;
        runtimePayload.isSystemScenario = isSystemInput.value === 'true';
        scenarioNameHidden.value = runtimePayload.name || 'Scenario';
        document.getElementById('ReportMethodHidden').value = document.getElementById('ReportMethod').value || 'Adhoc';
        document.getElementById('QueryPlanTemplateId').value = document.getElementById('QueryPlanTemplate').value || '';
        runConfigurationJsonHidden.value = JSON.stringify(runtimePayload);

        if (runtimePayload.isSystemScenario !== true) {
            try {
                await upsertScenario(false);
                runtimePayload.id = scenarioIdInput.value || runtimePayload.id;
                runConfigurationJsonHidden.value = JSON.stringify(runtimePayload);
            } catch (err) {
                console.error(err);
                alert('Unable to save test before running. Please fix and try again.');
                return;
            }
        }

        runForm.submit();
    });

    validateRunForm();

    // If redirected from Scenarios/Edit, auto-load the selected scenario
    // into the same editor used for run creation.
    if (initialScenarioId) {
        selector.value = initialScenarioId;
        loadScenario(initialScenarioId);
    }

    // --- AJAX Cancel for run rows ---
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-cancel-run');
        if (!btn) return;

        if (!confirm('Cancel this running test and cleanup all related service/FHIR data?')) return;

        var runId = btn.getAttribute('data-run-id');

        btn.disabled = true;
        btn.textContent = 'Cancelling…';

        fetch('@Url.Action("CancelJson", "Runs")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiforgeryToken()
            },
            body: JSON.stringify({ id: runId })
        })
        .then(function (r) { return r.json(); })
        .then(function () {
            var badge = document.querySelector('.run-status-badge[data-run-id="' + runId + '"]');
            if (badge) {
                badge.textContent = 'Cancelled';
                badge.className = 'badge run-status-badge bg-warning text-dark';
            }

            var actionsDiv = btn.closest('.run-actions');
            if (actionsDiv) {
                btn.remove();
                var deleteBtn = document.createElement('button');
                deleteBtn.type = 'button';
                deleteBtn.className = 'btn btn-sm btn-outline-danger btn-delete-run';
                deleteBtn.setAttribute('data-run-id', runId);
                deleteBtn.textContent = 'Delete';
                actionsDiv.appendChild(deleteBtn);
            }
        })
        .catch(function (err) {
            console.error('Cancel failed', err);
            btn.disabled = false;
            btn.textContent = 'Cancel';
            alert('Unable to cancel the run. Please try again.');
        });
    });

    // --- AJAX Delete for run rows ---
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-delete-run');
        if (!btn) return;

        if (!confirm('Delete this run and all persisted data?')) return;

        var runId = btn.getAttribute('data-run-id');

        btn.disabled = true;
        btn.textContent = 'Deleting…';

        fetch('@Url.Action("DeleteJson", "Runs")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiforgeryToken()
            },
            body: JSON.stringify({ id: runId })
        })
        .then(function (r) { return r.json(); })
        .then(function (result) {
            if (result.success) {
                var row = btn.closest('tr');
                if (row) row.remove();
            } else {
                btn.disabled = false;
                btn.textContent = 'Delete';
                alert('Unable to delete the run. It may still be active.');
            }
        })
        .catch(function (err) {
            console.error('Delete failed', err);
            btn.disabled = false;
            btn.textContent = 'Delete';
            alert('Unable to delete the run. Please try again.');
        });
    });

})();
</script>
