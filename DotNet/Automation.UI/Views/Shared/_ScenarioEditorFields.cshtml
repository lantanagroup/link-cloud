@model Automation.UI.Models.RunsIndexViewModel

<div class="au-card">
    <div class="card-header"><i class="bi bi-gear-fill me-2"></i>Start Test</div>
    <div class="card-body">
        @Html.AntiForgeryToken()

        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold" for="savedScenarioSelect">Select Test</label>
                <select class="form-select" id="savedScenarioSelect">
                    <option value="">-- Select a test --</option>
                    @foreach (var s in Model.SavedScenarios)
                    {
                        var suffix = s.IsSystemScenario ? " [System]" : "";
                        <option value="@s.Id">@s.Name@suffix</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-success w-100" id="btnNewScenario">
                    <i class="bi bi-plus-lg"></i> New
                </button>
            </div>
        </div>

        <form asp-controller="Runs" asp-action="Start" method="post" id="runForm" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Scenario" value="@AutomationScenarioKind.Custom" />
            <input type="hidden" name="ReportMethod" id="ReportMethodHidden" value="Adhoc" />
            <input type="hidden" name="ScenarioName" id="ScenarioNameHidden" value="" />
            <input type="hidden" name="RunConfigurationJson" id="RunConfigurationJson" value="" />

            <div class="au-scenario-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="scenarioHeaderTitle"><i class="bi bi-file-earmark-play me-2"></i>New Test</h5>
                <div class="d-flex gap-2" id="scenarioHeaderActions">
                    <button type="button" class="btn btn-success btn-sm" id="btnSaveScenario">
                        <i class="bi bi-floppy"></i> Save
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnDeleteScenario" style="display:none;">
                        <i class="bi bi-x-lg"></i> Delete
                    </button>
                </div>
            </div>

            <input type="hidden" id="ScenarioId" value="" />
            <input type="hidden" id="IsSystemScenario" value="false" />

            <div id="scenarioConfigArea" class="position-relative">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="ScenarioName">Test Name</label>
                    <input class="form-control" id="ScenarioName" maxlength="120" value="New Scenario" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ScenarioDescription">Description</label>
                    <input class="form-control" id="ScenarioDescription" maxlength="500" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="ReportMethod">Report Method <span class="au-info-icon" data-bs-toggle="tooltip" data-bs-placement="right" title="Adhoc: generates an on-demand report for a single period. Scheduled Report: simulates a recurring report schedule with census events and discharge processing. Regenerate Report: re-runs measure evaluation on previously acquired data without re-acquiring from FHIR."><i class="bi bi-info-circle"></i></span></label>
                    <select class="form-select" id="ReportMethod">
                        <option value="Adhoc">Adhoc</option>
                        <option value="ScheduledReport">Scheduled Report</option>
                        <option value="RegenerateReport">Regenerate Report</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label class="form-label">Measures <span class="au-info-icon" data-bs-toggle="tooltip" data-bs-placement="right" title="CQL-based NHSN quality measures evaluated by MeasureEval. Each measure has its own eligibility criteria — patients must have the right encounter types, diagnoses, and clinical data to qualify. Select multiple to run a multi-measure test where patients may qualify for different subsets."><i class="bi bi-info-circle"></i></span></label>
                    <div class="form-check">
                        <input class="form-check-input measure-checkbox" type="checkbox" id="measure_monthly" name="SelectedMeasures" value="NhsnAcuteCareHospitalMonthlyInitialPopulation" checked />
                        <label class="form-check-label" for="measure_monthly">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnAcuteCareHospitalMonthlyInitialPopulation)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input measure-checkbox" type="checkbox" id="measure_daily" name="SelectedMeasures" value="NhsnAcuteCareHospitalDailyInitialPopulation" />
                        <label class="form-check-label" for="measure_daily">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnAcuteCareHospitalDailyInitialPopulation)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input measure-checkbox" type="checkbox" id="measure_hypo" name="SelectedMeasures" value="NhsnGlycemicControlHypoglycemicInitialPopulation" />
                        <label class="form-check-label" for="measure_hypo">@ProfiledMeasureCatalog.GetDisplayName(ProfiledMeasureType.NhsnGlycemicControlHypoglycemicInitialPopulation)</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="QueryPlanTemplate">Query Plan</label>
                    <select class="form-select" id="QueryPlanTemplate">
                        @foreach (var qp in Model.QueryPlanTemplates)
                        {
                            var defaultLabel = qp.IsDefault ? " (Default)" : "";
                            var systemLabel = qp.IsSystem ? " [System]" : "";
                            <option value="@qp.Id" data-name="@qp.Name" data-is-default="@qp.IsDefault.ToString().ToLower()">@qp.Name@defaultLabel@systemLabel</option>
                        }
                    </select>
                    <small class="text-muted">Controls which FHIR resource types are acquired. <a asp-controller="QueryPlans" asp-action="Index" target="_blank">Manage</a></small>
                    <input type="hidden" name="QueryPlanTemplateId" id="QueryPlanTemplateId" value="" />
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="Seed">Seed <span class="au-info-icon" data-bs-toggle="tooltip" data-bs-placement="right" title="Deterministic seed for FHIR data generation. The same seed + cohort configuration always produces identical patient data, making test results reproducible across runs."><i class="bi bi-info-circle"></i></span></label>
                    <input class="form-control" type="number" min="1" id="Seed" name="Seed" value="20260329" />
                </div>
                <div class="col-md-3" id="patientCountGroup">
                    <label class="form-label" for="PatientCount">Patient Count (derived from cohorts)</label>
                    <input class="form-control" type="number" min="1" max="10000" id="PatientCount" name="PatientCount" value="10" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="PatientPrefix">Patient Prefix <span class="au-info-icon" data-bs-toggle="tooltip" data-bs-placement="right" title="Prefix for generated patient IDs (e.g. 'CustomPatient' ? CustomPatient-001, CustomPatient-002). Also used as the FHIR resource ID prefix. Use distinct prefixes to avoid collisions between concurrent runs."><i class="bi bi-info-circle"></i></span></label>
                    <input class="form-control" type="text" id="PatientPrefix" name="PatientPrefix" value="CustomPatient" maxlength="64" />
                </div>
                <input type="hidden" id="ResourcesPerPatient" name="ResourcesPerPatient" value="250" />

                <div class="col-md-3 d-flex align-items-end">
                    <div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="CleanupFhirData" name="CleanupFhirData" value="true" checked />
                            <input type="hidden" name="CleanupFhirData" value="false" />
                            <label class="form-check-label" for="CleanupFhirData">Cleanup FHIR Data <span class="au-info-icon" data-bs-toggle="tooltip" title="When checked, deletes all generated FHIR resources from the FHIR server after the run completes. Recommended for repeated testing to avoid stale data accumulation."><i class="bi bi-info-circle"></i></span></label>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="CleanupServiceData" name="CleanupServiceData" value="true" />
                            <input type="hidden" name="CleanupServiceData" value="false" />
                            <label class="form-check-label" for="CleanupServiceData">Cleanup Service Data <span class="au-info-icon" data-bs-toggle="tooltip" title="When checked, removes all service-side data created by this run: facility configuration, tenant settings, report schedules, data acquisition logs, and query dispatch entries. Use when you want a clean slate between runs."><i class="bi bi-info-circle"></i></span></label>
                        </div>
                    </div>
                </div>

                <div id="cohortBuilder" class="col-12">
                    <div class="au-cohort-card mt-2">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="fw-semibold"><i class="bi bi-people-fill me-1"></i>Cohorts <span class="au-info-icon" data-bs-toggle="tooltip" data-bs-placement="right" title="Cohorts define groups of patients with shared characteristics. Each cohort specifies: how many patients to generate, which measures they should qualify for (via Measure Eligibility checkboxes), a resource count range per patient, and which clinical scenarios (diagnosis profiles) to draw from. Add multiple cohorts to create a mixed patient population — e.g. one qualifying cohort and one non-qualifying cohort."><i class="bi bi-info-circle"></i></span></span>
                                    <p class="text-muted small mb-0 mt-1">
                                        Each cohort defines patient count, per-measure eligibility, and resource range.
                                    </p>
                                </div>
                                <span class="badge bg-secondary" data-bs-toggle="tooltip" title="Hypoglycemic eligibility requires ACH Monthly eligibility. Checking Hypo auto-checks ACH. Unchecking ACH auto-unchecks Hypo.">
                                    <i class="bi bi-info-circle"></i> Eligibility Rules
                                </span>
                            </div>

                            <table class="table table-sm table-bordered mb-2" id="cohortTable">
                                <thead>
                                    <tr>
                                        <th style="width:50px">#</th>
                                        <th style="width:180px">Patient Count</th>
                                        <th style="width:360px">Measure Eligibility <span class="au-info-icon" data-bs-toggle="tooltip" title="Check a measure to make this cohort's patients qualify for it (generate matching encounter types, diagnoses, and clinical data). Uncheck to generate non-qualifying patients for that measure. The clinical profile pool below automatically filters to show only scenarios compatible with your eligibility selections."><i class="bi bi-info-circle"></i></span></th>
                                        <th style="width:140px">Res/Patient Min <span class="au-info-icon" data-bs-toggle="tooltip" title="Minimum number of FHIR resources generated per patient (Observations, Conditions, Procedures, etc). The actual count is randomized between Min and Max using the test seed."><i class="bi bi-info-circle"></i></span></th>
                                        <th style="width:140px">Res/Patient Max</th>
                                        <th>Clinical Profile Pool <span class="au-info-icon" data-bs-toggle="tooltip" title="Clinical diagnosis profiles available for this cohort. Each profile defines a primary diagnosis (ICD-10 code), service type, and associated clinical data patterns. The pool auto-filters based on Measure Eligibility — only profiles that produce qualifying/non-qualifying results for the selected measures are shown. Select specific profiles or leave all checked for maximum variety."><i class="bi bi-info-circle"></i></span></th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody id="cohortRows"></tbody>
                            </table>
                            <div id="cohortValidationErrors" class="small text-danger mb-2"></div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-success" id="addQualifyingCohort">+ Qualifying Cohort</button>
                                <button type="button" class="btn btn-sm btn-outline-warning" id="addNonQualifyingCohort">+ Non-Qualifying Cohort</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div id="systemScenarioOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-au-run" type="submit" id="runButton" disabled>
                    <i class="bi bi-play-fill me-1"></i> Run Test
                </button>
            </div>
        </form>
    </div>
</div>
