<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Automation.UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm au-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Runs" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Automation.UI
                </a>
                <button class="navbar-toggler border-light" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Runs" asp-action="Index"><i class="bi bi-play-circle me-1"></i>Runs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Scenarios" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Scenarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ApiHealth" asp-action="Index"><i class="bi bi-heart-pulse me-1"></i>API Health</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="configurationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sliders me-1"></i>Configurations
                            </a>
                            <ul class="dropdown-menu au-nav-dropdown-menu" aria-labelledby="configurationsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="QueryPlans" asp-action="Index"><i class="bi bi-diagram-3 me-1"></i>Query Plans</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Normalizations" asp-action="Index"><i class="bi bi-funnel me-1"></i>Normalizations</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrganizationResourceMaps" asp-action="Index"><i class="bi bi-diagram-2 me-1"></i>Org Resource Maps</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav au-nav-admin">
                        <li class="nav-item d-none d-sm-flex align-items-center">
                            <span class="navbar-text au-nav-admin-label">Admin</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cleanup" asp-action="Index"><i class="bi bi-recycle me-1"></i>Cleanup</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Automation.UI
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Bootstrap tooltip initialization — covers all pages
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
