@* ========== Suite Editor Modal ========== *@
<div id="suiteModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="suiteModalTitle" tabindex="-1">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:800px;display:flex;flex-direction:column;max-height:90vh;">
