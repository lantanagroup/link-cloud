    function buildCodeSystemMapsFromCardsOrError() {
        const cards = Array.from(document.querySelectorAll('#opCodeSystemMapRows .code-system-map-card'));
        if (cards.length === 0) return null;

        return cards.map((card, index) => {
            const sourceSystem = (card.querySelector('.csm-source-system').value || '').trim();
            const targetSystem = (card.querySelector('.csm-target-system').value || '').trim();
            if (!sourceSystem) throw new Error(`Code System Map #${index + 1} requires Source System.`);
            if (!targetSystem) throw new Error(`Code System Map #${index + 1} requires Target System.`);

            const codeMaps = {};
            const rows = Array.from(card.querySelectorAll('.code-map-entry-row'));
            if (rows.length === 0) throw new Error(`Code System Map #${index + 1} requires at least one Code Map entry.`);

            rows.forEach((row, rowIndex) => {
                const key = (row.querySelector('.code-map-source-key').value || '').trim();
                const code = (row.querySelector('.code-map-target-code').value || '').trim();
                const display = (row.querySelector('.code-map-target-display').value || '').trim();

                if (!key && !code && !display) return;
                if (!key) throw new Error(`Code System Map #${index + 1}, entry #${rowIndex + 1} requires Source Code.`);
                if (!code) throw new Error(`Code System Map #${index + 1}, entry #${rowIndex + 1} requires Target Code.`);
                if (Object.prototype.hasOwnProperty.call(codeMaps, key))
                    throw new Error(`Code System Map #${index + 1}, entry #${rowIndex + 1} duplicates Source Code '${key}'. Source Codes must be unique within a map.`);

                codeMaps[key] = {
                    code: code,
                    display: display || code
                };
            });

            if (Object.keys(codeMaps).length === 0)
                throw new Error(`Code System Map #${index + 1} requires at least one non-empty Code Map entry.`);

            return {
                sourceSystem,
                targetSystem,
                codeMaps
            };
        });
    }

