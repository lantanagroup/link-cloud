    function updateSeqOperationOptions() {
        const selects = Array.from(document.querySelectorAll('#seqEntriesContainer .seq-op-select'));

        selects.forEach(select => {
            const selectedByOtherRows = new Set(
                selects
                    .filter(other => other !== select)
                    .map(other => other.value)
                    .filter(Boolean)
            );

            Array.from(select.options).forEach(option => {
                option.disabled =
                    option.value !== select.value &&
                    selectedByOtherRows.has(option.value);
            });
        });

        document.getElementById('btnAddSeqEntry').disabled =
            selects.length >= allOperations.length;
    }

