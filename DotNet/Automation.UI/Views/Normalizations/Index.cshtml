    function getSuiteSelectedSequenceIds() {
        return Array.from(document.querySelectorAll('#suiteSequencesContainer .suite-seq-select'))
            .map(select => select.value)
            .filter(Boolean);
    }

    function getSuiteSequenceOperationSources() {
        const sourcesByOperation = new Map();

        getSuiteSelectedSequenceIds().forEach(sequenceId => {
            const sequence = allSequences.find(s => s.id === sequenceId);
            if (!sequence) return;

            (sequence.entries || []).forEach(entry => {
                if (!sourcesByOperation.has(entry.operationId)) {
                    sourcesByOperation.set(entry.operationId, []);
                }

                sourcesByOperation.get(entry.operationId).push(`sequence '${sequence.name}'`);
            });
        });

        return sourcesByOperation;
    }

    function refreshSuiteStandaloneOperationOptions() {
        const sequenceOperationSources = getSuiteSequenceOperationSources();

        const standaloneSelects = Array.from(
            document.querySelectorAll('#suiteOpsContainer .suite-op-select')
        );

        standaloneSelects.forEach(select => {
            Array.from(select.options).forEach(option => {
                if (!option.value) {
                    option.disabled = false;
                    return;
                }

                const sources = sequenceOperationSources.get(option.value) || [];

                const selectedElsewhere = standaloneSelects.some(otherSelect =>
                    otherSelect !== select &&
                    otherSelect.value === option.value
                );

                option.disabled =
                    sources.length > 0 ||
                    selectedElsewhere;

                const operation = allOperations.find(
                    o => o.id === option.value
                );

                if (!operation) return;

                option.textContent =
                    `${operation.name} (${operation.operationType})`;

                if (sources.length > 0) {
                    option.textContent +=
                        ` — already included in ${sources.join(', ')}`;
                } else if (selectedElsewhere) {
                    option.textContent +=
                        ' — already selected as a standalone operation';
                }
            });
        });
    }

    function getSuiteDuplicateOperationMessages() {
        const occurrences = new Map();

        function addOccurrence(operationId, source) {
            if (!operationId) return;

            if (!occurrences.has(operationId)) {
                occurrences.set(operationId, []);
            }

            occurrences.get(operationId).push(source);
        }

        getSuiteSelectedSequenceIds().forEach(sequenceId => {
            const sequence = allSequences.find(s => s.id === sequenceId);
            if (!sequence) return;

            (sequence.entries || []).forEach(entry => {
                addOccurrence(
                    entry.operationId,
                    `sequence '${sequence.name}'`
                );
            });
        });

        document.querySelectorAll(
            '#suiteOpsContainer .suite-op-select'
        ).forEach(select => {
            if (select.value) {
                addOccurrence(select.value, 'Standalone Operations');
            }
        });

        return Array.from(occurrences.entries())
            .filter(([, sources]) => sources.length > 1)
            .map(([operationId, sources]) => {
                const operation = allOperations.find(o => o.id === operationId);
                const operationName = operation?.name || operationId;
                const uniqueSources = [...new Set(sources)];

                return `'${operationName}' (${uniqueSources.join(' and ')})`;
        });
    }

    function openSuiteEditor(data, mode) {
        document.getElementById('SuiteId').value = data?.id || '';
        document.getElementById('SuiteIsSystem').value = data?.isSystem ? 'true' : 'false';
        document.getElementById('SuiteName').value = data?.name || '';
        document.getElementById('SuiteDescription').value = data?.description || '';

        const seqContainer = document.getElementById('suiteSequencesContainer');
        seqContainer.innerHTML = '';
        (data?.sequenceIds || []).forEach(sid => addSuiteSeqRow(sid));

        const opContainer = document.getElementById('suiteOpsContainer');
        opContainer.innerHTML = '';
        (data?.operationIds || []).forEach(oid => addSuiteOpRow(oid));

        document.getElementById('btnSuiteSave').style.display = mode === 'edit' ? '' : 'none';
        document.getElementById('suiteSystemOverlay').style.display = mode === 'view' ? '' : 'none';

        const formErrors = document.getElementById('suiteFormErrors');
        formErrors.style.display = 'none';
        formErrors.textContent = '';

        refreshSuiteStandaloneOperationOptions();

        showSuiteModal();
    }

    function addSuiteSeqRow(selectedId) {
        const container = document.getElementById('suiteSequencesContainer');
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 mb-1 align-items-center';

        const sequenceSelect = document.createElement('select');
        sequenceSelect.className = 'form-select form-select-sm suite-seq-select';

        const placeholderOption = document.createElement('option');
        placeholderOption.value = '';
        placeholderOption.textContent = 'Select a sequence...';
        sequenceSelect.appendChild(placeholderOption);

        allSequences.forEach(s => {
            const option = document.createElement('option');
            option.value = s.id;
            option.textContent = s.name;

            if (s.id === selectedId) {
                option.selected = true;
            }

            sequenceSelect.appendChild(option);
        });

        sequenceSelect.addEventListener(
            'change',
            refreshSuiteStandaloneOperationOptions
        );

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'btn btn-sm btn-outline-danger';
        removeButton.innerHTML = '<i class="bi bi-x-lg"></i>';

        removeButton.addEventListener('click', () => {
            row.remove();
            refreshSuiteStandaloneOperationOptions();
        });

        row.appendChild(sequenceSelect);
        row.appendChild(removeButton);
        container.appendChild(row);

        refreshSuiteStandaloneOperationOptions();
    }

    function addSuiteOpRow(selectedId) {
        const container = document.getElementById('suiteOpsContainer');
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 mb-1 align-items-center';

        const operationSelect = document.createElement('select');
        operationSelect.className = 'form-select form-select-sm suite-op-select';

        const placeholderOption = document.createElement('option');
        placeholderOption.value = '';
        placeholderOption.textContent = 'Select an operation...';
        operationSelect.appendChild(placeholderOption);

        allOperations.forEach(o => {
            const option = document.createElement('option');
            option.value = o.id;
            option.textContent = `${o.name} (${o.operationType})`;

            if (o.id === selectedId) {
                option.selected = true;
            }

            operationSelect.appendChild(option);
        });

        operationSelect.addEventListener(
            'change',
            refreshSuiteStandaloneOperationOptions
        );

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'btn btn-sm btn-outline-danger';
        removeButton.innerHTML = '<i class="bi bi-x-lg"></i>';

        removeButton.addEventListener('click', () => {
            row.remove();
            refreshSuiteStandaloneOperationOptions();
        });

        row.appendChild(operationSelect);
        row.appendChild(removeButton);
        container.appendChild(row);

        refreshSuiteStandaloneOperationOptions();
    }

    document.getElementById('btnAddSuiteSeq').addEventListener('click', () => addSuiteSeqRow(null));
    document.getElementById('btnAddSuiteOp').addEventListener('click', () => addSuiteOpRow(null));

    function collectSuiteData() {
        const sequenceIds = [];
        document.querySelectorAll('#suiteSequencesContainer .suite-seq-select').forEach(sel => { if (sel.value) sequenceIds.push(sel.value); });
        const operationIds = [];
        document.querySelectorAll('#suiteOpsContainer .suite-op-select').forEach(sel => { if (sel.value) operationIds.push(sel.value); });
        return {
            id: document.getElementById('SuiteId').value || crypto.randomUUID(),
            name: document.getElementById('SuiteName').value,
            description: document.getElementById('SuiteDescription').value,
            sequenceIds: sequenceIds,
            operationIds: operationIds,
            isSystem: false,
            isDefault: false
        };
    }

    document.getElementById('btnSuiteSave').addEventListener('click', async () => {
        const formErrors = document.getElementById('suiteFormErrors');
        formErrors.style.display = 'none';
        formErrors.textContent = '';

        const duplicates = getSuiteDuplicateOperationMessages();

        if (duplicates.length > 0) {
            formErrors.textContent =
                'Normalization suite cannot contain the same operation more than once. ' +
                `Duplicate operation(s): ${duplicates.join(', ')}.`;
            formErrors.style.display = '';
            return;
        }

        const data = collectSuiteData();

        const resp = await postJson(
            '@Url.Action("SaveSuite", "Normalizations")',
            data
        );

        if (resp.ok) {
            location.reload();
        } else {
            const err = await resp.text();
            formErrors.textContent = err;
            formErrors.style.display = '';
        }
    });

    document.getElementById('btnSuiteClose').addEventListener('click', hideSuiteModal);
    suiteBackdrop.addEventListener('click', hideSuiteModal);
    document.getElementById('btnNewSuite').addEventListener('click', () => openSuiteEditor(null, 'edit'));

    document.querySelectorAll('.btn-suite-open').forEach(btn => btn.addEventListener('click', async () => {
        const resp = await fetch(`@Url.Action("GetSuiteJson", "Normalizations")?id=${btn.dataset.id}`);
        if (resp.ok) openSuiteEditor(await resp.json(), btn.dataset.mode);
    }));
    document.querySelectorAll('.btn-suite-clone').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("CloneSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-suite-default').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("SetDefaultSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-suite-delete').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Delete this suite?')) return;
        await postJson('@Url.Action("DeleteSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));

    const analyzeUrl = '@Url.Action("Analyze", "ConfigurationGeneration")';
    const applyOrmUrl = '@Url.Action("ApplyOrm", "ConfigurationGeneration")';
    const applyNormUrl = '@Url.Action("ApplyNormalization", "ConfigurationGeneration")';
    const normGenKey = 'cfgGen.norm';
    function loadNormGenState(){
        try { return JSON.parse(sessionStorage.getItem(normGenKey) || '{}'); } catch { return {}; }
    }
    function saveNormGenState(state){ sessionStorage.setItem(normGenKey, JSON.stringify(state || {})); }
    function refreshNormGenHint(){
        const hint = document.getElementById('normGenSessionHint');
        if (!hint) return;
        const state = loadNormGenState();
        hint.textContent = state.fingerprint
            ? 'Session has prior patient data. The next analyze will refine the current proposal. Use Start over to reset.'
            : '';
    }
    refreshNormGenHint();
    document.getElementById('btnNormGenerateReset').addEventListener('click', () => {
        sessionStorage.removeItem(normGenKey);
        document.getElementById('normGenFile').value = '';
        refreshNormGenHint();
    });
    document.getElementById('btnNormGenerate').addEventListener('click', async () => {
        const files = document.getElementById('normGenFile').files;
        if (!files.length) { alert('Choose one or more FHIR bundle JSON files first.'); return; }
        const btn = document.getElementById('btnNormGenerate');
        btn.disabled = true;
        try {
        const sources = await window.BundleConfigGeneration.readFilesAsSources(files);
        const state = loadNormGenState();
        const request = { sources, priorFingerprint: state.fingerprint || null, refineOrmId: state.lastOrmId || null, refineSuiteId: state.lastSuiteId || null };
        function persist(idKey, id, proposal){
            const next = loadNormGenState();
            if (proposal) next.fingerprint = proposal.fingerprint || proposal.Fingerprint || next.fingerprint;
            if (idKey && id) next[idKey] = id;
            saveNormGenState(next);
            refreshNormGenHint();
        }
        const proposal = await window.BundleConfigGeneration.analyzeAndShow(
            { analyze: analyzeUrl, applyOrm: applyOrmUrl, applyNorm: applyNormUrl },
            request,
            {
                selectOrmLabel: 'Save new ORM',
                selectSuiteLabel: 'Save new suite',
                onSelectOrm: () => location.reload(),
                onSelectSuite: () => location.reload(),
                onSavedOrm: (id, p) => persist('lastOrmId', id, p || proposal),
                onSavedSuite: (id, p) => persist('lastSuiteId', id, p || proposal),
                onExtendOrm: async (id) => {
                    const refined = await window.BundleConfigGeneration.postJson(analyzeUrl, Object.assign({}, request, { refineOrmId: id }));
                    const saved = await window.BundleConfigGeneration.postJson(applyOrmUrl, { proposal: refined.orm || refined.Orm, updateExistingId: id });
                    persist('lastOrmId', saved.id || saved.Id, refined);
                    location.reload();
                },
                onExtendSuite: async (id) => {
                    const refined = await window.BundleConfigGeneration.postJson(analyzeUrl, Object.assign({}, request, { refineSuiteId: id }));
                    const saved = await window.BundleConfigGeneration.postJson(applyNormUrl, { proposal: refined.normalization || refined.Normalization, updateExistingSuiteId: id });
                    persist('lastSuiteId', saved.id || saved.Id, refined);
                    location.reload();
                }
            });
        persist(null, null, proposal);
        } catch (err) {
            alert(err.message || 'Suggestion failed.');
        } finally {
            btn.disabled = false;
        }
    });
</script>
}