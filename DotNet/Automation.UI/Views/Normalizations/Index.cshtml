@model List<NormalizationOperationDefinition>
@{
    ViewData["Title"] = "Normalizations";
    var operations = (List<NormalizationOperationDefinition>?)ViewBag.Operations ?? [];
    var sequences = (List<NormalizationSequenceDefinition>?)ViewBag.Sequences ?? [];
    var suites = (List<NormalizationSuiteDefinition>?)ViewBag.Suites ?? [];
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-funnel me-2"></i>Normalizations</h2>
    <p class="text-muted mb-3">Manage normalization operations, sequences, and suites. Suites are selectable on scenarios to control which normalizations run during a test.</p>

    <ul class="nav nav-tabs mb-3" id="normTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-operations" data-bs-toggle="tab" data-bs-target="#pane-operations" type="button" role="tab">
                <i class="bi bi-gear me-1"></i>Operations <span class="badge bg-secondary">@operations.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-sequences" data-bs-toggle="tab" data-bs-target="#pane-sequences" type="button" role="tab">
                <i class="bi bi-list-ol me-1"></i>Sequences <span class="badge bg-secondary">@sequences.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-suites" data-bs-toggle="tab" data-bs-target="#pane-suites" type="button" role="tab">
                <i class="bi bi-box me-1"></i>Suites <span class="badge bg-secondary">@suites.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @* ===== Operations Tab ===== *@
        <div class="tab-pane fade show active" id="pane-operations" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-gear me-2"></i>All Operations</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewOp" aria-label="Create new normalization operation" title="Create new normalization operation"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="opTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Resource Types</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:200px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var op in operations)
                            {
                                <tr data-id="@op.Id">
                                    <td>
                                        <strong>@op.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(op.Description))
                                        {
                                            <br /><small class="text-muted">@op.Description</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-info text-dark">@op.OperationType</span></td>
                                    <td><small class="text-muted">@string.Join(", ", op.ResourceTypes)</small></td>
                                    <td>
                                        @if (op.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@op.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-op-open" data-id="@op.Id" data-mode="@(op.IsSystem ? "view" : "edit")">
                                                @(op.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-op-clone" data-id="@op.Id">Clone</button>
                                            @if (!op.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-op-delete" data-id="@op.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (operations.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No operations yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>

        @* ===== Sequences Tab ===== *@
        <div class="tab-pane fade" id="pane-sequences" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-ol me-2"></i>All Sequences</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewSeq" aria-label="Create new normalization sequence" title="Create new normalization sequence"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="seqTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Operations</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:200px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seq in sequences)
                            {
                                <tr data-id="@seq.Id">
                                    <td>
                                        <strong>@seq.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(seq.Description))
                                        {
                                            <br /><small class="text-muted">@seq.Description</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary">@seq.Entries.Count op(s)</span></td>
                                    <td>
                                        @if (seq.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@seq.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-seq-open" data-id="@seq.Id" data-mode="@(seq.IsSystem ? "view" : "edit")">
                                                @(seq.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-seq-clone" data-id="@seq.Id">Clone</button>
                                            @if (!seq.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-seq-delete" data-id="@seq.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (sequences.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No sequences yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>

        @* ===== Suites Tab ===== *@
        <div class="tab-pane fade" id="pane-suites" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-box me-2"></i>All Suites</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewSuite" aria-label="Create new normalization suite" title="Create new normalization suite"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="suiteTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Contents</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:260px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var suite in suites)
                            {
                                <tr data-id="@suite.Id">
                                    <td>
                                        <strong>@suite.Name</strong>
                                        @if (suite.IsDefault)
                                        {
                                            <span class="badge bg-success ms-1">Default</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(suite.Description))
                                        {
                                            <br /><small class="text-muted">@suite.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@suite.SequenceIds.Count seq, @suite.OperationIds.Count op(s)</small>
                                    </td>
                                    <td>
                                        @if (suite.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@suite.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-suite-open" data-id="@suite.Id" data-mode="@(suite.IsSystem ? "view" : "edit")">
                                                @(suite.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-suite-clone" data-id="@suite.Id">Clone</button>
                                            @if (!suite.IsDefault)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success btn-suite-default" data-id="@suite.Id" title="Set as default">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            }
                                            @if (!suite.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-suite-delete" data-id="@suite.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (suites.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No suites yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ========== Operation Editor Modal ========== *@
<div id="opModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="opModalTitle" tabindex="-1">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:800px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="opModalTitle"><i class="bi bi-gear me-2"></i>Operation</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnOpSave" style="display:none;"><i class="bi bi-floppy me-1"></i>Save</button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnOpClose">Close</button>
                </div>
            </div>
            <div id="opFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="opModalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="OpId" />
                <input type="hidden" id="OpIsSystem" value="false" />
                <div id="opConfigArea" class="position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="OpName">Name</label>
                            <input class="form-control" id="OpName" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="OpType">Operation Type</label>
                            <select class="form-select" id="OpType">
                                <option value="CopyProperty">CopyProperty</option>
                                <option value="CopyLocation">CopyLocation</option>
                                <option value="ConditionalTransform">ConditionalTransform</option>
                                <option value="CodeMap">CodeMap</option>
                                <option value="RemoveExtensions">RemoveExtensions</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="OpDescription">Description</label>
                            <input class="form-control" id="OpDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="OpResourceTypes">Resource Types <small class="text-muted">(comma-separated)</small></label>
                            <input class="form-control" id="OpResourceTypes" placeholder="e.g. Location, Encounter, Patient" />
                        </div>

                        @* --- CopyProperty fields --- *@
                        <div class="col-md-6 op-field op-field-CopyProperty">
                            <label class="form-label" for="OpSourceFhirPath">Source FhirPath</label>
                            <input class="form-control" id="OpSourceFhirPath" placeholder="e.g. identifier.value" />
                        </div>
                        <div class="col-md-6 op-field op-field-CopyProperty">
                            <label class="form-label" for="OpTargetFhirPath">Target FhirPath</label>
                            <input class="form-control" id="OpTargetFhirPath" placeholder="e.g. type[0].coding.code" />
                        </div>

                        @* --- ConditionalTransform fields --- *@
                        <div class="col-md-6 op-field op-field-ConditionalTransform">
                            <label class="form-label" for="OpCondTargetFhirPath">Target FhirPath</label>
                            <input class="form-control" id="OpCondTargetFhirPath" />
                        </div>
                        <div class="col-md-6 op-field op-field-ConditionalTransform">
                            <label class="form-label" for="OpCondTargetValue">Target Value</label>
                            <input class="form-control" id="OpCondTargetValue" />
                        </div>
                        <div class="col-12 op-field op-field-ConditionalTransform">
                            <label class="form-label">Conditions</label>
                            <div id="opConditionsContainer"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-1" id="btnAddCondition"><i class="bi bi-plus-lg me-1"></i>Add Condition</button>
                        </div>

                        @* --- CodeMap fields --- *@
                        <div class="col-12 op-field op-field-CodeMap">
                            <label class="form-label" for="OpCodeMapFhirPath">FhirPath</label>
                            <input class="form-control" id="OpCodeMapFhirPath" />
                        </div>
                        <div class="col-12 op-field op-field-CodeMap">
                            <label class="form-label">Code System Maps <small class="text-muted">(JSON)</small></label>
                            <textarea class="form-control font-monospace" id="OpCodeSystemMaps" rows="6" style="font-size:.8rem;"></textarea>
                        </div>

                        @* --- RemoveExtensions fields --- *@
                        <div class="col-12 op-field op-field-RemoveExtensions">
                            <label class="form-label" for="OpExtensionUrls">Extension URLs <small class="text-muted">(one per line)</small></label>
                            <textarea class="form-control font-monospace" id="OpExtensionUrls" rows="4" style="font-size:.8rem;"></textarea>
                        </div>
                    </div>
                    <div id="opSystemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="opModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

