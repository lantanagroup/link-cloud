<div id="suiteModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

@section Scripts {
<script>
    // -- Data from server --
    const allOperations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(operations, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const allSequences = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sequences, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const allSuites = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(suites, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    function postJson(url, body) {
        return fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken }, body: JSON.stringify(body)
        });
    }

    // ============ OPERATION MODAL ============
    const opModal = document.getElementById('opModal');
    const opBackdrop = document.getElementById('opModalBackdrop');

    const modalFocusState = new WeakMap();

    function getFocusableElements(modal) {
        return Array.from(modal.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'))
            .filter(el => el.offsetParent !== null);
    }

    function onModalKeyDown(event) {
        const modal = event.currentTarget;
        const state = modalFocusState.get(modal);

        if (event.key === 'Escape') {
            event.preventDefault();
            if (state?.requestClose) state.requestClose();
            return;
        }

        if (event.key !== 'Tab') return;

        const focusable = getFocusableElements(modal);
        if (!focusable.length) {
            event.preventDefault();
            modal.focus();
            return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    }

    function showCrudModal(modal, backdrop, requestClose) {
        const trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        modalFocusState.set(modal, { trigger, requestClose });

        modal.style.display = '';
        backdrop.style.display = '';
        modal.addEventListener('keydown', onModalKeyDown);

        const focusable = getFocusableElements(modal);
        const focusTarget = focusable[0] || modal;
        setTimeout(() => focusTarget.focus(), 0);
    }

    function hideCrudModal(modal, backdrop) {
        modal.style.display = 'none';
        backdrop.style.display = 'none';
        modal.removeEventListener('keydown', onModalKeyDown);

        const state = modalFocusState.get(modal);
        if (state?.trigger && document.contains(state.trigger)) {
            state.trigger.focus();
        }
        modalFocusState.delete(modal);
    }

    function showOpModal() { showCrudModal(opModal, opBackdrop, hideOpModal); }
    function hideOpModal() { hideCrudModal(opModal, opBackdrop); }

    function toggleOpFields() {
        const t = document.getElementById('OpType').value;
        document.querySelectorAll('.op-field').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.op-field-' + t).forEach(el => el.style.display = '');
    }

    document.getElementById('OpType').addEventListener('change', toggleOpFields);

    function openOpEditor(data, mode) {
        document.getElementById('OpId').value = data?.id || '';
        document.getElementById('OpIsSystem').value = data?.isSystem ? 'true' : 'false';
        document.getElementById('OpName').value = data?.name || '';
        document.getElementById('OpType').value = data?.operationType || 'CopyProperty';
        document.getElementById('OpDescription').value = data?.description || '';
        document.getElementById('OpResourceTypes').value = (data?.resourceTypes || []).join(', ');
        document.getElementById('OpSourceFhirPath').value = data?.sourceFhirPath || '';
        document.getElementById('OpTargetFhirPath').value = data?.targetFhirPath || '';
        document.getElementById('OpCondTargetFhirPath').value = data?.conditionTargetFhirPath || '';
        document.getElementById('OpCondTargetValue').value = data?.conditionTargetValue || '';
        document.getElementById('OpCodeMapFhirPath').value = data?.codeMapFhirPath || '';
        document.getElementById('OpCodeSystemMaps').value = data?.codeSystemMaps ? JSON.stringify(data.codeSystemMaps, null, 2) : '';
        document.getElementById('OpExtensionUrls').value = (data?.extensionUrls || []).join('\n');

        // Conditions
        const condContainer = document.getElementById('opConditionsContainer');
        condContainer.innerHTML = '';
        (data?.conditions || []).forEach(c => addConditionRow(c));

        toggleOpFields();
        document.getElementById('btnOpSave').style.display = mode === 'edit' ? '' : 'none';
        document.getElementById('opSystemOverlay').style.display = mode === 'view' ? '' : 'none';
        document.getElementById('opFormErrors').style.display = 'none';
        showOpModal();
    }

    function addConditionRow(cond) {
        const container = document.getElementById('opConditionsContainer');
        const operators = ['Equal','NotEqual','GreaterThan','GreaterThanOrEqual','LessThan','LessThanOrEqual','Exists','NotExists'];
        const row = document.createElement('div');
        row.className = 'row g-2 mb-1 align-items-center';

        const col1 = document.createElement('div');
        col1.className = 'col-4';
        const fhirPathInput = document.createElement('input');
        fhirPathInput.className = 'form-control form-control-sm cond-fhirpath';
        fhirPathInput.placeholder = 'FhirPath';
        fhirPathInput.value = cond?.fhirPathSource || '';
        col1.appendChild(fhirPathInput);

        const col2 = document.createElement('div');
        col2.className = 'col-3';
        const operatorSelect = document.createElement('select');
        operatorSelect.className = 'form-select form-select-sm cond-operator';
        const selectedOperator = cond?.operator || 'Equal';
        operators.forEach(o => {
            const option = document.createElement('option');
            option.value = o;
            option.textContent = o;
            if (o === selectedOperator) option.selected = true;
            operatorSelect.appendChild(option);
        });
        col2.appendChild(operatorSelect);

        const col3 = document.createElement('div');
        col3.className = 'col-3';
        const valueInput = document.createElement('input');
        valueInput.className = 'form-control form-control-sm cond-value';
        valueInput.placeholder = 'Value';
        valueInput.value = cond?.value ?? '';
        col3.appendChild(valueInput);

        const col4 = document.createElement('div');
        col4.className = 'col-2';
        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'btn btn-sm btn-outline-danger';
        removeButton.innerHTML = '<i class="bi bi-x-lg"></i>';
        removeButton.addEventListener('click', () => row.remove());
        col4.appendChild(removeButton);

        row.appendChild(col1);
        row.appendChild(col2);
        row.appendChild(col3);
        row.appendChild(col4);
        container.appendChild(row);
    }

    document.getElementById('btnAddCondition').addEventListener('click', () => addConditionRow(null));

    function parseCodeSystemMapsOrError() {
        const csmText = document.getElementById('OpCodeSystemMaps').value.trim();
        if (!csmText) return [];

        let parsed;
        try {
            parsed = JSON.parse(csmText);
        } catch (e) {
            throw new Error('Code System Maps must be valid JSON.');
        }

        if (!Array.isArray(parsed))
            throw new Error('Code System Maps JSON must be an array.');

        parsed.forEach((m, i) => {
            if (!m || typeof m !== 'object' || Array.isArray(m))
                throw new Error(`Code System Maps entry #${i + 1} must be an object.`);
            if (typeof m.sourceSystem !== 'string' || !m.sourceSystem.trim())
                throw new Error(`Code System Maps entry #${i + 1} requires a non-empty sourceSystem.`);
            if (typeof m.targetSystem !== 'string' || !m.targetSystem.trim())
                throw new Error(`Code System Maps entry #${i + 1} requires a non-empty targetSystem.`);
            if (!m.codeMaps || typeof m.codeMaps !== 'object' || Array.isArray(m.codeMaps))
                throw new Error(`Code System Maps entry #${i + 1} requires a codeMaps object.`);
        });

        return parsed;
    }

    function collectOpData() {
        const conditions = [];
        document.querySelectorAll('#opConditionsContainer .row').forEach(row => {
            conditions.push({
                fhirPathSource: row.querySelector('.cond-fhirpath').value,
                operator: row.querySelector('.cond-operator').value,
                value: row.querySelector('.cond-value').value || null
            });
        });

        const codeSystemMaps = parseCodeSystemMapsOrError();

        return {
            id: document.getElementById('OpId').value || crypto.randomUUID(),
            name: document.getElementById('OpName').value,
            operationType: document.getElementById('OpType').value,
            description: document.getElementById('OpDescription').value,
            resourceTypes: document.getElementById('OpResourceTypes').value.split(',').map(s => s.trim()).filter(Boolean),
            sourceFhirPath: document.getElementById('OpSourceFhirPath').value || null,
            targetFhirPath: document.getElementById('OpTargetFhirPath').value || null,
            conditionTargetFhirPath: document.getElementById('OpCondTargetFhirPath').value || null,
            conditionTargetValue: document.getElementById('OpCondTargetValue').value || null,
            conditions: conditions,
            codeMapFhirPath: document.getElementById('OpCodeMapFhirPath').value || null,
            codeSystemMaps: codeSystemMaps,
            extensionUrls: document.getElementById('OpExtensionUrls').value.split('\n').map(s => s.trim()).filter(Boolean),
            isSystem: false
        };
    }

    document.getElementById('btnOpSave').addEventListener('click', async () => {
        const formErrors = document.getElementById('opFormErrors');
        formErrors.style.display = 'none';
        formErrors.textContent = '';

        let data;
        try {
            data = collectOpData();
        } catch (e) {
            formErrors.textContent = e.message || 'Invalid operation form data.';
            formErrors.style.display = '';
            return;
        }

        const resp = await postJson('@Url.Action("SaveOperation", "Normalizations")', data);
        if (resp.ok) { location.reload(); } else {
            const err = await resp.text();
            formErrors.textContent = err;
            formErrors.style.display = '';
        }
    });

    document.getElementById('btnOpClose').addEventListener('click', hideOpModal);
    opBackdrop.addEventListener('click', hideOpModal);
    document.getElementById('btnNewOp').addEventListener('click', () => openOpEditor(null, 'edit'));

    document.querySelectorAll('.btn-op-open').forEach(btn => btn.addEventListener('click', async () => {
        const resp = await fetch(`@Url.Action("GetOperationJson", "Normalizations")?id=${btn.dataset.id}`);
        if (resp.ok) openOpEditor(await resp.json(), btn.dataset.mode);
    }));
    document.querySelectorAll('.btn-op-clone').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("CloneOperation", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-op-delete').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Delete this operation?')) return;
        await postJson('@Url.Action("DeleteOperation", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));

    // ============ SEQUENCE MODAL ============
    const seqModal = document.getElementById('seqModal');
    const seqBackdrop = document.getElementById('seqModalBackdrop');

    function showSeqModal() { showCrudModal(seqModal, seqBackdrop, hideSeqModal); }
    function hideSeqModal() { hideCrudModal(seqModal, seqBackdrop); }

    function openSeqEditor(data, mode) {
        document.getElementById('SeqId').value = data?.id || '';
        document.getElementById('SeqIsSystem').value = data?.isSystem ? 'true' : 'false';
        document.getElementById('SeqName').value = data?.name || '';
        document.getElementById('SeqDescription').value = data?.description || '';

        const container = document.getElementById('seqEntriesContainer');
        container.innerHTML = '';
        (data?.entries || []).sort((a,b) => a.sequence - b.sequence).forEach(e => addSeqEntryRow(e));

        document.getElementById('btnSeqSave').style.display = mode === 'edit' ? '' : 'none';
        document.getElementById('seqSystemOverlay').style.display = mode === 'view' ? '' : 'none';
        document.getElementById('seqFormErrors').style.display = 'none';
        showSeqModal();
    }

    function addSeqEntryRow(entry) {
        const container = document.getElementById('seqEntriesContainer');
        const seq = container.children.length + 1;
        const options = allOperations.map(o => `<option value="${o.id}" ${o.id === entry?.operationId ? 'selected' : ''}>${o.name} (${o.operationType})</option>`).join('');
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 mb-1 align-items-center';
        row.innerHTML = `
            <span class="badge bg-dark" style="width:28px;">${seq}</span>
            <select class="form-select form-select-sm seq-op-select">${options}</select>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.d-flex').remove(); renumberSeqEntries();"><i class="bi bi-x-lg"></i></button>`;
        container.appendChild(row);
    }

    function renumberSeqEntries() {
        document.querySelectorAll('#seqEntriesContainer > div').forEach((row, idx) => {
            row.querySelector('.badge').textContent = idx + 1;
        });
    }

    document.getElementById('btnAddSeqEntry').addEventListener('click', () => addSeqEntryRow(null));

    function collectSeqData() {
        const entries = [];
        document.querySelectorAll('#seqEntriesContainer > div').forEach((row, idx) => {
            entries.push({ operationId: row.querySelector('.seq-op-select').value, sequence: idx + 1 });
        });
        return {
            id: document.getElementById('SeqId').value || crypto.randomUUID(),
            name: document.getElementById('SeqName').value,
            description: document.getElementById('SeqDescription').value,
            entries: entries,
            isSystem: false
        };
    }

    document.getElementById('btnSeqSave').addEventListener('click', async () => {
        const data = collectSeqData();
        const resp = await postJson('@Url.Action("SaveSequence", "Normalizations")', data);
        if (resp.ok) { location.reload(); } else {
            const err = await resp.text();
            document.getElementById('seqFormErrors').textContent = err;
            document.getElementById('seqFormErrors').style.display = '';
        }
    });

    document.getElementById('btnSeqClose').addEventListener('click', hideSeqModal);
    seqBackdrop.addEventListener('click', hideSeqModal);
    document.getElementById('btnNewSeq').addEventListener('click', () => openSeqEditor(null, 'edit'));

    document.querySelectorAll('.btn-seq-open').forEach(btn => btn.addEventListener('click', async () => {
        const resp = await fetch(`@Url.Action("GetSequenceJson", "Normalizations")?id=${btn.dataset.id}`);
        if (resp.ok) openSeqEditor(await resp.json(), btn.dataset.mode);
    }));
    document.querySelectorAll('.btn-seq-clone').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("CloneSequence", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-seq-delete').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Delete this sequence?')) return;
        await postJson('@Url.Action("DeleteSequence", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));

    // ============ SUITE MODAL ============
    const suiteModal = document.getElementById('suiteModal');
    const suiteBackdrop = document.getElementById('suiteModalBackdrop');

    function showSuiteModal() { showCrudModal(suiteModal, suiteBackdrop, hideSuiteModal); }
    function hideSuiteModal() { hideCrudModal(suiteModal, suiteBackdrop); }

    function openSuiteEditor(data, mode) {
        document.getElementById('SuiteId').value = data?.id || '';
        document.getElementById('SuiteIsSystem').value = data?.isSystem ? 'true' : 'false';
        document.getElementById('SuiteName').value = data?.name || '';
        document.getElementById('SuiteDescription').value = data?.description || '';

        const seqContainer = document.getElementById('suiteSequencesContainer');
        seqContainer.innerHTML = '';
        (data?.sequenceIds || []).forEach(sid => addSuiteSeqRow(sid));

        const opContainer = document.getElementById('suiteOpsContainer');
        opContainer.innerHTML = '';
        (data?.operationIds || []).forEach(oid => addSuiteOpRow(oid));

        document.getElementById('btnSuiteSave').style.display = mode === 'edit' ? '' : 'none';
        document.getElementById('suiteSystemOverlay').style.display = mode === 'view' ? '' : 'none';
        document.getElementById('suiteFormErrors').style.display = 'none';
        showSuiteModal();
    }

    function addSuiteSeqRow(selectedId) {
        const container = document.getElementById('suiteSequencesContainer');
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 mb-1 align-items-center';

        const sequenceSelect = document.createElement('select');
        sequenceSelect.className = 'form-select form-select-sm suite-seq-select';
        allSequences.forEach(s => {
            const option = document.createElement('option');
            option.value = s.id;
            option.textContent = s.name;
            if (s.id === selectedId) option.selected = true;
            sequenceSelect.appendChild(option);
        });

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'btn btn-sm btn-outline-danger';
        removeButton.innerHTML = '<i class="bi bi-x-lg"></i>';
        removeButton.addEventListener('click', () => row.remove());

        row.appendChild(sequenceSelect);
        row.appendChild(removeButton);
        container.appendChild(row);
    }

    function addSuiteOpRow(selectedId) {
        const container = document.getElementById('suiteOpsContainer');
        const row = document.createElement('div');
        row.className = 'd-flex gap-2 mb-1 align-items-center';

        const operationSelect = document.createElement('select');
        operationSelect.className = 'form-select form-select-sm suite-op-select';
        allOperations.forEach(o => {
            const option = document.createElement('option');
            option.value = o.id;
            option.textContent = `${o.name} (${o.operationType})`;
            if (o.id === selectedId) option.selected = true;
            operationSelect.appendChild(option);
        });

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'btn btn-sm btn-outline-danger';
        removeButton.innerHTML = '<i class="bi bi-x-lg"></i>';
        removeButton.addEventListener('click', () => row.remove());

        row.appendChild(operationSelect);
        row.appendChild(removeButton);
        container.appendChild(row);
    }

    document.getElementById('btnAddSuiteSeq').addEventListener('click', () => addSuiteSeqRow(null));
    document.getElementById('btnAddSuiteOp').addEventListener('click', () => addSuiteOpRow(null));

    function collectSuiteData() {
        const sequenceIds = [];
        document.querySelectorAll('#suiteSequencesContainer .suite-seq-select').forEach(sel => { if (sel.value) sequenceIds.push(sel.value); });
        const operationIds = [];
        document.querySelectorAll('#suiteOpsContainer .suite-op-select').forEach(sel => { if (sel.value) operationIds.push(sel.value); });
        return {
            id: document.getElementById('SuiteId').value || crypto.randomUUID(),
            name: document.getElementById('SuiteName').value,
            description: document.getElementById('SuiteDescription').value,
            sequenceIds: sequenceIds,
            operationIds: operationIds,
            isSystem: false,
            isDefault: false
        };
    }

    document.getElementById('btnSuiteSave').addEventListener('click', async () => {
        const data = collectSuiteData();
        const resp = await postJson('@Url.Action("SaveSuite", "Normalizations")', data);
        if (resp.ok) { location.reload(); } else {
            const err = await resp.text();
            document.getElementById('suiteFormErrors').textContent = err;
            document.getElementById('suiteFormErrors').style.display = '';
        }
    });

    document.getElementById('btnSuiteClose').addEventListener('click', hideSuiteModal);
    suiteBackdrop.addEventListener('click', hideSuiteModal);
    document.getElementById('btnNewSuite').addEventListener('click', () => openSuiteEditor(null, 'edit'));

    document.querySelectorAll('.btn-suite-open').forEach(btn => btn.addEventListener('click', async () => {
        const resp = await fetch(`@Url.Action("GetSuiteJson", "Normalizations")?id=${btn.dataset.id}`);
        if (resp.ok) openSuiteEditor(await resp.json(), btn.dataset.mode);
    }));
    document.querySelectorAll('.btn-suite-clone').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("CloneSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-suite-default').forEach(btn => btn.addEventListener('click', async () => {
        await postJson('@Url.Action("SetDefaultSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
    document.querySelectorAll('.btn-suite-delete').forEach(btn => btn.addEventListener('click', async () => {
        if (!confirm('Delete this suite?')) return;
        await postJson('@Url.Action("DeleteSuite", "Normalizations")', { id: btn.dataset.id });
        location.reload();
    }));
</script>
}
