@model List<NormalizationOperationDefinition>
@{
    ViewData["Title"] = "Normalizations";
    var operations = (List<NormalizationOperationDefinition>?)ViewBag.Operations ?? [];
    var sequences = (List<NormalizationSequenceDefinition>?)ViewBag.Sequences ?? [];
    var suites = (List<NormalizationSuiteDefinition>?)ViewBag.Suites ?? [];
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-funnel me-2"></i>Normalizations</h2>
    <p class="text-muted mb-3">Manage normalization operations, sequences, and suites. Suites are selectable on scenarios to control which normalizations run during a test.</p>

    <div class="au-card">
        <div class="card-header">Suggest from a patient bundle</div>
        <div class="card-body">
            <p class="small text-muted mb-2">Upload one or more FHIR bundles. We'll propose one operation of each type the data can support, reuse existing operations when they already match, and recommend a suite if one already covers the work. Upload additional patients to refine the same suite.</p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="file" id="normGenFile" accept="application/json,.json" class="form-control form-control-sm" style="max-width:320px;" multiple />
                <button type="button" class="btn btn-sm btn-au-action" id="btnNormGenerate"><i class="bi bi-magic me-1"></i>Analyze bundle</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNormGenerateReset">Start over</button>
                <span id="normGenSessionHint" class="small text-muted"></span>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="normTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-operations" data-bs-toggle="tab" data-bs-target="#pane-operations" type="button" role="tab">
                <i class="bi bi-gear me-1"></i>Operations <span class="badge bg-secondary">@operations.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-sequences" data-bs-toggle="tab" data-bs-target="#pane-sequences" type="button" role="tab">
                <i class="bi bi-list-ol me-1"></i>Sequences <span class="badge bg-secondary">@sequences.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-suites" data-bs-toggle="tab" data-bs-target="#pane-suites" type="button" role="tab">
                <i class="bi bi-box me-1"></i>Suites <span class="badge bg-secondary">@suites.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @* ===== Operations Tab ===== *@
        <div class="tab-pane fade show active" id="pane-operations" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-gear me-2"></i>All Operations</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewOp" aria-label="Create new normalization operation" title="Create new normalization operation"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="opTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Resource Types</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:200px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var op in operations)
                            {
                                <tr data-id="@op.Id">
                                    <td>
                                        <strong>@op.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(op.Description))
                                        {
                                            <br /><small class="text-muted">@op.Description</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-info text-dark">@op.OperationType</span></td>
                                    <td><small class="text-muted">@string.Join(", ", op.ResourceTypes)</small></td>
                                    <td>
                                        @if (op.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@op.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-op-open" data-id="@op.Id" data-mode="@(op.IsSystem ? "view" : "edit")">
                                                @(op.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-op-clone" data-id="@op.Id">Clone</button>
                                            @if (!op.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-op-delete" data-id="@op.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (operations.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No operations yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>

        @* ===== Sequences Tab ===== *@
        <div class="tab-pane fade" id="pane-sequences" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-ol me-2"></i>All Sequences</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewSeq" aria-label="Create new normalization sequence" title="Create new normalization sequence"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="seqTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Operations</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:200px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seq in sequences)
                            {
                                <tr data-id="@seq.Id">
                                    <td>
                                        <strong>@seq.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(seq.Description))
                                        {
                                            <br /><small class="text-muted">@seq.Description</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary">@seq.Entries.Count op(s)</span></td>
                                    <td>
                                        @if (seq.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@seq.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-seq-open" data-id="@seq.Id" data-mode="@(seq.IsSystem ? "view" : "edit")">
                                                @(seq.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-seq-clone" data-id="@seq.Id">Clone</button>
                                            @if (!seq.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-seq-delete" data-id="@seq.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (sequences.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No sequences yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>

        @* ===== Suites Tab ===== *@
        <div class="tab-pane fade" id="pane-suites" role="tabpanel">
            <div class="au-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-box me-2"></i>All Suites</span>
                    <button type="button" class="btn btn-sm btn-success" id="btnNewSuite" aria-label="Create new normalization suite" title="Create new normalization suite"><i class="bi bi-plus-lg"></i></button>
                </div>
                <div class="card-body p-0">
                    <table class="table au-table mb-0" id="suiteTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Contents</th>
                                <th>Kind</th>
                                <th>Updated</th>
                                <th style="width:260px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var suite in suites)
                            {
                                <tr data-id="@suite.Id">
                                    <td>
                                        <strong>@suite.Name</strong>
                                        @if (suite.IsDefault)
                                        {
                                            <span class="badge bg-success ms-1">Default</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(suite.Description))
                                        {
                                            <br /><small class="text-muted">@suite.Description</small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@suite.SequenceIds.Count seq, @suite.OperationIds.Count op(s)</small>
                                    </td>
                                    <td>
                                        @if (suite.IsSystem) { <span class="badge bg-dark">System</span> }
                                        else { <span class="badge bg-light text-dark border">Custom</span> }
                                    </td>
                                    <td class="small text-muted">@suite.UpdatedAt.LocalDateTime.ToString("g")</td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-suite-open" data-id="@suite.Id" data-mode="@(suite.IsSystem ? "view" : "edit")">
                                                @(suite.IsSystem ? "View" : "Edit")
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-suite-clone" data-id="@suite.Id">Clone</button>
                                            @if (!suite.IsDefault)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success btn-suite-default" data-id="@suite.Id" title="Set as default">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            }
                                            @if (!suite.IsSystem)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-suite-delete" data-id="@suite.Id">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (suites.Count == 0)
                    {
                        <div class="text-center text-muted py-4">No suites yet. Click <strong>+</strong> to create one.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ========== Operation Editor Modal ========== *@
<div id="opModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="opModalTitle" tabindex="-1">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:800px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="opModalTitle"><i class="bi bi-gear me-2"></i>Operation</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnOpSave" style="display:none;"><i class="bi bi-floppy me-1"></i>Save</button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnOpClose">Close</button>
                </div>
            </div>
            <div id="opFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="opModalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="OpId" />
                <input type="hidden" id="OpIsSystem" value="false" />
                <div id="opConfigArea" class="position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="OpName">Name</label>
                            <input class="form-control" id="OpName" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="OpType">Operation Type</label>
                            <select class="form-select" id="OpType">
                                <option value="CopyProperty">CopyProperty</option>
                                <option value="CopyLocation">CopyLocation</option>
                                <option value="CopyLocationAliasToTypeIteratively">CopyLocationAliasToTypeIteratively</option>
                                <option value="ConditionalTransform">ConditionalTransform</option>
                                <option value="CodeMap">CodeMap</option>
                                <option value="RemoveExtensions">RemoveExtensions</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="OpDescription">Description</label>
                            <input class="form-control" id="OpDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="OpResourceTypes">Resource Types <small class="text-muted">(comma-separated)</small></label>
                            <input class="form-control" id="OpResourceTypes" placeholder="e.g. Location, Encounter, Patient" />
                        </div>

                        @* --- CopyProperty fields --- *@
                        <div class="col-md-6 op-field op-field-CopyProperty">
                            <label class="form-label" for="OpSourceFhirPath">Source FhirPath</label>
                            <input class="form-control" id="OpSourceFhirPath" placeholder="e.g. identifier.value" />
                        </div>
                        <div class="col-md-6 op-field op-field-CopyProperty">
                            <label class="form-label" for="OpTargetFhirPath">Target FhirPath</label>
                            <input class="form-control" id="OpTargetFhirPath" placeholder="e.g. type[0].coding.code" />
                        </div>

                        @* --- ConditionalTransform fields --- *@
                        <div class="col-md-6 op-field op-field-ConditionalTransform">
                            <label class="form-label" for="OpCondTargetFhirPath">Target FhirPath</label>
                            <input class="form-control" id="OpCondTargetFhirPath" />
                        </div>
                        <div class="col-md-6 op-field op-field-ConditionalTransform">
                            <label class="form-label" for="OpCondTargetValue">Target Value</label>
                            <input class="form-control" id="OpCondTargetValue" />
                        </div>
                        <div class="col-12 op-field op-field-ConditionalTransform">
                            <label class="form-label">Conditions</label>
                            <div id="opConditionsContainer"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-1" id="btnAddCondition"><i class="bi bi-plus-lg me-1"></i>Add Condition</button>
                        </div>

                        @* --- CodeMap fields --- *@
                        <div class="col-12 op-field op-field-CodeMap">
                            <label class="form-label" for="OpCodeMapFhirPath">FhirPath</label>
                            <input class="form-control" id="OpCodeMapFhirPath" />
                        </div>
                        <div class="col-12 op-field op-field-CodeMap">
                            <label class="form-label">Code System Maps</label>
                            <div id="opCodeSystemMapRows"></div>
                            <div class="d-flex gap-2 mt-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-success" id="btnAddCodeSystemMap"><i class="bi bi-plus-lg me-1"></i>Add Code System Map</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCodeMapLoadFromJson" title="Load the current JSON textarea content into the visual controls (JSON → controls).">Load from JSON</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCodeMapSyncJson" title="Write the current visual controls into the JSON textarea (controls → JSON).">Sync JSON from Controls</button>
                                <span class="text-muted" title="Use the textarea and controls independently: Load from JSON copies textarea JSON into controls, and Sync JSON from Controls copies controls into the textarea.">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-12 op-field op-field-CodeMap">
                            <label class="form-label">Code System Maps <small class="text-muted">(JSON)</small></label>
                            <textarea class="form-control font-monospace" id="OpCodeSystemMaps" rows="6" style="font-size:.8rem;"></textarea>
                        </div>

                        @* --- RemoveExtensions fields --- *@
                        <div class="col-12 op-field op-field-RemoveExtensions">
                            <label class="form-label" for="OpExtensionUrls">Extension URLs <small class="text-muted">(one per line)</small></label>
                            <textarea class="form-control font-monospace" id="OpExtensionUrls" rows="4" style="font-size:.8rem;"></textarea>
                        </div>

                        @* --- CopyLocationAliasToTypeIteratively fields --- *@
                        <div class="col-md-6 op-field op-field-CopyLocationAliasToTypeIteratively" id="OpCopyIterativeMaxIterationsWrap">
                            <label class="form-label" for="OpMaxIterations">Max Iterations</label>
                            <input class="form-control" type="number" min="1" id="OpMaxIterations" value="15" />
                        </div>
                        <div class="col-md-6 op-field op-field-CopyLocationAliasToTypeIteratively align-items-end" id="OpCopyIterativeSplitOnCommaWrap">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="OpSplitOnComma" />
                                <label class="form-check-label" for="OpSplitOnComma">Split Alias Entries on Comma</label>
                            </div>
                        </div>
                    </div>
                    <div id="opSystemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="opModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

@* ========== Sequence Editor Modal ========== *@
<div id="seqModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="seqModalTitle" tabindex="-1">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:800px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="seqModalTitle"><i class="bi bi-list-ol me-2"></i>Sequence</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnSeqSave" style="display:none;"><i class="bi bi-floppy me-1"></i>Save</button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnSeqClose">Close</button>
                </div>
            </div>
            <div id="seqFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="seqModalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="SeqId" />
                <input type="hidden" id="SeqIsSystem" value="false" />
                <div id="seqConfigArea" class="position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="SeqName">Name</label>
                            <input class="form-control" id="SeqName" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="SeqDescription">Description</label>
                            <input class="form-control" id="SeqDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Operations (in order)</label>
                            <div id="seqEntriesContainer"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-2" id="btnAddSeqEntry"><i class="bi bi-plus-lg me-1"></i>Add Operation</button>
                        </div>
                    </div>
                    <div id="seqSystemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="seqModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

@* ========== Suite Editor Modal ========== *@
<div id="suiteModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;" role="dialog" aria-modal="true" aria-labelledby="suiteModalTitle" tabindex="-1">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:800px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="suiteModalTitle"><i class="bi bi-box me-2"></i>Suite</h5>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-sm btn-success" id="btnSuiteSave" style="display:none;"><i class="bi bi-floppy me-1"></i>Save</button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnSuiteClose">Close</button>
                </div>
            </div>
            <div id="suiteFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="suiteModalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="SuiteId" />
                <input type="hidden" id="SuiteIsSystem" value="false" />
                <div id="suiteConfigArea" class="position-relative">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="SuiteName">Name</label>
                            <input class="form-control" id="SuiteName" maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="SuiteDescription">Description</label>
                            <input class="form-control" id="SuiteDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Sequences</label>
                            <div id="suiteSequencesContainer"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-1" id="btnAddSuiteSeq"><i class="bi bi-plus-lg me-1"></i>Add Sequence</button>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Standalone Operations</label>
                            <div id="suiteOpsContainer"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-1" id="btnAddSuiteOp"><i class="bi bi-plus-lg me-1"></i>Add Operation</button>
                        </div>
                    </div>
                    <div id="suiteSystemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="suiteModalBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1050;display:none;"></div>

@section Scripts {
<script src="~/js/bundle-config-generation.js" asp-append-version="true"></script>
<script>
    // -- Data from server --
    const allOperations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(operations, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const allSequences = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sequences, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const allSuites = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(suites, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    function postJson(url, body) {
        return fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken }, body: JSON.stringify(body)
        });
    }

    // ============ OPERATION MODAL ============
    const opModal = document.getElementById('opModal');
    const opBackdrop = document.getElementById('opModalBackdrop');

    const modalFocusState = new WeakMap();

    function getFocusableElements(modal) {
        return Array.from(modal.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'))
            .filter(el => el.offsetParent !== null);
    }

    function onModalKeyDown(event) {
        const modal = event.currentTarget;
        const state = modalFocusState.get(modal);

        if (event.key === 'Escape') {
            event.preventDefault();
            if (state?.requestClose) state.requestClose();
            return;
        }

        if (event.key !== 'Tab') return;

        const focusable = getFocusableElements(modal);
        if (!focusable.length) {
            event.preventDefault();
            modal.focus();
            return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    }

    function showCrudModal(modal, backdrop, requestClose) {
        const trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        modalFocusState.set(modal, { trigger, requestClose });

        modal.style.display = '';
        backdrop.style.display = '';
        modal.addEventListener('keydown', onModalKeyDown);

        const focusable = getFocusableElements(modal);
        const focusTarget = focusable[0] || modal;
        setTimeout(() => focusTarget.focus(), 0);
    }

    function hideCrudModal(modal, backdrop) {
        modal.style.display = 'none';
        backdrop.style.display = 'none';
        modal.removeEventListener('keydown', onModalKeyDown);

        const state = modalFocusState.get(modal);
        if (state?.trigger && document.contains(state.trigger)) {
            state.trigger.focus();
        }
        modalFocusState.delete(modal);
    }

