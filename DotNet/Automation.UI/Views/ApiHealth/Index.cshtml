@model ApiHealthDashboardViewModel
@{
    ViewData["Title"] = "API Health";
    var grafanaBase = Model.GrafanaBaseUrl?.TrimEnd('/');
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-heart-pulse me-2"></i>API Health</h2>
            <p class="text-muted mb-0">Exercises every annotated response path across all services. Each row is one test — one response code, one code path.</p>
        </div>
        <button type="button" class="btn btn-au-run" id="btnRunAll">
            <i class="bi bi-play-fill me-1"></i> Run All
        </button>
    </div>

    @* --- Summary bar --- *@
    <div class="d-flex gap-3 mb-3 flex-wrap" id="summaryBar">
        <span class="badge bg-secondary" id="sumTotal">@Model.Services.Sum(s => s.Endpoints.Count(e => !e.Definition.IsInformational)) tests</span>
        <span class="badge au-badge-success" id="sumPass">@Model.Services.Sum(s => s.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult?.Passed == true)) passed</span>
        <span class="badge au-badge-danger" id="sumFail">@Model.Services.Sum(s => s.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult?.Passed == false && e.LastResult?.Skipped != true)) failed</span>
        <span class="badge au-badge-skip" id="sumSkip">@Model.Services.Sum(s => s.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult?.Skipped == true)) skipped</span>
        <span class="badge bg-light text-dark border" id="sumPending">@Model.Services.Sum(s => s.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult == null)) not run</span>
    </div>

    <div id="runPhaseBanner" class="alert alert-secondary py-2 px-3 mb-3" style="display:none;">
        <strong id="runPhaseTitle">Phase</strong>
        <span id="runPhaseMessage" class="ms-2">Preparing...</span>
    </div>

    <div id="seedRunCard" class="alert alert-light border py-2 px-3 mb-3" style="display:none;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Seed Run</strong>
                <span id="seedRunStatus" class="badge bg-secondary ms-2">Starting</span>
                <div class="small text-muted" id="seedRunMeta"></div>
            </div>
            <a id="seedRunLink" class="btn btn-sm btn-outline-secondary" target="_blank" style="display:none;">
                <i class="bi bi-box-arrow-up-right me-1"></i>Open Run
            </a>
        </div>
    </div>

    <div class="accordion" id="serviceAccordion">
    @foreach (var service in Model.Services)
    {
        var passCount = service.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult?.Passed == true);
        var failCount = service.Endpoints.Count(e => !e.Definition.IsInformational && e.LastResult?.Passed == false);
        var totalCount = service.Endpoints.Count(e => !e.Definition.IsInformational);

        <div class="accordion-item au-health-accordion mb-2" id="svc-@service.ServiceName">
            <h2 class="accordion-header au-health-header">
                <div class="d-flex align-items-center w-100">
                    <button class="accordion-button collapsed au-health-toggle flex-grow-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@service.ServiceName" aria-expanded="false">
                        <i class="bi bi-hdd-stack me-2"></i>
                        <strong>@service.ServiceName</strong>
                        <span class="badge svc-summary ms-2" data-service="@service.ServiceName">@passCount/@totalCount</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark btn-run-service me-2" data-service="@service.ServiceName">
                        <i class="bi bi-play-fill"></i>
                    </button>
                </div>
            </h2>
            <div id="collapse-@service.ServiceName" class="accordion-collapse collapse" data-bs-parent="#serviceAccordion">
                <div class="accordion-body p-0">
                    <table class="table au-health-table mb-0 table-sm">
                        <thead>
                            <tr>
                                <th>Test</th>
                                <th style="width:80px;">Result</th>
                                <th style="width:100px;">Status</th>
                                <th>Reason</th>
                                <th style="width:80px;">Time</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{string? lastGroup = null;}
                            @foreach (var ep in service.Endpoints)
                            {
                                var key = ep.Definition.Key;
                                var hasPassed = ep.LastResult?.Passed;
                                var isSkipped = ep.LastResult?.Skipped == true
                                    || (ep.LastResult == null && ep.Definition.AlwaysSkipReason != null);
                                var skipReason = ep.LastResult?.SkipReason ?? ep.Definition.AlwaysSkipReason;
                                var badgeClass = isSkipped ? "au-badge-skip" : (hasPassed == null ? "bg-secondary" : (hasPassed == true ? "au-badge-success" : "au-badge-danger"));
                                var badgeText = isSkipped ? "SKIP" : (hasPassed == null ? "N/A" : (hasPassed == true ? "PASS" : "FAIL"));

                                @if (ep.Definition.GroupName != null && ep.Definition.GroupName != lastGroup)
                                {
                                    lastGroup = ep.Definition.GroupName;
                                    <tr class="row-group-header">
                                        <td colspan="6"><strong>@ep.Definition.GroupName</strong></td>
                                    </tr>
                                }

                                <tr data-endpoint-key="@key" data-informational="@(ep.Definition.IsInformational ? "true" : "false")">
                                    <td class="@(ep.Definition.GroupName != null ? "ps-4" : "")">
                                        <span>@ep.Definition.EndpointName</span>
                                        @if (!string.IsNullOrWhiteSpace(ep.Definition.Description))
                                        {
                                            <br /><small class="text-muted">@ep.Definition.Description</small>
                                        }
                                    </td>
                                    <td class="cell-result">
                                        <span class="badge @badgeClass">@badgeText</span>
                                    </td>
                                    <td class="cell-status">
                                        @if (!isSkipped && ep.LastResult != null)
                                        {
                                            <code class="small">@ep.LastResult.ActualStatusCode / @ep.LastResult.ExpectedStatusCode</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="cell-reason">
                                        @if (isSkipped && !string.IsNullOrWhiteSpace(skipReason))
                                        {
                                            <small class="text-muted">@skipReason</small>
                                        }
                                        else if (!isSkipped && ep.LastResult is { Passed: false } && !string.IsNullOrWhiteSpace(ep.LastResult.ErrorMessage))
                                        {
                                            <small class="text-danger">@ep.LastResult.ErrorMessage</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="cell-duration">
                                        @if (!isSkipped && ep.LastResult != null)
                                        {
                                            <small>@(ep.LastResult.DurationMs)ms</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!ep.Definition.IsInformational)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-history" data-key="@key" title="History">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                                @if (ep.LastResult != null && !ep.Definition.IsInformational)
                                {
                                    <tr class="row-detail" data-detail-for="@key" style="display:none;">
                                        <td colspan="6" class="ps-4 py-2">
                                            <dl class="row mb-0 small">
                                                <dt class="col-sm-2 text-muted">Request</dt>
                                                <dd class="col-sm-10"><code>@(ep.LastResult.RequestMethod ?? "—") @(ep.LastResult.RequestUrl ?? "—")</code></dd>
                                                <dt class="col-sm-2 text-muted">Status</dt>
                                                <dd class="col-sm-10">@(ep.LastResult.ActualStatusCode?.ToString() ?? "—") (expected @ep.LastResult.ExpectedStatusCode)</dd>
                                                @if (!string.IsNullOrWhiteSpace(ep.LastResult.TraceId))
                                                {
                                                    <dt class="col-sm-2 text-muted">Trace</dt>
                                                    <dd class="col-sm-10">
                                                        <code class="user-select-all">@ep.LastResult.TraceId</code>
                                                        @if (!string.IsNullOrWhiteSpace(grafanaBase))
                                                        {
                                                            var traceLink = $"{grafanaBase}/explore?left={{\"queries\":[{{\"expr\":\"{{traceID=\\\"{ep.LastResult.TraceId}\\\"}}\"}}]}}";
                                                            <a href="@traceLink" target="_blank" class="ms-2 small"><i class="bi bi-box-arrow-up-right"></i> Grafana</a>
                                                        }
                                                    </dd>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(grafanaBase))
                                                {
                                                    var from = ep.LastResult.ExecutedAt.AddSeconds(-30).ToUnixTimeMilliseconds();
                                                    var to = ep.LastResult.ExecutedAt.AddSeconds(30).ToUnixTimeMilliseconds();
                                                    var timeLink = $"{grafanaBase}/explore?left={{\"range\":{{\"from\":\"{from}\",\"to\":\"{to}\"}}}}";
                                                    <dt class="col-sm-2 text-muted">Logs</dt>
                                                    <dd class="col-sm-10"><a href="@timeLink" target="_blank" class="small"><i class="bi bi-box-arrow-up-right"></i> View in Grafana (±30s window)</a></dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ep.LastResult.ResponseBody))
                                                {
                                                    <dt class="col-sm-2 text-muted">Response</dt>
                                                    <dd class="col-sm-10"><pre class="mb-0 p-2 bg-light rounded small" style="max-height:120px;overflow:auto;">@ep.LastResult.ResponseBody</pre></dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(ep.LastResult.ErrorMessage))
                                                {
                                                    <dt class="col-sm-2 text-muted">Error</dt>
                                                    <dd class="col-sm-10 text-danger">@ep.LastResult.ErrorMessage</dd>
                                                }
                                                <dt class="col-sm-2 text-muted">Time</dt>
                                                <dd class="col-sm-10">@ep.LastResult.ExecutedAt.ToString("yyyy-MM-dd HH:mm:ss.fff") UTC · @(ep.LastResult.DurationMs)ms</dd>
                                            </dl>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@* ========== History Modal ========== *@
<div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="historyModalLabel">Run History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="historyContent">
                    <p class="text-muted text-center">Loading...</p>
                </div>
                <nav id="historyPager" class="d-flex justify-content-center mt-3" style="display:none!important;"></nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const grafanaBaseUrl = @Html.Raw(Json.Serialize(grafanaBase ?? ""));

    function postJson(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken || '' },
            body: JSON.stringify(body)
        }).then(async r => {
            if (!r.ok) { const t = await r.text(); throw new Error(`Server ${r.status}: ${t.substring(0, 200)}`); }
            return r.json();
        });
    }

    function getJson(url) {
        return fetch(url).then(async r => {
            if (!r.ok) { const t = await r.text(); throw new Error(`Server ${r.status}: ${t.substring(0, 200)}`); }
            return r.json();
        });
    }

    function escapeHtml(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
    const runnableRowSelector = 'tr[data-endpoint-key][data-informational="false"]';
    let seedRunPollTimer = null;
    let seedRunTickerTimer = null;
    let seedRunDiscoveryTimer = null;
    let currentSeedRunId = null;
    let currentSeedRunStartedAt = null;

    function setSeedRunStatusBadge(status) {
        const badge = document.getElementById('seedRunStatus');
        if (!badge) return;
        const s = String(status || '').toLowerCase();
        badge.textContent = status || 'Unknown';
        badge.className = `badge ms-2 ${s === 'succeeded' ? 'au-badge-success' : s === 'failed' || s === 'cancelled' ? 'au-badge-danger' : 'bg-secondary'}`;
    }

    function clearSeedRunPoll() {
        if (seedRunPollTimer) {
            clearInterval(seedRunPollTimer);
            seedRunPollTimer = null;
        }
    }

    function clearSeedRunTicker() {
        if (seedRunTickerTimer) {
            clearInterval(seedRunTickerTimer);
            seedRunTickerTimer = null;
        }
    }

    function clearSeedRunDiscovery() {
        if (seedRunDiscoveryTimer) {
            clearInterval(seedRunDiscoveryTimer);
            seedRunDiscoveryTimer = null;
        }
    }

    function resetSeedRunDisplay() {
        clearSeedRunPoll();
        clearSeedRunTicker();
        clearSeedRunDiscovery();
        currentSeedRunId = null;
        currentSeedRunStartedAt = null;

        const card = document.getElementById('seedRunCard');
        const link = document.getElementById('seedRunLink');
        const meta = document.getElementById('seedRunMeta');
        const badge = document.getElementById('seedRunStatus');
        if (card) card.style.display = 'none';
        if (link) {
            link.style.display = 'none';
            link.removeAttribute('href');
        }
        if (meta) {
            meta.textContent = '';
            delete meta.dataset.baseText;
        }
        if (badge) {
            badge.textContent = 'Starting';
            badge.className = 'badge bg-secondary ms-2';
        }
    }

    function formatElapsed(ms) {
        const total = Math.max(0, Math.floor(ms / 1000));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        if (h > 0) return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function updateSeedRunElapsed() {
        const meta = document.getElementById('seedRunMeta');
        if (!meta || !currentSeedRunId || !currentSeedRunStartedAt) return;
        const elapsed = formatElapsed(Date.now() - currentSeedRunStartedAt.getTime());
        const base = meta.dataset.baseText || '';
        meta.textContent = `${base} · elapsed ${elapsed}`;
    }

    function bindSeedRun(seedRunId, seedRunName) {
        if (!seedRunId) return;
        if (currentSeedRunId && currentSeedRunId !== seedRunId) {
            clearSeedRunPoll();
            clearSeedRunTicker();
        }

        currentSeedRunId = seedRunId;
        clearSeedRunDiscovery();

        const card = document.getElementById('seedRunCard');
        const link = document.getElementById('seedRunLink');
        const meta = document.getElementById('seedRunMeta');
        if (!card || !link || !meta) return;

        card.style.display = '';
        link.style.display = '';
        link.href = `/Runs/Details/${encodeURIComponent(seedRunId)}`;
        meta.dataset.baseText = `${seedRunName || 'ApiHealthScenario'} · ${seedRunId}`;
        if (!currentSeedRunStartedAt) {
            currentSeedRunStartedAt = new Date();
        }
        updateSeedRunElapsed();
        clearSeedRunTicker();
        seedRunTickerTimer = setInterval(updateSeedRunElapsed, 1000);

        const refreshStatus = async () => {
            try {
                const s = await getJson(`/api/runs/${encodeURIComponent(seedRunId)}/status`);
                setSeedRunStatusBadge(s.status || 'Unknown');
                const started = s.startedAt || s.createdAt;
                if (started) {
                    const parsed = new Date(started);
                    if (!Number.isNaN(parsed.getTime())) {
                        currentSeedRunStartedAt = parsed;
                        updateSeedRunElapsed();
                    }
                }
                if (s.isTerminal === true) {
                    clearSeedRunPoll();
                    clearSeedRunTicker();
                }
            } catch {
                // best effort
            }
        };

        clearSeedRunPoll();
        refreshStatus();
        seedRunPollTimer = setInterval(refreshStatus, 3000);
    }

    async function discoverActiveSeedRun() {
        if (currentSeedRunId) return;
        try {
            const data = await getJson('/Runs/DashboardStats?pageNumber=1&pageSize=20&sortBy=createdAt&sortDir=desc');
            const activeRuns = data.activeRuns || [];
            const seedRun = activeRuns.find(r => String(r.runName || '').toLowerCase() === 'apihealthscenario');
            if (!seedRun || !seedRun.runId) return;

            if (seedRun.createdAt) {
                const parsed = new Date(seedRun.createdAt);
                if (!Number.isNaN(parsed.getTime())) currentSeedRunStartedAt = parsed;
            }
            bindSeedRun(seedRun.runId, seedRun.runName || 'ApiHealthScenario');
            setSeedRunStatusBadge(seedRun.status || 'Running');
        } catch {
            // best effort
        }
    }

    function ensureSeedRunDiscovery() {
        if (currentSeedRunId || seedRunDiscoveryTimer) return;
        discoverActiveSeedRun();
        seedRunDiscoveryTimer = setInterval(discoverActiveSeedRun, 3000);
    }

    // --- Update a single row from a result object ---
    function updateRowFromResult(result) {
        const row = document.querySelector(`tr[data-endpoint-key="${CSS.escape(result.endpointKey)}"]`);
        if (!row) return;
        if (row.dataset.informational === 'true') return;

        const placeholderText = 'N/A';
        const skipped = result.skipped === true;
        const passed = result.passed;
        const badgeClass = skipped ? 'au-badge-skip' : (passed ? 'au-badge-success' : 'au-badge-danger');
        const badgeText  = skipped ? 'SKIP' : (passed ? 'PASS' : 'FAIL');

        row.classList.remove('row-running');
        row.querySelector('.cell-result').innerHTML = `<span class="badge ${badgeClass}">${badgeText}</span>`;
        row.querySelector('.cell-status').innerHTML = skipped ? `<span class="text-muted">${placeholderText}</span>` : `<code class="small">${result.actualStatusCode || placeholderText} / ${result.expectedStatusCode}</code>`;
        row.querySelector('.cell-reason').innerHTML = skipped
            ? (result.skipReason ? `<small class="text-muted">${escapeHtml(result.skipReason)}</small>` : `<span class="text-muted">${placeholderText}</span>`)
            : (!passed && result.errorMessage ? `<small class="text-danger">${escapeHtml(result.errorMessage)}</small>` : `<span class="text-muted">${placeholderText}</span>`);
        row.querySelector('.cell-duration').innerHTML = skipped ? `<span class="text-muted">${placeholderText}</span>` : `<small>${result.durationMs}ms</small>`;

        // Remove old error, skip, and detail rows
        let sibling = row.nextElementSibling;
        while (sibling && (sibling.classList.contains('row-error') || sibling.classList.contains('row-skip') || sibling.classList.contains('row-detail'))) {
            const next = sibling.nextElementSibling;
            sibling.remove();
            sibling = next;
        }

        // Add detail row (hidden by default, toggled on click)
        const detailRow = document.createElement('tr');
        detailRow.className = 'row-detail';
        detailRow.dataset.detailFor = result.endpointKey;
        detailRow.style.display = 'none';
        const traceHtml = result.traceId ? `<dt class="col-sm-2 text-muted">Trace</dt><dd class="col-sm-10"><code class="user-select-all">${escapeHtml(result.traceId)}</code>${grafanaBaseUrl ? ` <a href="${grafanaBaseUrl}/explore?left=${encodeURIComponent(JSON.stringify({queries:[{expr:`{traceID="${result.traceId}"}`}]}))}" target="_blank" class="ms-2 small"><i class="bi bi-box-arrow-up-right"></i> Grafana</a>` : ''}</dd>` : '';
        const responseHtml = result.responseBody ? `<dt class="col-sm-2 text-muted">Response</dt><dd class="col-sm-10"><pre class="mb-0 p-2 bg-light rounded small" style="max-height:120px;overflow:auto;">${escapeHtml(result.responseBody)}</pre></dd>` : '';
        const errorHtml = result.errorMessage ? `<dt class="col-sm-2 text-muted">Error</dt><dd class="col-sm-10 text-danger">${escapeHtml(result.errorMessage)}</dd>` : '';
        detailRow.innerHTML = `<td colspan="6" class="ps-4 py-2"><dl class="row mb-0 small">
            <dt class="col-sm-2 text-muted">Request</dt><dd class="col-sm-10"><code>${escapeHtml(result.requestMethod || '—')} ${escapeHtml(result.requestUrl || '—')}</code></dd>
            <dt class="col-sm-2 text-muted">Status</dt><dd class="col-sm-10">${result.actualStatusCode || '—'} (expected ${result.expectedStatusCode})</dd>
            ${traceHtml}${responseHtml}${errorHtml}
            <dt class="col-sm-2 text-muted">Time</dt><dd class="col-sm-10">${new Date(result.executedAt).toISOString().replace('T',' ').substring(0,23)} UTC · ${result.durationMs}ms</dd>
        </dl></td>`;

        // Insert after error row if it exists, otherwise after main row
        row.after(detailRow);

        updateSummary();
    }

    // --- Mark rows as "running" (spinner in result cell) ---
    function clearRowTransientRows(row) {
        const key = row.dataset.endpointKey;
        let next = row.nextElementSibling;
        while (next) {
            const isTransient = next.classList.contains('row-error')
                || next.classList.contains('row-skip')
                || (next.classList.contains('row-detail') && next.dataset.detailFor === key);
            if (!isTransient) break;
            const remove = next;
            next = next.nextElementSibling;
            remove.remove();
        }
    }

    function resetRowToPending(row) {
        row.classList.remove('row-running');
        row.querySelector('.cell-result').innerHTML = '<span class="badge bg-secondary">N/A</span>';
        row.querySelector('.cell-status').innerHTML = '<span class="text-muted">N/A</span>';
        row.querySelector('.cell-reason').innerHTML = '<span class="text-muted">N/A</span>';
        row.querySelector('.cell-duration').innerHTML = '<span class="text-muted">N/A</span>';
        clearRowTransientRows(row);
    }

    function resetServiceRows(serviceName) {
        const card = document.getElementById(`svc-${serviceName}`);
        if (!card) return;
        card.querySelectorAll(runnableRowSelector).forEach(resetRowToPending);
        updateSummary();
    }

    function resetAllRows() {
        document.querySelectorAll(runnableRowSelector).forEach(resetRowToPending);
        updateSummary();
    }

    function markServiceRunning(serviceName) {
        const card = document.getElementById(`svc-${serviceName}`);
        if (!card) return;
        card.querySelectorAll(runnableRowSelector).forEach(row => {
            row.classList.add('row-running');
            row.querySelector('.cell-result').innerHTML = '<span class="spinner-border spinner-border-sm text-primary"></span>';
        });
    }

    // --- Update summary badges ---
    function updateSummary() {
        let pass = 0, fail = 0, skip = 0, pending = 0;
        document.querySelectorAll(runnableRowSelector).forEach(row => {
            const badge = row.querySelector('.cell-result .badge');
            if (!badge) { pending++; return; }
            if (badge.classList.contains('au-badge-success')) pass++;
            else if (badge.classList.contains('au-badge-skip')) skip++;
            else if (badge.classList.contains('au-badge-danger')) fail++;
            else pending++;
        });
        const total = pass + fail + skip + pending;
        document.getElementById('sumTotal').textContent = `${total} tests`;
        document.getElementById('sumPass').textContent = `${pass} passed`;
        document.getElementById('sumFail').textContent = `${fail} failed`;
        const skipEl = document.getElementById('sumSkip');
        if (skipEl) skipEl.textContent = `${skip} skipped`;
        document.getElementById('sumPending').textContent = `${pending} not run`;

        // Update per-service accordion badges
        document.querySelectorAll('.svc-summary').forEach(badge => {
            const svc = badge.dataset.service;
            const card = document.getElementById(`svc-${svc}`);
            if (!card) return;
            let sp = 0, sf = 0, st = 0;
            card.querySelectorAll(runnableRowSelector).forEach(row => {
                st++;
                const b = row.querySelector('.cell-result .badge');
                if (b && b.classList.contains('au-badge-success')) sp++;
                else if (b && b.classList.contains('au-badge-danger')) sf++;
            });
            badge.textContent = `${sp}/${st}`;
            badge.className = `badge svc-summary ms-2 ${sf > 0 ? 'au-badge-danger' : (sp === st && st > 0 ? 'au-badge-success' : 'bg-secondary')}`;
        });
    }

    function setButtonLoading(btn, loading) {
        if (loading) { btn.disabled = true; btn.dataset.origHtml = btn.innerHTML; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; }
        else { btn.disabled = false; btn.innerHTML = btn.dataset.origHtml || btn.innerHTML; }
    }

    // --- SSE streaming helper ---
    function runViaSSE(url, { onResult, onDone, onError }) {
        const es = new EventSource(url);
        es.addEventListener('phase', (e) => {
            try {
                const p = JSON.parse(e.data);
                const banner = document.getElementById('runPhaseBanner');
                const title = document.getElementById('runPhaseTitle');
                const msg = document.getElementById('runPhaseMessage');
                banner.style.display = '';
                banner.className = `alert ${p.isError ? 'alert-danger' : 'alert-secondary'} py-2 px-3 mb-3`;
                title.textContent = `${p.scope}${p.serviceName ? ` · ${p.serviceName}` : ''} · ${p.phase}`;
                msg.textContent = p.message || '';

                if (p.seedRunId) {
                    bindSeedRun(p.seedRunId, p.seedRunName);
                } else if (p.phase === 'Seeding') {
                    ensureSeedRunDiscovery();
                }

                if (p.phase === 'Testing') {
                    if (p.scope === 'Service' && p.serviceName) {
                        markServiceRunning(p.serviceName);
                    } else if (p.scope === 'All') {
                        document.querySelectorAll(runnableRowSelector).forEach(row => {
                            row.classList.add('row-running');
                            row.querySelector('.cell-result').innerHTML = '<span class="spinner-border spinner-border-sm text-primary"></span>';
                        });
                    }
                }
            } catch (err) {
                console.error('SSE phase parse error', err);
            }
        });
        es.addEventListener('result', (e) => {
            try { const r = JSON.parse(e.data); onResult(r); } catch (err) { console.error('SSE parse error', err); }
        });
        es.addEventListener('done', () => { es.close(); onDone(); });
        es.onerror = (e) => { es.close(); onError(e); };
    }

    // --- Run single endpoint (still POST, instant) ---
    document.querySelectorAll('.btn-run-endpoint').forEach(btn => {
        btn.addEventListener('click', async () => {
            // This button was removed from the compact layout, but kept for history modal
        });
    });

    // --- Run service (SSE streaming) ---
    document.querySelectorAll('.btn-run-service').forEach(btn => {
        btn.addEventListener('click', () => {
            const svc = btn.dataset.service;
            resetSeedRunDisplay();
            resetServiceRows(svc);
            setButtonLoading(btn, true);
            document.getElementById('runPhaseBanner').style.display = '';

            // Expand the accordion panel
            const panel = document.getElementById(`collapse-${svc}`);
            if (panel && !panel.classList.contains('show')) {
                new bootstrap.Collapse(panel, { toggle: true });
            }

            runViaSSE(`/ApiHealth/RunServiceStream?serviceName=${encodeURIComponent(svc)}`, {
                onResult: updateRowFromResult,
                onDone: () => {
                    setButtonLoading(btn, false);
                    document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false);
                },
                onError: () => { setButtonLoading(btn, false); document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false); }
            });

            document.querySelectorAll('.btn-run-service').forEach(b => {
                if (b !== btn) b.disabled = true;
            });
        });
    });

    // --- Run all (SSE streaming) ---
    document.getElementById('btnRunAll').addEventListener('click', function () {
        const btn = this;
        resetSeedRunDisplay();
        resetAllRows();
        setButtonLoading(btn, true);
        document.getElementById('runPhaseBanner').style.display = '';

        // Disable service-level run buttons while run-all is active
        document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = true);

        runViaSSE('/ApiHealth/RunAllStream', {
            onResult: updateRowFromResult,
            onDone: () => {
                setButtonLoading(btn, false);
                document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false);
            },
            onError: () => {
                setButtonLoading(btn, false);
                document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false);
                alert('Run all failed — connection lost.');
            }
        });
    });

    // --- Resume active fire-and-forget run after navigation/refresh ---
    (async function resumeActiveRun() {
        try {
            const active = await getJson('/ApiHealth/ActiveRun');
            if (!active || !active.runId) return;

            document.getElementById('runPhaseBanner').style.display = '';
            document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = true);
            document.getElementById('btnRunAll').disabled = true;

            runViaSSE(`/ApiHealth/RunStream?runId=${encodeURIComponent(active.runId)}`, {
                onResult: updateRowFromResult,
                onDone: () => {
                    document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false);
                    document.getElementById('btnRunAll').disabled = false;
                },
                onError: () => {
                    document.querySelectorAll('.btn-run-service').forEach(b => b.disabled = false);
                    document.getElementById('btnRunAll').disabled = false;
                }
            });
        } catch {
            // No active run or transient fetch failure.
        }
    })();

    // --- History modal ---
    const historyModal = new bootstrap.Modal(document.getElementById('historyModal'));
    let currentHistoryKey = '';

    document.querySelectorAll('.btn-history').forEach(btn => {
        btn.addEventListener('click', () => {
            currentHistoryKey = btn.dataset.key;
            loadHistory(currentHistoryKey, 1);
            historyModal.show();
        });
    });

    // --- Toggle detail row on endpoint row click ---
    document.addEventListener('click', (e) => {
        const row = e.target.closest(runnableRowSelector);
        if (!row) return;
        // Don't toggle if clicking a button
        if (e.target.closest('button')) return;
        const key = row.dataset.endpointKey;
        const detailRow = document.querySelector(`tr.row-detail[data-detail-for="${CSS.escape(key)}"]`);
        if (detailRow) {
            detailRow.style.display = detailRow.style.display === 'none' ? '' : 'none';
        }
    });

    async function loadHistory(key, page) {
        const content = document.getElementById('historyContent');
        const pager = document.getElementById('historyPager');
        content.innerHTML = '<p class="text-muted text-center">Loading...</p>';
        pager.style.display = 'none';

        try {
            const data = await getJson(`/ApiHealth/History?endpointKey=${encodeURIComponent(key)}&pageNumber=${page}&pageSize=15`);
            if (data.runs.length === 0) { content.innerHTML = '<p class="text-muted text-center">No history yet.</p>'; return; }

            let html = '<table class="table table-sm au-table"><thead><tr><th>Result</th><th>Status</th><th>Duration</th><th>Time</th><th>Error</th></tr></thead><tbody>';
            data.runs.forEach((r, idx) => {
                const badge = r.passed ? '<span class="badge au-badge-success">PASS</span>' : '<span class="badge au-badge-danger">FAIL</span>';
                const error = r.errorMessage ? `<small class="text-danger">${escapeHtml(r.errorMessage)}</small>` : '—';
                html += `<tr class="cursor-pointer" data-toggle-detail="hist-${idx}"><td>${badge}</td><td><code>${r.actualStatusCode || '—'} / ${r.expectedStatusCode}</code></td><td>${r.durationMs}ms</td><td><small>${new Date(r.executedAt).toLocaleString()}</small></td><td>${error}</td></tr>`;
                // Expandable detail row
                const traceHtml = r.traceId ? `<dt class="col-sm-2 text-muted">Trace</dt><dd class="col-sm-10"><code class="user-select-all">${escapeHtml(r.traceId)}</code>${grafanaBaseUrl ? ` <a href="${grafanaBaseUrl}/explore?left=${encodeURIComponent(JSON.stringify({queries:[{expr:`{traceID="${r.traceId}"}`}]}))}" target="_blank" class="ms-2 small"><i class="bi bi-box-arrow-up-right"></i> Grafana</a>` : ''}</dd>` : '';
                const responseHtml = r.responseBody ? `<dt class="col-sm-2 text-muted">Response</dt><dd class="col-sm-10"><pre class="mb-0 p-2 bg-light rounded small" style="max-height:100px;overflow:auto;">${escapeHtml(r.responseBody)}</pre></dd>` : '';
                html += `<tr class="row-detail" id="hist-${idx}" style="display:none;"><td colspan="5" class="ps-3 py-2"><dl class="row mb-0 small">
                    <dt class="col-sm-2 text-muted">Request</dt><dd class="col-sm-10"><code>${escapeHtml(r.requestMethod || '—')} ${escapeHtml(r.requestUrl || '—')}</code></dd>
                    ${traceHtml}${responseHtml}
                    <dt class="col-sm-2 text-muted">Time</dt><dd class="col-sm-10">${new Date(r.executedAt).toISOString().replace('T',' ').substring(0,23)} UTC · ${r.durationMs}ms</dd>
                </dl></td></tr>`;
            });
            html += '</tbody></table>';
            content.innerHTML = html;

            // Toggle detail on row click in history
            content.querySelectorAll('tr[data-toggle-detail]').forEach(tr => {
                tr.addEventListener('click', () => {
                    const target = document.getElementById(tr.dataset.toggleDetail);
                    if (target) target.style.display = target.style.display === 'none' ? '' : 'none';
                });
            });

            if (data.totalPages > 1) {
                let ph = '<ul class="pagination pagination-sm mb-0">';
                for (let p = 1; p <= data.totalPages; p++) {
                    ph += `<li class="page-item${p === data.pageNumber ? ' active' : ''}"><a class="page-link" href="#" data-page="${p}">${p}</a></li>`;
                }
                ph += '</ul>';
                pager.innerHTML = ph;
                pager.style.display = 'flex';
                pager.querySelectorAll('a[data-page]').forEach(a => {
                    a.addEventListener('click', (e) => { e.preventDefault(); loadHistory(currentHistoryKey, parseInt(a.dataset.page)); });
                });
            }
        } catch (e) {
            content.innerHTML = '<p class="text-danger text-center">Failed to load history.</p>';
        }
    }
})();
</script>
