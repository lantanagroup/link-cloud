@model MetricsCompareViewModel
@using Automation.UI.Services
@{
    ViewData["Title"] = "Compare runs";
    var stages = new[] { "acquisition", "normalization", "measureeval", "validation", "submission" };
    var activeFilter = MetricsCompareClassifier.NormalizeFilter(Context.Request.Query["filter"]);
    string DisplayName(string key) => key switch
    {
        "acquisition" => "Data Acquisition",
        "normalization" => "Normalization",
        "measureeval" => "Measure Evaluation",
        "validation" => "Validation",
        "submission" => "Submission",
        _ => key
    };
    string FormatRam(double? bytes)
    {
        if (bytes is null || bytes.Value <= 0) return "—";
        if (bytes.Value >= 1024L * 1024 * 1024)
            return $"{bytes.Value / (1024.0 * 1024 * 1024):0.00} GB";
        return $"{bytes.Value / (1024.0 * 1024):0} MB";
    }
    string FormatPercent(double? percent)
    {
        if (percent is null) return "—";
        if (percent.Value < 0.1) return "< 0.1%";
        if (percent.Value < 10) return $"{percent.Value:0.0}%";
        return $"{percent.Value:0}%";
    }
    string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} hr {ts.Minutes} min";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
        return $"{Math.Max(1, ts.Seconds)} sec";
    }
    string FormatMs(double? ms)
    {
        if (ms is null) return "—";
        if (ms.Value >= 1000) return $"{ms.Value / 1000.0:0.0} sec";
        return $"{ms.Value:0} ms";
    }
    string FormatWhen(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    string Shown(string? value) => string.IsNullOrEmpty(value) ? "—" : value;
    bool BothMissing(bool leftMissing, bool rightMissing) => leftMissing && rightMissing;

    var rows = new List<(string Label, string Earlier, string Later, MetricsChange Change)>();
    rows.Add((
        "Result",
        Shown(MetricsCompareClassifier.DisplayResult(Model.Left.Outcome)),
        Shown(MetricsCompareClassifier.DisplayResult(Model.Right.Outcome)),
        MetricsCompareClassifier.ClassifyResult(Model.Left.Outcome, Model.Right.Outcome)));
    rows.Add((
        "Total time",
        FormatDuration(Model.Left.E2eDurationSeconds),
        FormatDuration(Model.Right.E2eDurationSeconds),
        MetricsCompareClassifier.Classify(Model.Left.E2eDurationSeconds, Model.Right.E2eDurationSeconds, higherIsBetter: false, MetricsDeltaWording.Duration)));
    rows.Add((
        "Patients / min",
        Model.Left.PatientsPerMinute?.ToString("0.0") ?? "—",
        Model.Right.PatientsPerMinute?.ToString("0.0") ?? "—",
        MetricsCompareClassifier.Classify(Model.Left.PatientsPerMinute, Model.Right.PatientsPerMinute, higherIsBetter: true, MetricsDeltaWording.Throughput)));

    foreach (var key in stages)
    {
        Model.Left.Stages.TryGetValue(key, out var leftStage);
        Model.Right.Stages.TryGetValue(key, out var rightStage);
        leftStage ??= new StageSnapshot { Unavailable = true };
        rightStage ??= new StageSnapshot { Unavailable = true };
        if (BothMissing(leftStage.Unavailable, rightStage.Unavailable))
            continue;
        rows.Add((
            $"{DisplayName(key)} (slow)",
            leftStage.Unavailable ? "—" : FormatMs(leftStage.P95Ms),
            rightStage.Unavailable ? "—" : FormatMs(rightStage.P95Ms),
            MetricsCompareClassifier.Classify(
                leftStage.Unavailable ? null : leftStage.P95Ms,
                rightStage.Unavailable ? null : rightStage.P95Ms,
                higherIsBetter: false,
                MetricsDeltaWording.Duration)));
    }

    foreach (var key in Model.Left.ProcessUtilization.Select(p => p.Key).Concat(Model.Right.ProcessUtilization.Select(p => p.Key)).Distinct())
    {
        var leftProc = Model.Left.ProcessUtilization.FirstOrDefault(p => p.Key == key)
            ?? new ProcessUtilizationItemView { Unavailable = true };
        var rightProc = Model.Right.ProcessUtilization.FirstOrDefault(p => p.Key == key)
            ?? new ProcessUtilizationItemView { Unavailable = true };
        if (BothMissing(leftProc.Unavailable, rightProc.Unavailable))
            continue;
        var name = string.IsNullOrWhiteSpace(leftProc.Name) ? rightProc.Name : leftProc.Name;
        rows.Add((
            $"{name} (peak RAM)",
            leftProc.Unavailable ? "—" : FormatRam(leftProc.PeakMemoryBytes),
            rightProc.Unavailable ? "—" : FormatRam(rightProc.PeakMemoryBytes),
            MetricsCompareClassifier.Classify(
                leftProc.Unavailable ? null : leftProc.PeakMemoryBytes,
                rightProc.Unavailable ? null : rightProc.PeakMemoryBytes,
                higherIsBetter: false,
                MetricsDeltaWording.Amount)));
        rows.Add((
            $"{name} (avg CPU)",
            leftProc.Unavailable ? "—" : FormatPercent(leftProc.AvgCpuPercent),
            rightProc.Unavailable ? "—" : FormatPercent(rightProc.AvgCpuPercent),
            MetricsCompareClassifier.Classify(
                leftProc.Unavailable ? null : leftProc.AvgCpuPercent,
                rightProc.Unavailable ? null : rightProc.AvgCpuPercent,
                higherIsBetter: false,
                MetricsDeltaWording.Amount)));
    }

    foreach (var apiKey in Model.Left.ApiLatency.Select(a => a.Key).Concat(Model.Right.ApiLatency.Select(a => a.Key)).Distinct())
    {
        var leftApi = Model.Left.ApiLatency.FirstOrDefault(a => a.Key == apiKey)
            ?? new ApiLatencyItemView { Unavailable = true };
        var rightApi = Model.Right.ApiLatency.FirstOrDefault(a => a.Key == apiKey)
            ?? new ApiLatencyItemView { Unavailable = true };
        if (BothMissing(leftApi.Unavailable, rightApi.Unavailable))
            continue;
        var apiName = string.IsNullOrWhiteSpace(leftApi.Name) ? rightApi.Name : leftApi.Name;
        rows.Add((
            $"{apiName} (API slow)",
            leftApi.Unavailable ? "—" : FormatMs(leftApi.P95Ms),
            rightApi.Unavailable ? "—" : FormatMs(rightApi.P95Ms),
            MetricsCompareClassifier.Classify(
                leftApi.Unavailable ? null : leftApi.P95Ms,
                rightApi.Unavailable ? null : rightApi.P95Ms,
                higherIsBetter: false,
                MetricsDeltaWording.Duration)));
    }

    var anyVisible = rows.Any(row => MetricsCompareClassifier.MatchesFilter(row.Change.Kind, activeFilter));
    string EmptyMessage(string filter) => filter == "degradation"
        ? "No degradations in this comparison."
        : "No improvements in this comparison.";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="fw-bold mb-1">Compare two runs</h2>
            <p class="text-muted mb-0">@Model.Left.ScenarioName</p>
        </div>
        <a asp-action="Scenario" asp-route-id="@Model.Left.ScenarioId" class="btn btn-sm btn-outline-secondary">Back to history</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="au-card h-100">
                <div class="card-header">Earlier / left</div>
                <div class="card-body">
                    <div class="fw-semibold">@FormatWhen(Model.Left.FinishedAt)</div>
                    <div class="small text-muted">@Model.Left.SetupSummary</div>
                    <a asp-action="Details" asp-route-id="@Model.Left.RunId">Open this run</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="au-card h-100">
                <div class="card-header">Later / right</div>
                <div class="card-body">
                    <div class="fw-semibold">@FormatWhen(Model.Right.FinishedAt)</div>
                    <div class="small text-muted">@Model.Right.SetupSummary</div>
                    <a asp-action="Details" asp-route-id="@Model.Right.RunId">Open this run</a>
                </div>
            </div>
        </div>
    </div>

    <div class="au-card">
        <div class="card-header">What changed</div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
            <div class="btn-group btn-group-sm" role="group" aria-label="Filter by change">
                <input type="radio" class="btn-check" name="compareFilter" id="filterAll" value="all" autocomplete="off" checked="@(activeFilter == "all")" />
                <label class="btn btn-outline-primary" for="filterAll">All</label>
                <input type="radio" class="btn-check" name="compareFilter" id="filterImprovement" value="improvement" autocomplete="off" checked="@(activeFilter == "improvement")" />
                <label class="btn btn-outline-primary" for="filterImprovement">Improvement</label>
                <input type="radio" class="btn-check" name="compareFilter" id="filterDegradation" value="degradation" autocomplete="off" checked="@(activeFilter == "degradation")" />
                <label class="btn btn-outline-primary" for="filterDegradation">Degradation</label>
            </div>
            <span class="small text-muted">Green is an improvement and red is a degradation. Changes of 5% or less stay on All.</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table au-table mb-0" id="compareTable">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Earlier</th>
                            <th>Later</th>
                            <th>Change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            var visible = MetricsCompareClassifier.MatchesFilter(row.Change.Kind, activeFilter);
                            <tr data-change="@row.Change.Token" hidden="@(!visible)">
                                <td>@row.Label</td>
                                <td>@row.Earlier</td>
                                <td>@row.Later</td>
                                <td class="@row.Change.CssClass">@row.Change.Text</td>
                            </tr>
                        }
                        <tr id="compareFilterEmpty" hidden="@(activeFilter == "all" || anyVisible)"
                            data-improvement="No improvements in this comparison."
                            data-degradation="No degradations in this comparison.">
                            <td colspan="4" class="text-muted text-center py-4">@EmptyMessage(activeFilter)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var rows = Array.prototype.slice.call(document.querySelectorAll('#compareTable tbody tr[data-change]'));
        var empty = document.getElementById('compareFilterEmpty');
        var radios = Array.prototype.slice.call(document.querySelectorAll('input[name="compareFilter"]'));

        function selectedFilter() {
            var selected = radios.filter(function (radio) { return radio.checked; })[0];
            return selected ? selected.value : 'all';
        }

        function apply(filter, updateUrl) {
            var visible = 0;
            rows.forEach(function (row) {
                var show = filter === 'all' || row.getAttribute('data-change') === filter;
                row.hidden = !show;
                if (show) visible += 1;
            });
            if (empty) {
                var showEmpty = filter !== 'all' && visible === 0;
                empty.hidden = !showEmpty;
                if (showEmpty) {
                    var cell = empty.querySelector('td');
                    if (cell) cell.textContent = empty.getAttribute('data-' + filter) || 'No rows match this filter.';
                }
            }
            if (updateUrl && window.history && window.history.replaceState) {
                var url = new URL(window.location.href);
                if (filter === 'all') url.searchParams.delete('filter');
                else url.searchParams.set('filter', filter);
                window.history.replaceState(null, '', url);
            }
        }

        radios.forEach(function (radio) {
            radio.addEventListener('change', function () {
                if (radio.checked) apply(radio.value, true);
            });
        });
        apply(selectedFilter(), false);
    })();
</script>
}
