@model MetricsRunDetailViewModel
@{
    ViewData["Title"] = "Performance results";
    string FormatWhen(DateTimeOffset? value)
    {
        if (value is null) return "—";
        return value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-0">@Model.ScenarioName</h3>
            <div class="small text-muted">
                Finished @FormatWhen(Model.FinishedAt)
                @if (!string.IsNullOrWhiteSpace(Model.BenchmarkKey))
                {
                    <span class="ms-2">Saved limits: <code>@Model.BenchmarkKey</code></span>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Runs" asp-action="Details" asp-route-id="@Model.RunId" class="btn btn-sm btn-au-action">
                <i class="bi bi-clipboard-data me-1"></i>Open full run
            </a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>All metrics runs
            </a>
        </div>
    </div>

    @await Html.PartialAsync("_AdvancedPerformance", Model)
</div>
