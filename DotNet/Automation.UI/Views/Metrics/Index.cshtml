@model MetricsDashboardViewModel
@{
    ViewData["Title"] = "Performance results";
    string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} hr {ts.Minutes} min";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
        return $"{Math.Max(1, ts.Seconds)} sec";
    }
    string FormatWhen(DateTimeOffset? value)
    {
        if (value is null) return "—";
        return value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    }
    var lastE2e = FormatDuration(Model.LastRunE2eSeconds);
    var patientsPerMin = Model.LastRunPatientsPerMinute is > 0
        ? Model.LastRunPatientsPerMinute.Value.ToString("0.0")
        : "—";
}

<div class="container mt-4">
    <div class="mb-3">
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Performance results</h2>
        <p class="text-muted mb-0">History of scenarios that had <strong>Metrics run</strong> turned on. Open a row to see total time, speed, and how long each pipeline step took. Everyday functional runs stay on the Runs page.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="au-kpi-card" title="How long the most recent metrics run took, start to finish.">
                <div class="au-kpi-value">@lastE2e</div>
                <div class="au-kpi-label">Last run total time</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card" title="How fast the last run moved patients through the pipeline.">
                <div class="au-kpi-value">@patientsPerMin</div>
                <div class="au-kpi-label">Last run patients / min</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card" title="How many times a recent run was noticeably slower than the previous successful run of the same scenario (last 14 days).">
                <div class="au-kpi-value @(Model.RegressionFlagCount > 0 ? "text-warning" : "")">@(Model.RegressionFlagCount)</div>
                <div class="au-kpi-label">Got slower (14 days)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card" title="Whether the last run recorded per-step timings (Data Acquisition, Normalization, and so on).">
                <div class="au-kpi-value @(Model.LastRunStagesUnavailable ? "text-warning" : "text-success")">
                    @(Model.LastRunStagesUnavailable ? "No" : "Yes")
                </div>
                <div class="au-kpi-label">Step timings recorded</div>
            </div>
        </div>
    </div>

    @if (Model.LastRunStagesUnavailable && Model.Runs.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            The latest run saved total time and check results, but not per-step timings. That usually means the metrics store was empty or unreachable. The run itself is still on this list.
        </div>
    }

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-play-fill me-2"></i>Start a metrics run</div>
        <div class="card-body">
            @if (Model.MetricsScenarios.Count == 0)
            {
                <p class="text-muted mb-0">No saved scenarios have <strong>Metrics run</strong> turned on. Open Scenarios, edit a scenario, switch Metrics run on, save, then come back here.</p>
            }
            else
            {
                <p class="small text-muted mb-2">Only scenarios with Metrics run enabled appear here. The run still uses that scenario’s patients, measures, and report settings.</p>
                <form asp-controller="Runs" asp-action="Start" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Scenario" value="@AutomationScenarioKind.Custom" />
                    <div class="col-md-8">
                        <label class="form-label" for="metricsScenarioId">Scenario</label>
                        <select class="form-select" id="metricsScenarioId" name="ScenarioId" required>
                            @foreach (var scenario in Model.MetricsScenarios)
                            {
                                <option value="@scenario.Id">@scenario.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-au-run w-100">
                            <i class="bi bi-play-fill me-1"></i> Run
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-graph-up me-2"></i>Total run time — last 14 days</div>
        <div class="card-body">
            @if (Model.DurationTrend.Count == 0)
            {
                <p class="text-muted mb-0">No metrics runs in the last 14 days.</p>
            }
            else
            {
                <p class="small text-muted mb-2">Each point is one finished metrics run. Spikes mean that run took longer than usual.</p>
                <canvas id="metricsDurationChart" height="120"></canvas>
            }
        </div>
    </div>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history me-2"></i>Finished metrics runs</span>
            <span class="small" style="opacity:.75;">@Model.Metadata.TotalCount total</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table au-table mb-0">
                    <thead>
                        <tr>
                            <th>Scenario</th>
                            <th>Result</th>
                            <th>Total time</th>
                            <th>Step timings</th>
                            <th>Finished</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Runs.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">Nothing here yet. Turn on Metrics run on a scenario and run it.</td></tr>
                    }
                    else
                    {
                        foreach (var run in Model.Runs)
                        {
                            <tr>
                                <td>@run.ScenarioName</td>
                                <td>
                                    <span class="badge rounded-pill @(run.Outcome == "Succeeded" ? "au-badge-success" : run.Outcome == "Failed" ? "au-badge-danger" : "au-badge-muted")">
                                        @(run.Outcome == "Succeeded" ? "Passed" : run.Outcome == "Failed" ? "Failed" : run.Outcome)
                                    </span>
                                </td>
                                <td>@FormatDuration(run.E2eDurationSeconds)</td>
                                <td>
                                    @if (run.StagesUnavailable)
                                    {
                                        <span class="text-warning">Not recorded</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">Recorded</span>
                                    }
                                </td>
                                <td>@FormatWhen(run.FinishedAt)</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@run.RunId" class="btn btn-sm btn-au-action">View</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Metadata.TotalPages > 1)
        {
            <div class="card-body border-top d-flex justify-content-between align-items-center">
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber - 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Previous</a>
                <span class="small text-muted">Page @Model.Metadata.PageNumber of @Model.Metadata.TotalPages</span>
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber >= Model.Metadata.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber + 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Next</a>
            </div>
        }
    </div>
</div>

@if (Model.DurationTrend.Count > 0)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.DurationTrend.Select(p => new { finishedAt = p.FinishedAt.UtcDateTime.ToString("MMM d h:mm tt"), seconds = p.E2eDurationSeconds, runId = p.RunId }),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const canvas = document.getElementById('metricsDurationChart');
        if (!canvas || !points.length) return;
        new Chart(canvas, {
            type: 'line',
            data: {
                labels: points.map(p => p.finishedAt),
                datasets: [{
                    label: 'Total time (seconds)',
                    data: points.map(p => p.seconds),
                    borderColor: '#4da3ff',
                    backgroundColor: 'rgba(77,163,255,.15)',
                    fill: true,
                    tension: 0.2
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Seconds' }
                    }
                }
            }
        });
    })();
</script>
}
