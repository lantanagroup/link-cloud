@model MetricsDashboardViewModel
@{
    ViewData["Title"] = "Performance";
    string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} hr {ts.Minutes} min";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
        return $"{Math.Max(1, ts.Seconds)} sec";
    }
    string FormatWhen(DateTimeOffset? value)
    {
        if (value is null) return "—";
        return value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    }
    string FormatMs(double? ms)
    {
        if (ms is null) return "—";
        if (ms.Value >= 1000) return $"{ms.Value / 1000.0:0.0} sec";
        return $"{ms.Value:0} ms";
    }
    string SparklinePath(IReadOnlyList<double> points)
    {
        if (points.Count == 0) return "";
        var max = Math.Max(1, points.Max());
        var w = 120.0;
        var h = 28.0;
        var step = points.Count == 1 ? 0 : w / (points.Count - 1);
        var parts = new List<string>();
        for (var i = 0; i < points.Count; i++)
        {
            var x = points.Count == 1 ? w / 2 : i * step;
            var y = h - (points[i] / max * (h - 4)) - 2;
            parts.Add($"{(i == 0 ? "M" : "L")}{x:0.##},{y:0.##}");
        }
        return string.Join(" ", parts);
    }
}

<div class="container mt-4">
    <div class="mb-3">
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Performance</h2>
        <p class="text-muted mb-0">
            Each <strong>metrics scenario</strong> is a use case we keep timing — same patients, same setup, run after run.
            Open a card to see whether that use case got faster or slower. Everyday pass/fail tests stay on Runs.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            @if (Model.LastRunId is Guid lastRunId)
            {
                <a class="au-kpi-card au-kpi-link" asp-action="Details" asp-route-id="@lastRunId" title="Open the most recent metrics run.">
                    <div class="au-kpi-value">@FormatDuration(Model.LastRunE2eSeconds)</div>
                    <div class="au-kpi-label">Last run</div>
                    @if (Model.LastRunStagesIncomplete)
                    {
                        <div class="au-kpi-note">Partial timings</div>
                    }
                    else if (Model.LastRunStagesUnavailable)
                    {
                        <div class="au-kpi-note">Step timings missing</div>
                    }
                </a>
            }
            else
            {
                <div class="au-kpi-card" title="Wall-clock time of the most recent metrics run.">
                    <div class="au-kpi-value">@FormatDuration(Model.LastRunE2eSeconds)</div>
                    <div class="au-kpi-label">Last run</div>
                </div>
            }
        </div>
        <div class="col-6 col-lg-3">
            <div class="au-kpi-card" title="Typical patients per minute across successful metrics runs in the last 14 days.">
                <div class="au-kpi-value">@(Model.FleetPatientsPerMinute?.ToString("0.0") ?? "—")</div>
                <div class="au-kpi-label">Typical patients / min</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <a class="au-kpi-card au-kpi-link" href="#useCases" title="Jump to use-case cards.">
                <div class="au-kpi-value">@Model.ScenarioCount</div>
                <div class="au-kpi-label">Use cases tracked</div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="au-kpi-card au-kpi-link" href="#useCases" title="Use-case cards flag a run that got slower than the previous successful run of the same setup.">
                <div class="au-kpi-value @(Model.RegressionFlagCount > 0 ? "text-warning" : "")">@Model.RegressionFlagCount</div>
                <div class="au-kpi-label">Runs that got slower</div>
            </a>
        </div>
    </div>

    <div class="au-pulse mb-4" id="liveUtilizationCard" data-url="@Url.Action("LiveUtilization", "Metrics")" title="CPU is percent of this machine (like Task Manager), not cores busy. Polls Prometheus about every five seconds while this page is open. Not saved.">
        <div class="au-pulse-head">
            <div>
                <div class="au-pulse-kicker">Live fleet</div>
                <div class="au-pulse-title"><i class="bi bi-activity me-1"></i>CPU and RAM pulse</div>
                <div class="au-pulse-status" id="liveUtilizationStatus">Watching while this page is open. Not saved.</div>
                <div class="au-pulse-hottest" id="livePulseHottest"></div>
            </div>
            <div class="au-pulse-controls">
                <div class="au-pulse-seg" role="group" aria-label="View">
                    <button type="button" data-pulse-group="view" data-pulse-value="compact" class="is-on">Pulse</button>
                    <button type="button" data-pulse-group="view" data-pulse-value="expanded">Cards</button>
                </div>
                <div class="au-pulse-seg" role="group" aria-label="Filter">
                    <button type="button" data-pulse-group="filter" data-pulse-value="all">All</button>
                    <button type="button" data-pulse-group="filter" data-pulse-value="pipeline" class="is-on">Pipeline</button>
                    <button type="button" data-pulse-group="filter" data-pulse-value="hot">Hot</button>
                </div>
                <div class="au-pulse-seg" role="group" aria-label="Sort">
                    <button type="button" data-pulse-group="sort" data-pulse-value="heat" class="is-on">Hottest</button>
                    <button type="button" data-pulse-group="sort" data-pulse-value="name">A–Z</button>
                </div>
            </div>
        </div>
        <div id="livePulseStrip" class="au-pulse-strip">
            <div class="small px-2 py-2" style="color:rgba(255,255,255,.6)">Connecting to Prometheus…</div>
        </div>
        <div id="livePulseExpanded" class="au-pulse-expanded" hidden></div>
        <div class="au-pulse-detail" id="livePulseDetail">
            <p class="au-pulse-detail-empty mb-0">Click a service to pin CPU, RAM, and API p95. Hot services glow. Pulse view keeps the rest of Performance in sight.</p>
        </div>
    </div>

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-layers me-2"></i>How each pipeline step is doing</div>
        <div class="card-body">
            <p class="small text-muted mb-3">Slow time from recent metrics runs (typical of the last 14 days). These are Link services, not one scenario.</p>
            <div class="row g-2">
                @foreach (var service in Model.Services)
                {
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="au-service-chip" title="@service.Hint">
                            <div class="au-service-name">@service.Name</div>
                            <div class="au-service-value @(service.Unavailable ? "text-muted" : "")">
                                @(service.Unavailable ? "No data yet" : FormatMs(service.SlowMs))
                            </div>
                            <div class="au-service-hint">@service.Hint</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-2" id="useCases">
        <h3 class="h5 fw-semibold mb-0">Use cases</h3>
        <div class="d-flex align-items-center gap-2">
            <input type="search" id="useCaseSearch" class="form-control form-control-sm" style="max-width:16rem;" placeholder="Filter use cases…" aria-label="Filter use cases" />
            <span class="small text-muted">Newer runs sit to the right on the sparkline.</span>
        </div>
    </div>

    @if (Model.ScenarioCards.Count == 0 && Model.Runs.Count == 0)
    {
        <div class="au-card mb-4">
            <div class="card-body py-5 text-center">
                <p class="mb-2 fw-semibold">No metrics runs yet</p>
                <p class="text-muted mb-3">Turn on <strong>Metrics run</strong> in a scenario, save it, then start it from here. After it finishes you’ll see total time, speed, and how long each step took.</p>
            </div>
        </div>
    }
    else if (Model.ScenarioCards.Count > 0)
    {
        <div class="row g-3 mb-4">
            @foreach (var card in Model.ScenarioCards)
            {
                <div class="col-md-6 col-xl-4">
                    <a class="au-scenario-card" asp-action="Scenario" asp-route-id="@card.ScenarioId" data-name="@card.Name">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="au-scenario-card-name">@card.Name</div>
                                <div class="small text-muted">@card.SetupSummary</div>
                            </div>
                            <span class="badge rounded-pill @(card.Outcome == "Succeeded" ? "au-badge-success" : card.Outcome == "Failed" ? "au-badge-danger" : "au-badge-muted")">
                                @(card.Outcome == "Succeeded" ? "Passed" : card.Outcome == "Failed" ? "Failed" : string.IsNullOrWhiteSpace(card.Outcome) ? "—" : card.Outcome)
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-end mt-3 gap-2">
                            <div>
                                <div class="au-scenario-card-metric">@FormatDuration(card.LastE2eSeconds)</div>
                                <div class="small text-muted">
                                    @(card.LastPatientsPerMinute?.ToString("0.0") ?? "—") patients / min
                                    · @card.RunCount @(card.RunCount == 1 ? "run" : "runs")
                                </div>
                            </div>
                            @if (card.Sparkline.Count > 0)
                            {
                                <svg class="au-sparkline" viewBox="0 0 120 28" width="120" height="28" aria-hidden="true">
                                    <path d="@SparklinePath(card.Sparkline)" fill="none" stroke="currentColor" stroke-width="2" />
                                </svg>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @if (card.GotSlower)
                            {
                                <span class="badge au-badge-warning">Got slower</span>
                            }
                            @if (card.VersionChanged)
                            {
                                <span class="badge bg-light text-dark border">Setup v@(card.ScenarioVersion)</span>
                            }
                            @if (card.LastStagesUnavailable)
                            {
                                <span class="badge bg-light text-dark border">Step timings missing</span>
                            }
                            else if (card.LastStagesIncomplete)
                            {
                                <span class="badge bg-light text-dark border">Partial timings</span>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-play-fill me-2"></i>Start a metrics run</div>
        <div class="card-body">
            @if (Model.MetricsScenarios.Count == 0)
            {
                <p class="text-muted mb-0">No saved scenarios have Metrics run turned on. Open Scenarios, edit a scenario, switch it on, save, then come back here.</p>
            }
            else
            {
                <p class="small text-muted mb-2">You’ll jump to the live run page. Step timings show up about a minute after it finishes.</p>
                <form asp-controller="Runs" asp-action="Start" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Scenario" value="@AutomationScenarioKind.Custom" />
                    <div class="col-md-8">
                        <label class="form-label" for="metricsScenarioId">Scenario</label>
                        <select class="form-select" id="metricsScenarioId" name="ScenarioId" required>
                            @foreach (var scenario in Model.MetricsScenarios)
                            {
                                if (Model.LastRunScenarioId == scenario.Id)
                                {
                                    <option value="@scenario.Id" selected>@scenario.Name</option>
                                }
                                else
                                {
                                    <option value="@scenario.Id">@scenario.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-au-run w-100">
                            <i class="bi bi-play-fill me-1"></i> Run
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history me-2"></i>Recent metrics runs</span>
            <span class="small" style="opacity:.75;">@Model.Metadata.TotalCount total</span>
        </div>
        <div class="card-body p-0" data-au-table>
            <div class="table-responsive">
                <table class="table au-table mb-0">
                    <thead>
                        <tr>
                            <th data-sort="name">Scenario</th>
                            <th data-sort="result">Result</th>
                            <th data-sort="seconds" data-sort-type="number" data-sort-default="desc">Total time</th>
                            <th data-sort="ppm" data-sort-type="number" data-sort-default="desc">Patients / min</th>
                            <th data-sort="finished" data-sort-default="desc">Finished</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Runs.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">Nothing here yet.</td></tr>
                    }
                    else
                    {
                        foreach (var run in Model.Runs)
                        {
                            <tr data-name="@run.ScenarioName"
                                data-result="@(run.Outcome == "Succeeded" ? "Passed" : run.Outcome)"
                                data-seconds="@run.E2eDurationSeconds"
                                data-ppm="@(run.PatientsPerMinute?.ToString("0.0") ?? "")"
                                data-finished="@(run.FinishedAt?.UtcDateTime.ToString("o") ?? "")">
                                <td>
                                    @run.ScenarioName
                                    @if (run.ScenarioVersion > 1)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">v@(run.ScenarioVersion)</span>
                                    }
                                    @if (run.StagesIncomplete)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Partial</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(run.Outcome == "Succeeded" ? "au-badge-success" : run.Outcome == "Failed" ? "au-badge-danger" : "au-badge-muted")">
                                        @(run.Outcome == "Succeeded" ? "Passed" : run.Outcome == "Failed" ? "Failed" : run.Outcome)
                                    </span>
                                </td>
                                <td>@FormatDuration(run.E2eDurationSeconds)</td>
                                <td>@(run.PatientsPerMinute?.ToString("0.0") ?? "—")</td>
                                <td>@FormatWhen(run.FinishedAt)</td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@run.RunId" class="btn btn-sm btn-au-action">View</a>
                                    @if (run.ScenarioId is Guid scenarioId)
                                    {
                                        <a asp-action="Scenario" asp-route-id="@scenarioId" class="btn btn-sm btn-outline-secondary">History</a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@run.RunId" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this result from Performance history? Cards, trends, and compare will drop it. The run log is not deleted.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Metadata.TotalPages > 1)
        {
            <div class="card-body border-top d-flex justify-content-between align-items-center">
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber - 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Previous</a>
                <span class="small text-muted">Page @Model.Metadata.PageNumber of @Model.Metadata.TotalPages</span>
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber >= Model.Metadata.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber + 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Next</a>
            </div>
        }
    </div>
</div>

<script src="~/js/live-utilization.js" asp-append-version="true"></script>
<script>
    (function () {
        var search = document.getElementById('useCaseSearch');
        if (!search) return;
        search.addEventListener('input', function () {
            var q = search.value.trim().toLowerCase();
            document.querySelectorAll('.au-scenario-card').forEach(function (card) {
                var col = card.closest('[class*="col-"]') || card;
                var hay = (card.getAttribute('data-name') || card.innerText || '').toLowerCase();
                col.style.display = !q || hay.indexOf(q) >= 0 ? '' : 'none';
            });
        });
    })();
</script>
