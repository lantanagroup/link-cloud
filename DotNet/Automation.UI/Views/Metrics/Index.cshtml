@model MetricsDashboardViewModel
@{
    ViewData["Title"] = "Metrics";
    var lastE2e = Model.LastRunE2eSeconds > 0
        ? TimeSpan.FromSeconds(Model.LastRunE2eSeconds).ToString(@"mm\:ss")
        : "—";
    var patientsPerMin = Model.LastRunPatientsPerMinute is > 0
        ? Model.LastRunPatientsPerMinute.Value.ToString("0.0")
        : "—";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i>Metrics</h2>
            <p class="text-muted mb-0">Performance-run snapshots from Mongo. Stage latency is captured at run end — this page does not query Prometheus.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="au-kpi-card">
                <div class="au-kpi-value">@lastE2e</div>
                <div class="au-kpi-label">Last run e2e</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card">
                <div class="au-kpi-value">@patientsPerMin</div>
                <div class="au-kpi-label">Patients / min</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card">
                <div class="au-kpi-value">@(Model.RegressionFlagCount)</div>
                <div class="au-kpi-label">Regression flags (14d)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="au-kpi-card">
                <div class="au-kpi-value @(Model.LastRunStagesUnavailable ? "text-warning" : "text-success")">
                    @(Model.LastRunStagesUnavailable ? "No" : "Yes")
                </div>
                <div class="au-kpi-label">Stage latency available</div>
            </div>
        </div>
    </div>

    @if (Model.LastRunStagesUnavailable && Model.Runs.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Stage latency is unavailable for the latest Metrics run (Prometheus was empty, unreachable, or not configured). Wall-clock duration and validators still persisted.
        </div>
    }

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-play-fill me-2"></i>Run Metrics scenario</div>
        <div class="card-body">
            @if (Model.MetricsScenarios.Count == 0)
            {
                <p class="text-muted mb-0">No scenarios have <strong>Metrics / Performance run</strong> enabled. Open Scenarios, check the Metrics box, then return here.</p>
            }
            else
            {
                <form asp-controller="Runs" asp-action="Start" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Scenario" value="@AutomationScenarioKind.Custom" />
                    <div class="col-md-8">
                        <label class="form-label" for="metricsScenarioId">Scenario</label>
                        <select class="form-select" id="metricsScenarioId" name="ScenarioId" required>
                            @foreach (var scenario in Model.MetricsScenarios)
                            {
                                <option value="@scenario.Id">@scenario.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-au-run w-100">
                            <i class="bi bi-play-fill me-1"></i> Run
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-graph-up me-2"></i>E2E duration (14 days)</div>
        <div class="card-body">
            @if (Model.DurationTrend.Count == 0)
            {
                <p class="text-muted mb-0">No Metrics snapshots in the last 14 days.</p>
            }
            else
            {
                <canvas id="metricsDurationChart" height="120"></canvas>
            }
        </div>
    </div>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history me-2"></i>Metrics runs</span>
            <span class="small" style="opacity:.75;">@Model.Metadata.TotalCount total</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table au-table mb-0">
                    <thead>
                        <tr>
                            <th>Scenario</th>
                            <th>Outcome</th>
                            <th>E2E</th>
                            <th>Stages</th>
                            <th>Finished</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Runs.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">No Metrics snapshots yet. Run a scenario with the Metrics checkbox.</td></tr>
                    }
                    else
                    {
                        foreach (var run in Model.Runs)
                        {
                            <tr>
                                <td>@run.ScenarioName</td>
                                <td>
                                    <span class="badge rounded-pill @(run.Outcome == "Succeeded" ? "au-badge-success" : run.Outcome == "Failed" ? "au-badge-danger" : "au-badge-muted")">
                                        @run.Outcome
                                    </span>
                                </td>
                                <td>@(run.E2eDurationSeconds > 0 ? TimeSpan.FromSeconds(run.E2eDurationSeconds).ToString(@"mm\:ss") : "—")</td>
                                <td>
                                    @if (run.StagesUnavailable)
                                    {
                                        <span class="text-warning">unavailable</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">captured</span>
                                    }
                                </td>
                                <td>@(run.FinishedAt?.ToString("u") ?? "—")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@run.RunId" class="btn btn-sm btn-au-action">Details</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Metadata.TotalPages > 1)
        {
            <div class="card-body border-top d-flex justify-content-between align-items-center">
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber <= 1 ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber - 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Previous</a>
                <span class="small text-muted">Page @Model.Metadata.PageNumber of @Model.Metadata.TotalPages</span>
                <a class="btn btn-sm btn-outline-secondary @(Model.Metadata.PageNumber >= Model.Metadata.TotalPages ? "disabled" : "")"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.Metadata.PageNumber + 1)"
                   asp-route-pageSize="@Model.Metadata.PageSize">Next</a>
            </div>
        }
    </div>
</div>

@if (Model.DurationTrend.Count > 0)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.DurationTrend.Select(p => new { finishedAt = p.FinishedAt.ToString("u"), seconds = p.E2eDurationSeconds, runId = p.RunId }),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const canvas = document.getElementById('metricsDurationChart');
        if (!canvas || !points.length) return;
        new Chart(canvas, {
            type: 'line',
            data: {
                labels: points.map(p => p.finishedAt),
                datasets: [{
                    label: 'E2E seconds',
                    data: points.map(p => p.seconds),
                    borderColor: '#4da3ff',
                    backgroundColor: 'rgba(77,163,255,.15)',
                    fill: true,
                    tension: 0.2
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    })();
</script>
}
