@model MetricsScenarioHistoryViewModel
@{
    ViewData["Title"] = Model.Name;
    string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} hr {ts.Minutes} min";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
        return $"{Math.Max(1, ts.Seconds)} sec";
    }
    string FormatWhen(DateTimeOffset? value)
    {
        if (value is null) return "—";
        return value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <p class="text-muted mb-0">
                @Model.SetupSummary
                @if (Model.HasVersionChange)
                {
                    <span class="ms-2 badge bg-light text-dark border">Setup changed · now v@(Model.CurrentVersion)</span>
                }
            </p>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All use cases</a>
    </div>

    <div class="au-card mb-4">
        <div class="card-header"><i class="bi bi-graph-up me-2"></i>Total time over runs</div>
        <div class="card-body">
            @if (Model.DurationTrend.Count == 0)
            {
                <p class="text-muted mb-0">No finished metrics runs for this scenario yet.</p>
            }
            else
            {
                <p class="small text-muted mb-2">Each point is one finished run of this use case. Click a point to open that run. A jump usually means the pipeline got heavier — or the scenario setup changed.</p>
                var pts = Model.DurationTrend;
                var maxSec = Math.Max(1, pts.Max(p => p.E2eDurationSeconds));
                const double padL = 36, padR = 12, padT = 16, padB = 28, vw = 640, vh = 160;
                var plotW = vw - padL - padR;
                var plotH = vh - padT - padB;
                string X(int i) => (padL + (pts.Count == 1 ? plotW / 2 : i * plotW / Math.Max(1, pts.Count - 1))).ToString("0.##");
                string Y(double seconds) => (padT + plotH - seconds / maxSec * plotH).ToString("0.##");
                var path = string.Join(" ", pts.Select((p, i) => $"{(i == 0 ? "M" : "L")}{X(i)},{Y(p.E2eDurationSeconds)}"));
                <svg class="au-trend" id="scenarioDurationChart" viewBox="0 0 640 160" role="img" aria-label="Total time over runs">
                    <line x1="@padL.ToString("0")" y1="@padT.ToString("0")" x2="@padL.ToString("0")" y2="@(padT + plotH)" stroke="#d7dbe3" />
                    <line x1="@padL.ToString("0")" y1="@(padT + plotH)" x2="@(padL + plotW)" y2="@(padT + plotH)" stroke="#d7dbe3" />
                    @Html.Raw($"<text x=\"4\" y=\"{padT + 4}\" class=\"au-trend-axis\">{(int)maxSec}s</text>")
                    @Html.Raw($"<text x=\"4\" y=\"{padT + plotH}\" class=\"au-trend-axis\">0</text>")
                    <path d="@path" fill="none" stroke="#4da3ff" stroke-width="2.5" />
                    @for (var i = 0; i < pts.Count; i++)
                    {
                        var p = pts[i];
                        <a asp-action="Details" asp-route-id="@p.RunId">
                            <circle cx="@X(i)" cy="@Y(p.E2eDurationSeconds)" r="5" fill="#4da3ff" stroke="#fff" stroke-width="1.5">
                                <title>@FormatDuration(p.E2eDurationSeconds) · @FormatWhen(p.FinishedAt)</title>
                            </circle>
                        </a>
                    }
                    @if (pts.Count > 0)
                    {
                        @Html.Raw($"<text x=\"{padL:0}\" y=\"{vh - 8}\" class=\"au-trend-axis\">{pts[0].FinishedAt.UtcDateTime:MMM d h:mm tt}</text>")
                        @Html.Raw($"<text x=\"{padL + plotW:0}\" y=\"{vh - 8}\" class=\"au-trend-axis\" text-anchor=\"end\">{pts[^1].FinishedAt.UtcDateTime:MMM d h:mm tt}</text>")
                    }
                </svg>
            }
        </div>
    </div>

    <div class="au-card">
        <div class="card-header">Runs of this use case</div>
        <div class="card-body p-0" data-au-table>
            <div class="table-responsive">
                <table class="table au-table mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th data-sort="result">Result</th>
                            <th data-sort="seconds" data-sort-type="number" data-sort-default="desc">Total time</th>
                            <th data-sort="ppm" data-sort-type="number" data-sort-default="desc">Patients / min</th>
                            <th data-sort="finished" data-sort-default="desc">Finished</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Runs.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">No runs yet.</td></tr>
                    }
                    else
                    {
                        foreach (var run in Model.Runs)
                        {
                            <tr data-result="@(run.Outcome == "Succeeded" ? "Passed" : run.Outcome)"
                                data-seconds="@run.E2eDurationSeconds"
                                data-ppm="@(run.PatientsPerMinute?.ToString("0.0") ?? "")"
                                data-finished="@(run.FinishedAt?.UtcDateTime.ToString("o") ?? "")">
                                <td>
                                    <input type="checkbox" class="form-check-input compare-run" value="@run.RunId" aria-label="Select for compare" />
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(run.Outcome == "Succeeded" ? "au-badge-success" : run.Outcome == "Failed" ? "au-badge-danger" : "au-badge-muted")">
                                        @(run.Outcome == "Succeeded" ? "Passed" : run.Outcome == "Failed" ? "Failed" : run.Outcome)
                                    </span>
                                    @if (run.ScenarioVersion > 1)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">v@(run.ScenarioVersion)</span>
                                    }
                                    @if (run.StagesIncomplete)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Partial</span>
                                    }
                                </td>
                                <td>@FormatDuration(run.E2eDurationSeconds)</td>
                                <td>@(run.PatientsPerMinute?.ToString("0.0") ?? "—")</td>
                                <td>@FormatWhen(run.FinishedAt)</td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@run.RunId" class="btn btn-sm btn-au-action">View</a>
                                    <form asp-action="Delete" asp-route-id="@run.RunId" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this result from Performance history? Cards, trends, and compare will drop it. The run log is not deleted.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-body border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Select two runs and compare them side by side.</span>
            <button type="button" class="btn btn-sm btn-au-action" id="btnCompare" disabled>Compare selected</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const boxes = Array.from(document.querySelectorAll('.compare-run'));
        const button = document.getElementById('btnCompare');
        if (button) {
            function selected() { return boxes.filter(b => b.checked).map(b => b.value); }
            boxes.forEach(box => box.addEventListener('change', function () {
                if (selected().length > 2) this.checked = false;
                button.disabled = selected().length !== 2;
            }));
            button.addEventListener('click', function () {
                const ids = selected();
                if (ids.length === 2) {
                    window.location = '@Url.Action("Compare")' + '?a=' + encodeURIComponent(ids[0]) + '&b=' + encodeURIComponent(ids[1]);
                }
            });
        }
    })();
</script>

