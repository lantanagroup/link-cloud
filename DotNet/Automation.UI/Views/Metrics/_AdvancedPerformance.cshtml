@model MetricsRunDetailViewModel
@{
    var stageOrder = new[] { "acquisition", "normalization", "measureeval", "validation", "submission" };
    string DisplayName(string key) => key switch
    {
        "acquisition" => "Data Acquisition",
        "normalization" => "Normalization",
        "measureeval" => "Measure Evaluation",
        "validation" => "Validation",
        "submission" => "Submission",
        _ => key
    };
    string StageHint(string key) => key switch
    {
        "acquisition" => "Pulling FHIR resources from the server",
        "normalization" => "Cleaning and reshaping FHIR",
        "measureeval" => "Running the eCQM / measure against the data",
        "validation" => "Checking the measure report",
        "submission" => "Uploading the report package",
        _ => ""
    };
    string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours} hr {ts.Minutes} min";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
        return $"{Math.Max(1, ts.Seconds)} sec";
    }
    string FormatMs(double? ms)
    {
        if (ms is null) return "—";
        if (ms.Value >= 1000) return $"{ms.Value / 1000.0:0.0} sec";
        return $"{ms.Value:0} ms";
    }
    string FormatWhen(DateTimeOffset? value)
    {
        if (value is null) return "—";
        return value.Value.UtcDateTime.ToString("MMM d, yyyy h:mm tt") + " UTC";
    }
    string FormatPercent(double? percent)
    {
        if (percent is null) return "—";
        if (percent.Value < 0.1) return "< 0.1%";
        if (percent.Value < 10) return $"{percent.Value:0.0}%";
        return $"{percent.Value:0}%";
    }
    string FormatRam(double? bytes)
    {
        if (bytes is null || bytes.Value <= 0) return "—";
        if (bytes.Value >= 1024L * 1024 * 1024)
            return $"{bytes.Value / (1024.0 * 1024 * 1024):0.00} GB";
        return $"{bytes.Value / (1024.0 * 1024):0} MB";
    }
    var utilization = Model.ProcessUtilization ?? [];
    var anyUtilization = utilization.Any(u => !u.Unavailable);
    var apiLatency = Model.ApiLatency ?? [];
    var anyApi = apiLatency.Any(a => !a.Unavailable);
    var slowestRoutes = Model.SlowestApiRoutes ?? [];
    var maxApiP95 = apiLatency.Where(a => !a.Unavailable && a.P95Ms is > 0).Select(a => a.P95Ms!.Value).DefaultIfEmpty(0).Max();
    var maxPeakRam = utilization.Where(u => !u.Unavailable && u.PeakMemoryBytes is > 0).Select(u => u.PeakMemoryBytes!.Value).DefaultIfEmpty(0).Max();
    var availableSlow = Model.Stages.Values.Where(s => !s.Unavailable && s.P95Ms is > 0).Select(s => s.P95Ms!.Value).ToList();
    var maxSlow = availableSlow.Count > 0 ? availableSlow.Max() : 0;
}

@if (Model.StagesUnavailable)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        Per-step timings were not recorded for this run. Total time, speed, and check results below are still from this run.
    </div>
}

<div class="au-card">
    <div class="card-header"><i class="bi bi-clipboard-data me-2"></i>At a glance</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Result</span><span class="au-value">@(Model.Outcome == "Succeeded" ? "Passed" : Model.Outcome)</span></div></div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Total time</span><span class="au-value">@FormatDuration(Model.E2eDurationSeconds)</span></div></div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Patients</span><span class="au-value">@Model.PatientCount</span></div></div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Patients per minute</span><span class="au-value">@(Model.PatientsPerMinute?.ToString("0.0") ?? "—")</span></div></div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">FHIR resources per second</span><span class="au-value">@(Model.ResourcesPerSecond?.ToString("0.0") ?? "—")</span></div></div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Finished</span><span class="au-value">@FormatWhen(Model.FinishedAt)</span></div></div>
            <div class="col-md-3">
                <div class="au-summary-item">
                    <span class="au-label">Patient generator version</span>
                    <code class="au-value" title="Git commit of the Thetis engine used to generate patients.">@(string.IsNullOrWhiteSpace(Model.ThetisGitSha) ? "—" : Model.ThetisGitSha)</code>
                </div>
            </div>
            <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Generation seed</span><span class="au-value">@Model.Seed</span></div></div>
            @if (Model.GenerationDurationMs > 0)
            {
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Patient generation time</span><span class="au-value">@FormatDuration(Model.GenerationDurationMs / 1000.0)</span></div></div>
            }
        </div>
    </div>
</div>

<div class="au-card">
    <div class="card-header"><i class="bi bi-bar-chart-steps me-2"></i>How long each pipeline step took</div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            <strong>Typical</strong> = half of the operations were faster than this.
            <strong>Slow</strong> = 95% were faster (this is the number to watch).
            <strong>Slowest</strong> = 99% were faster.
            Bars are sized from the Slow column so the longest step is easy to spot.
        </p>
        @foreach (var key in stageOrder)
        {
            Model.Stages.TryGetValue(key, out var stage);
            stage ??= new StageSnapshot { Unavailable = true };
            var width = !stage.Unavailable && maxSlow > 0 && stage.P95Ms is > 0
                ? Math.Clamp(stage.P95Ms.Value / maxSlow * 100, 4, 100)
                : 0;
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline gap-2">
                    <div>
                        <span class="fw-semibold">@DisplayName(key)</span>
                        <span class="small text-muted ms-1">@StageHint(key)</span>
                    </div>
                    @if (!stage.Unavailable && stage.ErrorCount > 0)
                    {
                        <span class="badge au-badge-danger">@stage.ErrorCount errors</span>
                    }
                </div>
                @if (stage.Unavailable)
                {
                    <div class="small text-warning mt-1">Not recorded for this run.</div>
                }
                else
                {
                    <div class="progress au-metrics-waterfall mt-1" role="img" aria-label="@DisplayName(key) slow time">
                        <div class="progress-bar" style="width:@width.ToString("0.0")%">Slow @FormatMs(stage.P95Ms)</div>
                    </div>
                    <div class="small text-muted mt-1">
                        Typical @FormatMs(stage.P50Ms)
                        · Slowest @FormatMs(stage.P99Ms)
                        · @stage.Count operations
                    </div>
                }
            </div>
        }

        <details class="mt-2">
            <summary class="small text-muted" style="cursor:pointer;">What is an operation?</summary>
            <p class="small text-muted mb-0 mt-2">One timing sample for that step — for example one FHIR query, one patient normalized, or one upload. Compare Slow times across runs of the same scenario; a jump usually means that step got heavier.</p>
        </details>
    </div>
</div>

<div class="au-card">
    <div class="card-header"><i class="bi bi-cpu me-2"></i>CPU and RAM during this run</div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Process CPU and memory over the same window as total time (report created through ABS upload).
            CPU is percent of this machine (like Task Manager). These are the service processes, not one facility. Peak RAM is the number to watch when a scenario gets bigger.
        </p>
        @if (!anyUtilization)
        {
            <p class="text-muted mb-0">CPU and RAM were not recorded for this run.</p>
        }
        else
        {
            @foreach (var proc in utilization)
            {
                var ramWidth = !proc.Unavailable && maxPeakRam > 0 && proc.PeakMemoryBytes is > 0
                    ? Math.Clamp(proc.PeakMemoryBytes.Value / maxPeakRam * 100, 4, 100)
                    : 0;
                <div class="mb-3">
                    <div>
                        <span class="fw-semibold">@proc.Name</span>
                        <span class="small text-muted ms-1">@proc.Hint</span>
                    </div>
                    @if (proc.Unavailable)
                    {
                        <div class="small text-warning mt-1">Not recorded for this run.</div>
                    }
                    else
                    {
                        <div class="progress au-metrics-waterfall mt-1" role="img" aria-label="@proc.Name peak RAM">
                            <div class="progress-bar" style="width:@ramWidth.ToString("0.0")%">Peak RAM @FormatRam(proc.PeakMemoryBytes)</div>
                        </div>
                        <div class="small text-muted mt-1">
                            Typical RAM @FormatRam(proc.AvgMemoryBytes)
                            · CPU @FormatPercent(proc.AvgCpuPercent) avg
                            · @FormatPercent(proc.PeakCpuPercent) peak
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="au-card">
    <div class="card-header"><i class="bi bi-hdd-network me-2"></i>API response time</div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Inbound HTTP to each Link service during this run, excluding health checks.
            <strong>Slow</strong> is p95. These are the service APIs the pipeline and poller actually called.
        </p>
        @if (!anyApi)
        {
            <p class="text-muted mb-0">API timings were not recorded for this run.</p>
        }
        else
        {
            @foreach (var api in apiLatency)
            {
                var width = !api.Unavailable && maxApiP95 > 0 && api.P95Ms is > 0
                    ? Math.Clamp(api.P95Ms.Value / maxApiP95 * 100, 4, 100)
                    : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="fw-semibold">@api.Name</span>
                        @if (!api.Unavailable && api.ErrorCount > 0)
                        {
                            <span class="badge au-badge-danger">@api.ErrorCount HTTP 5xx</span>
                        }
                    </div>
                    @if (api.Unavailable)
                    {
                        <div class="small text-warning mt-1">No API calls recorded for this service.</div>
                    }
                    else
                    {
                        <div class="progress au-metrics-waterfall mt-1" role="img" aria-label="@api.Name API slow time">
                            <div class="progress-bar" style="width:@width.ToString("0.0")%">Slow @FormatMs(api.P95Ms)</div>
                        </div>
                        <div class="small text-muted mt-1">
                            Typical @FormatMs(api.P50Ms)
                            · Slowest @FormatMs(api.P99Ms)
                            · @api.Count calls
                        </div>
                    }
                </div>
            }
        }

        @if (slowestRoutes.Count > 0)
        {
            <div class="mt-3">
                <div class="fw-semibold small mb-2">Slowest endpoints this run</div>
                <table class="table au-table mb-0">
                    <thead><tr><th>Service</th><th>Call</th><th>Slow</th><th>Calls</th></tr></thead>
                    <tbody>
                    @foreach (var route in slowestRoutes)
                    {
                        <tr>
                            <td>@route.Service</td>
                            <td><code>@route.Method @route.Route</code></td>
                            <td>@FormatMs(route.P95Ms)</td>
                            <td>@route.Count.ToString("0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="au-card">
    <div class="card-header"><i class="bi bi-check2-square me-2"></i>Checks that ran</div>
    <div class="card-body">
        @if (Model.Validators.Count == 0)
        {
            <p class="text-muted mb-0">No check results were saved with these timings. Use the Checks / validator cards on this run for the live table.</p>
        }
        else
        {
            <table class="table au-table mb-0">
                <thead><tr><th>Check</th><th>Result</th><th>Issues</th></tr></thead>
                <tbody>
                @foreach (var validator in Model.Validators)
                {
                    <tr>
                        <td>@validator.Name</td>
                        <td>
                            <span class="badge rounded-pill @(string.Equals(validator.Outcome, "Passed", StringComparison.OrdinalIgnoreCase) ? "au-badge-success" : string.Equals(validator.Outcome, "Failed", StringComparison.OrdinalIgnoreCase) ? "au-badge-danger" : "au-badge-muted")">
                                @validator.Outcome
                            </span>
                        </td>
                        <td>@validator.IssueCount</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="au-card">
    <div class="card-header"><i class="bi bi-flag me-2"></i>Limits and comparison</div>
    <div class="card-body">
        <p class="small text-muted mb-3">Compared with the last <strong>successful</strong> metrics run of this same scenario, when there is one. A missed time budget or saved limit is listed here even if the functional run still passed.</p>
        <div class="row g-3 mb-2">
            <div class="col-md-4">
                <div class="au-summary-item">
                    <span class="au-label">Met saved limits</span>
                    <span class="au-value">
                        @if (Model.BenchmarkViolations.Count > 0)
                        {
                            <span class="text-danger">No</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.BenchmarkKey) || !Model.BenchmarkPass)
                        {
                            @(Model.BenchmarkPass ? "Yes" : "No")
                        }
                        else
                        {
                            <span>None set</span>
                        }
                    </span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="au-summary-item">
                    <span class="au-label">Previous successful run</span>
                    @if (Model.PreviousRunId is Guid previous)
                    {
                        <a asp-controller="Metrics" asp-action="Details" asp-route-id="@previous">View previous run</a>
                    }
                    else
                    {
                        <span class="au-value">None yet</span>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="au-summary-item">
                    <span class="au-label">Got slower than last run</span>
                    <span class="au-value">@(Model.RegressionFlags.Count == 0 ? "No" : $"{Model.RegressionFlags.Count} notice(s)")</span>
                </div>
            </div>
        </div>

        @if (Model.BenchmarkViolations.Count > 0)
        {
            <div class="mt-2">
                <div class="fw-semibold small mb-1">Missed limits</div>
                <ul class="small mb-0">
                    @foreach (var violation in Model.BenchmarkViolations)
                    {
                        <li>@violation</li>
                    }
                </ul>
            </div>
        }

        @if (Model.RegressionFlags.Count > 0)
        {
            <div class="mt-3">
                <div class="fw-semibold small mb-1">Slower than last successful run</div>
                <ul class="small mb-0">
                    @foreach (var flag in Model.RegressionFlags)
                    {
                        <li>@flag</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
