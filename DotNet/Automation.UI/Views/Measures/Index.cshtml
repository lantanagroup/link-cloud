@using LantanaGroup.Automation.Generation
@model List<Automation.UI.Models.MeasureTemplate>
@{
    ViewData["Title"] = "Measures";
    var families = Enum.GetValues<ProfiledMeasureType>();
}

<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-clipboard2-pulse me-2"></i>Measures</h2>
    <p class="text-muted mb-3">
        Measure definitions loaded into MeasureEval at run start.
        Each measure has an <strong>Automation generation type</strong> that controls how patients are generated and predicted.
        System measures cannot be edited; clone one to use a different FHIR bundle.
    </p>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-2"></i>All Measures</span>
            <button type="button" class="btn btn-sm btn-success" id="btnNewMeasure">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table au-table mb-0" id="measureTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Generation type</th>
                        <th>Measure id</th>
                        <th>Version</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Updated</th>
                        <th style="width:280px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr data-id="@t.Id">
                            <td>
                                <strong>@t.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                {
                                    <br /><small class="text-muted">@t.Description</small>
                                }
                            </td>
                            <td><small>@ProfiledMeasureCatalog.GetDisplayName(t.GenerationFamily)</small></td>
                            <td><code class="small">@(t.MeasureId ?? "—")</code></td>
                            <td><small>@(t.Version ?? "—")</small></td>
                            <td class="small text-muted">@(t.MeasureDate ?? "—")</td>
                            <td>
                                @if (t.IsSystem)
                                {
                                    <span class="badge bg-dark">System</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Custom</span>
                                }
                            </td>
                            <td class="small text-muted">@t.UpdatedAt.LocalDateTime.ToString("g")</td>
                            <td class="text-nowrap">
                                <div class="d-inline-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-measure-open" data-id="@t.Id" data-mode="@(t.IsSystem ? "view" : "edit")">
                                        @(t.IsSystem ? "View" : "Edit")
                                    </button>
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Download", "Measures", new { id = t.Id })" title="Download FHIR bundle">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-measure-clone" data-id="@t.Id">Clone</button>
                                    @if (!t.IsSystem)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-measure-delete" data-id="@t.Id">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-4">No measures yet. Click <strong>+</strong> to create one.</div>
            }
        </div>
    </div>
</div>

<div id="measureModal" style="display:none;position:fixed;inset:0;z-index:1055;overflow-y:auto;">
    <div style="min-height:100%;display:flex;align-items:center;justify-content:center;padding:2rem;">
        <div style="background:#fff;border-radius:var(--au-radius);box-shadow:0 8px 40px rgba(0,0,0,.3);width:100%;max-width:1100px;display:flex;flex-direction:column;max-height:90vh;">
            <div style="background:var(--au-dark);color:#fff;padding:.75rem 1rem;border-radius:var(--au-radius) var(--au-radius) 0 0;flex-shrink:0;" class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="measureModalTitle"><i class="bi bi-clipboard2-pulse me-2"></i>Measure</h5>
                <div class="d-flex gap-2 align-items-center">
                    <a class="btn btn-sm btn-outline-light" id="btnMeasureDownload" href="#" style="display:none;">
                        <i class="bi bi-download me-1"></i>Download
                    </a>
                    <button type="button" class="btn btn-sm btn-success" id="btnMeasureSave" style="display:none;">
                        <i class="bi bi-floppy me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="btnMeasureClose">Close</button>
                </div>
            </div>
            <div id="measureFormErrors" class="alert alert-danger m-3 mb-0 py-2 small" style="display:none;"></div>
            <div style="flex:1;overflow-y:auto;padding:1.25rem;" id="measureModalBody">
                @Html.AntiForgeryToken()
                <input type="hidden" id="MeasureId" />
                <input type="hidden" id="MeasureIsSystem" value="false" />
                <div class="position-relative" id="measureConfigArea">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="MeasureName">Name</label>
                            <input class="form-control" id="MeasureName" maxlength="160" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="MeasureFamily">
                                Automation generation type
                                <span class="au-info-icon" data-bs-toggle="tooltip" title="Controls how Automation generates patients and predicts ABS contents. The uploaded FHIR bundle is what MeasureEval evaluates."><i class="bi bi-info-circle"></i></span>
                            </label>
                            <select class="form-select" id="MeasureFamily">
                                @foreach (var family in families)
                                {
                                    <option value="@family">@ProfiledMeasureCatalog.GetDisplayName(family)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="MeasureDescription">Description</label>
                            <input class="form-control" id="MeasureDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="MeasureBundleFile">Replace bundle (FHIR JSON)</label>
                            <input type="file" class="form-control" id="MeasureBundleFile" accept="application/json,.json" />
                            <div class="form-text">Transaction Bundle containing a Measure and Library. Maximum 12 MB.</div>
                            <div class="small mt-2" id="measureMetaPreview"></div>
                        </div>
                        <div class="col-12" id="customMeasureWarning">
                            <div class="alert alert-warning py-2 small mb-0">
                                Generation and ABS prediction follow the selected generation type’s rules.
                                If this file’s CQL supplemental data differs from that type, prediction may drift.
                            </div>
                        </div>
                    </div>
                    <div id="measureSystemOverlay" class="position-absolute top-0 start-0 w-100 h-100 au-system-overlay" style="display:none;"></div>
                </div>
                <div class="mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Bundle content</label>
                        <span class="small text-muted" id="measureContentHint"></span>
                    </div>
                    <pre id="measureBundleContent" class="border rounded p-2 small mb-0" style="max-height:40vh;overflow:auto;background:#f8f9fa;white-space:pre;">No bundle loaded.</pre>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="measureModalBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;"></div>

@section Scripts {
<script>
(function () {
    'use strict';

    var modal = document.getElementById('measureModal');
    var backdrop = document.getElementById('measureModalBackdrop');
    var modalTitle = document.getElementById('measureModalTitle');
    var btnSave = document.getElementById('btnMeasureSave');
    var btnDownload = document.getElementById('btnMeasureDownload');
    var overlay = document.getElementById('measureSystemOverlay');
    var idInput = document.getElementById('MeasureId');
    var isSystemInput = document.getElementById('MeasureIsSystem');
    var errors = document.getElementById('measureFormErrors');
    var metaPreview = document.getElementById('measureMetaPreview');
    var customWarning = document.getElementById('customMeasureWarning');
    var bundleContent = document.getElementById('measureBundleContent');
    var contentHint = document.getElementById('measureContentHint');
    var pendingBundleJson = '';

    var saveUrl = '@Url.Action("SaveInline", "Measures")';
    var deleteUrl = '@Url.Action("DeleteInline", "Measures")';
    var cloneUrl = '@Url.Action("CloneInline", "Measures")';
    var getJsonUrl = '@Url.Action("GetJson", "Measures")';
    var getDefaultsUrl = '@Url.Action("GetDefaults", "Measures")';
    var downloadUrl = '@Url.Action("Download", "Measures")';

    function af() { var t = document.querySelector('#measureModal input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
    function showErrors(msg) { errors.style.display = ''; errors.textContent = msg; }
    function hideErrors() { errors.style.display = 'none'; errors.textContent = ''; }
    function openModal() { modal.style.display = ''; backdrop.style.display = ''; }
    function closeModal() { modal.style.display = 'none'; backdrop.style.display = 'none'; hideErrors(); }

    function setEditable(e) {
        overlay.style.display = e ? 'none' : '';
        btnSave.style.display = e ? '' : 'none';
        customWarning.style.display = e ? '' : 'none';
        document.getElementById('MeasureBundleFile').disabled = !e;
        document.getElementById('MeasureName').readOnly = !e;
        document.getElementById('MeasureDescription').readOnly = !e;
        document.getElementById('MeasureFamily').disabled = !e;
    }

    function setMeta(m) {
        var parts = [];
        if (m.measureId) parts.push('id=' + m.measureId);
        if (m.version) parts.push('version=' + m.version);
        if (m.measureDate) parts.push('date=' + m.measureDate);
        if (m.status) parts.push('status=' + m.status);
        metaPreview.textContent = parts.length ? parts.join(' · ') : '';
    }

    function prettyJson(raw) {
        if (!raw) return '';
        try { return JSON.stringify(JSON.parse(raw), null, 2); }
        catch (_) { return raw; }
    }

    function showBundle(raw) {
        if (!raw) {
            bundleContent.textContent = 'No bundle loaded.';
            contentHint.textContent = '';
            return;
        }
        var pretty = prettyJson(raw);
        bundleContent.textContent = pretty;
        var kb = Math.max(1, Math.round(raw.length / 1024));
        contentHint.textContent = kb + ' KB';
    }

    function setDownloadHref(id) {
        if (!id) {
            btnDownload.style.display = 'none';
            btnDownload.setAttribute('href', '#');
            return;
        }
        btnDownload.style.display = '';
        btnDownload.setAttribute('href', downloadUrl + '?id=' + encodeURIComponent(id));
    }

    function fill(m) {
        idInput.value = m.id || '';
        isSystemInput.value = m.isSystem ? 'true' : 'false';
        document.getElementById('MeasureName').value = m.name || '';
        document.getElementById('MeasureDescription').value = m.description || '';
        document.getElementById('MeasureFamily').value = m.generationFamily || 'NhsnAcuteCareHospitalMonthlyInitialPopulation';
        pendingBundleJson = m.bundleJson || '';
        document.getElementById('MeasureBundleFile').value = '';
        setMeta(m);
        showBundle(pendingBundleJson);
        setDownloadHref(m.id && pendingBundleJson ? m.id : '');
    }

    document.getElementById('btnMeasureClose').addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);

    document.getElementById('MeasureBundleFile').addEventListener('change', function (ev) {
        var file = ev.target.files && ev.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function () {
            pendingBundleJson = String(reader.result || '');
            metaPreview.textContent = 'Loaded ' + file.name + ' (' + Math.round(file.size / 1024) + ' KB). Metadata is extracted on save.';
            showBundle(pendingBundleJson);
        };
        reader.readAsText(file);
    });

    document.getElementById('btnNewMeasure').addEventListener('click', function () {
        fetch(getDefaultsUrl, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (m) {
                fill(m);
                modalTitle.innerHTML = '<i class="bi bi-clipboard2-pulse me-2"></i>New Measure';
                setEditable(true);
                openModal();
            });
    });

    document.querySelectorAll('.btn-measure-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-id');
            var mode = btn.getAttribute('data-mode');
            fetch(getJsonUrl + '?id=' + encodeURIComponent(id), { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (m) {
                    fill(m);
                    modalTitle.innerHTML = '<i class="bi bi-clipboard2-pulse me-2"></i>' + (mode === 'view' ? 'View Measure' : 'Edit Measure');
                    setEditable(mode !== 'view');
                    openModal();
                });
        });
    });

    document.querySelectorAll('.btn-measure-clone').forEach(function (btn) {
        btn.addEventListener('click', function () {
            fetch(cloneUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': af() },
                body: JSON.stringify({ id: btn.getAttribute('data-id') })
            }).then(function (r) {
                if (r.ok) location.reload();
                else r.text().then(function (t) { alert(t || 'Clone failed'); });
            });
        });
    });

    document.querySelectorAll('.btn-measure-delete').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (!confirm('Delete this custom measure?')) return;
            fetch(deleteUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': af() },
                body: JSON.stringify({ id: btn.getAttribute('data-id') })
            }).then(function (r) {
                if (r.ok) location.reload();
                else r.text().then(function (t) { alert(t || 'Delete failed'); });
            });
        });
    });

    btnSave.addEventListener('click', function () {
        hideErrors();
        if (!pendingBundleJson) {
            showErrors('A FHIR measure bundle is required.');
            return;
        }
        var body = {
            id: idInput.value,
            name: document.getElementById('MeasureName').value,
            description: document.getElementById('MeasureDescription').value,
            generationFamily: document.getElementById('MeasureFamily').value,
            bundleJson: pendingBundleJson
        };
        fetch(saveUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': af() },
            body: JSON.stringify(body)
        }).then(function (r) {
            if (r.ok) { location.reload(); return; }
            return r.text().then(function (t) { showErrors(t || 'Save failed'); });
        });
    });
})();
</script>
}
