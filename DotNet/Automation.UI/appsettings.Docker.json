{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ServiceInformation": {
    "ServiceName": "Link Automation UI",
    "ServiceConfigName": "AutomationUI",
    "ProductVersion": "dev"
  },
  "PatientAggregator": {
    "IncludeOrganizationResource": true
  },
  "Authentication": {
    "UseBearerForServiceCalls": false,
    "EnableAnonymousAccess": true
  },
  "LinkTokenService": {
    "SigningKey": ""
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceUrl": "http://tenant:8074",
      "CheckIfTenantExists": true
    },
    "CensusServiceUrl": "http://census:8064",
    "DataAcquisitionServiceUrl": "http://dataacq:8065",
    "NormalizationServiceUrl": "http://normalization:8068",
    "QueryDispatchServiceUrl": "http://querydispatch:8071",
    "ReportServiceUrl": "http://report:8072",
    "MeasureServiceUrl": "http://measureeval:8067",
    "ValidationServiceUrl": "http://validation:8075",
    "SubmissionServiceUrl": "http://submission:8073"
  },
  "Automation": {
    "FhirServerBase": "http://fhir-server:8080/fhir",
    "FacilityFhirServerBase": "http://fhir-server:8080/fhir",
    "AdminBffBase": "http://admin-bff:8063/api",
    "LokiBaseUrl": "http://loki:3100",
    "CleanupTestData": false,
    "AdminBffOAuth": {
      "ShouldAuthenticate": false,
      "Scope": "openid profile email"
    },
    "FhirServerOAuth": {
      "ShouldAuthenticate": false,
      "Scope": "openid profile email"
    },
    "FhirServerBasicAuth": {
      "ShouldAuthenticate": false
    },
    "FhirQuery": {
      "MaxConcurrentRequests": 8,
      "MinAcquisitionPullTime": null,
      "MaxAcquisitionPullTime": null,
      "TimeZone": null
    },
    "FhirGeneration": {
      "IncludeLowValueOptionalReferences": false,
      "ResourceDistribution": {
        "Observation": 0.3,
        "Condition": 0.1,
        "Procedure": 0.08,
        "MedicationRequest": 0.08,
        "MedicationAdministration": 0.1,
        "DiagnosticReport": 0.07,
        "ServiceRequest": 0.08,
        "Coverage": 0.02,
        "Specimen": 0.07
      }
    },
    "Database": {
      "Server": "mssql,1433"
    },
    "Kafka": {
      "BootstrapServers": "kafka_b:9092",
      "RestProxyBaseUrl": "http://kafka-rest-proxy:8082"
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://mongo:27017/?replicaSet=rs0",
    "DatabaseName": "botw-automation"
  },
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://+:5257"
      }
    }
  }
}
