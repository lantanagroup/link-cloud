{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceInformation": {
    "ServiceName": "Link Automation UI"
  },
  "Authentication": {
    "EnableAnonymousAccess": true,
    "Schemas": {
      "OpenIdConnect": {
        "Authority": "",
        "ClientId": "",
        "CallbackPath": "/signin-oidc"
      }
    }
  },
  "LinkTokenService": {
    "Authority": "",
    "TokenLifespan": 10
  },
  "ServiceRegistry": {
    "TenantService": {
      "TenantServiceUrl": ""
    },
    "CensusServiceUrl": "",
    "DataAcquisitionServiceUrl": "",
    "NormalizationServiceUrl": "",
    "ReportServiceUrl": "",
    "MeasureServiceUrl": "",
    "ValidationServiceUrl": "",
    "SubmissionServiceUrl": ""
  },
  "Automation": {
    "ExternalFhirServerBase": "http://localhost:6157/fhir",
    "InternalFhirServerBase": "http://fhir-server:8080/fhir",
    "AdminBffBase": "http://localhost:8063/api",
    "LokiBaseUrl": "http://localhost:3100",
    "CleanupTestData": false,
    "AdminBffOAuth": {
      "ShouldAuthenticate": false,
      "Scope": "openid profile email"
