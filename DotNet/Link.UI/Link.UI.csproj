<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Link.UI</RootNamespace>
    <AssemblyName>Link.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Automation.UI\Automation.UI.csproj" />
    <ProjectReference Include="..\LinkSdk\LinkSdk.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- Automation.UI is referenced for its run engine. Its wwwroot must not merge
       into this host, which already serves css/site.css. -->
  <Target Name="DropAutomationUiStaticWebAssets" BeforeTargets="GenerateStaticWebAssetsManifest">
    <ItemGroup>
      <StaticWebAsset Remove="@(StaticWebAsset)" Condition="'%(SourceId)' == 'Automation.UI'" />
      <StaticWebAssetEndpoint Remove="@(StaticWebAssetEndpoint)" Condition="'%(AssetFile)' != '' and $([System.String]::Copy('%(AssetFile)').Contains('Automation.UI'))" />
      <StaticWebAssetDiscoveryPattern Remove="@(StaticWebAssetDiscoveryPattern)" Condition="$([System.String]::Copy('%(ContentRoot)').Contains('Automation.UI'))" />
      <StaticWebAssetProjectConfiguration Remove="@(StaticWebAssetProjectConfiguration)" Condition="$([System.String]::Copy('%(Identity)').Contains('Automation.UI.csproj'))" />
    </ItemGroup>
  </Target>
</Project>
