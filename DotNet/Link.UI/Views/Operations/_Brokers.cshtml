@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var origin = ReturnUrlRules.Here(Context.Request);
    var selected = Model.SelectedBroker;
    var showLogDirs = KafkaLogDirs.Show(Model.Cluster);
    var rightsDenied = Model.Capabilities.Topics.Count(right => right.CanAlterPartitions == false);
    var rightsUnknown = Model.Capabilities.Topics.Count(right => right.CanAlterPartitions is null);
    var rightsWindow = KafkaWindows.DeniedRights(Model.Capabilities.Topics, query.PartPage, query.PageSize);
    string SortDir(string column) => query.Sort == column && query.Dir == "asc" ? "desc" : "asc";
    string Size(long bytes) => bytes < 0 ? "Not available" : bytes.ToString("N0");
}

@if (!string.IsNullOrWhiteSpace(query.Broker) && selected is null)
{
    <partial name="_KafkaNotFound" model="@(new KafkaNotFound("Broker", query.Broker, "/Operations/Kafka/Brokers", "All brokers"))" />
}
@if (string.IsNullOrWhiteSpace(query.Broker))
{
<section class="card au-card mt-3" id="kafka-brokers">
    <h2 class="card-header h6 mb-0 d-flex justify-content-between align-items-center">
        <span>Brokers <partial name="_TermInfo" model="@(new TermInfo { Label = "About brokers", Text = "Open a broker to preview a decommission or a rebalance. A preview plans the partitions and changes nothing. Decommission stops the broker only after every replica and leader has moved and the cluster has no under-replicated or offline partitions. A broker that is not up is listed first. Alter is what an in-place partition increase needs. Topics that cannot alter partitions are listed under Broker rights." + (string.IsNullOrWhiteSpace(Model.Cluster.LogDirDetail) ? "" : " " + Model.Cluster.LogDirDetail) + (Model.Infra.Enabled ? "" : " " + Model.Infra.Detail) })" /></span>
        <button class="btn btn-sm btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#kafka-add-broker" aria-expanded="false" aria-controls="kafka-add-broker">Add broker</button>
    </h2>
    <div class="card-body">
        <div class="collapse mb-3" id="kafka-add-broker">
            <form method="post" action="/Operations/Kafka/brokers">
                @Html.AntiForgeryToken()
                <partial name="_QueryFields" model="query" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="add-broker-reason">Reason <partial name="_TermInfo" model="@(new TermInfo { Label = "About adding a broker", Text = "The new broker is registered first. This request does not move partitions. Open the new broker afterwards to preview a rebalance onto it. Nothing moves until that request is approved and executed." })" /></label>
                        <input class="form-control" id="add-broker-reason" name="addBrokerReason" value="@Model.DraftAddBrokerReason" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-success" type="submit" title="Add a broker" aria-label="Add a broker"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="ms-1">Add</span></button>
                    </div>
                </div>
            </form>
        </div>
        <form class="row g-2 align-items-end mb-3" method="get" action="@(string.IsNullOrWhiteSpace(query.Broker) ? "/Operations/Kafka/Brokers" : KafkaConsoleRoutes.Broker(query.Broker))">
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <input type="hidden" name="family" value="@query.Family" />
            <input type="hidden" name="keyClass" value="@query.KeyClass" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="topic" value="@query.TopicName" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
            <div class="col-12 col-md-4">
                <input class="form-control" id="kafka-q" aria-label="Search brokers" placeholder="Search brokers by id or host" name="q" value="@query.Q" />
            </div>
            <div class="col-auto">
                <button class="btn btn-au-execute" type="submit">Search</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm mb-0" id="kafka-broker-table">
                <thead>
                    <tr>
                        <th class="lu-shrink">Id</th>
                        <th class="lu-flex">Host</th>
                        <th>Rack</th>
                        <th>State</th>
                        <th><a href="@query.Href(sort: "partitions", dir: SortDir("partitions"), page: 1)">Partitions</a></th>
                        <th><a href="@query.Href(sort: "leaders", dir: SortDir("leaders"), page: 1)">Leaders</a></th>
                        @if (showLogDirs)
                        {
                            <th>Log dir</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.BrokerRows)
                {
                    <tr class="@(KafkaAttention.Broker(row) ? "lu-kafka-problem" : null)">
                        <td class="lu-shrink"><a href="@query.Href(broker: row.Id.ToString(), page: 1)" title="Open broker @row.Id">@row.Id</a></td>
                        <td class="lu-flex" title="@row.Host:@row.Port">@row.Host:@row.Port</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Rack) ? "—" : row.Rack)</td>
                        <td><span class="badge @StatusPills.ForKafka(row.State)">@row.State</span></td>
                        <td>@row.PartitionCount</td>
                        <td>@row.LeaderCount</td>
                        @if (showLogDirs)
                        {
                            <td>@Size(row.LogDirBytes)</td>
                        }
                        <td>
                            <a class="btn btn-sm btn-au-link lu-icon-btn" href="@query.Href(broker: row.Id.ToString(), page: 1)" title="Open broker @row.Id" aria-label="Open broker @row.Id"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.BrokerRows.Count == 0)
        {
            <p class="text-muted mb-0 mt-2">No brokers match this search.</p>
        }
        <div class="lu-kafka-pager">
            <span>@Counts.Of(Model.BrokerCount, "broker"). Page @query.Page of @Model.BrokerPages.@(query.Sort is "partitions" or "brokers" or "leaders" ? "" : " Worst first.")</span>
            <span class="d-flex gap-2">
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "previous", Href = query.Href(page: query.Page - 1), Enabled = query.Page > 1 })" />
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "next", Href = query.Href(page: query.Page + 1), Enabled = query.Page < Model.BrokerPages })" />
            </span>
        </div>

        </div>
</section>
}

@if (selected is not null)
{
    var onBroker = Model.Cluster.Placements.Where(row => row.Leader == selected.Id || row.Replicas.Contains(selected.Id)).OrderByDescending(row => row.Leader < 0 || row.Isr.Count < row.Replicas.Count).ThenBy(row => row.Topic, StringComparer.OrdinalIgnoreCase).ThenBy(row => row.Partition).ToList();
    var shownPlacements = onBroker.Take(query.PageSize).ToList();
    var brokerBlocked = !Model.Infra.Enabled;
    <section class="card au-card mt-3 @(KafkaAttention.Broker(selected) ? "lu-kafka-attention" : null)" id="kafka-broker-card">
        <h2 class="card-header h6 mb-0">Broker @selected.Id <partial name="_CopyButton" model="@(new CopyTarget { Value = selected.Id.ToString(), Label = "Copy broker id" })" /></h2>
        <div class="card-body">
            <form method="post" action="/Operations/Kafka/brokers/decommission/plan" data-kafka-busy="Dry run is running.">
                    @Html.AntiForgeryToken()
                    <partial name="_QueryFields" model="@(query with { Broker = selected.Id.ToString() })" />
                    <input type="hidden" name="brokerId" value="@selected.Id" />
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="broker-reason">Reason <partial name="_TermInfo" model="@(new TermInfo { Label = "About the broker request", Text = "A preview does not read the reason. Decommission and Rebalance do. Preview decommission plans moves off this broker. Preview rebalance plans moves onto it." + (Model.Infra.Enabled ? "" : " " + Model.Infra.Detail) })" /></label>
                        <input class="form-control" id="broker-reason" name="reason" value="@Model.DraftReason" />
                    </div>
                    @if (Model.MovePlan is not null)
                    {
                        var plan = Model.MovePlan;
                        var moveLines = BrokerMovePreview.Lines(plan.Moves);
                        var shownMoves = moveLines.Take(BrokerMovePreview.FoldAfter).ToList();
                        var restMoves = moveLines.Skip(BrokerMovePreview.FoldAfter).ToList();
                        var shownErrors = plan.Errors.Take(BrokerMovePreview.FoldAfter).ToList();
                        var restErrors = plan.Errors.Skip(BrokerMovePreview.FoldAfter).ToList();
                        var moveTone = plan.Accepted ? "alert-success" : "alert-danger";
                        <div id="kafka-broker-result" class="alert @moveTone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-broker" data-result-key="@(plan.Accepted)-@plan.BrokerId-@plan.Moves.Count-@plan.Errors.Count">
                            <details class="lu-result-details">
                                <summary>
                                    <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                                    <span class="lu-result-text">@(plan.Accepted ? "Dry run accepted. Nothing has moved yet." : "This broker change cannot run yet.")</span>
                                    <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                                </summary>
                                <div class="lu-result-body">
                                    <dl class="row mb-2">
                                        <dt class="col-sm-4">Broker</dt>
                                        <dd class="col-sm-8">@plan.BrokerId</dd>
                                        <dt class="col-sm-4">Partitions</dt>
                                        <dd class="col-sm-8">@BrokerMovePreview.MoveSummary(plan.Accepted, plan.AlreadyEmpty, plan.Moves.Count)</dd>
                                        <dt class="col-sm-4">Approval</dt>
                                        <dd class="col-sm-8">@(plan.SecondApproverRequired ? "A second approver is required." : "A second approver is not required.")</dd>
                                    </dl>
                                    @if (shownErrors.Count > 0)
                                    {
                                        <p class="mb-1">Blocking reasons</p>
                                        <ul class="mb-2">
                                        @foreach (var planError in shownErrors)
                                        {
                                            <li>@planError</li>
                                        }
                                        </ul>
                                        @if (restErrors.Count > 0)
                                        {
                                            <details>
                                                <summary>Show the rest</summary>
                                                <ul class="mb-2">
                                                @foreach (var planError in restErrors)
                                                {
                                                    <li>@planError</li>
                                                }
                                                </ul>
                                            </details>
                                        }
                                    }
                                    @if (shownMoves.Count > 0)
                                    {
                                        <p class="mb-1">Topics</p>
                                        <ul class="mb-2">
                                        @foreach (var line in shownMoves)
                                        {
                                            <li>@line.Topic — @line.Partitions partition@(line.Partitions == 1 ? "" : "s")@(line.Internal ? " (internal)" : "")</li>
                                        }
                                        </ul>
                                        @if (restMoves.Count > 0)
                                        {
                                            <details>
                                                <summary>Show the rest</summary>
                                                <ul class="mb-2">
                                                @foreach (var line in restMoves)
                                                {
                                                    <li>@line.Topic — @line.Partitions partition@(line.Partitions == 1 ? "" : "s")@(line.Internal ? " (internal)" : "")</li>
                                                }
                                                </ul>
                                            </details>
                                        }
                                    }
                                    <p class="mb-2">@(plan.Accepted ? "Ready. Submit the decommission or the rebalance when the reason is filled in." : "Fix the items above, then preview again.")</p>
                                    @if (plan.Notes.Count > 0)
                                    {
                                        <details>
                                            <summary>Details</summary>
                                            @foreach (var note in plan.Notes)
                                            {
                                                <p class="mb-1">@note</p>
                                            }
                                        </details>
                                    }
                                </div>
                            </details>
                        </div>
                    }
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button class="btn btn-sm btn-au-execute lu-icon-btn @(brokerBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/brokers/decommission/plan" title="Preview decommission" aria-label="Preview decommission" @(brokerBlocked ? "disabled" : null)><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview decommission</span></button>
                        <button class="btn btn-sm btn-danger lu-icon-btn @(brokerBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/brokers/decommission" data-hold="@Hold.Of("Decommission broker " + selected.Id, "Move every replica and leader off broker " + selected.Id + ", then stop it.", new[] { Hold.Pair("Broker", selected.Id), Hold.Pair("Host", selected.Host + ":" + selected.Port), Hold.Pair("Partitions", selected.PartitionCount), Hold.Pair("Leaders", selected.LeaderCount) }, new[] { new[] { "reason", "Reason" } }, new[] { "Partition moves add network and disk load on every broker until they finish.", "Cluster capacity drops once the broker stops.", "A cluster with too few brokers can go under-replicated." }, "", "Hold to decommission")" title="Decommission broker" aria-label="Decommission broker" @(brokerBlocked ? "disabled" : null)><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="ms-1">Decommission</span></button>
                        <button class="btn btn-sm btn-au-execute lu-icon-btn @(brokerBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/brokers/rebalance/plan" title="Preview rebalance" aria-label="Preview rebalance" @(brokerBlocked ? "disabled" : null)><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview rebalance</span></button>
                        <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
                        <button class="btn btn-sm btn-au-execute lu-icon-btn @(brokerBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/brokers/rebalance" data-hold="@Hold.Of("Rebalance onto broker " + selected.Id, "Move partitions onto broker " + selected.Id + ".", new[] { Hold.Pair("Broker", selected.Id), Hold.Pair("Host", selected.Host + ":" + selected.Port), Hold.Pair("Partitions", selected.PartitionCount) }, new[] { new[] { "reason", "Reason" } }, new[] { "Partition moves add network and disk load until they finish.", "Leaders can change while partitions move." }, "", "Hold to rebalance")" title="Rebalance onto this broker" aria-label="Rebalance onto this broker" @(brokerBlocked ? "disabled" : null)><i class="bi bi-arrow-left-right" aria-hidden="true"></i><span class="ms-1">Rebalance</span></button>
                    </div>
                </form>
            <div class="row g-2 mt-3">
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.Host:@selected.Port</div><div class="au-stat-label">Host</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@(string.IsNullOrWhiteSpace(selected.Rack) ? "—" : selected.Rack)</div><div class="au-stat-label">Rack</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.State</div><div class="au-stat-label">State</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.PartitionCount</div><div class="au-stat-label">Partitions</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.LeaderCount</div><div class="au-stat-label">Leaders</div></div></div>
                @if (showLogDirs)
                {
                    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@Size(selected.LogDirBytes)</div><div class="au-stat-label">Log dir</div></div></div>
                }
            </div>
            <h3 class="h6 mt-3">Partitions on this broker</h3>
            @if (shownPlacements.Count == 0)
            {
                <p class="text-muted mb-0">This broker has no partitions.</p>
            }
            else
            {
                <p class="text-muted">Showing @shownPlacements.Count of @onBroker.Count. Worst first.</p>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Topic</th>
                                <th>Partition</th>
                                <th>Leader</th>
                                <th>Replicas</th>
                                <th>ISR</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in shownPlacements)
                        {
                            <tr class="@(row.Leader < 0 || row.Isr.Count < row.Replicas.Count ? "lu-kafka-problem" : null)">
                                <td class="lu-flex">@row.Topic</td>
                                <td>@row.Partition</td>
                                <td>@row.Leader</td>
                                <td>@string.Join(", ", row.Replicas)</td>
                                <td>@string.Join(", ", row.Isr)</td>
                                <td><a class="btn btn-sm btn-au-link lu-icon-btn" href="@KafkaConsoleRoutes.Topics(row.Topic, KafkaConsoleRoutes.Summary)" title="Open topic @row.Topic" aria-label="Open topic @row.Topic"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">Open</span></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

@if (rightsDenied > 0 || !string.IsNullOrWhiteSpace(Model.Capabilities.Error))
{
<details class="lu-kafka-fold">
    <summary>Broker rights (@Counts.Of(Model.Capabilities.Topics.Count, "topic")@(rightsDenied > 0 ? ", " + rightsDenied + " cannot alter partitions" : "")) <partial name="_TermInfo" model="@(new TermInfo { Label = "About broker rights", Text = "Alter is what an in-place partition increase needs. Unknown means the client did not report the right. This list is only the topics that cannot alter partitions." })" /></summary>
    <div class="mt-3">
        @if (!string.IsNullOrWhiteSpace(Model.Capabilities.Error))
        {
            <p class="text-muted">@Model.Capabilities.Error</p>
        }
        @if (Model.Capabilities.Topics.Count == 0)
        {
            <p class="mb-0">No topic rights were reported.</p>
        }
        else if (rightsWindow.Total == 0)
        {
            <p class="mb-0">Every reported topic can alter partitions.</p>
        }
        else if (rightsWindow.Rows.Count == 0)
        {
            <p class="mb-0">No denied topic on this page.</p>
        }
        else
        {
            <p>Showing @rightsWindow.Rows.Count of @rightsDenied that cannot alter partitions.</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Topic</th>
                            <th>Can alter partitions</th>
                            <th>Authorized operations</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var right in rightsWindow.Rows)
                    {
                        <tr class="lu-kafka-problem">
                            <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = right.Topic, Compact = true, CopyLabel = "Copy topic" })" /></td>
                            <td>No</td>
                            <td>@(right.AuthorizedOperations.Count == 0 ? (right.Error ?? "None reported") : string.Join(", ", right.AuthorizedOperations.Take(8)))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(rightsWindow.Page, rightsWindow.Pages, "Alphabetical.", rightsWindow.Page > 1 ? query.Href(part: rightsWindow.Page - 1) : "", rightsWindow.Page < rightsWindow.Pages ? query.Href(part: rightsWindow.Page + 1) : ""))" />
        }
        @if (rightsUnknown > 0)
        {
            <p class="text-muted mb-0">@Counts.Of(rightsUnknown, "topic") did not report the alter right. They stay off this list.</p>
        }
    </div>
</details>
}
