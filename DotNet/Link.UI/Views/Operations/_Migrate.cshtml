@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var topic = Model.SelectedTopic;
    var detail = Model.Detail;
    var plan = Model.MigrationPlan;
    var migration = Model.Migration;
    var topicName = topic?.Topic ?? query.TopicName;
    var targetPartitions = Model.DraftPartitions > 0 ? Model.DraftPartitions : (topic?.Partitions ?? 3) + 1;
    var resultTone = plan is null ? "alert-secondary" : !plan.Accepted ? "alert-danger" : plan.Warnings.Count > 0 ? "alert-warning" : "alert-success";
    var currentPartitions = topic?.Partitions ?? detail?.Partitions ?? 0;
    var partitionTone = Model.Plan is null ? "alert-secondary" : Model.Plan.Accepted ? "alert-success" : "alert-danger";
    var increaseLine = topic is null ? null : KafkaIncreaseEligibility.Line(topic.PartitionAddReason, Model.Plan, topic.Topic);
    var migrationLine = KafkaIncreaseEligibility.MigrationLine(topic?.MigrationEligibility ?? detail?.Eligibility, plan);
    var familyUneven = topic is not null && (topic.RetryPartitions > 0 && topic.RetryPartitions < topic.Partitions || topic.ErrorPartitions > 0 && topic.ErrorPartitions < topic.Partitions);
    var chooseMigrate = plan is not null || topic is null;
    var chooseFamily = !chooseMigrate && familyUneven && Model.Plan?.FamilyCompletion == true;
    var chooseAdd = !chooseMigrate && !chooseFamily;
    var previewAction = chooseMigrate ? "/Operations/Kafka/migrations/plan" : chooseFamily ? "/Operations/Kafka/family/plan" : "/Operations/Kafka/plan";
    var changeHelp = "An in-place add keeps the topic and remaps keys. A migration stops the workloads, copies the log to a backup, and recreates the topic empty. Consumer groups start at offset 0. Nothing is copied back. The backup stays until a person deletes it or retention expires. Adding partitions is permanent and cannot be reversed. The main topic, its retry topic, and its error topic increase together. None of them can shrink. When the family is uneven, the family action raises only the siblings that are behind.";
    if (topic?.KeyClass == "Facility")
        changeHelp += " One facility can never use more than one partition.";
}

<section class="card au-card mt-3 mb-3" id="kafka-change-partitions">
<h2 class="card-header h6 mb-0">Change partitions <partial name="_TermInfo" model="@(new TermInfo { Label = "About partition changes", Text = changeHelp })" /></h2>
<div class="card-body">
@if (string.IsNullOrWhiteSpace(topicName))
{
    <p class="mb-0">Choose a topic above.</p>
}
else
{
    <p class="mb-3">@topicName has @Counts.Of(currentPartitions, "partition").</p>
    <form method="post" action="@previewAction" data-kafka-busy="Dry run is running.">
        @Html.AntiForgeryToken()
        <partial name="_QueryFields" model="@(query with { TopicName = topicName, Advanced = true, View = ThroughputKafkaPageQuery.Migrate })" />
        <input type="hidden" name="planHash" value="@(Model.HasDryRunSnapshot ? (string.IsNullOrEmpty(plan?.PlanHash) ? Model.DraftPlanHash : plan.PlanHash) : "")" />
        <input type="hidden" name="hasDryRunSnapshot" value="@(Model.HasDryRunSnapshot ? "true" : "false")" />
        <input type="hidden" name="dryRunPartitions" value="@Model.DryRunPartitions" />
        <input type="hidden" name="dryRunBackupSkip" value="@(Model.DryRunBackupSkip ? "true" : "false")" />
        <input type="hidden" name="dryRunBackupSkipAcknowledged" value="@(Model.DryRunBackupSkipAcknowledged ? "true" : "false")" />
        <input type="hidden" name="dryRunAcknowledgedGroups" value="@string.Join(",", MigrationGroupList.Parse(Model.DryRunAcknowledgedGroups))" />
        <div class="d-flex flex-column gap-2 my-3">
            @if (topic is not null)
            {
                <div>
                    <label class="form-check-label" for="choice-add">
                        <input class="form-check-input" type="radio" name="partitionChoice" id="choice-add" data-preview="/Operations/Kafka/plan" @(chooseAdd ? "checked" : null) />
                        Add partitions in place
                    </label>
                    @if (!string.IsNullOrWhiteSpace(increaseLine))
                    {
                        <p class="mb-0 ms-4">@increaseLine</p>
                    }
                </div>
            }
            <div>
                <label class="form-check-label" for="choice-migrate">
                    <input class="form-check-input" type="radio" name="partitionChoice" id="choice-migrate" data-preview="/Operations/Kafka/migrations/plan" @(chooseMigrate ? "checked" : null) />
                    Migrate
                </label>
                @if (!string.IsNullOrWhiteSpace(migrationLine))
                {
                    <p class="mb-0 ms-4">@migrationLine</p>
                }
            </div>
            @if (familyUneven)
            {
                <div>
                    <label class="form-check-label" for="choice-family">
                        <input class="form-check-input" type="radio" name="partitionChoice" id="choice-family" data-preview="/Operations/Kafka/family/plan" @(chooseFamily ? "checked" : null) />
                        Complete the family <partial name="_TermInfo" model="@(new TermInfo { Label = "About family completion", Text = "The family is uneven. This raises only the retry and error topics up to the main topic. The main topic stays as it is. Preview and Apply both use that count. A preview does not read the reason. Apply does." })" />
                    </label>
                </div>
            }
        </div>
        <div data-partition-pane="add">
            <div class="form-check">
                <input class="form-check-input" id="plan-override" type="checkbox" name="overrideQuietWindow" value="true" @(Model.DraftOverride ? "checked" : null) />
                <label class="form-check-label" for="plan-override">Override the quiet window <partial name="_TermInfo" model="@(new TermInfo { Label = "About the quiet window", Text = "A second approver and a reason are required when the quiet window is overridden." })" /></label>
            </div>
            <div class="col-12 col-md-6 mt-2" data-lu-when="plan-override">
                <label class="form-label" for="plan-override-reason">Override reason</label>
                <input class="form-control" id="plan-override-reason" name="overrideReason" value="@Model.DraftOverrideReason" />
            </div>
        </div>
        <div data-partition-pane="migrate">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="migrate-skip" name="backupSkip" value="true" @(Model.DraftBackupSkip ? "checked" : null) />
                <label class="form-check-label" for="migrate-skip">Skip backup <partial name="_TermInfo" model="@(new TermInfo { Label = "About skipping the backup", Text = "No copy is made. The recreated topic starts empty and the old log is not kept. Leave this off unless you accept the risk." })" /></label>
            </div>
            <div class="form-check" data-lu-when="migrate-skip">
                <input class="form-check-input" type="checkbox" id="migrate-skip-ack" name="backupSkipAcknowledged" value="true" @(Model.DraftBackupSkipAcknowledged ? "checked" : null) />
                <label class="form-check-label" for="migrate-skip-ack">Skip acknowledged <partial name="_TermInfo" model="@(new TermInfo { Label = "About acknowledging a skipped backup", Text = "Required when the backup is skipped. The requester and the approver both accept that there is no backup." })" /></label>
            </div>
            <div class="mt-3">
                <label class="form-label" for="migrate-groups">Groups to drop offsets for <partial name="_TermInfo" model="@(new TermInfo { Label = "About groups to drop", Text = "Use this when a dry run says a group is inactive and still has lag. Type that group's exact name, then preview again. The migration drops that group's offsets on this topic. An active group cannot be cleared here. Separate names with commas or new lines." })" /></label>
                <textarea class="form-control" id="migrate-groups" name="acknowledgedGroups" rows="2">@Model.DraftAcknowledgedGroups</textarea>
            </div>
        </div>
        <div class="row g-2 align-items-end mt-2">
            <div class="col-12 col-md-2">
                <label class="form-label" for="plan-partitions">Target partitions</label>
                <input class="form-control" id="plan-partitions" name="partitions" type="number" min="1" max="@Model.Topics.Cap" value="@targetPartitions" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="plan-reason">Reason</label>
                <input class="form-control" id="plan-reason" name="reason" value="@Model.DraftReason" />
            </div>
            <input type="hidden" name="confirmation" value="" data-hold-target />
        </div>
        @if (Model.Plan is not null)
        {
            var increase = Model.Plan;
            <div id="kafka-partition-result" class="alert @partitionTone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-partition" data-result-key="@(increase.Accepted)-@increase.Topic-@increase.RequestedPartitions-@increase.Errors.Count">
                <details class="lu-result-details">
                    <summary>
                        <span class="badge @StatusPills.ForKafka(increase.Accepted ? "Approved" : "Rejected")">@(increase.Accepted ? "Accepted" : "Refused")</span>
                        <span class="lu-result-text">@(increase.Accepted ? "Dry run accepted. Nothing has changed yet." : "This increase cannot run yet.")</span>
                        <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                    </summary>
                    <div class="lu-result-body">
                        <dl class="row mb-2">
                            <dt class="col-sm-4">Partitions</dt>
                            <dd class="col-sm-8">@increase.CurrentPartitions to @increase.RequestedPartitions</dd>
                            <dt class="col-sm-4">Family</dt>
                            <dd class="col-sm-8">@increase.Family. Key @increase.KeyClass @increase.KeyShape. Replica ceiling @increase.MaxReplicas.</dd>
                            <dt class="col-sm-4">Related topics</dt>
                            <dd class="col-sm-8">@(increase.FamilyCompletion ? "The main topic stays at " + increase.CurrentPartitions + ". Siblings raised: " + (increase.TopicsToRaise.Count == 0 ? "none" : string.Join(", ", increase.TopicsToRaise)) + "." : "Retry " + increase.RetryTopic + " and error " + increase.ErrorTopic + " increase with the main topic.")</dd>
                            <dt class="col-sm-4">Quiet window</dt>
                            <dd class="col-sm-8">@(increase.QuietWindowRequired ? (increase.QuietWindowMet ? "Met." : "Not met.") : "Not required.")</dd>
                            <dt class="col-sm-4">Approval</dt>
                            <dd class="col-sm-8">@(increase.SecondApproverRequired ? "A second approver is required." : "A second approver is not required.")</dd>
                            <dt class="col-sm-4">Groups</dt>
                            <dd class="col-sm-8">@(increase.AffectedGroups.Count == 0 ? "none" : string.Join(", ", increase.AffectedGroups))</dd>
                        </dl>
                        @if (increase.Errors.Count > 0)
                        {
                            <p class="mb-1">Blocking reasons</p>
                            <ul>
                            @foreach (var planError in increase.Errors)
                            {
                                <li>@planError</li>
                            }
                            </ul>
                        }
                        <p class="mb-2">@(increase.Accepted ? "Ready. Press Apply and hold to confirm the increase." : "Fix the items above, then preview again.")</p>
                        @if (increase.Notes.Count > 0)
                        {
                            <details>
                                <summary>Details</summary>
                                @foreach (var note in increase.Notes)
                                {
                                    <p class="mb-1">@note</p>
                                }
                            </details>
                        }
                    </div>
                </details>
            </div>
        }
        @if (plan is not null)
        {
            <div id="kafka-dry-run-result" class="alert @resultTone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-migrate" data-plan-hash="@plan.PlanHash">
                <details class="lu-result-details">
                    <summary>
                        <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                        <span class="lu-result-text">@(plan.Accepted ? "Dry run accepted. Nothing has changed yet." : "This migration cannot run yet.")</span>
                        <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                    </summary>
                    <div class="lu-result-body">
                        <dl class="row mb-2">
                            <dt class="col-sm-4">Partitions</dt>
                            <dd class="col-sm-8">@currentPartitions to @targetPartitions</dd>
                            <dt class="col-sm-4">Expected pause</dt>
                            <dd class="col-sm-8">About @plan.WindowMinutes min, alert at @plan.AlertMinutes min.</dd>
                            <dt class="col-sm-4">Consumers paused</dt>
                            <dd class="col-sm-8">@(plan.StopSet.Count == 0 ? "none" : string.Join(", ", plan.StopSet))</dd>
                            <dt class="col-sm-4">Related topics grown first</dt>
                            <dd class="col-sm-8">@(plan.Siblings.Count == 0 ? "none" : string.Join(", ", plan.Siblings))</dd>
                            <dt class="col-sm-4">Data and backup</dt>
                            <dd class="col-sm-8">@(Model.DraftBackupSkip ? "The backup is skipped. The topic is deleted and created empty. Groups start at offset 0. Nothing is copied back." : "A verified backup is copied first. The topic is then deleted and created empty. Groups start at offset 0. Nothing is copied back. The backup stays until someone deletes it.")</dd>
                        </dl>
                        @if (!plan.Accepted && plan.Errors.Count > 0)
                        {
                            <p class="mb-1">Blocking reasons</p>
                            <ul>
                            @foreach (var item in plan.Errors)
                            {
                                <li>@item</li>
                            }
                            </ul>
                        }
                        else if (!plan.Accepted && !string.IsNullOrWhiteSpace(plan.Summary))
                        {
                            <p>@plan.Summary</p>
                        }
                        @if (plan.Warnings.Count > 0)
                        {
                            <p class="mb-1">Warnings</p>
                            <ul>
                            @foreach (var warning in plan.Warnings)
                            {
                                <li>@warning</li>
                            }
                            </ul>
                        }
                        <p class="mb-2">@(plan.Accepted ? "Ready. Press Apply and hold to confirm." : "Fix the items above, then preview again.")</p>
                        <details>
                            <summary>Details</summary>
                            <p>Plan hash @plan.PlanHash.</p>
                        </details>
                    </div>
                </details>
            </div>
        }
        <div class="d-flex flex-wrap gap-2 mt-3">
        <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-partition-btn="add" formaction="/Operations/Kafka/plan" title="Preview increase" aria-label="Preview increase"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview</span></button>
        @if (!Model.Topics.ReadOnly)
        {
            <button class="btn btn-sm btn-au-execute lu-icon-btn" id="plan-submit" type="submit" data-hold="@Hold.Of("Add partitions in place", "Add partitions to " + topicName + " in place.", new[] { Hold.Pair("Topic", topicName), Hold.Pair("Partitions now", currentPartitions) }, new[] { new[] { "partitions", "Target partitions" }, new[] { "reason", "Reason" } }, new[] { "Keys are remapped: a key can move to another partition, so per-key ordering is not kept across the change.", "Partitions cannot be removed later.", "The retry and error topics are raised with it." }, topicName, "Hold to add partitions")" data-partition-btn="add" formaction="/Operations/Kafka/requests" title="Apply partition increase" aria-label="Apply partition increase"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="ms-1">Apply</span></button>
        }
        <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-partition-btn="migrate" formaction="/Operations/Kafka/migrations/plan" title="Dry run" aria-label="Dry run"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview</span></button>
        @if (!Model.Topics.ReadOnly)
        {
            <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-partition-btn="migrate" formaction="/Operations/Kafka/migrations" data-hold="@Hold.Of("Migrate the topic", "Migrate " + topicName + " to a new partition count.", new[] { Hold.Pair("Topic", topicName), Hold.Pair("Partitions now", currentPartitions) }, new[] { new[] { "partitions", "Target partitions" }, new[] { "reason", "Reason" } }, new[] { "The workloads on this topic are stopped while it is copied to a backup and recreated empty.", "Consumer groups that had commits restart at offset 0.", "History stays only on the backup topic, or is lost if the backup is skipped." }, topicName, "Hold to migrate")" title="Apply migration" aria-label="Apply migration"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="ms-1">Apply</span></button>
        }
        <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-partition-btn="family" formaction="/Operations/Kafka/family/plan" title="Preview family" aria-label="Preview family"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview</span></button>
        @if (!Model.Topics.ReadOnly)
        {
            <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-partition-btn="family" formaction="/Operations/Kafka/family" data-hold="@Hold.Of("Complete the family", "Raise the retry and error topics of " + topicName + " to its partition count.", new[] { Hold.Pair("Topic", topicName), Hold.Pair("Partitions now", currentPartitions) }, new[] { new[] { "reason", "Reason" } }, new[] { "Retry and error topics gain partitions, which cannot be removed later.", "Keys on those topics are remapped." }, topicName, "Hold to complete")" title="Apply family completion" aria-label="Apply family completion"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="ms-1">Apply</span></button>
        }
        <a class="btn btn-warning" href="@query.Href(ThroughputKafkaPageQuery.Migrate)">Cancel</a>
        <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
        </div>
    </form>
}
</div>
</section>

@if (migration is not null)
{
    <div class="au-card card mt-3">
        <div class="card-header">Migration <partial name="_LabeledId" model="@(new LabeledId { Label = "Migration", Value = migration.Id.ToString("D"), Compact = true, CopyLabel = "Copy migration id" })" /></div>
        <div class="card-body">
            <p>@migration.Topic from @migration.OriginalPartitions to @migration.TargetPartitions. Step @migration.StepName.</p>
            <p>Requester @migration.Requester. Approver @migration.Approver. Executor @migration.Executor.</p>
            <p>Plan hash @migration.PlanHash.</p>
            @if (migration.BackupSkipped)
            {
                <p>The backup was skipped. No temp topic was created. The recreated topic starts empty.</p>
            }
            else
            {
                <p>Backup @(string.IsNullOrWhiteSpace(migration.BackupTopic) ? "not created" : migration.BackupTopic)@(migration.BackupCleanupRequired ? " is kept and flagged for cleanup." : ".")</p>
            }
            @if (!string.IsNullOrWhiteSpace(migration.Failure))
            {
                <p>@migration.Failure</p>
            }
            @if (!string.IsNullOrWhiteSpace(migration.Evidence))
            {
                <p>@migration.Evidence</p>
            }
            <p>The new topic stays empty. Groups that already had commits are set to offset 0. @(migration.BackupSkipped ? "Nothing is reprocessed." : "History stays on the backup for replay. Nothing is reprocessed.")</p>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" action="/Operations/Kafka/migrations/approve">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button class="btn btn-success" type="submit" aria-label="Approve migration">Approve</button>
                </form>
                <form method="post" action="/Operations/Kafka/migrations/execute">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button data-hold="@Hold.Of("Execute the migration", "Execute the approved migration of " + migration.Topic + ".", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Migration", migration.Id) }, Array.Empty<string[]>(), new[] { "Workloads on the topic stop and the topic is copied to its backup.", "Nothing can be produced to the topic until the migration finishes." }, "", "Hold to execute")" class="btn btn-au-execute" type="submit" aria-label="Execute migration">Execute</button>
                </form>
                <form method="post" action="/Operations/Kafka/migrations/abort">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button class="btn btn-warning" type="submit" aria-label="Abort migration">Abort</button>
                </form>
            </div>
            <form class="row g-2 mt-3" method="post" action="/Operations/Kafka/migrations/go">
                @Html.AntiForgeryToken()
                <input type="hidden" name="migrationId" value="@migration.Id" />
                <input type="hidden" name="topic" value="@migration.Topic" />
                <input type="hidden" name="confirmation" value="" data-hold-target />
                <div class="col-auto">
                    <button data-hold="@Hold.Of("Go", "Recreate " + migration.Topic + " at the new partition count and restart the workloads.", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Migration", migration.Id) }, Array.Empty<string[]>(), new[] { "The topic is recreated empty.", "Consumer groups that had commits restart at offset 0." }, migration.Topic, "Hold to go")" class="btn btn-au-execute" type="submit">Go</button>
                </div>
            </form>
            <form class="row g-2 mt-2" method="post" action="/Operations/Kafka/migrations/recover">
                @Html.AntiForgeryToken()
                <input type="hidden" name="migrationId" value="@migration.Id" />
                <input type="hidden" name="topic" value="@migration.Topic" />
                <input type="hidden" name="confirmation" value="" data-hold-target />
                <div class="col-auto d-flex flex-wrap gap-2">
                    <button data-hold="@Hold.Of("Recover the original", "Recreate " + migration.Topic + " at its original partition count.", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Migration", migration.Id) }, Array.Empty<string[]>(), new[] { "The topic is recreated and the migration is abandoned.", "Consumer groups may restart at offset 0." }, migration.Topic, "Hold to recover")" class="btn btn-au-execute" type="submit" name="action" value="original">Recover original</button>
                    <button data-hold="@Hold.Of("Continue forward", "Continue the migration of " + migration.Topic + " from where it stopped.", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Migration", migration.Id) }, Array.Empty<string[]>(), new[] { "The topic is recreated empty at the new partition count.", "Consumer groups that had commits restart at offset 0." }, migration.Topic, "Hold to continue")" class="btn btn-au-execute" type="submit" name="action" value="forward">Continue forward</button>
                    <button data-hold="@Hold.Of("Delete the empty foreign topic", "Delete the empty foreign topic left by the migration of " + migration.Topic + ".", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Migration", migration.Id) }, Array.Empty<string[]>(), new[] { "The topic is deleted permanently." }, migration.Topic, "Hold to delete")" class="btn btn-danger" type="submit" name="action" value="deleteForeign">Delete empty foreign topic</button>
                </div>
            </form>
            @if (migration.ManualChecklist)
            {
                <form class="row g-2 mt-2" method="post" action="/Operations/Kafka/migrations/manual">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="migrate-workload">Workload confirmed stopped or started</label>
                        <input class="form-control" id="migrate-workload" name="workload" />
                    </div>
                    <div class="col-auto mt-4">
                        <button class="btn btn-au-execute" type="submit">Confirm step</button>
                    </div>
                </form>
            }
            <h3 class="h6 mt-3">Timeline</h3>
            <ul class="mb-0">
                @foreach (var entry in migration.Timeline)
                {
                    <li>@entry.Sequence @LinkUiTime.Display(entry.At) @entry.Text</li>
                }
            </ul>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(migration.BackupTopic))
    {
        <form class="row g-2 mt-3" method="post" action="/Operations/Kafka/migrations/backup-delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="migrationId" value="@migration.Id" />
            <input type="hidden" name="topic" value="@migration.Topic" />
            <input type="hidden" name="backupName" value="@migration.BackupTopic" />
            <input type="hidden" name="confirmation" value="" data-hold-target />
            <div class="col-auto">
                <button data-hold="@Hold.Of("Delete the backup", "Delete the backup topic " + migration.BackupTopic + ".", new[] { Hold.Pair("Topic", migration.Topic), Hold.Pair("Backup", migration.BackupTopic) }, Array.Empty<string[]>(), new[] { "The backup and the history it holds are deleted permanently.", "Replay from the backup is no longer possible." }, migration.BackupTopic, "Hold to delete")" class="btn btn-danger" type="submit">Delete backup</button>
            </div>
        </form>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Runbook))
{
    <div class="au-card card mt-3">
        <div class="card-header">Runbook</div>
        <div class="card-body"><pre class="mb-0">@Model.Runbook</pre></div>
    </div>
}
