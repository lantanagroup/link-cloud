@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var topic = Model.SelectedTopic;
    var detail = Model.Detail;
    var plan = Model.MigrationPlan;
    var migration = Model.Migration;
    var topicName = topic?.Topic ?? query.TopicName;
    var targetPartitions = Model.DraftPartitions > 0 ? Model.DraftPartitions : (topic?.Partitions ?? 3) + 1;
    var resultTone = plan is null ? "alert-secondary" : !plan.Accepted ? "alert-danger" : plan.Warnings.Count > 0 ? "alert-warning" : "alert-success";
    var currentPartitions = topic?.Partitions ?? detail?.Partitions ?? 0;
    var partitionTone = Model.Plan is null ? "alert-secondary" : Model.Plan.Accepted ? "alert-success" : "alert-danger";
    var increaseLine = topic is null ? null : KafkaIncreaseEligibility.Line(topic.PartitionAddReason, Model.Plan, topic.Topic);
    var migrationLine = KafkaIncreaseEligibility.MigrationLine(topic?.MigrationEligibility ?? detail?.Eligibility, plan);
    bool Matches(KafkaTopicRow row)
    {
        if (query.Family.Length > 0 && !string.Equals(row.Family, query.Family, StringComparison.OrdinalIgnoreCase))
            return false;
        if (query.KeyClass.Length > 0 && !string.Equals(row.KeyClass, query.KeyClass, StringComparison.OrdinalIgnoreCase))
            return false;
        if (query.Q.Length > 0
            && !row.Topic.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !row.KeyClass.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !row.Groups.Any(group => group.Contains(query.Q, StringComparison.OrdinalIgnoreCase)))
            return false;
        return true;
    }
    var choices = Model.Topics.Topics.Where(Matches).OrderBy(row => row.Topic, StringComparer.OrdinalIgnoreCase).ToList();
    if (!string.IsNullOrWhiteSpace(topicName) && choices.All(row => !string.Equals(row.Topic, topicName, StringComparison.Ordinal)))
    {
        var current = Model.Topics.Topics.FirstOrDefault(row => string.Equals(row.Topic, topicName, StringComparison.Ordinal));
        if (current is not null)
            choices.Insert(0, current);
    }
}

<section class="card au-card mt-3 mb-3" id="kafka-migrate-topic">
<h2 class="card-header h6 mb-0">Topic <partial name="_TermInfo" model="@(new TermInfo { Label = "About partition changes", Text = "An in-place add keeps the topic and remaps keys. A migration stops the workloads, copies the log to a backup, and recreates the topic empty. Consumer groups start at offset 0. Nothing is copied back. The backup stays until a person deletes it or retention expires." })" /></h2>
<div class="card-body">
<form class="row g-2 align-items-end mb-0" method="get" action="/Operations/Kafka">
    <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Migrate" />
    <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="sort" value="@query.Sort" />
    <input type="hidden" name="dir" value="@query.Dir" />
    <input type="hidden" name="pageSize" value="@query.PageSize" />
    <input type="hidden" name="group" value="@query.Group" />
    <input type="hidden" name="broker" value="@query.Broker" />
    <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
    <div class="col-12 col-md-4">
        <label class="form-label" for="kafka-q-migrate">Search</label>
        <input class="form-control" id="kafka-q-migrate" name="q" value="@query.Q" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="kafka-family-migrate">Family</label>
        <select class="form-select" id="kafka-family-migrate" name="family">
            <option value="">All families</option>
            @foreach (var family in Model.Families)
            {
                if (family == query.Family)
                {
                    <option value="@family" selected>@family</option>
                }
                else
                {
                    <option value="@family">@family</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="kafka-key-migrate">Key class</label>
        <select class="form-select" id="kafka-key-migrate" name="keyClass">
            <option value="">All key classes</option>
            @foreach (var keyClass in Model.KeyClasses)
            {
                if (keyClass == query.KeyClass)
                {
                    <option value="@keyClass" selected>@keyClass</option>
                }
                else
                {
                    <option value="@keyClass">@keyClass</option>
                }
            }
        </select>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label" for="migrate-topic">Topic</label>
        <select class="form-select" id="migrate-topic" name="topic">
            @if (choices.Count == 0)
            {
                <option value="">No topics match</option>
            }
            @foreach (var row in choices)
            {
                if (row.Topic == topicName)
                {
                    <option value="@row.Topic" selected>@row.Topic (@row.Partitions)</option>
                }
                else
                {
                    <option value="@row.Topic">@row.Topic (@row.Partitions)</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-au-link" type="submit">Open</button>
    </div>
</form>
@if (!string.IsNullOrWhiteSpace(increaseLine))
{
    <p class="mt-3 mb-1">@increaseLine</p>
}
@if (!string.IsNullOrWhiteSpace(migrationLine))
{
    <p class="@(string.IsNullOrWhiteSpace(increaseLine) ? "mt-3" : "") mb-0">@migrationLine</p>
}
</div>
</section>

@if (detail is not null)
{
    var facts = KafkaWindows.Facts(detail.PartitionsDetail, query.PartPage, query.PageSize);
    @if (detail.PartitionsDetail.Count > 0)
    {
        <partial name="_KafkaSummary" model="@(new KafkaSummaryStrip(facts.Total, "Partitions", facts.Hot, "Largest log", facts.Hottest.ToString("N0"), facts.Skew))" />
        <div class="au-card card mt-3">
            <div class="card-header">Partition placement <partial name="_TermInfo" model="@(new TermInfo { Label = "About partition placement", Text = "One page, worst first. A short ISR, a missing preferred leader, or an offline leader comes first." })" /></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th class="lu-shrink">Partition</th><th>Leader</th><th>Replicas</th><th>ISR</th><th>Preferred</th><th>Start</th><th>End</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var row in facts.Rows)
                        {
                            var hot = !row.PreferredLeader || row.Isr.Count < row.Replicas.Count || row.Leader < 0;
                            <tr class="@(hot ? "lu-kafka-problem" : null)">
                                <td class="lu-shrink">@row.Partition</td>
                                <td>@(row.Leader < 0 ? "offline" : row.Leader.ToString())</td>
                                <td>@string.Join(", ", row.Replicas.Take(8))@(row.Replicas.Count > 8 ? ", …" : "")</td>
                                <td>@string.Join(", ", row.Isr.Take(8))@(row.Isr.Count > 8 ? ", …" : "")</td>
                                <td>@(row.PreferredLeader ? "yes" : "no")</td>
                                <td>@row.LogStart</td>
                                <td>@row.HighWatermark</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(facts.Page, facts.Pages, "Worst first.", facts.Page > 1 ? query.Href(part: facts.Page - 1) : "", facts.Page < facts.Pages ? query.Href(part: facts.Page + 1) : ""))" />
            </div>
        </div>
    }
    <details class="lu-kafka-fold">
        <summary>Topic settings — @detail.Partitions partitions, RF @detail.ReplicationFactor. @KafkaIncreaseEligibility.MigrationLine(detail.Eligibility, plan)</summary>
        <div class="au-card card mt-2">
            <div class="card-body">
                <p>Id <partial name="_LabeledId" model="@(new LabeledId { Label = "Topic id", Value = detail.TopicId, Compact = true, CopyLabel = "Copy topic id" })" /></p>
                <p>@detail.Partitions partitions, RF @detail.ReplicationFactor, @(detail.FullIsr ? "full ISR" : "ISR short")@(detail.LeadersSkewed ? ", leaders skewed" : ""). Key @detail.KeyClass @detail.KeyShape.</p>
                <p>Estimated records @detail.EstimatedRecords. @(detail.PartitionDrift ? "Live count differs from topics.txt (3)." : "Live count matches topics.txt.")</p>
                @if (detail.Held)
                {
                    <p>This topic is held.</p>
                }
                <p>Stop set: @(detail.StopSet.Count == 0 ? "none" : string.Join(", ", detail.StopSet.Take(12)))@(detail.StopSet.Count > 12 ? ", …" : "")</p>
                <p>Producers: @(detail.Producers.Count == 0 ? "none" : string.Join("; ", detail.Producers.Take(12)))@(detail.Producers.Count > 12 ? "; …" : "")</p>
                <p>Consumers: @(detail.Consumers.Count == 0 ? "none" : string.Join("; ", detail.Consumers.Take(12)))@(detail.Consumers.Count > 12 ? "; …" : "")</p>
                @if (!string.IsNullOrWhiteSpace(detail.Error))
                {
                    <p class="text-muted">@detail.Error</p>
                }
            </div>
        </div>
    </details>
}

@if (Model.Configs is not null)
{
    <details class="lu-kafka-fold">
        <summary>Topic configuration (@Model.Configs.Configs.Count settings)</summary>
        <div class="au-card card mt-2">
            <div class="card-body">
                <p>
                    <a href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: topicName)">All</a>
                    <a href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: topicName)&amp;diff=sibling">Sibling</a>
                    <a href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: topicName)&amp;diff=broker">Broker default</a>
                    <a href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: topicName)&amp;diff=frozen">Frozen snapshot</a>
                </p>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Name</th><th>Value</th><th>Source</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Configs.Configs.Take(query.PageSize))
                        {
                            <tr><td>@row.Name</td><td>@row.Value</td><td>@row.Source</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.Configs.Configs.Count > query.PageSize)
                {
                    <p class="text-muted mt-2 mb-0">Showing @query.PageSize of @Model.Configs.Configs.Count settings.</p>
                }
                @foreach (var change in Model.Configs.Changes.Take(query.PageSize))
                {
                    <p class="mb-1">@change</p>
                }
            </div>
        </div>
    </details>
}

@if (topic is not null)
{
    <form class="mt-3" method="post" action="/Operations/Kafka/plan" data-kafka-busy="Dry run is running.">
        @Html.AntiForgeryToken()
        <partial name="_QueryFields" model="@(query with { TopicName = topicName, Advanced = true, View = ThroughputKafkaPageQuery.Migrate })" />
        <section class="card au-card mb-3">
            <h2 class="card-header h6 mb-0">Add partitions <partial name="_TermInfo" model="@(new TermInfo { Label = "About adding partitions", Text = "Adding partitions is permanent and cannot be reversed. Existing keys are remapped. The main topic, its retry topic, and its error topic increase together. None of them can shrink. When the family is uneven, the family action raises only the siblings that are behind. Preview and Submit both use this count. A preview does not read the reason. Submit does." })" /></h2>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="plan-partitions">Target partitions</label>
                        <input class="form-control" id="plan-partitions" name="partitions" type="number" min="1" max="@Model.Topics.Cap" value="@(Model.DraftPartitions > 0 ? Model.DraftPartitions : topic.Partitions + 1)" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="plan-reason">Reason</label>
                        <input class="form-control" id="plan-reason" name="reason" value="@Model.DraftReason" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="plan-confirm">Type the topic name</label>
                        <input class="form-control" id="plan-confirm" name="confirmation" value="@Model.DraftConfirmation" data-topic="@topicName" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <label class="form-check-label" for="plan-override">
                            <input class="form-check-input" id="plan-override" type="checkbox" name="overrideQuietWindow" value="true" @(Model.DraftOverride ? "checked" : null) />
                            Override the quiet window. A second approver and a reason are required.
                        </label>
                    </div>
                    <div class="col-12 col-md-6" data-lu-when="plan-override">
                        <label class="form-label" for="plan-override-reason">Override reason</label>
                        <input class="form-control" id="plan-override-reason" name="overrideReason" value="@Model.DraftOverrideReason" />
                    </div>
                </div>
                @if (topic.KeyClass == "Facility")
                {
                    <p class="form-text mb-0 mt-2">One facility can never use more than one partition.</p>
                }
                @if (Model.Plan is not null)
                {
                    var increase = Model.Plan;
                    <div id="kafka-partition-result" class="alert @partitionTone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-partition" data-result-key="@(increase.Accepted)-@increase.Topic-@increase.RequestedPartitions-@increase.Errors.Count">
                        <details class="lu-result-details">
                            <summary>
                                <span class="badge @StatusPills.ForKafka(increase.Accepted ? "Approved" : "Rejected")">@(increase.Accepted ? "Accepted" : "Refused")</span>
                                <span class="lu-result-text">@(increase.Accepted ? "Dry run accepted. Nothing has changed yet." : "This increase cannot run yet.")</span>
                                <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                            </summary>
                            <div class="lu-result-body">
                                <dl class="row mb-2">
                                    <dt class="col-sm-4">Partitions</dt>
                                    <dd class="col-sm-8">@increase.CurrentPartitions to @increase.RequestedPartitions</dd>
                                    <dt class="col-sm-4">Family</dt>
                                    <dd class="col-sm-8">@increase.Family. Key @increase.KeyClass @increase.KeyShape. Replica ceiling @increase.MaxReplicas.</dd>
                                    <dt class="col-sm-4">Related topics</dt>
                                    <dd class="col-sm-8">@(increase.FamilyCompletion ? "The main topic stays at " + increase.CurrentPartitions + ". Siblings raised: " + (increase.TopicsToRaise.Count == 0 ? "none" : string.Join(", ", increase.TopicsToRaise)) + "." : "Retry " + increase.RetryTopic + " and error " + increase.ErrorTopic + " increase with the main topic.")</dd>
                                    <dt class="col-sm-4">Quiet window</dt>
                                    <dd class="col-sm-8">@(increase.QuietWindowRequired ? (increase.QuietWindowMet ? "Met." : "Not met.") : "Not required.")</dd>
                                    <dt class="col-sm-4">Approval</dt>
                                    <dd class="col-sm-8">@(increase.SecondApproverRequired ? "A second approver is required." : "A second approver is not required.")</dd>
                                    <dt class="col-sm-4">Groups</dt>
                                    <dd class="col-sm-8">@(increase.AffectedGroups.Count == 0 ? "none" : string.Join(", ", increase.AffectedGroups))</dd>
                                </dl>
                                @if (increase.Errors.Count > 0)
                                {
                                    <p class="mb-1">Blocking reasons</p>
                                    <ul>
                                    @foreach (var planError in increase.Errors)
                                    {
                                        <li>@planError</li>
                                    }
                                    </ul>
                                }
                                <p class="mb-2">@(increase.Accepted ? "Ready. Type the topic name and submit the increase." : "Fix the items above, then preview again.")</p>
                                @if (increase.Notes.Count > 0)
                                {
                                    <details>
                                        <summary>Details</summary>
                                        @foreach (var note in increase.Notes)
                                        {
                                            <p class="mb-1">@note</p>
                                        }
                                    </details>
                                }
                            </div>
                        </details>
                    </div>
                }
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" formaction="/Operations/Kafka/plan" title="Preview partition increase" aria-label="Preview partition increase"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview increase</span></button>
                    <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
                    @if (!Model.Topics.ReadOnly)
                    {
                        <button class="btn btn-sm btn-au-execute lu-icon-btn" id="plan-submit" type="submit" formaction="/Operations/Kafka/requests" title="Submit partition increase" aria-label="Submit partition increase"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="ms-1">Submit</span></button>
                    }
                </div>
            </div>
        </section>
    </form>
    @if (topic.RetryPartitions > 0 && topic.RetryPartitions < topic.Partitions || topic.ErrorPartitions > 0 && topic.ErrorPartitions < topic.Partitions)
    {
        <form method="post" action="/Operations/Kafka/family/plan" data-kafka-busy="Dry run is running.">
            @Html.AntiForgeryToken()
            <partial name="_QueryFields" model="@(query with { TopicName = topicName, Advanced = true, View = ThroughputKafkaPageQuery.Migrate })" />
            <input type="hidden" name="topic" value="@topicName" />
            <section class="card au-card mb-3">
                <h2 class="card-header h6 mb-0">Complete the family <partial name="_TermInfo" model="@(new TermInfo { Label = "About family completion", Text = "The family is uneven. This raises only the retry and error topics up to the main topic. The main topic stays as it is. Preview and Submit both use that count. A preview does not read the reason. Submit does." })" /></h2>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="family-reason">Reason</label>
                            <input class="form-control" id="family-reason" name="reason" value="@Model.DraftReason" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="family-confirm">Type the topic name</label>
                            <input class="form-control" id="family-confirm" name="confirmation" value="@Model.DraftConfirmation" autocomplete="off" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" formaction="/Operations/Kafka/family/plan" title="Preview family completion" aria-label="Preview family completion"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview family</span></button>
                        <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
                        @if (!Model.Topics.ReadOnly)
                        {
                            <button class="btn btn-sm btn-au-execute" type="submit" formaction="/Operations/Kafka/family" title="Submit family completion" aria-label="Submit family completion"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="ms-1">Submit</span></button>
                        }
                    </div>
                </div>
            </section>
        </form>
    }
}

@if (!string.IsNullOrWhiteSpace(topicName))
{
    <form class="mt-3" method="post" action="/Operations/Kafka/migrations" data-kafka-busy="Dry run is running.">
        @Html.AntiForgeryToken()
        <input type="hidden" name="topic" value="@topicName" />
        <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
        <input type="hidden" name="planHash" value="@(Model.HasDryRunSnapshot ? (string.IsNullOrEmpty(plan?.PlanHash) ? Model.DraftPlanHash : plan.PlanHash) : "")" />
        <input type="hidden" name="hasDryRunSnapshot" value="@(Model.HasDryRunSnapshot ? "true" : "false")" />
        <input type="hidden" name="dryRunPartitions" value="@Model.DryRunPartitions" />
        <input type="hidden" name="dryRunBackupSkip" value="@(Model.DryRunBackupSkip ? "true" : "false")" />
        <input type="hidden" name="dryRunBackupSkipAcknowledged" value="@(Model.DryRunBackupSkipAcknowledged ? "true" : "false")" />
        <input type="hidden" name="dryRunAcknowledgedGroups" value="@string.Join(",", MigrationGroupList.Parse(Model.DryRunAcknowledgedGroups))" />

        <section class="card au-card mb-3">
            <h2 class="card-header h6 mb-0">Migrate <partial name="_TermInfo" model="@(new TermInfo { Label = "About migration", Text = "Dry run checks the plan and changes nothing. Request submits the migration for approval. Type the topic name first. Dry run and Request both use the target count, the backup choice, and the group list. A dry run does not read the reason. Request does." })" /></h2>
            <div class="card-body">
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="migrate-partitions">Target partitions</label>
                    <input class="form-control" id="migrate-partitions" name="partitions" type="number" min="1" value="@targetPartitions" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="migrate-reason">Reason</label>
                    <input class="form-control" id="migrate-reason" name="reason" value="@Model.DraftReason" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="migrate-confirm">Type the topic name</label>
                    <input class="form-control" id="migrate-confirm" name="confirmation" value="@Model.DraftConfirmation" autocomplete="off" aria-label="Type the topic name to request the migration" />
                </div>
            </div>
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="migrate-skip" name="backupSkip" value="true" @(Model.DraftBackupSkip ? "checked" : null) />
                <label class="form-check-label" for="migrate-skip">Skip backup <partial name="_TermInfo" model="@(new TermInfo { Label = "About skipping the backup", Text = "No copy is made. The recreated topic starts empty and the old log is not kept. Leave this off unless you accept the risk." })" /></label>
            </div>
            <div class="form-check" data-lu-when="migrate-skip">
                <input class="form-check-input" type="checkbox" id="migrate-skip-ack" name="backupSkipAcknowledged" value="true" @(Model.DraftBackupSkipAcknowledged ? "checked" : null) />
                <label class="form-check-label" for="migrate-skip-ack">Skip acknowledged <partial name="_TermInfo" model="@(new TermInfo { Label = "About acknowledging a skipped backup", Text = "Required when the backup is skipped. The requester and the approver both accept that there is no backup." })" /></label>
            </div>
            <div class="mt-3">
                <label class="form-label" for="migrate-groups">Groups to drop offsets for <partial name="_TermInfo" model="@(new TermInfo { Label = "About groups to drop", Text = "Use this when a dry run says a group is inactive and still has lag. Type that group's exact name, then dry run again. The migration drops that group's offsets on this topic. An active group cannot be cleared here. Separate names with commas or new lines." })" /></label>
                <textarea class="form-control" id="migrate-groups" name="acknowledgedGroups" rows="2">@Model.DraftAcknowledgedGroups</textarea>
            </div>

        @if (plan is not null)
        {
            <div id="kafka-dry-run-result" class="alert @resultTone lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-migrate" data-plan-hash="@plan.PlanHash">
                <details class="lu-result-details">
                    <summary>
                        <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                        <span class="lu-result-text">@(plan.Accepted ? "Dry run accepted. Nothing has changed yet." : "This migration cannot run yet.")</span>
                        <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                    </summary>
                    <div class="lu-result-body">
                <dl class="row mb-2">
                    <dt class="col-sm-4">Partitions</dt>
                    <dd class="col-sm-8">@currentPartitions to @targetPartitions</dd>
                    <dt class="col-sm-4">Expected pause</dt>
                    <dd class="col-sm-8">About @plan.WindowMinutes min, alert at @plan.AlertMinutes min.</dd>
                    <dt class="col-sm-4">Consumers paused</dt>
                    <dd class="col-sm-8">@(plan.StopSet.Count == 0 ? "none" : string.Join(", ", plan.StopSet))</dd>
                    <dt class="col-sm-4">Related topics grown first</dt>
                    <dd class="col-sm-8">@(plan.Siblings.Count == 0 ? "none" : string.Join(", ", plan.Siblings))</dd>
                    <dt class="col-sm-4">Data and backup</dt>
                    <dd class="col-sm-8">@(Model.DraftBackupSkip ? "The backup is skipped. The topic is deleted and created empty. Groups start at offset 0. Nothing is copied back." : "A verified backup is copied first. The topic is then deleted and created empty. Groups start at offset 0. Nothing is copied back. The backup stays until someone deletes it.")</dd>
                </dl>
                @if (!plan.Accepted && plan.Errors.Count > 0)
                {
                    <p class="mb-1">Blocking reasons</p>
                    <ul>
                    @foreach (var item in plan.Errors)
                    {
                        <li>@item</li>
                    }
                    </ul>
                }
                else if (!plan.Accepted && !string.IsNullOrWhiteSpace(plan.Summary))
                {
                    <p>@plan.Summary</p>
                }
                @if (plan.Warnings.Count > 0)
                {
                    <p class="mb-1">Warnings</p>
                    <ul>
                    @foreach (var warning in plan.Warnings)
                    {
                        <li>@warning</li>
                    }
                    </ul>
                }
                <p class="mb-2">@(plan.Accepted ? "Ready. Type the topic name and press Request." : "Fix the items above, then dry run again.")</p>
                <details>
                    <summary>Details</summary>
                    <p>Plan hash @plan.PlanHash.</p>
                    <p class="mb-0">In-place add keeps the topic name and remaps keys. Migrate stops the workloads, copies the log to the backup, and recreates an empty topic. Use an in-place add when the quiet window can be met.</p>
                </details>
                    </div>
                </details>
            </div>
        }

        <div class="mt-3">
            <button class="btn btn-au-execute" type="submit" formaction="/Operations/Kafka/migrations/plan">Dry run</button>
            <button class="btn btn-au-execute" type="submit">Request</button>
            <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
        </div>
            </div>
        </section>
    </form>
}

@if (migration is not null)
{
    <div class="au-card card mt-3">
        <div class="card-header">Migration <partial name="_LabeledId" model="@(new LabeledId { Label = "Migration", Value = migration.Id.ToString("D"), Compact = true, CopyLabel = "Copy migration id" })" /></div>
        <div class="card-body">
            <p>@migration.Topic from @migration.OriginalPartitions to @migration.TargetPartitions. Step @migration.StepName.</p>
            <p>Requester @migration.Requester. Approver @migration.Approver. Executor @migration.Executor.</p>
            <p>Plan hash @migration.PlanHash.</p>
            @if (migration.BackupSkipped)
            {
                <p>The backup was skipped. No temp topic was created. The recreated topic starts empty.</p>
            }
            else
            {
                <p>Backup @(string.IsNullOrWhiteSpace(migration.BackupTopic) ? "not created" : migration.BackupTopic)@(migration.BackupCleanupRequired ? " is kept and flagged for cleanup." : ".")</p>
            }
            @if (!string.IsNullOrWhiteSpace(migration.Failure))
            {
                <p>@migration.Failure</p>
            }
            @if (!string.IsNullOrWhiteSpace(migration.Evidence))
            {
                <p>@migration.Evidence</p>
            }
            <p>The new topic stays empty. Groups that already had commits are set to offset 0. @(migration.BackupSkipped ? "Nothing is reprocessed." : "History stays on the backup for replay. Nothing is reprocessed.")</p>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" action="/Operations/Kafka/migrations/approve">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button class="btn btn-success" type="submit" aria-label="Approve migration">Approve</button>
                </form>
                <form method="post" action="/Operations/Kafka/migrations/execute">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button class="btn btn-au-execute" type="submit" aria-label="Execute migration">Execute</button>
                </form>
                <form method="post" action="/Operations/Kafka/migrations/abort">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <button class="btn btn-warning" type="submit" aria-label="Abort migration">Abort</button>
                </form>
            </div>
            <form class="row g-2 mt-3" method="post" action="/Operations/Kafka/migrations/go">
                @Html.AntiForgeryToken()
                <input type="hidden" name="migrationId" value="@migration.Id" />
                <input type="hidden" name="topic" value="@migration.Topic" />
                <div class="col-12 col-md-4">
                    <label class="form-label" for="migrate-go">Type the topic name</label>
                    <input class="form-control" id="migrate-go" name="confirmation" autocomplete="off" aria-label="Type the topic name before go" />
                </div>
                <div class="col-auto mt-4">
                    <button class="btn btn-au-execute" type="submit">Go</button>
                </div>
            </form>
            <form class="row g-2 mt-2" method="post" action="/Operations/Kafka/migrations/recover">
                @Html.AntiForgeryToken()
                <input type="hidden" name="migrationId" value="@migration.Id" />
                <input type="hidden" name="topic" value="@migration.Topic" />
                <div class="col-12 col-md-4">
                    <label class="form-label" for="migrate-recover">Type the topic name</label>
                    <input class="form-control" id="migrate-recover" name="confirmation" autocomplete="off" aria-label="Type the topic name to recover the original count" />
                </div>
                <div class="col-auto mt-4 d-flex flex-wrap gap-2">
                    <button class="btn btn-warning" type="submit" name="action" value="original">Recover original</button>
                    <button class="btn btn-au-execute" type="submit" name="action" value="forward">Continue forward</button>
                    <button class="btn btn-danger" type="submit" name="action" value="deleteForeign">Delete empty foreign topic</button>
                </div>
            </form>
            @if (migration.ManualChecklist)
            {
                <form class="row g-2 mt-2" method="post" action="/Operations/Kafka/migrations/manual">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="migrationId" value="@migration.Id" />
                    <input type="hidden" name="topic" value="@migration.Topic" />
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="migrate-workload">Workload confirmed stopped or started</label>
                        <input class="form-control" id="migrate-workload" name="workload" />
                    </div>
                    <div class="col-auto mt-4">
                        <button class="btn btn-au-execute" type="submit">Confirm step</button>
                    </div>
                </form>
            }
            <h3 class="h6 mt-3">Timeline</h3>
            <ul class="mb-0">
                @foreach (var entry in migration.Timeline)
                {
                    <li>@entry.Sequence @LinkUiTime.Display(entry.At) @entry.Text</li>
                }
            </ul>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(migration.BackupTopic))
    {
        <form class="row g-2 mt-3" method="post" action="/Operations/Kafka/migrations/backup-delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="migrationId" value="@migration.Id" />
            <input type="hidden" name="topic" value="@migration.Topic" />
            <input type="hidden" name="backupName" value="@migration.BackupTopic" />
            <div class="col-12 col-md-6">
                <label class="form-label" for="migrate-backup">Type the backup topic name</label>
                <input class="form-control" id="migrate-backup" name="confirmation" autocomplete="off" aria-label="Type the backup topic name to delete it" />
            </div>
            <div class="col-auto mt-4">
                <button class="btn btn-danger" type="submit">Delete backup</button>
            </div>
        </form>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Runbook))
{
    <div class="au-card card mt-3">
        <div class="card-header">Runbook</div>
        <div class="card-body"><pre class="mb-0">@Model.Runbook</pre></div>
    </div>
}
