@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var topic = Model.SelectedTopic;
}

@if (topic is null)
{
    <section class="card au-card mt-3" id="kafka-topic">
        <div class="card-body"><p class="text-muted mb-0">This topic is not in the cluster metadata.</p></div>
    </section>
}
else
{
    var keyHelp = topic.KeyShape + ". " + (topic.OrderSensitive ? "This key is order-sensitive. An increase waits until every subscribed group has zero lag and the produce rate is zero." + (topic.KeyClass == "Facility" ? " One facility can never use more than one partition." : "") : "This key is not order-sensitive.") + (topic.HardBlocked ? " Partition changes for this topic are blocked." : "");
    <div class="row g-2 mt-3" id="kafka-topic">
        <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@topic.Partitions</div><div class="au-stat-label">Partitions</div></div></div>
        <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@topic.ReplicationFactor</div><div class="au-stat-label">Replication factor</div></div></div>
        <div class="col"><div class="au-stat-tile @(topic.FullIsr ? null : "lu-kafka-attention")"><div class="au-stat-value">@(topic.FullIsr ? "Full" : "Short")</div><div class="au-stat-label">ISR</div></div></div>
        <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@topic.KeyClass</div><div class="au-stat-label">Key class <partial name="_TermInfo" model="@(new TermInfo { Label = "Key class " + topic.KeyClass, Text = keyHelp })" /></div></div></div>
        <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@(topic.ProduceRateKnown ? topic.ProduceRatePerSecond.ToString("0.#") + "/s" : "—")</div><div class="au-stat-label">Produce rate</div></div></div>
        <div class="col"><div class="au-stat-tile @(topic.LagKnown && topic.TotalLag > 0 ? "lu-kafka-attention" : null)"><div class="au-stat-value">@(topic.LagKnown ? topic.TotalLag.ToString("N0") : "—")</div><div class="au-stat-label">Total lag</div></div></div>
    </div>
}

@if (topic is not null)
{
    @if (Model.Partitions.Count == 0)
    {
        <section class="card au-card mt-3">
            <div class="card-body">
                <p class="text-muted mb-0">Placement for this topic is not in the cluster metadata.</p>
            </div>
        </section>
    }
    else
    {
        var placement = KafkaWindows.Topic(Model.Partitions, query.PartPage, query.PageSize);
        var byGroup = Model.Partitions.SelectMany(row => row.Lag).GroupBy(item => item.GroupId, StringComparer.Ordinal)
            .Select(g => new { Group = g.Key, Lag = g.Sum(item => item.Lag) }).OrderByDescending(item => item.Lag).ThenBy(item => item.Group, StringComparer.Ordinal).ToList();
        <div class="row g-3 mt-0">
        <div class="col-12 col-xl-7">
        <div class="au-card card mt-3 h-100">
            <div class="card-header">Partition placement <partial name="_TermInfo" model="@(new TermInfo { Label = "About partition placement", Text = "One page, worst first. Offline leaders, a short ISR, and group lag come before partitions that are caught up." })" /></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0" id="kafka-placement-table">
                        <thead>
                            <tr>
                                <th class="lu-shrink">Partition</th>
                                <th>Leader</th>
                                <th>Replicas</th>
                                <th>ISR</th>
                                <th class="lu-wrap">End offset</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in placement.Rows)
                        {
                            <tr class="@(KafkaAttention.Partition(row.Leader, row.Replicas, row.InSync, row.Lag.Select(item => item.Lag)) ? "lu-kafka-problem" : null)">
                                <td class="lu-shrink">@row.Partition</td>
                                <td>@(row.Leader < 0 ? "offline" : row.Leader.ToString())</td>
                                <td>@row.Replicas</td>
                                <td>@row.InSync</td>
                                <td class="lu-wrap">@(row.HighWatermark < 0 ? "—" : row.HighWatermark.ToString())</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(placement.Page, placement.Pages, "Worst first.", placement.Page > 1 ? query.Href(part: placement.Page - 1) : "", placement.Page < placement.Pages ? query.Href(part: placement.Page + 1) : ""))" />
            </div>
        </div>
        </div>
        <div class="col-12 col-xl-5">
        <div class="au-card card mt-3 h-100" id="kafka-lag-by-group">
            <div class="card-header">Lag by group <partial name="_TermInfo" model="@(new TermInfo { Label = "About lag by group", Text = "Each group's lag on this topic, summed across partitions, largest first. Open goes to the group." })" /></div>
            <div class="card-body">
                @if (byGroup.Count == 0)
                {
                    <p class="text-muted mb-0">No group commits offsets on this topic.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th class="lu-flex">Group</th><th>State</th><th>Lag</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var item in byGroup.Take(KafkaWindows.Size(query.PageSize)))
                        {
                            var g = Model.Groups.Groups.FirstOrDefault(row => string.Equals(row.GroupId, item.Group, StringComparison.Ordinal));
                            <tr class="@(item.Lag > 0 ? "lu-kafka-problem" : null)">
                                <td class="lu-flex" title="@item.Group">@item.Group</td>
                                <td>@(string.IsNullOrWhiteSpace(g?.State) ? "—" : g!.State)</td>
                                <td>@item.Lag.ToString("N0")</td>
                                <td class="text-end"><a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, group: item.Group, page: 1)">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        </div>
        </div>
    }

    <details class="lu-kafka-fold">
        <summary>Topic configuration (@Counts.Of(topic.Configs.Count, "setting"))</summary>
        <div class="table-responsive mt-3">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th class="lu-wrap">Name</th>
                        <th class="lu-flex">Value</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var config in topic.Configs.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase).Take(query.PageSize))
                {
                    <tr>
                        <td class="lu-wrap">@config.Key</td>
                        <td class="lu-flex">@config.Value</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (topic.Configs.Count > query.PageSize)
        {
            <p class="text-muted mt-2 mb-0">Showing @query.PageSize of @Counts.Of(topic.Configs.Count, "setting").</p>
        }
    </details>



    }
