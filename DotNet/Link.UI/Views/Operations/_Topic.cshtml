@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var origin = ReturnUrlRules.Here(Context.Request);
    var topic = Model.SelectedTopic;
    bool Matches(KafkaTopicRow row)
    {
        if (query.Family.Length > 0 && !string.Equals(row.Family, query.Family, StringComparison.OrdinalIgnoreCase))
            return false;
        if (query.KeyClass.Length > 0 && !string.Equals(row.KeyClass, query.KeyClass, StringComparison.OrdinalIgnoreCase))
            return false;
        if (query.Q.Length > 0
            && !row.Topic.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !row.KeyClass.Contains(query.Q, StringComparison.OrdinalIgnoreCase)
            && !row.Groups.Any(group => group.Contains(query.Q, StringComparison.OrdinalIgnoreCase)))
            return false;
        return true;
    }
    var choices = Model.Topics.Topics.Where(Matches).OrderBy(row => row.Topic, StringComparer.OrdinalIgnoreCase).ToList();
    if (topic is not null && choices.All(row => !string.Equals(row.Topic, topic.Topic, StringComparison.Ordinal)))
        choices.Insert(0, topic);
}

<section class="card au-card mt-3" id="kafka-topic">
    <h2 class="card-header h6 mb-0">@(topic?.Topic ?? "Topic") <partial name="_TermInfo" model="@(new TermInfo { Label = "About this topic", Text = "Placement and lag for one topic. Partition changes are on Migrate. An in-place add remaps keys. A migration recreates the topic empty and keeps the backup." })" /></h2>
    <div class="card-body">
        <form class="row g-2 align-items-end mb-0" method="get" action="/Operations/Kafka">
            <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Topic" />
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
            <div class="col-12 col-md-4">
                <label class="form-label" for="kafka-q-topic">Search</label>
                <input class="form-control" id="kafka-q-topic" name="q" value="@query.Q" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="kafka-family-topic">Family</label>
                <select class="form-select" id="kafka-family-topic" name="family">
                    <option value="">All families</option>
                    @foreach (var family in Model.Families)
                    {
                        if (family == query.Family)
                        {
                            <option value="@family" selected>@family</option>
                        }
                        else
                        {
                            <option value="@family">@family</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="kafka-key-topic">Key class</label>
                <select class="form-select" id="kafka-key-topic" name="keyClass">
                    <option value="">All key classes</option>
                    @foreach (var keyClass in Model.KeyClasses)
                    {
                        if (keyClass == query.KeyClass)
                        {
                            <option value="@keyClass" selected>@keyClass</option>
                        }
                        else
                        {
                            <option value="@keyClass">@keyClass</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="topic-pick">Topic</label>
                <select class="form-select" id="topic-pick" name="topic">
                    @if (choices.Count == 0)
                    {
                        <option value="">No topics match</option>
                    }
                    @foreach (var row in choices)
                    {
                        if (topic is not null && row.Topic == topic.Topic)
                        {
                            <option value="@row.Topic" selected>@row.Topic (@row.Partitions)</option>
                        }
                        else
                        {
                            <option value="@row.Topic">@row.Topic (@row.Partitions)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-au-link" type="submit">Open</button>
            </div>
        </form>
        @if (choices.Count == 0)
        {
            <p class="text-muted mb-0 mt-3">No topics match this search.</p>
        }
        else if (topic is null)
        {
            <p class="text-muted mb-0 mt-3">Select a topic to see leaders, replicas, in-sync replicas, and lag.</p>
        }
        else
        {
            <p class="mt-3 mb-2">
                <partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = topic.Topic, CopyLabel = "Copy topic", ReturnUrl = origin })" />
            </p>
            <p class="mb-3">Key @topic.KeyClass <span class="text-muted">@topic.KeyShape</span>. Partitions @topic.Partitions. Retry @topic.RetryPartitions. Error @topic.ErrorPartitions. RF @topic.ReplicationFactor. Replica ceiling @topic.MaxReplicas.</p>
            @if (topic.HardBlocked)
            {
                <div class="alert alert-secondary" role="status">Partition changes for this topic are blocked.</div>
            }
            else if (topic.OrderSensitive)
            {
                <div class="alert alert-secondary" role="status">This key is order-sensitive. An increase waits until every subscribed group has zero lag and the produce rate is zero.@(topic.KeyClass == "Facility" ? " One facility can never use more than one partition." : "")</div>
            }
            <a class="btn btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: topic.Topic, page: 1)">Change partitions</a>
        }
    </div>
</section>

@if (topic is not null)
{
    @if (Model.Partitions.Count == 0)
    {
        <section class="card au-card mt-3">
            <div class="card-body">
                <p class="text-muted mb-0">Placement for this topic is not in the cluster metadata.</p>
            </div>
        </section>
    }
    else
    {
        var placement = KafkaWindows.Topic(Model.Partitions, query.PartPage, query.PageSize);
        <partial name="_KafkaSummary" model="@(new KafkaSummaryStrip(placement.Total, "Partitions", placement.Hot, "Hottest lag", placement.Hottest.ToString("N0"), placement.Skew))" />
        <div class="au-card card mt-3">
            <div class="card-header">Partition placement <partial name="_TermInfo" model="@(new TermInfo { Label = "About partition placement", Text = "One page, worst first. Offline leaders, a short ISR, and group lag come before partitions that are caught up." })" /></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0" id="kafka-placement-table">
                        <thead>
                            <tr>
                                <th>Partition</th>
                                <th>Leader</th>
                                <th>Replicas</th>
                                <th>ISR</th>
                                <th>High watermark</th>
                                <th>Lag by group</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in placement.Rows)
                        {
                            <tr class="@(KafkaAttention.Partition(row.Leader, row.Replicas, row.InSync, row.Lag.Select(item => item.Lag)) ? "lu-kafka-problem" : null)">
                                <td>@row.Partition</td>
                                <td>@(row.Leader < 0 ? "offline" : row.Leader.ToString())</td>
                                <td>@row.Replicas</td>
                                <td>@row.InSync</td>
                                <td>@(row.HighWatermark < 0 ? "—" : row.HighWatermark.ToString())</td>
                                <td class="lu-wrap">
                                    @if (row.Lag.Count == 0)
                                    {
                                        <span class="text-muted">No group lag</span>
                                    }
                                    else
                                    {
                                        @KafkaWindows.LagByGroup(row.Lag)
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(placement.Page, placement.Pages, "Worst first.", placement.Page > 1 ? query.Href(part: placement.Page - 1) : "", placement.Page < placement.Pages ? query.Href(part: placement.Page + 1) : ""))" />
            </div>
        </div>
    }

    <details class="lu-kafka-fold">
        <summary>Topic configuration (@topic.Configs.Count settings)</summary>
        <div class="table-responsive mt-3">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var config in topic.Configs.OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase).Take(query.PageSize))
                {
                    <tr>
                        <td>@config.Key</td>
                        <td>@config.Value</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (topic.Configs.Count > query.PageSize)
        {
            <p class="text-muted mt-2 mb-0">Showing @query.PageSize of @topic.Configs.Count settings.</p>
        }
    </details>

    <section class="card au-card mt-3">
        <h2 class="card-header h6 mb-0">Partition lag <partial name="_TermInfo" model="@(new TermInfo { Label = "About lag", Text = "How far a consumer is behind the latest message on this topic. A larger number is further behind." })" /></h2>
        <div class="card-body">
            <div class="lu-chart mb-0"><canvas id="kafkaLagChart"></canvas></div>
        </div>
    </section>

    <partial name="_ReplicationFactor" model="Model" />
}
