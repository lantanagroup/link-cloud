@model KafkaNotFound
<section class="card au-card mt-3" id="kafka-not-found">
    <h2 class="card-header h6 mb-0">@Model.Kind not found</h2>
    <div class="card-body d-flex align-items-center gap-2">
        <p class="mb-0">@Model.Kind <code>@Model.Name</code> is not in the cluster.</p>
        <a class="btn btn-sm btn-au-link lu-icon-btn" href="@Model.BackHref" title="@Model.BackLabel" aria-label="@Model.BackLabel"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">@Model.BackLabel</span></a>
    </div>
</section>
