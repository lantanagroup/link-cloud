@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var cluster = Model.Cluster;
    var controllerTile = KafkaControllerTile.Display(cluster.ControllerId, cluster.ControllerUnavailableReason);
    var showController = cluster.ControllerId is int;
    var ranked = KafkaNeedsAttention.Rank(Model.Topics.Topics, Model.Groups.Groups, cluster.Placements, cluster.OfflinePartitions, cluster.UnderReplicatedPartitions);
    var pageSize = KafkaWindows.Size(query.PageSize);
    var pages = Math.Max(1, (int)Math.Ceiling(ranked.Count / (double)pageSize));
    var page = Math.Min(Math.Max(query.PartPage, 1), pages);
    var rows = ranked.Skip((page - 1) * pageSize).Take(pageSize).ToList();
    var topicAttention = ranked.Any(item => item.Kind != "Group");
    var groupAttention = ranked.Any(item => item.Kind == "Group");
    var brokersNeedAttention = cluster.Brokers.Any(KafkaAttention.Broker);
    var maxLag = 0L;
    foreach (var lag in Model.Groups.Groups.Select(row => row.TotalLag).Concat(Model.Topics.Topics.Where(row => row.LagKnown).Select(row => row.TotalLag)))
        if (lag > maxLag)
            maxLag = lag;
}

<div class="row g-2 mt-3">
    @if (showController)
    {
        <div class="col"><div class="au-stat-tile" title="@controllerTile.Title"><div class="au-stat-value">@controllerTile.Value</div><div class="au-stat-label">@controllerTile.Caption</div></div></div>
    }
    <div class="col"><div class="au-stat-tile @(brokersNeedAttention ? "lu-kafka-attention" : null)"><div class="au-stat-value">@cluster.BrokerCount</div><div class="au-stat-label">Brokers</div></div></div>
    <div class="col"><div class="au-stat-tile @(topicAttention ? "lu-kafka-attention" : null)"><div class="au-stat-value">@Model.Topics.Topics.Count</div><div class="au-stat-label">Topics</div></div></div>
    <div class="col"><div class="au-stat-tile @(cluster.UnderReplicatedPartitions > 0 ? "lu-kafka-attention" : null)"><div class="au-stat-value">@cluster.UnderReplicatedPartitions</div><div class="au-stat-label">Under-replicated</div></div></div>
    <div class="col"><div class="au-stat-tile @(cluster.OfflinePartitions > 0 ? "lu-kafka-attention" : null)"><div class="au-stat-value">@cluster.OfflinePartitions</div><div class="au-stat-label">Offline</div></div></div>
    <div class="col"><div class="au-stat-tile @(cluster.IsrShrunkPartitions > 0 ? "lu-kafka-attention" : null)"><div class="au-stat-value">@cluster.IsrShrunkPartitions</div><div class="au-stat-label">ISR shrink</div></div></div>
    <div class="col"><div class="au-stat-tile @(groupAttention ? "lu-kafka-attention" : null)"><div class="au-stat-value">@Model.Groups.Groups.Count</div><div class="au-stat-label">Groups</div></div></div>
    <div class="col"><div class="au-stat-tile @(maxLag > 0 ? "lu-kafka-attention" : null)"><div class="au-stat-value">@maxLag.ToString("N0")</div><div class="au-stat-label">Max lag</div></div></div>
</div>

@if (Model.Dashboard is not null)
{
    <partial name="Kafka/_KafkaPipeline" model="Model.Dashboard" />
}

<section class="card au-card mt-3" id="kafka-attention">
    <h2 class="card-header h6 mb-0">Needs attention <partial name="_TermInfo" model="@(new TermInfo { Label = "About needs attention", Text = "Only problems are listed, worst first. Offline partitions come before a short ISR, then empty, unowned, or not-stable groups, then lag, then an error or retry topic that is still receiving messages. Unknown groups are included when they are empty, unowned, or behind. One blue button opens the place to act. A quiet topic stays off this list." })" /></h2>
    <div class="card-body">
        @if (ranked.Count == 0)
        {
            <p class="mb-0">@KafkaNeedsAttention.Healthy</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th class="lu-flex">Item</th>
                            <th class="lu-wrap">Why</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in rows)
                    {
                        <tr class="lu-kafka-problem">
                            <td class="lu-flex"><span title="@item.What">@item.What</span> <span class="badge ms-1 au-badge-muted lu-kind-badge">@item.Kind</span></td>
                            <td class="lu-wrap">@item.Why</td>
                            <td><a class="btn btn-sm btn-au-link lu-icon-btn" href="@item.Href" title="@item.Action" aria-label="@item.Action"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">@item.Action</span></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="text-muted mt-2 mb-0">Showing @rows.Count of @ranked.Count. Worst first. @KafkaNeedsAttention.Healthy</p>
            @if (pages > 1)
            {
                <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(page, pages, "Worst first.", page > 1 ? query.Href(part: page - 1) : "", page < pages ? query.Href(part: page + 1) : ""))" />
            }
        }
    </div>
</section>

@if (Model.Dashboard is not null)
{
    <div class="row g-3 lu-kafka-widget-grid">
        <div class="col-12 col-xxl-8"><partial name="Kafka/_KafkaBrokerHealth" model="Model.Dashboard" /></div>
        <div class="col-12 col-xxl-4"><partial name="Kafka/_KafkaLeaderDonut" model="Model.Dashboard" /></div>
        <div class="col-12 col-xxl-8"><partial name="Kafka/_KafkaThroughput" model="Model.Dashboard" /></div>
        <div class="col-12 col-xxl-4"><partial name="Kafka/_KafkaErrorRetry" model="Model.Dashboard" /></div>
    </div>
}
