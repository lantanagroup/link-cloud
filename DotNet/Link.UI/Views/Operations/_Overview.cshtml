@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var cluster = Model.Cluster;
    var controllerTile = KafkaControllerTile.Display(cluster.ControllerId, cluster.ControllerUnavailableReason);
    var origin = ReturnUrlRules.Here(Context.Request);
    var groupWindow = KafkaWindows.Groups(Model.Groups.Groups, query.PartPage, query.PageSize);
    string SortDir(string column) => query.Sort == column && query.Dir == "asc" ? "desc" : "asc";
}

<div class="row g-2 mt-3">
    <div class="col"><div class="au-stat-tile" title="@controllerTile.Title"><div class="au-stat-value">@controllerTile.Value</div><div class="au-stat-label">@controllerTile.Caption</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.BrokerCount</div><div class="au-stat-label">Brokers</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.UnderReplicatedPartitions</div><div class="au-stat-label">Under-replicated</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.OfflinePartitions</div><div class="au-stat-label">Offline</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.IsrShrunkPartitions</div><div class="au-stat-label">ISR shrink</div></div></div>
</div>

<section class="card au-card mt-3" id="kafka-topics">
    <h2 class="card-header h6 mb-0">Topics <partial name="_TermInfo" model="@(new TermInfo { Label = "About topics", Text = "The counts above are the cluster. Topics that are behind, short on replicas, or blocked are listed first. Open one for placement. Partition changes are on Migrate." })" /></h2>
    <div class="card-body">
        <p class="text-muted">Provider @Model.Infra.Provider. @(Model.Infra.Enabled ? "Replica and broker changes are enabled." : Model.Infra.Detail)</p>
        <form class="row g-2 align-items-end mb-3" method="get" action="/Operations/Kafka">
            <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Overview" />
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="topic" value="@query.TopicName" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
            <input type="hidden" name="advanced" value="@(query.Advanced ? "1" : "")" />
            <div class="col-12 col-md-4">
                <label class="form-label" for="kafka-q">Search</label>
                <input class="form-control" id="kafka-q" name="q" value="@query.Q" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="kafka-family">Family</label>
                <select class="form-select" id="kafka-family" name="family">
                    <option value="">All families</option>
                    @foreach (var family in Model.Families)
                    {
                        if (family == query.Family)
                        {
                            <option value="@family" selected>@family</option>
                        }
                        else
                        {
                            <option value="@family">@family</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="kafka-key">Key class</label>
                <select class="form-select" id="kafka-key" name="keyClass">
                    <option value="">All key classes</option>
                    @foreach (var keyClass in Model.KeyClasses)
                    {
                        if (keyClass == query.KeyClass)
                        {
                            <option value="@keyClass" selected>@keyClass</option>
                        }
                        else
                        {
                            <option value="@keyClass">@keyClass</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-au-execute" type="submit">Search</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm mb-0" id="kafka-topic-table">
                <thead>
                    <tr>
                        <th><a href="@query.Href(sort: "topic", dir: SortDir("topic"), page: 1)">Topic</a></th>
                        <th><a href="@query.Href(sort: "key", dir: SortDir("key"), page: 1)">Key</a></th>
                        <th><a href="@query.Href(sort: "partitions", dir: SortDir("partitions"), page: 1)">Partitions</a></th>
                        <th>RF</th>
                        <th>ISR</th>
                        <th>Size</th>
                        <th><a href="@query.Href(sort: "lag", dir: SortDir("lag"), page: 1)">Lag <partial name="_TermInfo" model="@(new TermInfo { Label = "About lag", Text = "How far a consumer is behind the latest message on that topic. A larger number is further behind." })" /></a></th>
                        <th><a href="@query.Href(sort: "rate", dir: SortDir("rate"), page: 1)">Produce rate</a></th>
                        <th>Ceiling</th>
                        <th class="lu-wrap">Why</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.TopicRows)
                {
                    <tr class="@(KafkaAttention.Topic(row) ? "lu-kafka-problem" : null)">
                        <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = row.Topic, Compact = true, CopyLabel = "Copy topic", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1) })" /></td>
                        <td>@row.KeyClass <span class="text-muted">@row.KeyShape</span></td>
                        <td>
                            @row.Partitions
                            @if (row.PartitionDrift)
                            {
                                <span class="text-muted">file @row.TopicsFilePartitions</span>
                            }
                            @if (row.ServiceRetryBehind || row.ServiceRedriveBehind || row.PinnedSiblingBehind || row.RetryBehind || row.ErrorBehind)
                            {
                                <span class="text-muted">family behind</span>
                            }
                        </td>
                        <td>@row.ReplicationFactor</td>
                        <td>@(row.FullIsr ? "full" : "short")@(row.LeadersSkewed ? ", skewed" : "")</td>
                        <td>@row.SizeClass</td>
                        <td>@(row.LagKnown ? row.TotalLag.ToString() : "unknown")</td>
                        <td>@KafkaProduceRate.Text(row.ProduceRateKnown, row.ProduceRatePerSecond)</td>
                        <td>@row.MaxReplicas</td>
                        <td class="lu-wrap">@KafkaAttention.Join(KafkaAttention.TopicReasons(row))</td>
                        <td>
                            <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1)" title="Open topic @row.Topic" aria-label="Open topic @row.Topic"><i class="bi bi-hdd-network" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                            @if (row.Slice1Eligible)
                            {
                                <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: row.Topic, page: 1)" aria-label="Migrate @row.Topic">Migrate</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TopicRows.Count == 0)
        {
            <p class="text-muted mb-0 mt-2">No topics match this search.</p>
        }
        <div class="lu-kafka-pager">
            <span>@Model.TopicCount topics. Page @query.Page of @Model.TopicPages.@(query.Sort == "topic" && query.Dir == "asc" ? " Worst first." : "")</span>
            <span class="d-flex gap-2">
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "previous", Href = query.Href(page: query.Page - 1), Enabled = query.Page > 1 })" />
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "next", Href = query.Href(page: query.Page + 1), Enabled = query.Page < Model.TopicPages })" />
            </span>
        </div>
    </div>
</section>

<section class="card au-card mt-3" id="kafka-overview-groups">
    <h2 class="card-header h6 mb-0">Groups <partial name="_TermInfo" model="@(new TermInfo { Label = "About groups", Text = "Open a group to preview a replica change. The preview changes nothing. Groups that are behind or unowned are listed first." })" /></h2>
    <div class="card-body">
        <form class="row g-2 align-items-end mb-3" method="get" action="/Operations/Kafka">
            <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Overview" />
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="page" value="@query.Page" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <input type="hidden" name="q" value="@query.Q" />
            <input type="hidden" name="family" value="@query.Family" />
            <input type="hidden" name="keyClass" value="@query.KeyClass" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="topic" value="@query.TopicName" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <div class="col-auto">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="kafka-tests" name="tests" value="1" @(query.Tests ? "checked" : null) />
                    <label class="form-check-label" for="kafka-tests">Include test groups <partial name="_TermInfo" model="@(new TermInfo { Label = "About test groups", Text = "Groups named e2e-diag-* and Dynamic:* stay hidden unless Include test groups is checked." })" /></label>
                </div>
            </div>
            <div class="col-auto">
                <button class="btn btn-au-execute" type="submit">Search</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Group</th>
                        <th>State</th>
                        <th>Members</th>
                        <th>Lag <partial name="_TermInfo" model="@(new TermInfo { Label = "About lag", Text = "How far a consumer is behind the latest message on that topic. A larger number is further behind." })" /></th>
                        <th class="lu-wrap">Why</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in groupWindow.Rows)
                {
                    <tr class="@(KafkaAttention.Group(row) ? "lu-kafka-problem" : null)">
                        <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Group", Value = row.GroupId, Compact = true, CopyLabel = "Copy group id", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1) })" />@if (!row.Catalogued) { <span class="badge au-badge-muted">Unknown</span> }</td>
                        <td><span class="badge @StatusPills.ForKafka(row.State)">@row.State</span></td>
                        <td>@row.Members.Count</td>
                        <td>@row.TotalLag</td>
                        <td class="lu-wrap">@KafkaAttention.Join(KafkaAttention.GroupReasons(row))</td>
                        <td>
                            <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1)" title="Open group @row.GroupId" aria-label="Open group @row.GroupId"><i class="bi bi-people" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(groupWindow.Page, groupWindow.Pages, "Worst first.", groupWindow.Page > 1 ? query.Href(part: groupWindow.Page - 1) : "", groupWindow.Page < groupWindow.Pages ? query.Href(part: groupWindow.Page + 1) : ""))" />
        <p class="mt-2 mb-0"><a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, page: 1)">Open the group list</a></p>
    </div>
</section>

<section class="card au-card mt-3">
    <h2 class="card-header h6 mb-0">Produce rate and lag <partial name="_TermInfo" model="@(new TermInfo { Label = "About the charts", Text = "The charts follow the topics on this page. A flat rate with rising lag is the group to open." })" /></h2>
    <div class="card-body">
        <div class="lu-chart"><canvas id="kafkaRateChart"></canvas></div>
        <div class="lu-chart"><canvas id="kafkaLagChart"></canvas></div>
    </div>
</section>

