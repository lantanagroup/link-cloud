@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var cluster = Model.Cluster;
    var controllerTile = KafkaControllerTile.Display(cluster.ControllerId, cluster.ControllerUnavailableReason);
    var origin = ReturnUrlRules.Here(Context.Request);
    var topicHot = Model.TopicRows
        .Where(KafkaAttention.Topic)
        .OrderByDescending(row => row.LagKnown ? row.TotalLag : long.MaxValue)
        .ThenBy(row => row.Topic, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var topicProblems = topicHot.Take(KafkaWindows.HottestCap).ToList();
    var groupWindow = KafkaWindows.Groups(Model.Groups.Groups, query.PartPage, query.PageSize);
    var groupProblems = groupWindow.HottestRows;
    var rightsDenied = Model.Capabilities.Topics.Count(right => right.CanAlterPartitions == false);
    var rightsUnknown = Model.Capabilities.Topics.Count(right => right.CanAlterPartitions is null);
    var rightsWindow = KafkaWindows.DeniedRights(Model.Capabilities.Topics, query.PartPage, query.PageSize);
    string SortDir(string column) => query.Sort == column && query.Dir == "asc" ? "desc" : "asc";
}

<h2 class="h5 mt-3">Cluster overview</h2>
<p>Read this before changing anything. The counts above the tables are the cluster. A topic or group that is behind, short on replicas, or unknown is listed on its own. The full tables stay folded.</p>

<div class="row g-2 mt-3">
    <div class="col"><div class="au-stat-tile" title="@controllerTile.Title"><div class="au-stat-value">@controllerTile.Value</div><div class="au-stat-label">@controllerTile.Caption</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.BrokerCount</div><div class="au-stat-label">Brokers</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.UnderReplicatedPartitions</div><div class="au-stat-label">Under-replicated</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.OfflinePartitions</div><div class="au-stat-label">Offline</div></div></div>
    <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@cluster.IsrShrunkPartitions</div><div class="au-stat-label">ISR shrink</div></div></div>
</div>
<p class="text-muted mt-2 mb-0">Provider @Model.Infra.Provider. @(Model.Infra.Enabled ? "Replica and broker changes are enabled." : Model.Infra.Detail)</p>

@if (topicProblems.Count > 0)
{
    <div class="au-card card mt-3">
        <div class="card-header">Topics that need attention (@topicHot.Count)</div>
        <div class="card-body">
            <p>These topics on this page are behind, uneven, or blocked. Open one to see placement, or migrate when an in-place increase is the wrong tool.</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Topic</th>
                            <th>Why</th>
                            <th>Lag</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in topicProblems)
                    {
                        <tr class="lu-kafka-problem">
                            <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = row.Topic, Compact = true, CopyLabel = "Copy topic", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1) })" /></td>
                            <td>@KafkaAttention.Join(KafkaAttention.TopicReasons(row))</td>
                            <td>@(row.LagKnown ? row.TotalLag.ToString() : "unknown")</td>
                            <td>
                                <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1)" title="Open topic @row.Topic" aria-label="Open topic @row.Topic"><i class="bi bi-hdd-network" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                                @if (row.Slice1Eligible)
                                {
                                    <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: row.Topic, page: 1)" aria-label="Migrate @row.Topic">Migrate</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (topicHot.Count > topicProblems.Count)
            {
                <p class="text-muted mt-2 mb-0">@topicProblems.Count of @topicHot.Count shown. The rest are in the topic table on this page.</p>
            }
        </div>
    </div>
}
else if (Model.TopicRows.Count > 0)
{
    <p class="mt-3 mb-0">No topic on this page needs attention.</p>
}

<details class="lu-kafka-fold">
    <summary>Full topic table (@Model.TopicRows.Count on this page)</summary>
    <div class="table-responsive mt-3">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th><a href="@query.Href(sort: "topic", dir: SortDir("topic"), page: 1)">Topic</a></th>
                    <th><a href="@query.Href(sort: "key", dir: SortDir("key"), page: 1)">Key</a></th>
                    <th><a href="@query.Href(sort: "partitions", dir: SortDir("partitions"), page: 1)">Partitions</a></th>
                    <th>RF</th>
                    <th>ISR</th>
                    <th>Size</th>
                    <th><a href="@query.Href(sort: "lag", dir: SortDir("lag"), page: 1)">Lag</a></th>
                    <th><a href="@query.Href(sort: "rate", dir: SortDir("rate"), page: 1)">Produce rate</a></th>
                    <th>Ceiling</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.TopicRows)
            {
                <tr class="@(KafkaAttention.Topic(row) ? "lu-kafka-problem" : null)">
                    <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = row.Topic, Compact = true, CopyLabel = "Copy topic", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1) })" /></td>
                    <td>@row.KeyClass <span class="text-muted">@row.KeyShape</span></td>
                    <td>
                        @row.Partitions
                        @if (row.PartitionDrift)
                        {
                            <span class="text-muted">file @row.TopicsFilePartitions</span>
                        }
                        @if (row.ServiceRetryBehind || row.ServiceRedriveBehind || row.PinnedSiblingBehind || row.RetryBehind || row.ErrorBehind)
                        {
                            <span class="text-muted">family behind</span>
                        }
                    </td>
                    <td>@row.ReplicationFactor</td>
                    <td>@(row.FullIsr ? "full" : "short")@(row.LeadersSkewed ? ", skewed" : "")</td>
                    <td>@row.SizeClass</td>
                    <td>@(row.LagKnown ? row.TotalLag.ToString() : "unknown")</td>
                    <td>@KafkaProduceRate.Text(row.ProduceRateKnown, row.ProduceRatePerSecond)</td>
                    <td>@row.MaxReplicas</td>
                    <td>
                        <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Topic, topic: row.Topic, page: 1)" title="Open topic @row.Topic" aria-label="Open topic @row.Topic"><i class="bi bi-hdd-network" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                        @if (row.Slice1Eligible)
                        {
                            <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, topic: row.Topic, page: 1)" aria-label="Migrate @row.Topic">Migrate</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TopicRows.Count == 0)
    {
        <p class="text-muted mb-0 mt-2">No topics match this search.</p>
    }
</details>
<div class="lu-kafka-pager">
    <span>@Model.TopicCount topics. Page @query.Page of @Model.TopicPages.</span>
    <span class="d-flex gap-2">
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "previous", Href = query.Href(page: query.Page - 1), Enabled = query.Page > 1 })" />
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "next", Href = query.Href(page: query.Page + 1), Enabled = query.Page < Model.TopicPages })" />
    </span>
</div>

@if (groupProblems.Count > 0)
{
    <div class="au-card card mt-3">
        <div class="card-header">Groups that need attention (@groupWindow.Hot)</div>
        <div class="card-body">
            <p>Open a group to preview a replica change. The preview changes nothing.</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Group</th>
                            <th>State</th>
                            <th>Why</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in groupProblems)
                    {
                        <tr class="lu-kafka-problem">
                            <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Group", Value = row.GroupId, Compact = true, CopyLabel = "Copy group id", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1) })" />@if (!row.Catalogued) { <span class="badge au-badge-muted">Unknown</span> }</td>
                            <td><span class="badge @StatusPills.ForKafka(row.State)">@row.State</span></td>
                            <td>@KafkaAttention.Join(KafkaAttention.GroupReasons(row))</td>
                            <td>
                                <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1)" title="Open group @row.GroupId" aria-label="Open group @row.GroupId"><i class="bi bi-people" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (groupWindow.CapNote.Length > 0)
            {
                <p class="text-muted mt-2 mb-0">@groupWindow.CapNote</p>
            }
        </div>
    </div>
}
else if (groupWindow.Total > 0)
{
    <p class="mt-3 mb-0">No group needs attention.</p>
}

<details class="lu-kafka-fold">
    <summary>Groups (@groupWindow.Rows.Count of @groupWindow.Total, worst first)</summary>
    <div class="table-responsive mt-3">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>State</th>
                    <th>Members</th>
                    <th>Lag</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in groupWindow.Rows)
            {
                <tr class="@(KafkaAttention.Group(row) ? "lu-kafka-problem" : null)">
                    <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Group", Value = row.GroupId, Compact = true, CopyLabel = "Copy group id", ReturnUrl = origin, LinkHref = query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1) })" />@if (!row.Catalogued) { <span class="badge au-badge-muted">Unknown</span> }</td>
                    <td><span class="badge @StatusPills.ForKafka(row.State)">@row.State</span></td>
                    <td>@row.Members.Count</td>
                    <td>@row.TotalLag</td>
                    <td>
                        <a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, group: row.GroupId, page: 1)" title="Open group @row.GroupId" aria-label="Open group @row.GroupId"><i class="bi bi-people" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(groupWindow.Page, groupWindow.Pages, "Worst first.", groupWindow.Page > 1 ? query.Href(part: groupWindow.Page - 1) : "", groupWindow.Page < groupWindow.Pages ? query.Href(part: groupWindow.Page + 1) : ""))" />
    <p class="mt-2 mb-0"><a class="btn btn-sm btn-au-link" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, page: 1)">Open the group list</a></p>
</details>

<h2 class="h5 mt-4">Produce rate and lag</h2>
<p class="text-muted">The charts follow the topics on this page. A flat rate with rising lag is the group to open.</p>
<div class="lu-chart"><canvas id="kafkaRateChart"></canvas></div>
<div class="lu-chart"><canvas id="kafkaLagChart"></canvas></div>

<details class="lu-kafka-fold">
    <summary>Broker rights (@Model.Capabilities.Topics.Count topics@(rightsDenied > 0 ? ", " + rightsDenied + " cannot alter partitions" : ""))</summary>
    <div class="mt-3">
        @if (!string.IsNullOrWhiteSpace(Model.Capabilities.Error))
        {
            <p class="text-muted">@Model.Capabilities.Error</p>
        }
        <p>Alter is what an in-place partition increase needs. Unknown means the client did not report the right. This list is only the topics that cannot alter partitions.</p>
        @if (Model.Capabilities.Topics.Count == 0)
        {
            <p class="mb-0">No topic rights were reported.</p>
        }
        else if (rightsWindow.Total == 0)
        {
            <p class="mb-0">Every reported topic can alter partitions.</p>
        }
        else if (rightsWindow.Rows.Count == 0)
        {
            <p class="mb-0">No denied topic on this page.</p>
        }
        else
        {
            <p>Showing @rightsWindow.Rows.Count of @rightsDenied that cannot alter partitions.</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Topic</th>
                            <th>Can alter partitions</th>
                            <th>Authorized operations</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var right in rightsWindow.Rows)
                    {
                        <tr class="lu-kafka-problem">
                            <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Topic", Value = right.Topic, Compact = true, CopyLabel = "Copy topic" })" /></td>
                            <td>No</td>
                            <td>@(right.AuthorizedOperations.Count == 0 ? (right.Error ?? "None reported") : string.Join(", ", right.AuthorizedOperations.Take(8)))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(rightsWindow.Page, rightsWindow.Pages, "Alphabetical.", rightsWindow.Page > 1 ? query.Href(part: rightsWindow.Page - 1) : "", rightsWindow.Page < rightsWindow.Pages ? query.Href(part: rightsWindow.Page + 1) : ""))" />
        }
        @if (rightsUnknown > 0)
        {
            <p class="text-muted mb-0">@rightsUnknown topics did not report the alter right. They stay off this list.</p>
        }
    </div>
</details>
