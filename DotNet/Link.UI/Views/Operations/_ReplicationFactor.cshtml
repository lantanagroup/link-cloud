@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var topic = Model.SelectedTopic;
}
@if (topic is not null)
{
    var topicName = topic.Topic;
    var online = Model.Cluster.Brokers.Count(broker => string.Equals(broker.State, "up", StringComparison.OrdinalIgnoreCase));
    var minIsr = topic.Configs.TryGetValue("min.insync.replicas", out var configured) && configured.Length > 0 ? configured : "1";
    var targetValue = query.Rf > 0 ? query.Rf : (topic.ReplicationFactor > 1 ? topic.ReplicationFactor - 1 : topic.ReplicationFactor);
    var throttleValue = query.RfThrottle > 0 ? query.RfThrottle : ReplicationFactorRules.DefaultThrottle;
    var plan = Model.ReplicationPlan;
    var tone = plan is null ? "alert-secondary" : plan.Accepted ? "alert-success" : "alert-danger";
    <h2 class="h5 mt-4">Change replication factor</h2>
    <p>This moves replicas with a partition reassignment. It does not change how many partitions the topic has. Preview shows the replica each partition would gain or lose, and whether the brokers and racks can hold it. The request sets a replication throttle, moves the replicas, waits until they are in sync, and then clears the throttle.</p>
    <form class="mt-3" method="post" action="/Operations/Kafka/replication-factor/plan" data-kafka-busy="Dry run is running.">
        @Html.AntiForgeryToken()
        <partial name="_QueryFields" model="@(query with { TopicName = topicName, Advanced = true })" />
        <input type="hidden" name="rfSize" value="@query.RfSize" />
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h6">What to change</legend>
            <p class="form-text">The topic is at RF @topic.ReplicationFactor. min.insync.replicas is @minIsr. @online brokers are online. A higher target adds a replica. A lower target removes one. The leader stays.</p>
            <div class="row g-2">
                <div class="col-12 col-md-3">
                    <label class="form-label" for="rf-target">Target replication factor</label>
                    <input class="form-control" id="rf-target" name="replicationFactor" type="number" min="1" max="64" value="@targetValue" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="rf-throttle">Replication throttle (bytes/s)</label>
                    <input class="form-control" id="rf-throttle" name="throttle" type="number" min="1" value="@throttleValue" />
                    <p class="form-text">How fast the new replicas are allowed to copy. @ReplicationFactorRules.ThrottleText(ReplicationFactorRules.DefaultThrottle) is the usual limit. The limit is removed after the ISR is complete.</p>
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label" for="rf-search">Search the plan</label>
                    <input class="form-control" id="rf-search" name="rfQ" value="@query.RfQ" />
                    <p class="form-text">Partition, broker, or rack. Preview again to apply it. The list stays worst first.</p>
                </div>
            </div>
        </fieldset>
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h6">Request only</legend>
            <p class="form-text">A preview does not read these. The request does.</p>
            <div class="row g-2">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="rf-reason">Reason</label>
                    <input class="form-control" id="rf-reason" name="reason" value="@Model.DraftReason" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="rf-confirm">Type the topic name</label>
                    <input class="form-control" id="rf-confirm" name="confirmation" value="@Model.DraftConfirmation" autocomplete="off" />
                </div>
            </div>
        </fieldset>
        @if (plan is not null)
        {
            <div id="kafka-replication-result" class="alert @tone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-replication" data-result-key="@(plan.Accepted)-@plan.Topic-@plan.TargetFactor-@plan.Errors.Count">
                <details class="lu-result-details">
                    <summary>
                        <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                        <span class="lu-result-text">@plan.Summary</span>
                        <button type="button" class="btn btn-sm btn-warning lu-result-dismiss" aria-label="Dismiss result">Dismiss</button>
                    </summary>
                    <div class="lu-result-body">
                        <dl class="row mb-2">
                            <dt class="col-sm-4">Replication factor</dt>
                            <dd class="col-sm-8">@plan.CurrentFactor to @plan.TargetFactor@(plan.Uneven ? " (partitions differ today)" : "")</dd>
                            <dt class="col-sm-4">min.insync.replicas</dt>
                            <dd class="col-sm-8">@plan.MinInSyncReplicas</dd>
                            <dt class="col-sm-4">Online brokers</dt>
                            <dd class="col-sm-8">@plan.OnlineBrokers</dd>
                            <dt class="col-sm-4">Partitions</dt>
                            <dd class="col-sm-8">@plan.ChangedCount of @plan.PartitionCount change. @plan.AddedReplicas added, @plan.RemovedReplicas removed.</dd>
                            <dt class="col-sm-4">Racks</dt>
                            <dd class="col-sm-8">@(plan.ChangedCount == 0 ? "No replica move was planned." : plan.RackProblems == 0 ? "Every changed partition keeps one replica per rack." : plan.RackProblems + " partitions share a rack.")</dd>
                            <dt class="col-sm-4">Throttle</dt>
                            <dd class="col-sm-8">@ReplicationFactorRules.ThrottleText(plan.ThrottleBytesPerSecond) (@plan.ThrottleBytesPerSecond bytes/s)</dd>
                            <dt class="col-sm-4">Skew</dt>
                            <dd class="col-sm-8">@plan.Skew</dd>
                        </dl>
                        @if (plan.Errors.Count > 0)
                        {
                            <p class="mb-1">Blocking reasons</p>
                            <ul>
                            @foreach (var planError in plan.Errors)
                            {
                                <li>@planError</li>
                            }
                            </ul>
                        }
                        <p class="mb-2">@(plan.Accepted ? "Ready. Type the topic name and request the change." : "Fix the items above, then preview again.")</p>
                        <ol class="mb-3">
                            <li>Set the replication throttle on the brokers that gain or lose a replica.</li>
                            <li>Submit the partition reassignment.</li>
                            <li>Wait until every added replica is in the ISR.</li>
                            <li>Clear the throttle.</li>
                        </ol>
                        @if (plan.Hottest.Count > 0)
                        {
                            <p class="mb-1">Busiest brokers</p>
                            <div class="table-responsive">
                                <table class="table table-sm mb-2">
                                    <thead>
                                        <tr>
                                            <th>Broker</th>
                                            <th>Rack</th>
                                            <th>Before</th>
                                            <th>After</th>
                                            <th>Leaders</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var broker in plan.Hottest)
                                    {
                                        <tr>
                                            <td>@broker.Id</td>
                                            <td>@broker.Rack</td>
                                            <td>@broker.Before</td>
                                            <td>@broker.After</td>
                                            <td>@broker.Leaders</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            @if (plan.BrokerCount > plan.Hottest.Count)
                            {
                                <p class="text-muted">@plan.Hottest.Count of @plan.BrokerCount brokers, busiest first.</p>
                            }
                        }
                        @if (plan.Rows.Count == 0)
                        {
                            <p class="mb-2">@(plan.Search.Length > 0 ? "No partition matches this search." : "No partition would change.")</p>
                        }
                        else
                        {
                            <p class="text-muted mb-1">@plan.Rows.Count of @plan.MatchCount partitions on this page. Worst first.</p>
                            <div class="table-responsive">
                                <table class="table table-sm mb-2">
                                    <thead>
                                        <tr>
                                            <th>Partition</th>
                                            <th>Leader</th>
                                            <th>Before</th>
                                            <th>After</th>
                                            <th>Add</th>
                                            <th>Remove</th>
                                            <th>Racks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in plan.Rows)
                                    {
                                        <tr class="@(row.RackShared ? "lu-kafka-problem" : null)">
                                            <td>@row.Partition</td>
                                            <td>@row.Leader</td>
                                            <td>@ReplicationFactorRules.List(row.Before)</td>
                                            <td>@ReplicationFactorRules.List(row.After)</td>
                                            <td>@ReplicationFactorRules.List(row.Added)</td>
                                            <td>@ReplicationFactorRules.List(row.Removed)</td>
                                            <td>@row.Racks</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex gap-2 mb-2">
                                @foreach (var size in new[] { 10, 25, 50 })
                                {
                                    <a class="btn btn-sm @(size == plan.PageSize ? "lu-nav-current" : "btn-au-link")" href="@query.WithReplication(page: 1, size: size).Href()">@size</a>
                                }
                            </div>
                            <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(plan.Page, plan.Pages, "Worst first.", plan.Page > 1 ? query.WithReplication(page: plan.Page - 1).Href() : "", plan.Page < plan.Pages ? query.WithReplication(page: plan.Page + 1).Href() : ""))" />
                        }
                        @if (plan.Notes.Count > 0)
                        {
                            <details>
                                <summary>How this plan is chosen</summary>
                                @foreach (var note in plan.Notes)
                                {
                                    <p class="mb-1">@note</p>
                                }
                            </details>
                        }
                    </div>
                </details>
            </div>
        }
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" formaction="/Operations/Kafka/replication-factor/plan" title="Preview replication factor" aria-label="Preview replication factor"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview replication factor</span></button>
            <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
            @if (!Model.Topics.ReadOnly)
            {
                <button class="btn btn-sm btn-success lu-icon-btn" type="submit" formaction="/Operations/Kafka/replication-factor" title="Request replication factor change" aria-label="Request replication factor change"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span class="ms-1">Request</span></button>
            }
        </div>
    </form>
}
