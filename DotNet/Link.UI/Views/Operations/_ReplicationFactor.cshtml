@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var topic = Model.SelectedTopic;
}
@if (topic is not null)
{
    var topicName = topic.Topic;
    var online = Model.Cluster.Brokers.Count(broker => string.Equals(broker.State, "up", StringComparison.OrdinalIgnoreCase));
    var minIsr = topic.Configs.TryGetValue("min.insync.replicas", out var configured) && configured.Length > 0 ? configured : "1";
    var targetValue = query.Rf > 0 ? query.Rf : (topic.ReplicationFactor > 1 ? topic.ReplicationFactor - 1 : topic.ReplicationFactor);
    var throttleValue = query.RfThrottle > 0 ? query.RfThrottle : ReplicationFactorRules.DefaultThrottle;
    var plan = Model.ReplicationPlan;
    var rfStep = Model.Request?.Kind == "ReplicationFactor" ? 4 : plan is not null ? 3 : 1;
    <section class="card au-card mt-4 mb-3">
    <h2 class="card-header h6 mb-0">Change replication factor</h2>
    <div class="card-body">
    <p class="mb-2">This moves replicas. It does not add or remove partitions. Preview the plan first. Nothing moves until the request is submitted, and the throttle is cleared only after every new replica is in the ISR.</p>
    <ol class="lu-kafka-steps mb-2">
        <li>Set the target factor and the throttle.</li>
        <li>Preview the replica each partition would gain or lose.</li>
        <li>Review the result. A refusal names the reason and changes nothing.</li>
        <li>Type the topic name and request the change. Track it until the throttle clears.</li>
    </ol>
    <p class="mb-0">
        <span class="badge @StatusPills.ForWizardStep(rfStep, 1)">1 Set the target</span>
        <span class="badge @StatusPills.ForWizardStep(rfStep, 2)">2 Preview</span>
        <span class="badge @StatusPills.ForWizardStep(rfStep, 3)">3 Review</span>
        <span class="badge @StatusPills.ForWizardStep(rfStep, 4)">4 Track</span>
    </p>
    </div>
    </section>
    <form class="mt-3" method="post" action="/Operations/Kafka/replication-factor/plan" data-kafka-busy="Dry run is running.">
        @Html.AntiForgeryToken()
        <partial name="_QueryFields" model="@(query with { TopicName = topicName, Advanced = true })" />
        <input type="hidden" name="rfSize" value="@query.RfSize" />
        <section class="card au-card mb-3">
            <h3 class="card-header h6 mb-0">What to change</h3>
            <div class="card-body">
            <p class="form-text">The topic is at replication factor @topic.ReplicationFactor. min.insync.replicas is @minIsr. @online brokers are online. A higher target adds a replica and prefers a free rack. A lower target removes one. The leader stays.</p>
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="rf-target">Target replication factor</label>
                    <input class="form-control" id="rf-target" name="replicationFactor" type="number" min="1" max="64" value="@targetValue" />
                    <p class="form-text">1 to 64. It cannot exceed the online brokers, and it cannot sit below min.insync.replicas.</p>
                </div>
                <div class="col-12 col-md-8">
                    <label class="form-label" for="rf-throttle">Replication throttle (bytes/s)</label>
                    <input class="form-control" id="rf-throttle" name="throttle" type="number" min="1" value="@throttleValue" />
                    <p class="form-text">How fast the new replicas are allowed to copy. @ReplicationFactorRules.ThrottleText(ReplicationFactorRules.DefaultThrottle) is the usual limit. The limit is removed after the ISR is complete.</p>
                </div>
            </div>
            </div>
        </section>
        <section class="card au-card mb-3">
            <h3 class="card-header h6 mb-0">Filter the preview</h3>
            <div class="card-body">
            <p class="form-text">Optional. It does not change the plan. Preview again to apply it. The list stays worst first, one page at a time.</p>
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="rf-search">Partition, broker, or rack</label>
                    <input class="form-control" id="rf-search" name="rfQ" value="@query.RfQ" />
                </div>
            </div>
            </div>
        </section>
        <section class="card au-card mb-3">
            <h3 class="card-header h6 mb-0">Request only</h3>
            <div class="card-body">
            <p class="form-text">A preview does not read these. The request does.</p>
            <div class="row g-2">
                <div class="col-12 col-md-5">
                    <label class="form-label" for="rf-reason">Reason</label>
                    <input class="form-control" id="rf-reason" name="reason" value="@Model.DraftReason" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="rf-confirm">Type the topic name</label>
                    <input class="form-control" id="rf-confirm" name="confirmation" value="@Model.DraftConfirmation" autocomplete="off" />
                </div>
            </div>
            </div>
        </section>
        @if (plan is not null)
        {
            var tone = plan.Accepted ? "alert-success" : "alert-danger";
            var racks = plan.ChangedCount == 0
                ? "No replica move was planned."
                : plan.RackProblems == 0
                    ? "Every changed partition keeps one replica per rack."
                    : plan.RackProblems + " partitions share a rack.";
            <div id="kafka-replication-result" class="alert @tone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-replication" data-result-key="@(plan.Accepted)-@plan.Topic-@plan.TargetFactor-@plan.Errors.Count">
                <details class="lu-result-details">
                    <summary>
                        <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                        <span class="lu-result-text">@plan.Summary</span>
                        <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                    </summary>
                    <div class="lu-result-body">
                        <div class="lu-kafka-summary" aria-label="Replication plan summary">
                            <div>
                                <div class="lu-kafka-summary-value">@plan.CurrentFactor to @plan.TargetFactor</div>
                                <div class="lu-kafka-summary-label">Replication factor@(plan.Uneven ? ", uneven today" : "") <partial name="_TermInfo" model="@(new TermInfo { Label = "About replication factor", Text = "How many copies of each partition the topic keeps. The leader stays. A higher number adds a replica. A lower number removes one." })" /></div>
                            </div>
                            <div>
                                <div class="lu-kafka-summary-value">@plan.ChangedCount<span class="lu-kafka-summary-of"> of @plan.PartitionCount</span></div>
                                <div class="lu-kafka-summary-label">@plan.AddedReplicas added, @plan.RemovedReplicas removed</div>
                            </div>
                            <div>
                                <div class="lu-kafka-summary-value">@ReplicationFactorRules.ThrottleText(plan.ThrottleBytesPerSecond)</div>
                                <div class="lu-kafka-summary-label">Throttle, @plan.ThrottleBytesPerSecond bytes/s</div>
                            </div>
                            <div class="lu-kafka-summary-wide">
                                <div class="lu-kafka-summary-value lu-kafka-summary-text">@plan.Skew</div>
                                <div class="lu-kafka-summary-label">Skew</div>
                            </div>
                        </div>
                        <p class="text-muted mt-2 mb-2">min.insync.replicas <partial name="_TermInfo" model="@(new TermInfo { Label = "About min.insync.replicas", Text = "The fewest copies that must be in sync before a write is accepted. A replication factor cannot sit below this." })" /> @plan.MinInSyncReplicas. @plan.OnlineBrokers brokers online. @racks</p>
                        @if (plan.Errors.Count > 0)
                        {
                            <p class="mb-1">Blocking reasons</p>
                            <ul>
                            @foreach (var planError in plan.Errors)
                            {
                                <li>@planError</li>
                            }
                            </ul>
                        }
                        <p class="mb-2">@(plan.Accepted ? "Ready. Type the topic name and request the change. The request sets the throttle, submits the reassignment, waits for the ISR, and then clears the throttle." : "Fix the items above, then preview again. Nothing has moved.")</p>
                        @if (plan.Hottest.Count > 0)
                        {
                            <p class="mb-1">Busiest brokers</p>
                            <div class="table-responsive">
                                <table class="table table-sm mb-2">
                                    <thead>
                                        <tr>
                                            <th>Broker</th>
                                            <th>Rack</th>
                                            <th>Before</th>
                                            <th>After</th>
                                            <th>Leaders</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var broker in plan.Hottest)
                                    {
                                        <tr>
                                            <td>@broker.Id</td>
                                            <td>@broker.Rack</td>
                                            <td>@broker.Before</td>
                                            <td>@broker.After</td>
                                            <td>@broker.Leaders</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            @if (plan.BrokerCount > plan.Hottest.Count)
                            {
                                <p class="text-muted">@plan.Hottest.Count of @plan.BrokerCount brokers, busiest first.</p>
                            }
                        }
                        @if (plan.Rows.Count == 0)
                        {
                            <p class="mb-2">@(plan.Search.Length > 0 ? "No partition matches this search." : "No partition would change.")</p>
                        }
                        else
                        {
                            <p class="text-muted mb-1">@plan.Rows.Count of @plan.MatchCount partitions on this page. Worst first.</p>
                            <div class="table-responsive">
                                <table class="table table-sm mb-2">
                                    <thead>
                                        <tr>
                                            <th>Partition</th>
                                            <th>Leader</th>
                                            <th>Before</th>
                                            <th>After</th>
                                            <th>Add</th>
                                            <th>Remove</th>
                                            <th>Racks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in plan.Rows)
                                    {
                                        <tr class="@(row.RackShared ? "lu-kafka-problem" : null)">
                                            <td>@row.Partition</td>
                                            <td>@row.Leader</td>
                                            <td>@ReplicationFactorRules.List(row.Before)</td>
                                            <td>@ReplicationFactorRules.List(row.After)</td>
                                            <td>@ReplicationFactorRules.List(row.Added)</td>
                                            <td>@ReplicationFactorRules.List(row.Removed)</td>
                                            <td>@row.Racks</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <span class="text-muted">Page size</span>
                                @foreach (var size in new[] { 10, 25, 50 })
                                {
                                    <a class="btn btn-sm @(size == plan.PageSize ? "lu-nav-current" : "btn-au-link")" href="@query.WithReplication(page: 1, size: size).Href()" aria-current="@(size == plan.PageSize ? "page" : null)">@size</a>
                                }
                            </div>
                            <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(plan.Page, plan.Pages, "Worst first.", plan.Page > 1 ? query.WithReplication(page: plan.Page - 1).Href() : "", plan.Page < plan.Pages ? query.WithReplication(page: plan.Page + 1).Href() : ""))" />
                        }
                        @if (plan.Notes.Count > 0)
                        {
                            <details class="lu-kafka-fold">
                                <summary>How this plan is chosen</summary>
                                @foreach (var note in plan.Notes)
                                {
                                    <p class="mb-1">@note</p>
                                }
                            </details>
                        }
                    </div>
                </details>
            </div>
        }
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" formaction="/Operations/Kafka/replication-factor/plan" title="Preview replication factor" aria-label="Preview replication factor"><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview replication factor</span></button>
            <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
            @if (!Model.Topics.ReadOnly)
            {
                <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" formaction="/Operations/Kafka/replication-factor" title="Request replication factor change" aria-label="Request replication factor change"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span class="ms-1">Request</span></button>
            }
        </div>
    </form>
}
