@model ThroughputKafkaPage
@{
    var request = Model.Request;
    var query = Model.Query;
}
@if (request is not null)
{
    var terminal = request.Status is "Done" or "Rejected" or "Failed" or "Cancelled" or "Aborted" or "TimedOut";
    static bool Named(string? who) => !string.IsNullOrWhiteSpace(who) && !string.Equals(who, "anonymous", StringComparison.OrdinalIgnoreCase);
    var cancellable = request.Kind is "DecommissionBroker" or "Rebalance" && request.Status is "Executing" or "Converging" or "TimedOut";
    <div class="au-card card mt-3" id="kafka-request-progress" data-status-url="/Operations/Kafka/requests/@request.Id.ToString("D")">
        <div class="card-header">Change request</div>
        <div class="card-body">
            <p>@request.Kind <span class="badge @StatusPills.ForKafka(request.Status)" id="kafka-request-status">@request.Status</span></p>
            @if (Named(request.Requester) || Named(request.Approver))
            {
                <p>@(Named(request.Requester) ? "Requested by " + request.Requester + "." : "") @(Named(request.Approver) ? "Approved by " + request.Approver + "." : "")</p>
            }
            @if (request.Kind == "PartitionIncrease")
            {
                <p>@request.Topic from @request.BeforePartitions to @request.RequestedPartitions. Replica ceiling @request.MaxReplicas. Retry @request.RetryTopic increases with it, and so does the error topic.</p>
            }
            else if (request.Kind == "CompleteTopicFamily")
            {
                <p>@request.Topic stays at @request.BeforePartitions. Retry and error topics are raised to that count. The main topic is not changed.</p>
            }
            else if (request.Kind == "CancelReassignment")
            {
                <p>Cancel the in-flight reassignment. @(request.SelfApprovalAllowed ? "It is approved before it runs." : "A different person must approve it before it runs.")</p>
            }
            else if (request.Kind == "ScaleReplicas")
            {
                <p>Group @request.GroupId from @request.BeforeReplicas to @Counts.Of(request.DesiredReplicas, "member").</p>
            }
            else if (request.Kind == "ReplicationFactor")
            {
                var recorded = request.Steps;
                var planned = new[]
                {
                    "Set the replication throttle.",
                    "Submit the partition reassignment.",
                    "Wait until every replica is in the ISR.",
                    "Clear the throttle."
                };
                var stages = new List<string>(recorded);
                for (var index = recorded.Count; index < planned.Length; index++)
                    stages.Add(planned[index]);
                var complete = request.ThrottleCleared || string.Equals(request.Status, "Done", StringComparison.Ordinal);
                <p>@request.Topic replication factor @request.BeforeReplicationFactor to @request.TargetReplicationFactor. Throttle @ReplicationFactorRules.ThrottleText(request.ThrottleBytesPerSecond). @(request.ThrottleCleared ? "The throttle has been cleared." : "The throttle stays until every replica is in the ISR.")</p>
                <ol id="kafka-replication-steps" class="lu-rf-track" aria-label="Replication factor progress">
                @for (var index = 0; index < stages.Count; index++)
                {
                    var done = complete || index < recorded.Count;
                    var current = !done && index == recorded.Count;
                    var mark = done ? "Done" : current ? "Now" : "Waiting";
                    <li class="@(done ? "is-done" : current ? "is-current" : null)">
                        <span class="lu-rf-mark">@mark</span>
                        <strong>@stages[index]</strong>
                    </li>
                }
                </ol>
            }
            else if (request.Kind == "Produce")
            {
                <p>One message was produced on @request.Topic.</p>
            }
            else if (request.BrokerId >= 0)
            {
                <p>Broker @request.BrokerId.</p>
            }
            <p id="kafka-request-progress-text">@request.Progress</p>
            <p>@request.DryRunSummary</p>
            @if (!string.IsNullOrWhiteSpace(request.Failure))
            {
                <p id="kafka-request-failure">@request.Failure</p>
            }
            @if (!string.IsNullOrWhiteSpace(request.Warning))
            {
                <p>@request.Warning</p>
            }
            <p><span>Opened </span><span>@LinkUiTime.Display(request.CreatedUtc)</span></p>
            @if (request.ApprovedUtc is not null)
            {
                <p><span>Approved </span><span>@LinkUiTime.Display(request.ApprovedUtc)</span></p>
            }
            @if (request.ExecutedUtc is not null)
            {
                <p><span>Executed </span><span>@LinkUiTime.Display(request.ExecutedUtc)</span></p>
            }
            @if (request.ConvergedUtc is not null)
            {
                <p><span>Converged </span><span>@LinkUiTime.Display(request.ConvergedUtc)</span></p>
            }
            @if (request.Groups.Count > 0)
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Group</th>
                            <th>Assigned</th>
                            <th>Expected</th>
                            <th>Complete</th>
                        </tr>
                    </thead>
                    <tbody id="kafka-request-groups">
                    @foreach (var group in request.Groups)
                    {
                        <tr>
                            <td>@group.GroupId</td>
                            <td>@group.AssignedPartitions</td>
                            <td>@group.ExpectedPartitions</td>
                            <td>@(group.Complete ? "Yes" : "No")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <details class="mt-2">
                <summary>Details</summary>
                <dl class="row mb-0 mt-2">
                    <dt class="col-sm-3">Request</dt>
                    <dd class="col-sm-9"><partial name="_LabeledId" model="@(new LabeledId { Label = "Request", Value = request.Id.ToString("D"), Compact = true, CopyLabel = "Copy request id" })" /></dd>
                    <dt class="col-sm-3">Correlation</dt>
                    <dd class="col-sm-9"><partial name="_LabeledId" model="@(new LabeledId { Label = "Correlation", Value = request.CorrelationId, Compact = true, CopyLabel = "Copy correlation id" })" /></dd>
                </dl>
            </details>
            @if (!terminal && KafkaChangeActions.ApprovalBlocked(request))
            {
                <p class="mb-0 mt-2" id="kafka-request-approval-blocked">@KafkaChangeActions.UnidentifiedNote</p>
            }
            @if (!terminal)
            {
            <div class="d-flex gap-2 mt-2">
                @if (KafkaChangeActions.CanApprove(request))
                {
                <form method="post" action="/Operations/Kafka/requests/@request.Id.ToString("D")/approve">
                    @Html.AntiForgeryToken()
                    <partial name="_QueryFields" model="query" />
                    <button class="btn btn-sm btn-success lu-icon-btn" type="submit" title="Approve change" aria-label="Approve change"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="ms-1">Approve</span></button>
                </form>
                }
                @if (KafkaChangeActions.CanExecute(request))
                {
                <form method="post" action="/Operations/Kafka/requests/@request.Id.ToString("D")/execute">
                    @Html.AntiForgeryToken()
                    <partial name="_QueryFields" model="query" />
                    <button class="btn btn-sm btn-au-execute lu-icon-btn" type="submit" data-hold="@KafkaChangeActions.ExecuteHold(request)" title="Execute change" aria-label="Execute change"><i class="bi bi-play-fill" aria-hidden="true"></i><span class="ms-1">Execute</span></button>
                </form>
                }
                @if (cancellable)
                {
                    <form method="post" action="/Operations/Kafka/requests/@request.Id.ToString("D")/cancel">
                        @Html.AntiForgeryToken()
                        <partial name="_QueryFields" model="query" />
                        <button class="btn btn-sm btn-warning lu-icon-btn" type="submit" title="Cancel reassignment" aria-label="Cancel reassignment"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="ms-1">Cancel</span></button>
                    </form>
                }
                @if (KafkaChangeActions.CanReject(request))
                {
                <form class="d-flex gap-2" method="post" action="/Operations/Kafka/requests/@request.Id.ToString("D")/reject">
                    @Html.AntiForgeryToken()
                    <partial name="_QueryFields" model="query" />
                    <label class="visually-hidden" for="reject-reason">Rejection reason</label>
                    <input class="form-control form-control-sm" id="reject-reason" name="reason" placeholder="Rejection reason" />
                    <button class="btn btn-sm btn-warning lu-icon-btn" type="submit" title="Reject change" aria-label="Reject change"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="ms-1">Reject</span></button>
                </form>
                }
            </div>
            }
        </div>
    </div>
}
