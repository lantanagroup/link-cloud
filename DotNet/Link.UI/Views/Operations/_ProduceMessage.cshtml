@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var draft = Model.ProduceDraft;
    var topicName = draft is { Topic.Length: > 0 } ? draft.Topic : (Model.SelectedTopic?.Topic ?? query.TopicName);
    var headers = draft?.Headers ?? "";
    var key = draft?.Key ?? "";
    var value = draft?.Value ?? "";
    var summary = draft?.Summary ?? "";
    var hold = draft is { FromStage: false };
    // The server refuses topics outside the catalog. Say so once and disable the form up front.
    var refused = !string.IsNullOrWhiteSpace(topicName) && !LantanaGroup.Link.Shared.Application.Models.Kafka.KafkaBrowseAllowList.Admit(topicName, null).Allowed;
}
<form id="kafka-produce" class="card au-card mt-4@(hold ? " lu-produce-hold" : null)" method="post" action="/Operations/Kafka/messages">
    <h2 class="card-header h5 mb-0">Produce a message <partial name="_TermInfo" model="@(new TermInfo { Label = "About producing a message", Text = "Review the topic, headers, key, and value. Produce sends one new record. Nothing is sent until you hold to confirm." })" /></h2>
    <div class="card-body">
    @if (Model.Request is { Kind: "Produce" } produced)
    {
        var producedOk = produced.Status == "Done";
        <div id="kafka-produce-result" class="alert @(producedOk ? "alert-success" : string.IsNullOrWhiteSpace(produced.Failure) ? "alert-secondary" : "alert-danger") lu-result" role="status" tabindex="-1">
            <details class="lu-result-details">
                <summary>
                    <span class="badge @StatusPills.ForKafka(produced.Status)">@produced.Status</span>
                    <span class="lu-result-text">@(producedOk ? "One message was produced on " + produced.Topic + "." : string.IsNullOrWhiteSpace(produced.Failure) ? produced.Progress : produced.Failure)</span>
                </summary>
                <div class="lu-result-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Message</dt>
                        <dd class="col-sm-9">@produced.DryRunSummary</dd>
                        <dt class="col-sm-3">Produced</dt>
                        <dd class="col-sm-9">@LinkUiTime.Display(produced.ExecutedUtc ?? produced.CreatedUtc)</dd>
                        <dt class="col-sm-3">Request</dt>
                        <dd class="col-sm-9"><partial name="_LabeledId" model="@(new LabeledId { Label = "Request", Value = produced.Id.ToString("D"), Compact = true, CopyLabel = "Copy request id" })" /></dd>
                        <dt class="col-sm-3">Correlation</dt>
                        <dd class="col-sm-9"><partial name="_LabeledId" model="@(new LabeledId { Label = "Correlation", Value = produced.CorrelationId, Compact = true, CopyLabel = "Copy correlation id" })" /></dd>
                    </dl>
                </div>
            </details>
        </div>
    }
    @if (refused)
    {
        <div class="alert alert-warning" role="status" id="kafka-produce-refused">Messages can't be produced to @topicName because it isn't a catalogued Link topic.</div>
    }
    @Html.AntiForgeryToken()
    <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Produce" />
    <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
    <input type="hidden" name="q" value="@query.Q" />
    <input type="hidden" name="sort" value="@query.Sort" />
    <input type="hidden" name="dir" value="@query.Dir" />
    <input type="hidden" name="pageSize" value="@query.PageSize" />
    <input type="hidden" name="family" value="@query.Family" />
    <input type="hidden" name="keyClass" value="@query.KeyClass" />
    <input type="hidden" name="group" value="@query.Group" />
    <input type="hidden" name="broker" value="@query.Broker" />
    <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
    <input type="hidden" name="page" value="1" />
    <input type="hidden" name="key" value="@query.BrowseKey" />
    <input type="hidden" name="messageText" value="@query.MessageText" />
    <input type="hidden" name="headerContains" value="@query.HeaderContains" />
    <input type="hidden" name="valueContains" value="@query.ValueContains" />
    <input type="hidden" name="messageKind" value="@query.MessageKind" />
    <input type="hidden" name="messageFrom" value="@(query.MessageFrom?.ToString() ?? "")" />
    <input type="hidden" name="messageTo" value="@(query.MessageTo?.ToString() ?? "")" />
    <input type="hidden" name="msgPage" value="@query.MsgPage" />
    <input type="hidden" name="more" value="@(query.More ? "true" : "false")" />
    <input type="hidden" name="record" value="@query.OpenRecord" />
    <input type="hidden" name="stage" value="@query.StageRecord" />
    @* The topic comes from the page-level picker; the sub-tab never asks for it again. *@
    <input type="hidden" id="produce-topic" name="topic" value="@topicName" />
    <fieldset id="produce-fields" disabled="@refused">
    <div class="row g-2">
            <div class="col-12">
                <label class="form-label" for="produce-headers">Headers</label>
                <textarea class="form-control" id="produce-headers" name="messageHeaders" rows="4" autocomplete="off">@headers</textarea>
            </div>
            <div class="col-12">
                <label class="form-label" for="produce-key">Key</label>
                <textarea class="form-control" id="produce-key" name="messageKey" rows="2" autocomplete="off">@key</textarea>
            </div>
            <div class="col-12">
                <label class="form-label" for="produce-value">Value</label>
                <textarea class="form-control" id="produce-value" name="messageValue" rows="6" autocomplete="off">@value</textarea>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-au-link" id="kafka-paste-message" type="button">Paste message</button>
        </div>
        @if (!refused)
        {
            <p class="lu-produce-summary mt-3" id="kafka-produce-summary">@summary</p>
        }
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <label class="form-label" for="produce-reason">Reason</label>
                <input class="form-control" id="produce-reason" name="reason" value="@Model.DraftReason" autocomplete="off" />
            </div>
            <div class="col-12 col-md-6">
                <input type="hidden" name="confirmation" value="" data-hold-target />
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-success" id="produce-submit" type="submit" data-hold="@Hold.Of("Produce a message", "Produce one new message to " + topicName + ".", new[] { Hold.Pair("Topic", topicName) }, new[] { new[] { "messageKey", "Key" }, new[] { "messageHeaders", "Headers" }, new[] { "reason", "Reason" } }, new[] { "Every consumer group reading " + topicName + " receives the message, and Link services may act on it.", "A produced message cannot be recalled or deleted." }, topicName, "Hold to produce")">Produce</button>
            <a class="btn btn-warning" href="@query.Href(closeStage: true)">Cancel</a>
        </div>
    </fieldset>
    </div>
</form>
