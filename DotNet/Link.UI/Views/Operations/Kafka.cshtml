@model ThroughputKafkaPage
@{
    var query = Model.Query;
}

<div class="lu-kafka">
<partial name="_BackButton" model="@(new BackLink("/Operations", "Operations"))" />
<h1 class="h3 mt-3">Kafka <span class="lu-live-label">Live</span>
    @if (!Model.Infra.Enabled)
    {
        <span class="badge au-badge-warning ms-2">Provider disabled</span>
        <partial name="_TermInfo" model="@(new TermInfo { Label = "Provider disabled", Text = string.IsNullOrWhiteSpace(Model.Infra.Detail) ? "Broker and replica changes are disabled until an infrastructure provider is enabled." : Model.Infra.Detail })" />
    }
</h1>

<div id="kafkaResults" data-au-refresh="8000" data-au-page-url="@query.Href()" class="lu-kafka">
    @{
        var topicsTab = query.View is ThroughputKafkaPageQuery.Topic or ThroughputKafkaPageQuery.Messages or ThroughputKafkaPageQuery.Produce or ThroughputKafkaPageQuery.Migrate;
        var topicTab = KafkaConsoleRoutes.TabFor(query.View, query.Subtab);
    }
    <nav class="lu-section-nav mt-3" aria-label="Kafka">
        <a class="@(query.View == ThroughputKafkaPageQuery.Overview ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Overview, page: 1)">Overview</a>
        <a class="@(topicsTab ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Topic, topic: query.TopicName, page: 1)">Topics</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Consumers ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, group: query.Group, page: 1)">Consumer groups</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Brokers ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Brokers, broker: query.Broker, page: 1)">Brokers</a>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-secondary" role="status">@Model.Error</div>
    }
    @if (Model.Topics.ReadOnly)
    {
        <div class="alert alert-secondary" role="status">This environment is read-only. Kafka changes are refused.</div>
    }

    @if (query.View == ThroughputKafkaPageQuery.Overview)
    {
        <partial name="_Overview" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Consumers)
    {
        <partial name="_Consumers" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Brokers)
    {
        <partial name="_Brokers" model="Model" />
    }
    else
    {
        <partial name="_TopicPicker" model="Model" />
        @if (!string.IsNullOrWhiteSpace(query.TopicName))
        {
            <partial name="_TopicTabs" model="Model" />
            @if (topicTab == KafkaConsoleRoutes.Messages)
            {
                <partial name="_Messages" model="Model" />
            }
            else if (topicTab == KafkaConsoleRoutes.Produce)
            {
                <partial name="_ProduceMessage" model="Model" />
            }
            else if (topicTab == KafkaConsoleRoutes.Partitions)
            {
                <partial name="_Migrate" model="Model" />
            }
            else if (topicTab == KafkaConsoleRoutes.Replication)
            {
                <partial name="_ReplicationFactor" model="Model" />
            }
            else if (topicTab == KafkaConsoleRoutes.Consumers)
            {
                <partial name="_TopicConsumers" model="Model" />
            }
            else
            {
                <partial name="_Topic" model="Model" />
            }
        }
    }

    <partial name="_ChangeRequest" model="Model" />
    <div id="kafka-ops-chart-data" hidden>@Html.Raw(Model.ChartJson)</div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/kafka-ops.js" asp-append-version="true"></script>
