@model ThroughputKafkaPage
@{
    var query = Model.Query;
}

<div class="lu-kafka">
<partial name="_BackButton" model="@(new BackLink("/Operations", "Operations"))" />
<h1 class="h3 mt-3">Kafka <span class="lu-live-label">Live</span></h1>
<partial name="_Nav" />

<div id="kafkaResults" data-au-refresh="8000" data-au-page-url="@query.Href()" class="lu-kafka">
    <nav class="lu-section-nav mt-3" aria-label="Kafka">
        <a class="@(query.View == ThroughputKafkaPageQuery.Overview ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Overview, page: 1)">Overview</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Topic ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Topic, page: 1)">Topic</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Consumers ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, page: 1)">Consumers</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Brokers ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Brokers, page: 1)">Brokers</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Messages ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Messages, page: 1)">Messages</a>
        <a class="@(query.View == ThroughputKafkaPageQuery.Migrate ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Migrate, page: 1)">Migrate</a>
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-secondary" role="status">@Model.Error</div>
    }
    @if (Model.Topics.ReadOnly)
    {
        <div class="alert alert-secondary" role="status">This environment is read-only. Kafka changes are refused.</div>
    }

    @if (query.View == ThroughputKafkaPageQuery.Overview)
    {
        <partial name="_Overview" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Topic)
    {
        <partial name="_Topic" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Consumers)
    {
        <partial name="_Consumers" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Messages)
    {
        <partial name="_Messages" model="Model" />
    }
    else if (query.View == ThroughputKafkaPageQuery.Migrate)
    {
        <partial name="_Migrate" model="Model" />
    }
    else
    {
        <partial name="_Brokers" model="Model" />
    }

    <partial name="_ChangeRequest" model="Model" />
    <div id="kafka-ops-chart-data" hidden>@Html.Raw(Model.ChartJson)</div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="~/js/kafka-ops.js" asp-append-version="true"></script>
