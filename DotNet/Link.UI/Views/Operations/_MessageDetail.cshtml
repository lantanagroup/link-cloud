@model KafkaMessageOpen
@using LantanaGroup.Link.Shared.Application.Models.Kafka
@{
    var record = Model.Record;
    var facilityHref = KafkaBrowseText.FacilityHref(record.Link.FacilityId);
    var reportHref = KafkaBrowseText.ReportHref(record.Link.FacilityId, record.Link.ReportId);
    var payload = record.Value ?? "";
    var headersText = KafkaProduceRules.HeadersText(record.Headers);
    var clipboard = KafkaProduceRules.ClipboardJson(record.Headers, record.Key, payload);
    var recordId = KafkaBrowseText.RecordId(record.Partition, record.Offset);
    var restageId = "kafka-restage-" + recordId.Replace(':', '-');
    var hasException = !string.IsNullOrWhiteSpace(record.Link.ExceptionMessage) || record.Link.ExceptionHeaders.Count > 0;
}
<article class="lu-msg">
    <header class="lu-msg-head">
        <div>
            <h3 class="lu-msg-topic">@Model.Topic</h3>
            <ul class="lu-msg-meta">
                <li><span>Partition</span><strong>@record.Partition</strong></li>
                <li><span>Offset</span><strong>@record.Offset</strong></li>
                <li><span>Time</span><strong>@KafkaBrowseText.When(record.TimestampUnixMs)</strong></li>
                <li><span>Size</span><strong>@record.ByteSize bytes</strong></li>
            </ul>
        </div>
        <div class="lu-msg-badges">
            <span class="lu-msg-pill">
                <span class="lu-msg-pill-label">Key</span>
                <span class="badge au-badge-active lu-msg-key" title="@record.Key">@KafkaBrowseText.KeyBadge(record.Key)</span>
            </span>
            <span class="lu-msg-pill">
                <span class="lu-msg-pill-label">Message type</span>
                <span class="badge au-badge-muted">@KafkaBrowseText.MessageType(Model.Topic)</span>
            </span>
            @if (record.Truncated)
            {
                <span class="badge au-badge-warning">Truncated</span>
            }
            @if (hasException)
            {
                <span class="badge au-badge-danger">Exception</span>
            }
            <button type="button" class="btn btn-sm btn-au-link" data-restage="@restageId" data-stage="@recordId" data-topic="@Model.Topic">Re-stage</button>
        </div>
    </header>
    <script type="application/json" id="@restageId">@Html.Raw(clipboard)</script>
    @if (record.Truncated)
    {
        <p class="lu-msg-note">The value was cut to stay inside the byte cap.</p>
    }
    @if (!string.IsNullOrWhiteSpace(record.Link.ExceptionMessage))
    {
        <p class="lu-msg-note lu-msg-note-danger">@record.Link.ExceptionMessage</p>
    }
    <nav class="lu-section-nav lu-msg-tabs" role="tablist" aria-label="Opened message">
        <button type="button" class="active" id="kafka-msg-details-tab" data-msg-tab="details" role="tab" aria-selected="true" aria-controls="kafka-msg-details">Details</button>
        <button type="button" id="kafka-msg-raw-tab" data-msg-tab="raw" role="tab" aria-selected="false" aria-controls="kafka-msg-raw">Raw</button>
    </nav>
    <div class="lu-msg-pane" id="kafka-msg-details" data-msg-pane="details" role="tabpanel" aria-labelledby="kafka-msg-details-tab">
        <div class="lu-msg-ids">
            <div>
                <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = record.Link.FacilityId, CopyLabel = "Copy facility id", LinkHref = facilityHref, ReturnUrl = Model.ReturnHref })" />
            </div>
            <div>
                <partial name="_LabeledId" model="@(new LabeledId { Label = "Patient", Value = record.Link.PatientId, CopyLabel = "Copy patient id" })" />
            </div>
            <div>
                <partial name="_LabeledId" model="@(new LabeledId { Label = "Report", Value = record.Link.ReportId, CopyLabel = "Copy report id", LinkHref = reportHref, ReturnUrl = Model.ReturnHref })" />
            </div>
            <div>
                <partial name="_LabeledId" model="@(new LabeledId { Label = "Correlation", Value = record.Link.CorrelationId, CopyLabel = "Copy correlation id" })" />
            </div>
            @if (!string.IsNullOrWhiteSpace(record.Link.RetryCount))
            {
                <div>
                    <span class="lu-id-label">Retry count</span>
                    <span>@record.Link.RetryCount</span>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(record.KeyNote))
        {
            <p class="lu-msg-note">@record.KeyNote</p>
        }
        <section class="lu-msg-section">
            <h4 class="h6">Headers</h4>
            @if (record.Headers.Count == 0)
            {
                <p class="text-muted mb-0">No headers on this record.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Header</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var header in record.Headers.Take(KafkaProduceRules.MaxHeaders))
                        {
                            <tr>
                                <td>@header.Name</td>
                                <td>
                                    <partial name="_LabeledId" model="@(new LabeledId { Label = header.Name, Value = header.Value, Compact = true, CopyLabel = "Copy " + header.Name })" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (record.Headers.Count > KafkaProduceRules.MaxHeaders)
                {
                    <p class="text-muted mb-0">@KafkaProduceRules.MaxHeaders of @record.Headers.Count headers shown.</p>
                }
            }
        </section>
        <section class="lu-msg-section">
            <h4 class="h6">Payload</h4>
            <p class="mb-0">@(string.IsNullOrWhiteSpace(record.ValueSummary) ? "No payload summary." : record.ValueSummary)</p>
        </section>
    </div>
    <div class="lu-msg-pane" id="kafka-msg-raw" data-msg-pane="raw" role="tabpanel" aria-labelledby="kafka-msg-raw-tab" hidden>
        <div class="lu-msg-copy">
            <partial name="_CopyButton" model="@(new CopyTarget { Value = clipboard, Label = "Copy all", Text = "Copy all" })" />
        </div>
        <section class="lu-msg-raw">
            <div class="lu-msg-copy">
                <partial name="_CopyButton" model="@(new CopyTarget { Value = headersText, Label = "Copy headers", Text = "Copy headers" })" />
            </div>
            <h4 class="h6">Headers</h4>
            @if (headersText.Length == 0)
            {
                <p class="text-muted mb-0">No headers on this record.</p>
            }
            else
            {
                <pre>@headersText</pre>
            }
        </section>
        <section class="lu-msg-raw">
            <div class="lu-msg-copy">
                <partial name="_CopyButton" model="@(new CopyTarget { Value = record.Key ?? "", Label = "Copy key", Text = "Copy key" })" />
            </div>
            <h4 class="h6">Key</h4>
            @if (string.IsNullOrEmpty(record.Key))
            {
                <p class="text-muted mb-0">No key on this record.</p>
            }
            else
            {
                <pre>@record.Key</pre>
            }
        </section>
        <section class="lu-msg-raw">
            <div class="lu-msg-copy">
                <partial name="_CopyButton" model="@(new CopyTarget { Value = payload, Label = "Copy value", Text = "Copy value" })" />
            </div>
            <h4 class="h6">Value</h4>
            @if (payload.Length == 0 && string.IsNullOrEmpty(record.ValuePretty))
            {
                <p class="text-muted mb-0">This record has no payload.</p>
            }
            else
            {
                <pre class="lu-json">@Html.Raw(KafkaBrowseText.PayloadHtml(record.ValuePretty, record.Value))</pre>
            }
        </section>
    </div>
</article>
