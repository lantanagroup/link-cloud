@model KafkaWindowPager
<div class="lu-kafka-pager">
    <span>Page @Model.Page of @Model.Pages. @Model.Note</span>
    <span class="d-flex gap-2">
        @if (!string.IsNullOrEmpty(Model.Previous))
        {
            <a class="btn btn-sm btn-au-link" href="@Model.Previous">Previous</a>
        }
        @if (!string.IsNullOrEmpty(Model.Next))
        {
            <a class="btn btn-sm btn-au-link" href="@Model.Next">Next</a>
        }
    </span>
</div>
