@{
    ViewData["Title"] = "Operations";
    ViewData["OperationsSection"] = "home";
}

<div class="lu-kafka">
<partial name="_BackButton" model="@(new BackLink("/Home", "Dashboard"))" />
<h1 class="h3 mt-3">Throughput and scaling</h1>
<partial name="_Nav" />
<div class="au-card card mt-3">
    <div class="card-header">Kafka <partial name="_TermInfo" model="@(new TermInfo { Label = "About Kafka", Text = "Kafka health, and the changes that start as a preview. Nothing moves until a later request is approved and executed. Start with Overview when something looks wrong. Messages reads one allow-listed topic and does not commit offsets. Partition changes are on Migrate. Consumers changes replicas. Brokers previews a decommission or a rebalance." })" /></div>
    <div class="card-body">
        <a class="btn btn-au-link" asp-action="Kafka">Open Kafka</a>
    </div>
</div>
</div>
