@model ThroughputKafkaPage
@{
    var query = Model.Query;
    var origin = ReturnUrlRules.Here(Context.Request);
    var selected = Model.SelectedGroup;
    string SortDir(string column) => query.Sort == column && query.Dir == "asc" ? "desc" : "asc";
}

@if (!string.IsNullOrWhiteSpace(query.Group) && selected is null)
{
    <partial name="_KafkaNotFound" model="@(new KafkaNotFound("Group", query.Group, "/Operations/Kafka/ConsumerGroups", "All consumer groups"))" />
}
@if (string.IsNullOrWhiteSpace(query.Group))
{
<section class="card au-card mt-3" id="kafka-groups">
    <h2 class="card-header h6 mb-0">Groups <partial name="_TermInfo" model="@(new TermInfo { Label = "About groups", Text = "Open a group to add or remove replicas. Add or remove members only after a preview. A count above the partition ceiling is refused, because the extra member would sit idle. Groups that are behind, unowned, or not stable are listed first. Time since the last rebalance is not reported by the client." })" /></h2>
    <div class="card-body">
        <form class="row g-2 align-items-end mb-3" method="get" action="@(string.IsNullOrWhiteSpace(query.Group) ? "/Operations/Kafka/ConsumerGroups" : KafkaConsoleRoutes.Group(query.Group))">
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@query.PageSize" />
            <input type="hidden" name="family" value="@query.Family" />
            <input type="hidden" name="keyClass" value="@query.KeyClass" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="topic" value="@query.TopicName" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <input type="hidden" name="advanced" value="@(query.Advanced ? "1" : "")" />
            <input type="hidden" name="hot" value="@(query.Hot ? "1" : "")" />
            <div class="col-12 col-md-4">
                <input class="form-control" id="kafka-q" aria-label="Search groups" placeholder="Search groups by name, client or host" name="q" value="@query.Q" />
            </div>
            <div class="col-auto">
                <a class="lu-chip @(query.Hot ? "is-current" : null)" href="@query.Href(view: ThroughputKafkaPageQuery.Consumers, hot: !query.Hot, page: 1)">Needs attention</a>
            </div>
            <div class="col-auto">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="kafka-tests" name="tests" value="1" @(query.Tests ? "checked" : null) />
                    <label class="form-check-label" for="kafka-tests">Include test groups <partial name="_TermInfo" model="@(new TermInfo { Label = "About test groups", Text = "Groups named e2e-diag-* and Dynamic:* stay hidden unless Include test groups is checked." })" /></label>
                </div>
            </div>
            <div class="col-auto">
                <button class="btn btn-au-execute" type="submit">Search</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm mb-0" id="kafka-group-table">
                <thead>
                    <tr>
                        <th><a href="@query.Href(sort: "group", dir: SortDir("group"), page: 1)">Group</a></th>
                        <th><a href="@query.Href(sort: "state", dir: SortDir("state"), page: 1)">State</a></th>
                        <th>Members</th>
                        <th><a href="@query.Href(sort: "lag", dir: SortDir("lag"), page: 1)">Lag</a></th>
                        <th>Unowned</th>
                        <th class="lu-wrap">Why</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.GroupRows)
                {
                    var member = row.Members.FirstOrDefault();
                    <tr class="@(KafkaAttention.Group(row) ? "lu-kafka-problem" : null)">
                        <td class="text-nowrap"><a href="@query.Href(group: row.GroupId, page: 1)" title="@row.GroupId">@row.GroupId</a> @if (!row.Catalogued) { <span class="badge au-badge-muted">Unknown</span> }</td>
                        <td><span class="badge @StatusPills.ForKafka(row.State)">@row.State</span></td>
                        <td>@row.Members.Count</td>
                        <td>@row.TotalLag</td>
                        <td>@row.UnownedPartitions.Count</td>
                        <td class="lu-wrap">@KafkaAttention.Join(KafkaAttention.GroupReasons(row))</td>
                        <td>
                            <a class="btn btn-sm btn-au-link lu-icon-btn" href="@query.Href(group: row.GroupId, page: 1)" title="Open group @row.GroupId" aria-label="Open group @row.GroupId"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.GroupRows.Count == 0)
        {
            <p class="text-muted mb-0 mt-2">No groups match this search.</p>
        }
        <div class="lu-kafka-pager">
            <span>@Counts.Of(Model.GroupCount, "group"). Page @query.Page of @Model.GroupPages.@(query.Sort is "group" or "state" or "lag" ? "" : " Worst first.")</span>
            <span class="d-flex gap-2">
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "previous", Href = query.Href(page: query.Page - 1), Enabled = query.Page > 1 })" />
                <partial name="_PagerStep" model="@(new PagerStep { Direction = "next", Href = query.Href(page: query.Page + 1), Enabled = query.Page < Model.GroupPages })" />
            </span>
        </div>

    </div>
</section>
}

@if (selected is not null)
{
    var committed = KafkaWindows.Committed(selected.Partitions, query.PartPage, query.PageSize);
    var shownMembers = selected.Members.Take(query.PageSize).ToList();
    var replicaTarget = Model.DraftReplicas > 0 ? Model.DraftReplicas : selected.Members.Count + 1;
    var replicaBlocked = !selected.Catalogued || !Model.Infra.Enabled;
    var replicaWhy = !selected.Catalogued
        ? "Replica changes are hidden for an unknown group."
        : "This is the member count to reach, not a delta. A preview does not read the reason. Apply does." + (Model.Infra.Enabled ? "" : " " + Model.Infra.Detail);
    <section class="card au-card mt-3 @(KafkaAttention.Group(selected) ? "lu-kafka-attention" : null)" id="kafka-group-card">
        <h2 class="card-header h6 mb-0">@selected.GroupId <partial name="_CopyButton" model="@(new CopyTarget { Value = selected.GroupId, Label = "Copy group id" })" /> @if (!selected.Catalogued) { <span class="badge au-badge-muted">Unknown</span> }</h2>
        <div class="card-body">
            @if (Model.Infra.BrokerLifecycleEnabled)
            {
            <form method="post" action="/Operations/Kafka/groups/replicas/plan" data-kafka-busy="Dry run is running.">
                @Html.AntiForgeryToken()
                <partial name="_QueryFields" model="@(query with { Group = selected.GroupId })" />
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label" for="replica-target">Target members <partial name="_TermInfo" model="@(new TermInfo { Label = "About replicas", Text = replicaWhy })" /></label>
                        <input class="form-control" id="replica-target" name="replicas" type="number" min="0" max="1000" value="@replicaTarget" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="replica-reason">Reason</label>
                        <input class="form-control" id="replica-reason" name="reason" value="@Model.DraftReason" />
                    </div>
                    @if (Model.ScalePlan is not null)
                {
                    var plan = Model.ScalePlan;
                    var scaleTone = plan.Accepted ? "alert-success" : "alert-danger";
                    <div id="kafka-replica-result" class="alert @scaleTone mt-3 lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-replica" data-result-key="@(plan.Accepted)-@plan.GroupId-@plan.DesiredMembers-@plan.Errors.Count">
                        <details class="lu-result-details">
                            <summary>
                                <span class="badge @StatusPills.ForKafka(plan.Accepted ? "Approved" : "Rejected")">@(plan.Accepted ? "Accepted" : "Refused")</span>
                                <span class="lu-result-text">@(plan.Accepted ? "Dry run accepted. Nothing has changed yet." : "This replica change cannot run yet.")</span>
                                <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                            </summary>
                            <div class="lu-result-body">
                                <dl class="row mb-2">
                                    <dt class="col-sm-4">Members</dt>
                                    <dd class="col-sm-8">@plan.CurrentMembers to @plan.DesiredMembers</dd>
                                    <dt class="col-sm-4">Ceiling</dt>
                                    <dd class="col-sm-8">Partition count @plan.PartitionCount. Ceiling @plan.Ceiling.</dd>
                                    <dt class="col-sm-4">Approval</dt>
                                    <dd class="col-sm-8">@(plan.SecondApproverRequired ? "A second approver is required." : "A second approver is not required.")</dd>
                                </dl>
                                @if (plan.Errors.Count > 0)
                                {
                                    <p class="mb-1">Blocking reasons</p>
                                    <ul>
                                    @foreach (var planError in plan.Errors)
                                    {
                                        <li>@planError</li>
                                    }
                                    </ul>
                                }
                                <p class="mb-0">@(plan.Accepted ? "Ready. Fill in the reason, then apply." : "Fix the items above, then preview again.")</p>
                            </div>
                        </details>
                    </div>
                }
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button class="btn btn-sm btn-au-execute lu-icon-btn @(replicaBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/groups/replicas/plan" title="Preview" aria-label="Preview" @(replicaBlocked ? "disabled" : null)><i class="bi bi-eye" aria-hidden="true"></i><span class="ms-1">Preview</span></button>
                    <button class="btn btn-sm btn-au-execute lu-icon-btn @(replicaBlocked ? "is-dimmed" : null)" type="submit" formaction="/Operations/Kafka/groups/replicas" title="Apply" aria-label="Apply" @(replicaBlocked ? "disabled" : null)><i class="bi bi-check-lg" aria-hidden="true"></i><span class="ms-1">Apply</span></button>
                    <p data-kafka-busy-note hidden class="text-muted mb-0">Dry run is running.</p>
                </div>
            </form>
            }
            <div class="row g-2 mt-3">
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.State</div><div class="au-stat-label">State</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.Members.Count</div><div class="au-stat-label">Members</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.TotalLag</div><div class="au-stat-label">Lag</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@Model.ReplicaCeiling</div><div class="au-stat-label">Replica ceiling</div></div></div>
                <div class="col"><div class="au-stat-tile"><div class="au-stat-value">@selected.MembersOnExpectedConfig</div><div class="au-stat-label">Expected config</div></div></div>
            </div>
            @if (selected.Partitions.Count == 0)
            {
                <p class="text-muted mb-0 mt-3">This group has no committed partitions.</p>
            }
            else
            {
                <h3 class="h6 mt-3">Committed partitions</h3>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Topic</th>
                                <th>Partition</th>
                                <th>High watermark</th>
                                <th>Committed</th>
                                <th>Lag</th>
                                <th>Owned</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in committed.Rows)
                        {
                            <tr class="@(KafkaAttention.CommittedPartition(row.Lag, row.Owned) ? "lu-kafka-problem" : null)">
                                <td><a class="btn btn-sm btn-au-link" href="@KafkaConsoleRoutes.Topics(row.Topic, KafkaConsoleRoutes.Summary)">@row.Topic</a></td>
                                <td>@row.Partition</td>
                                <td>@row.HighWatermark</td>
                                <td>@row.Committed</td>
                                <td>@row.Lag</td>
                                <td>@(row.Owned ? "Yes" : "No")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <partial name="_KafkaWindowPager" model="@(new KafkaWindowPager(committed.Page, committed.Pages, "Worst first.", committed.Page > 1 ? query.Href(part: committed.Page - 1) : "", committed.Page < committed.Pages ? query.Href(part: committed.Page + 1) : ""))" />
            }
            @if (selected.UnownedPartitions.Count > 0)
            {
                <p class="mt-2 mb-0">@KafkaWindows.UnownedText(selected.UnownedPartitions)</p>
            }
            <details class="lu-kafka-fold">
                <summary>Members (@shownMembers.Count of @selected.Members.Count)</summary>
                @if (selected.Members.Count == 0)
                {
                    <p class="text-muted mb-0 mt-2">This group has no members.</p>
                }
                else
                {
                    @if (shownMembers.Count < selected.Members.Count)
                    {
                        <p class="text-muted mt-3 mb-0">Showing @shownMembers.Count of @Counts.Of(selected.Members.Count, "member").</p>
                    }
                    <div class="table-responsive mt-3">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Host</th>
                                    <th class="lu-wrap">Assignment</th>
                                    <th>Config</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var member in shownMembers)
                            {
                                <tr class="@(!member.AdvertisesExpectedConfig ? "lu-kafka-problem" : null)">
                                    <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Client", Value = member.ClientId, Compact = true, CopyLabel = "Copy client id" })" /></td>
                                    <td>@member.Host</td>
                                    <td class="lu-wrap">@KafkaWindows.AssignmentText(member.Assignment)</td>
                                    <td>@(member.AdvertisesExpectedConfig ? "Expected" : "Not advertised")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </details>
        </div>
    </section>
}
