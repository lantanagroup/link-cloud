@model ThroughputKafkaPage
@using LantanaGroup.Link.Shared.Application.Models.Kafka
@{
    var query = Model.Query;
    var topicName = Model.SelectedTopic?.Topic ?? query.TopicName;
    var browse = Model.Messages;
    var error = Model.BrowseError;
    var fetched = browse is not null || !string.IsNullOrWhiteSpace(error);
    var step = string.IsNullOrWhiteSpace(topicName) ? 1 : fetched ? 3 : 2;
    var members = Model.Family is { Members.Count: > 0 }
        ? (IReadOnlyList<KafkaNamedTopic>)Model.Family.Members
        : KafkaBrowseAllowList.MembersOf(topicName);
    var familyChecked = Model.Family is not null;
    var topics = Model.TopicRows;
    var topicKnown = topics.Any(row => string.Equals(row.Topic, topicName, StringComparison.Ordinal))
        || Model.Topics.Topics.Any(row => string.Equals(row.Topic, topicName, StringComparison.Ordinal));
    var families = topics
        .GroupBy(row => string.IsNullOrWhiteSpace(row.Family) ? "Other" : row.Family, StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal);
    var pageSize = KafkaWindows.Size(query.PageSize);
    var messageLogEnd = members.FirstOrDefault(member => string.Equals(member.Topic, topicName, StringComparison.OrdinalIgnoreCase))?.HighWatermarkSum ?? 0;
    var messagePages = KafkaMessageWindow.Pages(browse?.Metadata.Total ?? 0, pageSize, messageLogEnd);
    var messagePage = query.MsgPage > messagePages ? messagePages : query.MsgPage;
    if (messagePage < 1)
        messagePage = 1;
    var windowStart = Math.Max(1, messagePage - 2);
    var windowEnd = Math.Min(messagePages, messagePage + 2);
    var matchLabel = browse is null
        ? ""
        : browse.Metadata.Total > 0
            ? browse.Metadata.Total + " matches"
            : browse.Records.Count == 0
                ? "No matches"
                : browse.Records.Count + " on this page";
    string TimeValue(long? unix) => unix is long ms ? DateTimeOffset.FromUnixTimeMilliseconds(ms).UtcDateTime.ToString("yyyy-MM-ddTHH:mm") : "";
    var advancedOpen = query.More || query.BrowseKey.Length > 0 || query.HeaderContains.Length > 0 || query.ValueContains.Length > 0;
    var exactKey = LinkMessageKey.TryDeserialize(query.BrowseKey, out _);
    var correlationSearch = Guid.TryParse(query.MessageText, out _);
    var clientBatch = browse is not null && (
        browse.Metadata.More
        || browse.Records.Count > pageSize
        || query.Resume.Length > 0
        || query.MessageFrom is not null
        || query.MessageTo is not null
        || exactKey
        || correlationSearch);
    var clock = DateTimeOffset.UtcNow;
}

<section class="card au-card mt-3 mb-3">
<h2 class="card-header h6 mb-0">Read messages</h2>
<div class="card-body">
<p class="mb-2">This reads one allow-listed topic: the main topic, its error topic, a retry topic, or a redrive topic. The read does not commit offsets, so the consumer groups stay where they are. Time, message type, and an exact facility and patient key narrow what is read. A keyword filters the messages already loaded and does not read again. Search further reads the next batch. An unfiltered topic is paged one page at a time. Export reads that same page again and writes an audit of the rows it returns.</p>
<ol class="lu-kafka-steps mb-2">
    <li>Choose the topic. The family tabs move between the main topic and its error, retry, and redrive topics.</li>
    <li>Search. Time, type, and an exact facility and patient key narrow the read. A keyword filters the loaded messages on this page.</li>
    <li>Open a row for the payload and the facility or report it belongs to.</li>
    <li>Export JSON when you need a copy of this page. That second read is audited.</li>
</ol>
<p class="mb-0">
    <span class="badge @StatusPills.ForWizardStep(step, 1)">1 Choose a topic</span>
    <span class="badge @StatusPills.ForWizardStep(step, 2)">2 Search</span>
    <span class="badge @StatusPills.ForWizardStep(step, 3)">3 Review</span>
    <span class="badge @StatusPills.ForWizardStep(step, 4)">4 Export</span>
</p>
</div>
</section>

<section class="card au-card mb-3">
<h2 class="card-header h6 mb-0">Topic</h2>
<div class="card-body">
<form class="row g-2 align-items-end mb-0" method="get" action="/Operations/Kafka">
    <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Messages" />
    <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
    <input type="hidden" name="q" value="@query.Q" />
    <input type="hidden" name="pageSize" value="@pageSize" />
    <input type="hidden" name="mq" value="@query.MessageText" />
    <input type="hidden" name="key" value="@query.BrowseKey" />
    <input type="hidden" name="hq" value="@query.HeaderContains" />
    <input type="hidden" name="vq" value="@query.ValueContains" />
    <input type="hidden" name="mtype" value="@query.MessageKind" />
    <input type="hidden" name="mfrom" value="@TimeValue(query.MessageFrom)" />
    <input type="hidden" name="mto" value="@TimeValue(query.MessageTo)" />
    <input type="hidden" name="msgPage" value="1" />
    <input type="hidden" name="more" value="@(query.More ? "1" : "")" />
    <div class="col-12 col-md-6">
        <label class="form-label" for="browse-topic">Topic</label>
        <select class="form-select" id="browse-topic" name="topic">
            @if (!string.IsNullOrWhiteSpace(topicName) && !topicKnown)
            {
                <option value="@topicName" selected>@topicName</option>
            }
            @foreach (var family in families)
            {
                <optgroup label="@family.Key">
                    @foreach (var row in family.OrderBy(row => row.Topic, StringComparer.Ordinal))
                    {
                        if (row.Topic == topicName)
                        {
                            <option value="@row.Topic" selected>@row.Topic</option>
                        }
                        else
                        {
                            <option value="@row.Topic">@row.Topic</option>
                        }
                    }
                </optgroup>
            }
        </select>
        <p class="form-text mb-0">Topics are grouped by family. Open keeps this search and starts at the first page.</p>
    </div>
    <div class="col-auto">
        <button class="btn btn-au-link" type="submit">Open</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(topicName) && members.Count > 0)
{
    <nav class="lu-section-nav mt-3" aria-label="Topic family">
        @foreach (var member in members)
        {
            <a class="@(string.Equals(member.Topic, topicName, StringComparison.OrdinalIgnoreCase) ? "lu-nav-current" : "")" href="@query.Href(view: ThroughputKafkaPageQuery.Messages, topic: member.Topic, closeRecord: true)">@KafkaBrowseText.MemberLabel(member)</a>
        }
    </nav>
    @if (familyChecked)
    {
        <p class="lu-kafka-stat mb-0">@KafkaBrowseText.FamilyStat(members)</p>
    }
}
@if (string.IsNullOrWhiteSpace(topicName))
{
    <p class="text-muted mb-0 mt-2">Choose a topic to read. Internal topics and names outside the catalog are refused.</p>
}
</div>
</section>

@if (!string.IsNullOrWhiteSpace(topicName))
{
    <form class="mt-3" method="get" action="/Operations/Kafka">
        <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Messages" />
        <input type="hidden" name="topic" value="@topicName" />
        <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
        <input type="hidden" name="q" value="@query.Q" />
        <input type="hidden" name="sort" value="@query.Sort" />
        <input type="hidden" name="dir" value="@query.Dir" />
        <input type="hidden" name="pageSize" value="@query.PageSize" />
        <input type="hidden" name="family" value="@query.Family" />
        <input type="hidden" name="keyClass" value="@query.KeyClass" />
        <input type="hidden" name="group" value="@query.Group" />
        <input type="hidden" name="broker" value="@query.Broker" />
        <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="mq" id="browse-mq" value="@query.MessageText" />
        <input type="hidden" name="hq" id="browse-hq" value="@query.HeaderContains" />
        <input type="hidden" name="vq" id="browse-vq" value="@query.ValueContains" />

        <section class="card au-card mb-0 lu-search">
            <h3 class="card-header h6 mb-0">Search</h3>
            <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-5">
                    <label class="form-label" for="browse-q">Search</label>
                    <input class="form-control" id="browse-q" value="@query.MessageText" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label" for="browse-kind">Message type</label>
                    <select class="form-select" id="browse-kind" name="mtype">
                        @foreach (var kind in new[] { "", "Main", "Error", "Retry", "Redrive" })
                        {
                            var label = kind.Length == 0 ? "All types" : kind;
                            if (kind == query.MessageKind)
                            {
                                <option value="@kind" selected>@label</option>
                            }
                            else
                            {
                                <option value="@kind">@label</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label" for="browse-from">From</label>
                    <input class="form-control" id="browse-from" name="mfrom" type="datetime-local" value="@TimeValue(query.MessageFrom)" />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label" for="browse-to">To</label>
                    <input class="form-control" id="browse-to" name="mto" type="datetime-local" value="@TimeValue(query.MessageTo)" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-au-execute" type="submit">Search</button>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <a class="btn btn-sm btn-au-link" href="@query.AtFrom(clock.AddMinutes(-15).ToUnixTimeMilliseconds()).Href()">Last 15 minutes</a>
                <a class="btn btn-sm btn-au-link" href="@query.AtFrom(clock.AddHours(-1).ToUnixTimeMilliseconds()).Href()">Last hour</a>
                <a class="btn btn-sm btn-au-link" href="@query.AtFrom(clock.AddHours(-24).ToUnixTimeMilliseconds()).Href()">Last 24 hours</a>
            </div>
            <details class="lu-advanced mt-3" @(advancedOpen ? "open" : null)>
                <summary>Advanced</summary>
                <div class="row g-2 mt-1">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="browse-header">Header contains</label>
                        <input class="form-control" id="browse-header" data-lu-keyword-part value="@query.HeaderContains" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="browse-key">Key contains</label>
                        <input class="form-control" id="browse-key" name="key" value="@query.BrowseKey" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="browse-value">Value contains</label>
                        <input class="form-control" id="browse-value" data-lu-keyword-part value="@query.ValueContains" autocomplete="off" />
                    </div>
                </div>
            </details>
            <input type="hidden" name="msgPage" value="1" />
            <input type="hidden" name="more" value="@(advancedOpen ? "1" : "")" />
            </div>
        </section>
        <div class="mt-2 mb-3">
            @if (browse is not null)
            {
                <a class="btn btn-au-link" href="@query.ExportHref()">Export JSON</a>
            }
            <a class="btn btn-warning" href="/Operations/Kafka?view=messages&amp;topic=@Uri.EscapeDataString(topicName)">Clear</a>
        </div>
        <p class="visually-hidden">The read does not commit offsets.</p>
    </form>

    @if (fetched)
    {
        <div id="kafka-browse-result" class="alert @KafkaBrowseText.Tone(browse, error) lu-result" role="status" tabindex="-1" data-kafka-result data-lu-result="kafka-browse" data-result-key="@(browse?.Metadata.Returned)-@(browse?.Metadata.CapHit)-@error">
            <details class="lu-result-details">
                <summary>
                    <span class="badge @KafkaBrowseText.BadgeClass(browse, error)">@KafkaBrowseText.Badge(browse, error)</span>
                    <span class="lu-result-text">@KafkaBrowseText.Verdict(browse, error)</span>
                    <button type="button" class="lu-dismiss lu-result-dismiss" aria-label="Dismiss"><span aria-hidden="true">&times;</span></button>
                </summary>
                <div class="lu-result-body">
            @if (browse is not null)
            {
                <dl class="row mb-2">
                    <dt class="col-sm-4">Topic</dt>
                    <dd class="col-sm-8">@browse.Topic</dd>
                    <dt class="col-sm-4">Mode</dt>
                    <dd class="col-sm-8">@browse.Mode</dd>
                    <dt class="col-sm-4">Returned</dt>
                    <dd class="col-sm-8">@browse.Metadata.Returned</dd>
                    <dt class="col-sm-4">Truncated</dt>
                    <dd class="col-sm-8">@(browse.Metadata.Truncated ? "Yes. A record or the page was cut to stay inside the cap." : "No.")</dd>
                    <dt class="col-sm-4">Cap hit</dt>
                    <dd class="col-sm-8">@(browse.Metadata.CapHit ? "Yes. The scan, the byte budget, or the time limit stopped the read." : "No.")</dd>
                    <dt class="col-sm-4">Elapsed</dt>
                    <dd class="col-sm-8">@browse.Metadata.ElapsedMs ms</dd>
                </dl>
            }
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="mb-1">Blocking reasons</p>
                <ul>
                    <li>@error</li>
                </ul>
            }
            <p class="mb-2">@KafkaBrowseText.NextStep(browse, error)</p>
            <details>
                <summary>Details</summary>
                <p class="mb-0">The read uses group @KafkaBrowseLimits.GroupId. Auto-commit is off, so this page does not move a consumer group. A page stops at @KafkaBrowseLimits.MaxLimit records, @KafkaBrowseLimits.MaxScanned scanned records, or @KafkaBrowseLimits.MaxPageBytes bytes.</p>
            </details>
                </div>
            </details>
        </div>
    }

    @if (browse is { Records.Count: > 0 })
    {
        <h3 class="h6 mt-4">Records</h3>
        <div class="au-card card">
        <div class="table-responsive">
            <table class="table table-sm align-middle" data-lu-messages data-lu-page-size="@pageSize" data-lu-page="1" data-lu-client="@(clientBatch ? "1" : "0")">
                <thead>
                    <tr>
                        <th>Partition</th>
                        <th>Offset</th>
                        <th>Time</th>
                        <th>Key</th>
                        <th>Summary</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var record in browse.Records)
                {
                    var recordId = KafkaBrowseText.RecordId(record.Partition, record.Offset);
                    var open = string.Equals(query.OpenRecord, recordId, StringComparison.Ordinal);
                    var hasException = !string.IsNullOrWhiteSpace(record.Link.ExceptionMessage) || record.Link.ExceptionHeaders.Count > 0;
                    <tr data-lu-id="@recordId" data-lu-text="@KafkaBrowseText.FilterText(record)">
                        <td>@record.Partition</td>
                        <td>@record.Offset</td>
                        <td>@KafkaBrowseText.When(record.TimestampUnixMs)</td>
                        <td><code class="small">@record.Key</code></td>
                        <td>@record.ValueSummary</td>
                        <td>
                            @if (record.Truncated)
                            {
                                <span class="badge au-badge-warning">Truncated</span>
                            }
                            @if (hasException)
                            {
                                <span class="badge au-badge-danger">Exception</span>
                            }
                            @if (!record.Truncated && !hasException)
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (open)
                            {
                                <a class="btn btn-sm btn-warning" href="@query.Href(closeRecord: true)">Close</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-au-link" href="@query.Href(record: recordId)">Open</a>
                            }
                        </td>
                    </tr>
                    @if (open)
                    {
                        <tr class="lu-msg-row">
                            <td colspan="7">
                                <partial name="_MessageDetail" model="@(new KafkaMessageOpen { Topic = topicName, Record = record, ReturnHref = query.Href() })" />
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        </div>
    }
    else if (browse is not null)
    {
        <p class="text-muted mt-3">No records matched this search.</p>
    }

    <nav class="lu-pager" aria-label="Message pages">
        @if (browse is not null)
        {
            var scanNote = KafkaBrowseText.ScanNote(browse);
            if (scanNote.Length > 0)
            {
                <span class="small text-muted" data-lu-scan>@scanNote</span>
            }
            <span class="small text-muted" data-lu-loaded>@KafkaBrowseText.LoadedNote(browse.Records.Count)</span>
            @if (browse.Metadata.More && browse.Metadata.Resume.Length > 0)
            {
                <a class="btn btn-sm btn-au-execute" data-lu-further href="@query.Href(resume: browse.Metadata.Resume, msgPage: 1)">Search further</a>
            }
        }
        <div data-lu-client-pager></div>
        <div data-lu-server-pager @(clientBatch ? "hidden" : null)>
        @if (matchLabel.Length > 0)
        {
            <span class="small text-muted">@matchLabel</span>
        }
        <span class="small text-muted">Page @messagePage of @messagePages</span>
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "first", Href = query.Href(msgPage: 1), Enabled = messagePage > 1 })" />
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "previous", Href = query.Href(msgPage: messagePage - 1), Enabled = messagePage > 1 })" />
        @for (var number = windowStart; number <= windowEnd; number++)
        {
            if (number == messagePage)
            {
                <span class="lu-page-num is-current" aria-current="page">@number</span>
            }
            else
            {
                <a class="lu-page-num" href="@query.Href(msgPage: number)">@number</a>
            }
        }
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "next", Href = query.Href(msgPage: messagePage + 1), Enabled = messagePage < messagePages })" />
        <partial name="_PagerStep" model="@(new PagerStep { Direction = "last", Href = query.Href(msgPage: messagePages), Enabled = messagePage < messagePages })" />
        <form class="lu-pager-jump" method="get" action="/Operations/Kafka">
            <input type="hidden" name="view" value="@ThroughputKafkaPageQuery.Messages" />
            <input type="hidden" name="topic" value="@topicName" />
            <input type="hidden" name="returnUrl" value="@query.ReturnUrl" />
            <input type="hidden" name="q" value="@query.Q" />
            <input type="hidden" name="sort" value="@query.Sort" />
            <input type="hidden" name="dir" value="@query.Dir" />
            <input type="hidden" name="pageSize" value="@pageSize" />
            <input type="hidden" name="family" value="@query.Family" />
            <input type="hidden" name="keyClass" value="@query.KeyClass" />
            <input type="hidden" name="group" value="@query.Group" />
            <input type="hidden" name="broker" value="@query.Broker" />
            <input type="hidden" name="tests" value="@(query.Tests ? "1" : "")" />
            <input type="hidden" name="mq" value="@query.MessageText" />
            <input type="hidden" name="key" value="@query.BrowseKey" />
            <input type="hidden" name="hq" value="@query.HeaderContains" />
            <input type="hidden" name="vq" value="@query.ValueContains" />
            <input type="hidden" name="mtype" value="@query.MessageKind" />
            <input type="hidden" name="mfrom" value="@TimeValue(query.MessageFrom)" />
            <input type="hidden" name="mto" value="@TimeValue(query.MessageTo)" />
            <input type="hidden" name="more" value="@(advancedOpen ? "1" : "")" />
            <input type="hidden" name="record" value="@query.OpenRecord" />
            <input type="hidden" name="stage" value="@query.StageRecord" />
            <label class="form-label mb-0" for="browse-jump">Page</label>
            <input class="form-control form-control-sm" id="browse-jump" name="msgPage" type="number" min="1" max="@messagePages" value="@messagePage" />
            <button class="lu-page-go" type="submit">Go</button>
        </form>
        <span class="small text-muted">Per page</span>
        @foreach (var size in new[] { 10, 25, 50 })
        {
            if (size == pageSize)
            {
                <span class="lu-page-num is-current" aria-current="true">@size</span>
            }
            else
            {
                <a class="lu-page-num" href="@query.Href(pageSize: size, msgPage: 1)">@size</a>
            }
        }
        </div>
    </nav>

    <partial name="_ProduceMessage" model="Model" />
}
