@model string?
@if (LinkUiFeatures.Value.AutomationEnabled)
{
    var scope = AutomationMarkRules.NormalizeScope(Model);
    <label class="form-label" for="automationScope">Show</label>
    <select id="automationScope" name="scope" class="form-select">
        @if (scope == AutomationMarkRules.Automation)
        {
            <option value="all">All</option>
            <option value="real">Real</option>
            <option value="automation" selected>Automation</option>
        }
        else if (scope == AutomationMarkRules.All)
        {
            <option value="all" selected>All</option>
            <option value="real">Real</option>
            <option value="automation">Automation</option>
        }
        else
        {
            <option value="all">All</option>
            <option value="real" selected>Real</option>
            <option value="automation">Automation</option>
        }
    </select>
}
