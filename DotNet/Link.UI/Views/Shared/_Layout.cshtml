@using Link.UI.Models
@using Link.UI.Services
@inject IAdminBffUserService UserService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool Ctrl(string name) => string.Equals(currentController, name, StringComparison.OrdinalIgnoreCase);
    bool Placeholder(string action) =>
        Ctrl("Placeholder") && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

    var user = Context.Items[AdminBffUserService.HttpContextItemKey] as AdminBffUser
        ?? await UserService.GetCurrentUserAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Link.UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="lu-body">
    <div class="lu-shell">
        <aside class="lu-sidebar">
            <div class="lu-brand">
                <a asp-controller="Home" asp-action="Index" class="lu-brand-link">
                    <i class="bi bi-link-45deg me-1"></i> Link.UI
                </a>
            </div>
            <nav class="lu-nav" aria-label="Primary">
                <div class="lu-nav-section-label">Admin</div>
                <a class="lu-nav-link @(Ctrl("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2"></i>Home
                </a>
                <a class="lu-nav-link @(Ctrl("Tenants") ? "active" : "")" asp-controller="Tenants" asp-action="Index">
                    <i class="bi bi-building me-2"></i>Tenants
                </a>
                <a class="lu-nav-link @(Placeholder("Reports") ? "active" : "")" asp-controller="Placeholder" asp-action="Reports">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>Reports
                </a>
                <a class="lu-nav-link @(Placeholder("Configuration") ? "active" : "")" asp-controller="Placeholder" asp-action="Configuration">
                    <i class="bi bi-sliders me-2"></i>Configuration
                </a>
                <a class="lu-nav-link @(Placeholder("Logs") ? "active" : "")" asp-controller="Placeholder" asp-action="Logs">
                    <i class="bi bi-journal-text me-2"></i>Logs
                </a>
                <a class="lu-nav-link @(Placeholder("System") ? "active" : "")" asp-controller="Placeholder" asp-action="System">
                    <i class="bi bi-gear me-2"></i>System
                </a>

                <div class="lu-nav-section-label mt-3">Later</div>
                <a class="lu-nav-link lu-nav-link-muted @(Placeholder("Automation") ? "active" : "")" asp-controller="Placeholder" asp-action="Automation">
                    <i class="bi bi-lightning-charge me-2"></i>Automation
                </a>
            </nav>
            <div class="lu-sidebar-footer">
                @if (user?.IsAuthenticated == true)
                {
                    <div class="lu-user-chip" title="@user.Email">
                        <i class="bi bi-person-circle me-1"></i>@(user.UserName ?? user.Email ?? "Signed in")
                    </div>
                    <a class="lu-nav-link" asp-controller="Auth" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </a>
                }
                else
                {
                    <a class="lu-nav-link" asp-controller="Auth" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                }
            </div>
        </aside>
        <div class="lu-main">
            <header class="lu-topbar">
                <h1 class="lu-page-title">@ViewData["Title"]</h1>
            </header>
            <main class="lu-content" role="main">
                @RenderBody()
            </main>
            <footer class="lu-footer text-muted">
                &copy; 2026 - Link.UI (phase 1 scaffold)
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
