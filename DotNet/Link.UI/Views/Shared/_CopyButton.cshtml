@model CopyTarget
<button type="button" class="btn btn-sm btn-au-link lu-icon-btn lu-copy" data-lu-copy="@Model.Value" title="@Model.Label" aria-label="@Model.Label">
    <i class="bi bi-copy" aria-hidden="true"></i>
    @if (string.IsNullOrWhiteSpace(Model.Text))
    {
        <span class="visually-hidden">Copy</span>
    }
    else
    {
        <span class="visually-hidden">@Model.Text</span>
    }
</button>
