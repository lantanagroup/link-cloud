@model RubricEditorPage
@{
    var definition = Model.Definition;
    var showForm = Model.Configured && !Model.NotFound && Model.Locked is null && (Model.Mode == "new" || !string.IsNullOrEmpty(definition.Id));
    var heading = Model.Mode switch
    {
        "edit" => "Edit draft",
        "new-version" => "New version",
        _ => "New rubric"
    };
    var title = string.IsNullOrWhiteSpace(definition.Title) ? heading : definition.Title;
    string backUrl;
    string backLabel;
    if (Model.Mode == "edit" && !string.IsNullOrEmpty(Model.RubricId))
    {
        var semver = string.IsNullOrEmpty(Model.RouteSemver) ? definition.Semver : Model.RouteSemver;
        backUrl = Url.Action("RubricVersion", new { rubricId = Model.RubricId, semver })!;
        backLabel = "Back to version";
    }
    else if (Model.Mode == "new-version" && !string.IsNullOrEmpty(Model.RubricId))
    {
        backUrl = Url.Action("Rubric", new { rubricId = Model.RubricId })!;
        backLabel = "Back to rubric";
    }
    else
    {
        backUrl = Url.Action("Rubrics")!;
        backLabel = "Back to rubrics";
    }
    var postAction = Model.Mode switch
    {
        "edit" => "PostEditRubric",
        "new-version" => "PostNewRubricVersion",
        _ => "PostNewRubric"
    };
    var idEditable = Model.Mode == "new" && string.IsNullOrEmpty(Model.SavedChecksum);
    var dimensions = RubricDraft.DimensionChoices(Model.Settings).ToList();
    foreach (var extra in definition.Dimensions.Where(item => !dimensions.Contains(item)))
        dimensions.Add(extra);
    var policies = RubricDraft.ScoringChoices(Model.Settings).ToList();
    if (!string.IsNullOrEmpty(definition.ScoringPolicy.Type) && policies.All(policy => policy.Type != definition.ScoringPolicy.Type))
        policies.Add(new RubricScoringPolicySetting { Type = definition.ScoringPolicy.Type, RollupRequired = RubricDraft.RollupRequired(definition.ScoringPolicy.Type, Model.Settings) });
    var rollups = RubricDraft.RollupChoices(Model.Settings).ToList();
    if (!string.IsNullOrEmpty(definition.ScoringPolicy.Rollup) && !rollups.Contains(definition.ScoringPolicy.Rollup))
        rollups.Add(definition.ScoringPolicy.Rollup);
    var resourceTypes = Model.Settings?.FhirResourceTypes ?? [];
    var resources = definition.ApplicableContext?.FhirResources ?? [];
    var tags = definition.ApplicableContext?.WorkflowTags ?? [];
    var usedDimensions = definition.Checks.Select(check => check.Dimension).Where(item => !string.IsNullOrEmpty(item)).ToHashSet();
    var overwrite = Hold.Of(
        "Save over the other draft",
        "Replace the draft someone else just saved with the definition on this page.",
        "Their changes to this draft are lost.",
        "Hold to save");
}

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(backUrl, backLabel))" />
</div>
<partial name="_Nav" />
<h1 class="h3">@title</h1>
<partial name="_Alerts" />

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
@if (Model.Locked is not null)
{
    <div class="alert alert-warning">@Model.Locked</div>
    @if (!string.IsNullOrEmpty(Model.RubricId))
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-au-link" asp-action="RubricVersion" asp-route-rubricId="@Model.RubricId" asp-route-semver="@definition.Semver">View this version</a>
            <a class="btn btn-success" asp-action="NewRubricVersion" asp-route-rubricId="@Model.RubricId" asp-route-from="@definition.Semver">New version from this one</a>
        </div>
    }
}
@if (!showForm && !string.IsNullOrWhiteSpace(Model.Failure))
{
    <div class="alert alert-warning">@Model.Failure</div>
}

@if (showForm)
{
    <form id="rubricEditor" method="post" asp-action="@postAction" asp-route-rubricId="@Model.RubricId" asp-route-semver="@Model.RouteSemver" data-au-save autocomplete="off">
        <textarea name="definitionJson" hidden>@RubricJson.Write(definition)</textarea>
        <textarea name="baselineJson" hidden>@RubricJson.Write(Model.Baseline)</textarea>
        <textarea name="existingVersions" hidden>@string.Join("\n", Model.ExistingVersions)</textarea>
        <input type="hidden" name="savedChecksum" value="@Model.SavedChecksum" />
        <input type="hidden" name="savedSemver" value="@Model.SavedSemver" />
        <input type="hidden" name="mode" value="@Model.Mode" />
        <input type="hidden" name="editIndex" value="@Model.EditIndex" />
        @if (Model.EditIndex >= 0)
        {
            <input type="hidden" name="checkOpen" value="1" />
        }

        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="submit" class="btn btn-success" name="intent" value="save">Save draft</button>
            <button type="submit" class="btn btn-au-execute" name="intent" value="validate">Validate</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notice))
        {
            <div class="alert alert-success">@Model.Notice</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Failure))
        {
            <div class="alert alert-warning">@Model.Failure</div>
        }
        @if (Model.StaleDraft)
        {
            <div class="alert alert-warning">
                <p>Someone else saved this draft after you opened it. Reload their version, or save yours over it.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-au-link" name="intent" value="reload">Reload</button>
                    <button type="submit" class="btn btn-danger" name="intent" value="save-anyway" data-hold="@overwrite">Save mine anyway</button>
                </div>
            </div>
        }
        @if (Model.Issues.Count > 0)
        {
            <div class="alert alert-warning">
                <ul class="mb-0">
                    @foreach (var issue in Model.Issues)
                    {
                        <li>@issue.Message</li>
                    }
                </ul>
            </div>
        }

        <div class="au-card card mb-3">
            <div class="card-header">Details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="rubricId">Id</label>
                        @if (idEditable)
                        {
                            <input id="rubricId" name="id" value="@definition.Id" class="form-control" maxlength="@RubricDraft.MaxId" autocomplete="off" />
                        }
                        else
                        {
                            <p id="rubricId" class="form-control-plaintext mb-0">@definition.Id</p>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="rubricSemver">Version</label>
                        <input id="rubricSemver" name="semver" value="@definition.Semver" class="form-control" maxlength="@RubricDraft.MaxSemver" autocomplete="off" />
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="bump:major">Next major</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="bump:minor">Next minor</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="bump:patch">Next patch</button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="rubricTitle">Title</label>
                        <input id="rubricTitle" name="title" value="@definition.Title" class="form-control" maxlength="@RubricDraft.MaxTitle" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="rubricOwner">Owner</label>
                        <input id="rubricOwner" name="owner" value="@definition.Owner" class="form-control" maxlength="@RubricDraft.MaxOwner" />
                    </div>
                    <div class="col-12">
                        <p class="form-label">Dimensions</p>
                        @foreach (var dimension in dimensions)
                        {
                            var used = usedDimensions.Contains(dimension);
                            var on = used || definition.Dimensions.Contains(dimension);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="dimensions" value="@dimension" id="dim-@dimension" checked="@(on ? "checked" : null)" disabled="@(used ? "disabled" : null)" />
                                @if (used)
                                {
                                    <input type="hidden" name="dimensions" value="@dimension" />
                                }
                                <label class="form-check-label" for="dim-@dimension">@RubricText.DimensionLabel(dimension)</label>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="scoringType">Scoring</label>
                        <select id="scoringType" name="scoringType" class="form-select" onchange="var b=document.getElementById('applyOpenCheck'); if(b) b.click();">
                            @foreach (var policy in policies)
                            {
                                <option value="@policy.Type" selected="@(policy.Type == definition.ScoringPolicy.Type ? "selected" : null)">@RubricText.ScoringLabel(new RubricScoringPolicy { Type = policy.Type })</option>
                            }
                        </select>
                    </div>
                    @if (RubricDraft.RollupRequired(definition.ScoringPolicy.Type, Model.Settings))
                    {
                        <div class="col-md-6">
                            <label class="form-label" for="rollup">Roll-up</label>
                            <select id="rollup" name="rollup" class="form-select">
                                @foreach (var rollup in rollups)
                                {
                                    <option value="@rollup" selected="@(rollup == definition.ScoringPolicy.Rollup ? "selected" : null)">@RubricText.RollupLabel(rollup)</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <hr />
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="resourceType">Resource type</label>
                        @if (resourceTypes.Count > 0)
                        {
                            <select id="resourceType" name="resourceType" class="form-select">
                                <option value="">Choose a resource type</option>
                                @foreach (var resourceType in resourceTypes.Where(item => !resources.Contains(item)))
                                {
                                    <option value="@resourceType">@resourceType</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input id="resourceType" name="resourceType" class="form-control" maxlength="128" />
                        }
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success" name="intent" value="add-resource">Add resource type</button>
                    </div>
                </div>
                @if (resources.Count > 0)
                {
                    <ul class="mt-2 mb-0">
                        @for (var i = 0; i < resources.Count; i++)
                        {
                            <li>
                                @resources[i]
                                <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="remove-resource:@i">Remove</button>
                            </li>
                        }
                    </ul>
                }
                <div class="row g-2 align-items-end mt-2">
                    <div class="col-md-6">
                        <label class="form-label" for="workflowTag">Workflow tag</label>
                        <input id="workflowTag" name="workflowTag" class="form-control" maxlength="@RubricDraft.MaxWorkflowTag" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success" name="intent" value="add-tag">Add workflow tag</button>
                    </div>
                </div>
                @if (tags.Count > 0)
                {
                    <ul class="mt-2 mb-0">
                        @for (var i = 0; i < tags.Count; i++)
                        {
                            <li>
                                @tags[i]
                                <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="remove-tag:@i">Remove</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="au-card card mb-3">
            <div class="card-header">Checks</div>
            <div class="card-body">
                @if (definition.Checks.Count == 0)
                {
                    <p>This draft has no checks.</p>
                }
                @for (var i = 0; i < definition.Checks.Count; i++)
                {
                    var check = definition.Checks[i];
                    var deleteHold = Hold.Of(
                        "Delete this check",
                        "Remove " + (string.IsNullOrEmpty(check.Id) ? "this check" : "check " + check.Id) + " from the draft.",
                        "The check leaves this draft. Save the draft to keep the change.",
                        "Hold to delete");
                    <div class="border-bottom py-2">
                        <p class="mb-1">
                            <span class="badge @RubricText.SeverityBadge(check.SeverityOverride)">@RubricText.SeverityLabel(check.SeverityOverride)</span>
                            @(string.IsNullOrEmpty(check.Id) ? "(no id)" : check.Id)
                            <span class="text-muted">@RubricText.CheckTypeLabel(check.Type)</span>
                            @if (!RubricText.IsCheckEnabled(check))
                            {
                                <span class="badge au-badge-muted">Disabled</span>
                            }
                        </p>
                        <p class="mb-2">@RubricText.CheckSummary(check)</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="open-check:@i">Edit</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="move:@i:-1" disabled="@(i == 0 ? "disabled" : null)">Move up</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="move:@i:1" disabled="@(i == definition.Checks.Count - 1 ? "disabled" : null)">Move down</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="duplicate:@i">Duplicate</button>
                            <button type="submit" class="btn btn-sm btn-au-link" name="intent" value="toggle:@i">@(RubricText.IsCheckEnabled(check) ? "Disable" : "Enable")</button>
                            <button type="submit" class="btn btn-sm btn-danger" name="intent" value="delete-check:@i" data-hold="@deleteHold">Delete</button>
                        </div>
                    </div>
                }
                <partial name="_RubricCheckEditor" />
                <div class="row g-2 align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label" for="addType">New check</label>
                        <select id="addType" name="addType" class="form-select">
                            @foreach (var type in RubricDraft.FormTypes(Model.Settings))
                            {
                                <option value="@type">@RubricText.CheckTypeLabel(type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success" name="intent" value="add-check">Add check</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="au-card card mb-3">
            <div class="card-header">Definition</div>
            <div class="card-body">
                <label class="form-label" for="pasteText">Replace the definition with JSON</label>
                <textarea id="pasteText" name="pasteText" class="form-control" rows="6"></textarea>
                <p class="form-text">YAML is reviewed on the import page. Replacing the definition here does not save it.</p>
                <button type="submit" class="btn btn-au-link" name="intent" value="paste">Replace from JSON</button>
                <details class="mt-3">
                    <summary>Current definition</summary>
                    <textarea class="form-control mt-2" rows="12" readonly>@RubricJson.Write(definition)</textarea>
                </details>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-success" name="intent" value="save">Save draft</button>
            <button type="submit" class="btn btn-au-execute" name="intent" value="validate">Validate</button>
        </div>
    </form>
    <script>
        (function () {
            var form = document.getElementById("rubricEditor");
            if (!form) return;
            var definitionField = form.querySelector("[name=definitionJson]");
            var baselineField = form.querySelector("[name=baselineJson]");
            var dirty = !!(definitionField && baselineField && definitionField.value !== baselineField.value);
            form.addEventListener("input", function () { dirty = true; });
            form.addEventListener("change", function () { dirty = true; });
            form.addEventListener("submit", function () { dirty = false; });
            if (window.__rubricBeforeUnload)
                window.removeEventListener("beforeunload", window.__rubricBeforeUnload);
            window.__rubricBeforeUnload = function (event) {
                if (!dirty) return;
                event.preventDefault();
                event.returnValue = "";
            };
            window.addEventListener("beforeunload", window.__rubricBeforeUnload);
        })();
    </script>
}
