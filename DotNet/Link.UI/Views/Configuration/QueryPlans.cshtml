@model QueryPlanPage

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("Index")!, "Back to configuration"))" />
</div>
<partial name="_Nav" />
<h1 class="h3">Query plans</h1>
<partial name="_Alerts" />
<p class="text-muted">Query plans are saved on each facility. This page shows whether the four plan types exist, then opens the facility editor.</p>

<div class="au-card card mb-3">
    <div class="card-header">Facility</div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="facilityId">Facility id</label>
                <input id="facilityId" name="facilityId" value="@Model.FacilityId" class="form-control" required />
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-au-execute">Look up</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

@if (Model.Plans.Count > 0)
{
    <div class="au-card card">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">Plans for <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = Model.FacilityId, Compact = true, CopyLabel = "Copy facility id" })" /></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 lu-wide-table">
                    <thead>
                        <tr>
                            <th scope="col">Type</th>
                            <th scope="col">Saved</th>
                            <th scope="col"><span class="visually-hidden">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var plan in Model.Plans)
                    {
                        <tr>
                            <td>@plan.Type</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(plan.Error))
                                {
                                    <span class="text-warning">@plan.Error</span>
                                }
                                else if (plan.Saved)
                                {
                                    <span>Saved</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not saved</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-au-link lu-icon-btn" asp-controller="Tenants" asp-action="Facility" asp-route-id="@Model.FacilityId" asp-route-planType="@plan.Type" title="Open editor" aria-label="Open editor"><i class="bi bi-pencil" aria-hidden="true"></i><span class="ms-1">Open</span></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
