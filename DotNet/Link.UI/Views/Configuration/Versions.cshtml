@model VendorVersionPage

<div class="mb-3">
    <a class="btn btn-sm btn-au-neutral" asp-action="Vendors"><i class="bi bi-arrow-left me-1"></i>Vendors</a>
</div>
<partial name="_Nav" />
<h1 class="h3">Vendor versions</h1>
<partial name="_Alerts" />
<p class="mb-3">Vendor: <strong>@Model.VendorName</strong></p>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<div class="au-card card mb-3 d-none" id="versionCreate" data-lu-panel data-lu-hide-on-cancel>
    <div class="card-header">New version for @Model.VendorName</div>
    <div class="card-body">
        <form method="post" data-au-save asp-action="SaveVersion" asp-route-vendorId="@Model.VendorId" class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="version">New version</label>
                <input id="version" name="version" class="form-control" maxlength="255" required />
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-success">Save</button>
                <button type="button" class="btn btn-au-neutral" data-lu-cancel>Cancel</button>
            </div>
        </form>
    </div>
</div>

<div class="au-card card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Versions</span>
        <button type="button" class="btn btn-sm btn-success" data-lu-reveal="versionCreate">+ Add</button>
    </div>
    <div class="card-body">
        @if (Model.Versions.Count == 0)
        {
            <p class="mb-0">No versions yet. Add the first version for this vendor.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 lu-wide-table">
                    <thead>
                        <tr>
                            <th scope="col">Version</th>
                            <th scope="col"><span class="visually-hidden">Save</span></th>
                            <th scope="col"><span class="visually-hidden">Delete</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Versions)
                    {
                        var formId = "version-" + row.Id;
                        <tr>
                            <td>
                                <input form="@formId" name="version" value="@row.Version" class="form-control form-control-sm" maxlength="255" required aria-label="Version @row.Version" />
                            </td>
                            <td>
                                <form id="@formId" method="post" data-au-save data-lu-panel asp-action="SaveVersion" asp-route-vendorId="@Model.VendorId">
                                    <input type="hidden" name="versionId" value="@row.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Save</button>
                                    <button type="button" class="btn btn-sm btn-au-neutral" data-lu-cancel>Cancel</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" data-au-save asp-action="DeleteVersion" asp-route-versionId="@row.Id" asp-route-vendorId="@Model.VendorId" onsubmit="return confirm('Delete this version?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
