@model HomeOverviewModel
@{
    var facilities = Model.Facilities;
    var reports = Model.Reports;
    var health = Model.Health;
    var runs = Model.Runs;
    var logs = Model.Logs;
}

<div id="homeOverview">
    @if (!facilities.Reachable)
    {
        <div class="alert alert-warning">@facilities.Message</div>
    }
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <a class="au-kpi-card au-kpi-link" asp-controller="Tenants" asp-action="Index">
                <div class="au-kpi-value">@facilities.TotalText</div>
                <div class="au-kpi-label">Facilities</div>
                @if (LinkUiFeatures.Value.AutomationEnabled && facilities.Reachable && facilities.Automation is int automation && facilities.Regular is int regular)
                {
                    <div class="au-kpi-note">@automation automation · @regular regular</div>
                }
                else if (facilities.Reachable && facilities.Message is not null)
                {
                    <div class="au-kpi-note">@facilities.Message</div>
                }
            </a>
        </div>
        @if (LinkUiFeatures.Value.AutomationEnabled)
        {
            <div class="col-6 col-md-3">
                <a class="au-kpi-card au-kpi-link au-kpi-auto" asp-controller="Tenants" asp-action="Index" asp-route-scope="automation">
                    <div class="au-kpi-value">@facilities.AutomationText</div>
                    <div class="au-kpi-label">Automation</div>
                    <div class="au-kpi-note">Owned facilities</div>
                </a>
            </div>
        }
        @if (LinkUiFeatures.Value.AutomationEnabled)
        {
            <div class="col-6 col-md-3">
                <a class="au-kpi-card au-kpi-link" asp-controller="Automation" asp-action="Index">
                    <div class="au-kpi-value">@runs.ActiveText</div>
                    <div class="au-kpi-label">Active runs</div>
                    <div class="au-kpi-note">Open the runs dashboard</div>
                </a>
            </div>
        }
        <div class="col-6 col-md-3">
            <a class="au-kpi-card au-kpi-link @(health.Reachable && health.Unhealthy > 0 ? "au-kpi-bad" : "")" asp-controller="System" asp-action="Health">
                <div class="au-kpi-value">@health.UnhealthyText</div>
                <div class="au-kpi-label">Unhealthy</div>
                <div class="au-kpi-note">@(health.Reachable ? $"{health.Healthy} healthy" : "Service health")</div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Reports" asp-action="Index">Recent reports</a>
                    <a class="home-card-link small" asp-controller="Reports" asp-action="Index">Open</a>
                </div>
                <div class="card-body">
                    @if (!reports.Reachable)
                    {
                        <div class="alert alert-warning mb-0">@reports.Message</div>
                    }
                    else if (reports.Rows.Count == 0)
                    {
                        <p class="mb-0 text-muted">No reports.</p>
                    }
                    else
                    {
                        foreach (var report in reports.Rows)
                        {
                            <a class="home-row" asp-controller="Tenants" asp-action="Report" asp-route-id="@report.FacilityId" asp-route-reportId="@report.Id">
                                <span class="badge @report.Badge">@report.Status</span>
                                <code class="lu-facility-id">@report.FacilityId</code>
                                <partial name="_AutomationBadge" model="report.AutomationRunId" />
                                <span class="text-muted small">@report.When</span>
                            </a>
                        }
                        <p class="small text-muted mt-2 mb-0">@reports.Total total</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="System" asp-action="Health">Service health</a>
                    <a class="home-card-link small" asp-controller="System" asp-action="Health">Open</a>
                </div>
                <div class="card-body">
                    @if (!health.Reachable)
                    {
                        <div class="alert alert-warning">@health.Message</div>
                    }
                    else if (health.Healthy == 0 && health.Unhealthy == 0)
                    {
                        <p class="text-muted">No service reports.</p>
                    }
                    else
                    {
                        <p class="mb-2">@health.Healthy healthy · @health.Unhealthy unhealthy</p>
                        @if (health.UnhealthyNames.Count == 0)
                        {
                            <p class="mb-2 text-muted">Every reported service is healthy.</p>
                        }
                        else
                        {
                            <ul class="mb-2 ps-3">
                                @foreach (var name in health.UnhealthyNames)
                                {
                                    <li>@name</li>
                                }
                            </ul>
                            @if (health.HiddenUnhealthy > 0)
                            {
                                <p class="small text-muted mb-2">@health.HiddenUnhealthy more</p>
                            }
                        }
                    }
                    @if (LinkUiFeatures.Value.AutomationEnabled)
                    {
                        <p class="mb-0">
                            @if (health.ApiHealthReachable)
                            {
                                <a asp-controller="ApiHealth" asp-action="Index">@health.ApiHealthText</a>
                            }
                            else
                            {
                                <span class="text-muted">@health.ApiHealthText</span>
                            }
                        </p>
                    }
                </div>
            </div>
        </div>

        @if (LinkUiFeatures.Value.AutomationEnabled)
        {
        <div class="col-12 col-lg-6">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Automation" asp-action="Index">Automation runs</a>
                    <a class="home-card-link small" asp-controller="Automation" asp-action="Index">Open</a>
                </div>
                <div class="card-body">
                    @if (!runs.Reachable)
                    {
                        <div class="alert alert-warning mb-0">@runs.Message</div>
                    }
                    else if (runs.Active.Count == 0 && runs.Recent.Count == 0)
                    {
                        <p class="mb-0 text-muted">No runs yet.</p>
                    }
                    else
                    {
                        @if (runs.Active.Count > 0)
                        {
                            <div class="small text-uppercase text-muted fw-semibold mb-1">Active</div>
                            foreach (var run in runs.Active)
                            {
                                <a class="home-row" asp-controller="Automation" asp-action="Run" asp-route-id="@run.Id">
                                    <span class="badge @run.Badge">@run.Status</span>
                                    <span class="home-name">@run.Name</span>
                                    <span class="text-muted small">@run.When</span>
                                </a>
                            }
                        }
                        @if (runs.Recent.Count > 0)
                        {
                            <div class="small text-uppercase text-muted fw-semibold mt-3 mb-1">Recent</div>
                            foreach (var run in runs.Recent)
                            {
                                <a class="home-row" asp-controller="Automation" asp-action="Run" asp-route-id="@run.Id">
                                    <span class="badge @run.Badge">@run.Status</span>
                                    <span class="home-name">@run.Name</span>
                                    <span class="text-muted small">@run.When</span>
                                </a>
                            }
                        }
                    }
                </div>
            </div>
        </div>
        }

        <div class="col-12 col-lg-6">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Logs" asp-action="Acquisition" asp-route-status="Failed,MaxRetriesReached">Failed acquisition logs</a>
                    <a class="home-card-link small" asp-controller="Logs" asp-action="Acquisition" asp-route-status="Failed,MaxRetriesReached">Open</a>
                </div>
                <div class="card-body">
                    @if (!logs.Reachable)
                    {
                        <div class="alert alert-warning">@logs.Message</div>
                    }
                    else if (logs.Rows.Count == 0)
                    {
                        <p class="text-muted">No failed acquisition logs.</p>
                    }
                    else
                    {
                        foreach (var row in logs.Rows)
                        {
                            <a class="home-row" asp-controller="Logs" asp-action="AcquisitionDetail" asp-route-id="@row.Id">
                                <span class="badge @row.Badge">@row.Status</span>
                                <code class="lu-facility-id">@row.FacilityId</code>
                                <partial name="_AutomationBadge" model="row.AutomationRunId" />
                                <span class="text-muted small">@row.When</span>
                            </a>
                        }
                        <p class="small text-muted mt-2 mb-0">@logs.Total failed</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(logs.AuditMessage))
                    {
                        <div class="alert alert-warning mb-0 @(logs.Reachable && logs.Rows.Count == 0 ? "" : "mt-3")">@logs.AuditMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
