@model HomeOverviewModel
@{
    var facilities = Model.Facilities;
    var reports = Model.Reports;
    var health = Model.Health;
    var logs = Model.Logs;
    var activity = Model.Activity;
    var pulse = Model.Pulse;
    var trendMax = activity.Trend.Where(day => day.Reachable).Select(day => day.Count).DefaultIfEmpty(0).Max();
    var trendTotal = activity.Trend.Where(day => day.Reachable).Sum(day => day.Count);
    var trendKnown = activity.Trend.Any(day => day.Reachable);
    var origin = ReturnUrlRules.Here(Context.Request);
}

<div id="homeOverview">
    @if (!facilities.Reachable)
    {
        <div class="alert alert-warning">@facilities.Message</div>
    }
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link" asp-controller="Tenants" asp-action="Index" asp-route-scope="@Model.RealScope" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@HomeOverviewRules.PrimaryFacilityText(facilities, Model.AutomationVisible)</div>
                <div class="au-kpi-label">@HomeOverviewRules.PrimaryFacilityLabel(facilities, Model.AutomationVisible)</div>
                @if (facilities.Reachable)
                {
                    <div class="au-kpi-note">Open the facility list</div>
                }
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link" asp-controller="Reports" asp-action="Index" asp-route-status="New,Scheduled,EndOfPeriod" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@activity.InFlightText</div>
                <div class="au-kpi-label">In flight</div>
                <div class="au-kpi-note">New, scheduled, or end of period</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link" asp-controller="Reports" asp-action="Index" asp-route-status="Submitted" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@activity.SubmittedText</div>
                <div class="au-kpi-label">Submitted</div>
                <div class="au-kpi-note">Reports that were submitted</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link @(activity.CompletedReachable && activity.CompletedNotSubmitted > 0 ? "au-kpi-auto" : "")" asp-controller="Reports" asp-action="Index" asp-route-status="CompletedNotSubmitted" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@activity.CompletedText</div>
                <div class="au-kpi-label">Not submitted</div>
                <div class="au-kpi-note">Completed, still to send</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link @(logs.Reachable && logs.Total > 0 ? "au-kpi-bad" : "")" asp-controller="Logs" asp-action="Acquisition" asp-route-status="Failed,MaxRetriesReached" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@logs.TotalText</div>
                <div class="au-kpi-label">Failed acquisition</div>
                <div class="au-kpi-note">Open the filtered logs</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <a class="au-kpi-card au-kpi-link @(health.Reachable && health.Unhealthy > 0 ? "au-kpi-bad" : "")" asp-controller="System" asp-action="Health" asp-route-returnUrl="@origin">
                <div class="au-kpi-value">@health.UnhealthyText</div>
                <div class="au-kpi-label">Unhealthy</div>
                <div class="au-kpi-note">@(health.Reachable ? $"{health.Healthy} healthy" : "Service health")</div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Reports" asp-action="Index" asp-route-returnUrl="@origin">Reports created</a>
                    <a class="btn btn-sm btn-au-neutral" asp-controller="Reports" asp-action="Index">Open</a>
                </div>
                <div class="card-body">
                    @if (!trendKnown)
                    {
                        <p class="mb-0 text-muted">Report counts could not be read for these days.</p>
                    }
                    else
                    {
                        @if (trendTotal == 0)
                        {
                            <p class="text-muted">No reports were created in the last seven days.</p>
                        }
                        <p class="small text-muted mb-2">UTC days</p>
                        <div class="home-trend">
                            @foreach (var day in activity.Trend)
                            {
                                var percent = day.Reachable ? HomeOverviewRules.BarPercent(day.Count, trendMax) : 0;
                                <a class="home-trend-link" asp-controller="Reports" asp-action="Index" asp-route-created="@day.Day" asp-route-returnUrl="@origin" title="@day.Day UTC">
                                    <span class="home-trend-plot" aria-hidden="true">
                                        <span class="home-trend-bar" style="height:@(percent)%"></span>
                                    </span>
                                    <span class="home-trend-count">@day.CountText</span>
                                    <span class="home-trend-day">@day.Day</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="au-card card h-100 mb-0">
                <div class="card-header">Needs attention</div>
                <div class="card-body">
                    @if (Model.Issues.Count == 0)
                    {
                        <p class="mb-0 text-muted">Nothing needs attention right now.</p>
                    }
                    else
                    {
                        foreach (var issue in Model.Issues)
                        {
                            <a class="home-issue" href="@ReturnUrlRules.WithReturn(issue.Href, origin)">
                                <span class="home-issue-title">@issue.Title</span>
                                @if (!string.IsNullOrWhiteSpace(issue.Detail))
                                {
                                    <span class="home-issue-detail">@issue.Detail</span>
                                }
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        @{
            var acquisitionMax = logs.Trend.Where(day => day.Reachable).Select(day => day.Count).DefaultIfEmpty(0).Max();
            var acquisitionTotal = logs.Trend.Where(day => day.Reachable).Sum(day => day.Count);
        }
        <div class="col-12 col-lg-7">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Logs" asp-action="Acquisition">Acquisition throughput</a>
                    <a class="btn btn-sm btn-au-neutral" asp-controller="Logs" asp-action="Acquisition">Open</a>
                </div>
                <div class="card-body">
                    @if (!logs.TrendReachable)
                    {
                        <div class="alert alert-warning mb-0">@(string.IsNullOrWhiteSpace(logs.Message) ? "Acquisition counts could not be read." : logs.Message)</div>
                    }
                    else
                    {
                        @if (acquisitionTotal == 0)
                        {
                            <p class="text-muted">No acquisition logs in the last seven UTC days.</p>
                        }
                        <p class="small text-muted mb-2">UTC days</p>
                        <div class="home-trend">
                            @foreach (var day in logs.Trend)
                            {
                                var percent = day.Reachable ? HomeOverviewRules.BarPercent(day.Count, acquisitionMax) : 0;
                                <a class="home-trend-link" asp-controller="Logs" asp-action="Acquisition" title="@day.Day UTC, @day.Failed failed">
                                    <span class="home-trend-plot" aria-hidden="true">
                                        <span class="home-trend-bar" style="height:@(percent)%"></span>
                                    </span>
                                    <span class="home-trend-count">@day.CountText</span>
                                    <span class="home-trend-day">@day.Day</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Logs" asp-action="Audit">Audit errors</a>
                    <a class="btn btn-sm btn-au-neutral" asp-controller="Logs" asp-action="Audit">Open</a>
                </div>
                <div class="card-body">
                    @if (!logs.AuditCounted)
                    {
                        <div class="alert alert-warning mb-0">@(string.IsNullOrWhiteSpace(logs.AuditMessage) ? "Audit could not be reached." : logs.AuditMessage)</div>
                    }
                    else
                    {
                        <a class="au-kpi-card au-kpi-link @(logs.AuditErrors > 0 ? "au-kpi-bad" : "")" asp-controller="Logs" asp-action="Audit">
                            <div class="au-kpi-value">@logs.AuditErrorsText</div>
                            <div class="au-kpi-label">Last 24 hours</div>
                            <div class="au-kpi-note">Notes that record a failure. UTC window.</div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="au-card card mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    @if (Model.AutomationVisible)
                    {
                        <a class="home-card-link" asp-controller="Metrics" asp-action="Index">Service health</a>
                        <a class="btn btn-sm btn-au-neutral" asp-controller="Metrics" asp-action="Index">Open</a>
                    }
                    else
                    {
                        <a class="home-card-link" asp-controller="System" asp-action="Health">Service health</a>
                        <a class="btn btn-sm btn-au-neutral" asp-controller="System" asp-action="Health">Open</a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.AutomationVisible)
                    {
                        if (!pulse.Reachable)
                        {
                            <div class="alert alert-warning">@(string.IsNullOrWhiteSpace(pulse.Message) ? "Service metrics could not be read." : pulse.Message)</div>
                        }
                        else
                        {
                            <partial name="_ServiceMonitor" model="@(new ServiceMonitorModel(Url.Action("LiveUtilization", "Metrics")!, compact: true, healthUrl: Url.Action("HealthStatus", "System")))" />
                        }
                    }
                    <div class="au-pulse-actions">
                        @if (health.Reachable)
                        {
                            <a class="btn btn-sm btn-au-neutral" asp-controller="System" asp-action="Health">@health.Healthy healthy · @health.Unhealthy unhealthy</a>
                        }
                        else
                        {
                            <span class="text-muted">@health.Message</span>
                        }
                        @if (Model.AutomationVisible)
                        {
                            if (health.ApiHealthReachable)
                            {
                                <a class="btn btn-sm btn-au-neutral" asp-controller="ApiHealth" asp-action="Index">@health.ApiHealthText</a>
                            }
                            else
                            {
                                <span class="text-muted">@health.ApiHealthText</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="au-card card h-100 mb-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a class="home-card-link" asp-controller="Reports" asp-action="Index">Latest reports</a>
                    <a class="btn btn-sm btn-au-neutral" asp-controller="Reports" asp-action="Index">Open</a>
                </div>
                <div class="card-body">
                    @if (!reports.Reachable)
                    {
                        <div class="alert alert-warning mb-0">@reports.Message</div>
                    }
                    else if (reports.Rows.Count == 0)
                    {
                        <p class="mb-0 text-muted">No reports yet.</p>
                    }
                    else
                    {
                        foreach (var report in reports.Rows)
                        {
                            <div class="home-row">
                                <span class="badge @report.Badge">@report.Status</span>
                                <span class="home-row-main">
                                    <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = report.FacilityId, CopyLabel = "Copy facility id", LinkHref = Url.Action("Report", "Tenants", new { id = report.FacilityId, reportId = report.Id }), ReturnUrl = origin })" />
                                    <partial name="_LabeledId" model="@(new LabeledId { Label = "Report", Value = report.Id, CopyLabel = "Copy report id", LinkHref = Url.Action("Report", "Tenants", new { id = report.FacilityId, reportId = report.Id }), ReturnUrl = origin })" />
                                    <partial name="_AutomationBadge" model="report.AutomationRunId" />
                                </span>
                                <a class="home-row-time text-muted small" asp-controller="Tenants" asp-action="Report" asp-route-id="@report.FacilityId" asp-route-reportId="@report.Id" asp-route-returnUrl="@origin">@report.When</a>
                            </div>
                        }
                        <p class="small text-muted mt-2 mb-0">@reports.Total total</p>
                    }
                </div>
            </div>
        </div>

        @if (Model.AutomationVisible)
        {
            var runs = Model.Runs;
            <div class="col-12 col-lg-6">
                <div class="au-card card h-100 mb-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <a class="home-card-link" asp-controller="Automation" asp-action="Index">Automation</a>
                        <a class="btn btn-sm btn-au-neutral" asp-controller="Automation" asp-action="Index">Open</a>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <a class="au-kpi-card au-kpi-link au-kpi-auto" asp-controller="Tenants" asp-action="Index" asp-route-scope="automation">
                                    <div class="au-kpi-value">@facilities.AutomationText</div>
                                    <div class="au-kpi-label">Owned facilities</div>
                                    @if (facilities.Reachable && facilities.Message is not null)
                                    {
                                        <div class="au-kpi-note">@facilities.Message</div>
                                    }
                                </a>
                            </div>
                            <div class="col-6">
                                <a class="au-kpi-card au-kpi-link" asp-controller="Automation" asp-action="Index">
                                    <div class="au-kpi-value">@runs.ActiveText</div>
                                    <div class="au-kpi-label">Active runs</div>
                                </a>
                            </div>
                        </div>
                        @if (!runs.Reachable)
                        {
                            <div class="alert alert-warning mb-0">@runs.Message</div>
                        }
                        else if (runs.Active.Count == 0 && runs.Recent.Count == 0)
                        {
                            <p class="mb-0 text-muted">No runs yet.</p>
                        }
                        else
                        {
                            foreach (var run in runs.Active.Concat(runs.Recent).Take(HomeOverviewRules.RowLimit))
                            {
                                <div class="home-row">
                                    <span class="badge @run.Badge">@(string.IsNullOrWhiteSpace(run.Status) ? "Unknown" : run.Status)</span>
                                    <span class="home-row-main">
                                        <a class="home-name" asp-controller="Automation" asp-action="Run" asp-route-id="@run.Id" asp-route-returnUrl="@origin">@run.Name</a>
                                        <partial name="_LabeledId" model="@(new LabeledId { Label = "Run", Value = run.Id, CopyLabel = "Copy run id", LinkHref = Url.Action("Run", "Automation", new { id = run.Id }), ReturnUrl = origin })" />
                                    </span>
                                    <span class="home-row-time text-muted small">@run.When</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <p class="small text-muted mt-3 mb-0">Checked @LinkUiTime.Display(Model.LoadedAt)</p>
</div>
