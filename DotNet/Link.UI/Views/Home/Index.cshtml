@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-1">Dashboard</h1>
<p class="text-muted mb-2">What is moving through the system, and where to look when something is wrong.</p>
<p class="lu-live-label mb-3">This overview updates on its own.</p>

<div id="homeOverview" data-au-refresh="15000" data-au-refresh-url="@Url.Action("Overview", "Home")">
    <p class="text-muted mb-0">Loading overview…</p>
</div>

@section Scripts {
    <script src="~/js/live-utilization.js" asp-append-version="true"></script>
}
