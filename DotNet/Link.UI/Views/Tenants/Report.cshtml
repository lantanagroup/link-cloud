@model ReportDetailModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ReportId) ? "Report" : Model.ReportId;
}

@{
    ViewData["FacilityId"] = Model.FacilityId;
    ViewData["FacilityName"] = Model.FacilityName;
    ViewData["ReportId"] = Model.ReportId;
    ViewData["ReportSection"] = "report";
}
<div class="mb-3 d-flex flex-wrap gap-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("View", new { id = Model.FacilityId, section = "reports" })!, "Back to facility"))" />
</div>

@if (TempData["Message"] is string saved)
{
    <div class="alert alert-success">@saved</div>
}
@if (TempData["Error"] is string actionError)
{
    <div class="alert alert-warning">@actionError</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ReportId))
{
    <partial name="_ReportNav" />
    <h1 class="h3">Report</h1>
    <partial name="_ReportIdentity" />
}
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.NotFound || Model.Report is null)
{
    <div class="au-card card">
        <div class="card-header">Report</div>
        <div class="card-body"><p class="mb-0">That report was not found.</p></div>
    </div>
}
else
{
    var report = Model.Report;
    @if (report.CanDownload)
    {
        <div class="mb-3">
            <a class="btn btn-au-link" asp-controller="Reports" asp-action="Download" asp-route-facilityId="@Model.FacilityId" asp-route-reportId="@Model.ReportId">Download</a>
        </div>
    }
    <partial name="_ReportLive" model="Model" />
}
