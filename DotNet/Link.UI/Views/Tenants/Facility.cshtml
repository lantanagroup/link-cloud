@model Link.UI.Models.FacilityHubViewModel
@{
    var heading = Model.IsCreate ? "New facility" : (Model.FacilityName ?? Model.FacilityId ?? "Facility");
    ViewData["Title"] = heading;
}

<div class="mb-3">
    <a asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back to tenants</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.NotFound)
{
    <div class="au-card card">
        <div class="card-header">Facility</div>
        <div class="card-body">
            <p class="mb-0">No facility named <code class="lu-facility-id">@Model.FacilityId</code> was found.</p>
        </div>
    </div>
}
else
{
    <div class="au-card card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@heading</span>
            @if (!Model.IsCreate)
            {
                <span class="badge text-bg-secondary">LinkSDK</span>
            }
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.FormError))
            {
                <div class="alert alert-warning">@Model.FormError</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.VendorWarning))
            {
                <div class="alert alert-warning">@Model.VendorWarning</div>
            }

            <form method="post" asp-action="@(Model.IsCreate ? "Create" : "SaveFacility")" asp-route-id="@Model.FacilityId">
                @if (!Model.IsCreate)
                {
                    <input type="hidden" name="FacilityId" value="@Model.FacilityId" />
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="facilityId">Facility ID</label>
                        @if (Model.IsCreate)
                        {
                            <input id="facilityId" name="FacilityId" value="@Model.FacilityId" class="form-control" required maxlength="64" />
                        }
                        else
                        {
                            <input id="facilityId" class="form-control" value="@Model.FacilityId" readonly />
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="facilityName">Facility name</label>
                        <input id="facilityName" name="FacilityName" value="@Model.FacilityName" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="timeZone">Timezone</label>
                        <select id="timeZone" name="TimeZone" class="form-select" required>
                            <option value="">Select a timezone</option>
                            @foreach (var zone in Model.TimeZones)
                            {
                                if (string.Equals(zone, Model.TimeZone, StringComparison.Ordinal))
                                {
                                    <option value="@zone" selected>@zone</option>
                                }
                                else
                                {
                                    <option value="@zone">@zone</option>
                                }
                            }
                        </select>
                        <div class="form-text">IANA ids, for example America/Chicago.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="vendorVersionId">Vendor</label>
                        @if (Model.VendorListLoaded)
                        {
                            <select id="vendorVersionId" name="VendorVersionId" class="form-select">
                                <option value="">None</option>
                                @foreach (var vendor in Model.Vendors)
                                {
                                    if (string.Equals(vendor.Id.ToString(), Model.VendorVersionId, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@vendor.Id" selected>@vendor.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@vendor.Id">@vendor.Label</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            <input type="hidden" name="VendorVersionId" value="@Model.VendorVersionId" />
                            <input id="vendorVersionId" class="form-control" value="@(Model.VendorVersionId ?? "Not loaded")" readonly />
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <div class="fw-semibold mb-1">Scheduled reports</div>
                    @if (Model.DmrpEnabled)
                    {
                        <p class="text-muted mb-0">
                            Scheduled reports for this facility come from its DMRP reporting plans and cannot be set here.
                        </p>
                        @if (!Model.IsCreate && HasReports(Model))
                        {
                            <ul class="mb-0 mt-2">
                                <li>Daily: @(string.IsNullOrWhiteSpace(Model.DailyReports) ? "none" : Model.DailyReports)</li>
                                <li>Weekly: @(string.IsNullOrWhiteSpace(Model.WeeklyReports) ? "none" : Model.WeeklyReports)</li>
                                <li>Monthly: @(string.IsNullOrWhiteSpace(Model.MonthlyReports) ? "none" : Model.MonthlyReports)</li>
                            </ul>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Comma-separated measure ids. The same id cannot appear in more than one period.</p>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="dailyReports">Daily</label>
                                <input id="dailyReports" name="DailyReports" value="@Model.DailyReports" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="weeklyReports">Weekly</label>
                                <input id="weeklyReports" name="WeeklyReports" value="@Model.WeeklyReports" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="monthlyReports">Monthly</label>
                                <input id="monthlyReports" name="MonthlyReports" value="@Model.MonthlyReports" class="form-control" />
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-au-action">@(Model.IsCreate ? "Create facility" : "Save facility")</button>
                </div>
            </form>

            @if (!Model.IsCreate)
            {
                <form method="post" asp-action="Remove" asp-route-id="@Model.FacilityId" class="mt-3" onsubmit="return confirm('Remove this facility?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove facility</button>
                </form>
            }
        </div>
    </div>

    @if (!Model.IsCreate)
    {
        <div class="accordion" id="facilityPanels">
            <div class="accordion-item">
                <h2 class="accordion-header" id="censusHeading">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#censusPanel" aria-expanded="true" aria-controls="censusPanel">
                        Census configuration
                    </button>
                </h2>
                <div id="censusPanel" class="accordion-collapse collapse show" aria-labelledby="censusHeading">
                    <div class="accordion-body">
                        @if (!Model.CensusConfigured)
                        {
                            <p class="text-muted mb-0">Census service URL is not configured (ServiceRegistry:CensusServiceUrl).</p>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.CensusError))
                            {
                                <div class="alert alert-warning">@Model.CensusError</div>
                            }
                            else if (!Model.CensusExists)
                            {
                                <div class="alert alert-info">No census configuration for this facility.</div>
                            }
                            <form method="post" asp-action="SaveCensus" asp-route-id="@Model.FacilityId">
                                <input type="hidden" name="censusExists" value="@(Model.CensusExists ? "true" : "false")" />
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="censusEnabled" name="enabled" value="true" @(Model.CensusEnabled ? "checked" : null) />
                                    <label class="form-check-label" for="censusEnabled">Enabled</label>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="scheduledTrigger">Scheduled trigger</label>
                                    <input id="scheduledTrigger" name="scheduledTrigger" value="@Model.CensusTrigger" class="form-control" placeholder="0 0 6 * * ?" />
                                    <div class="form-text">Quartz cron expression.</div>
                                </div>
                                <button type="submit" class="btn btn-au-action">@(Model.CensusExists ? "Save census" : "Add census")</button>
                            </form>
                            @if (Model.CensusExists)
                            {
                                <form method="post" asp-action="DeleteCensus" asp-route-id="@Model.FacilityId" class="mt-2" onsubmit="return confirm('Delete the census configuration?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete census</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="dispatchHeading">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#dispatchPanel" aria-expanded="true" aria-controls="dispatchPanel">
                        Query dispatch configuration
                    </button>
                </h2>
                <div id="dispatchPanel" class="accordion-collapse collapse show" aria-labelledby="dispatchHeading">
                    <div class="accordion-body">
                        @if (!Model.QueryDispatchConfigured)
                        {
                            <p class="text-muted mb-0">Query dispatch service URL is not configured (ServiceRegistry:QueryDispatchServiceUrl).</p>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.QueryDispatchError))
                            {
                                <div class="alert alert-warning">@Model.QueryDispatchError</div>
                            }
                            else if (!Model.QueryDispatchExists)
                            {
                                <div class="alert alert-info">No query dispatch configuration for this facility.</div>
                            }
                            <form method="post" asp-action="SaveQueryDispatch" asp-route-id="@Model.FacilityId">
                                <input type="hidden" name="queryDispatchExists" value="@(Model.QueryDispatchExists ? "true" : "false")" />
                                @for (var i = 0; i < Model.Schedules.Count; i++)
                                {
                                    <div class="row g-2 align-items-end mb-2">
                                        <div class="col-12 col-md-5">
                                            <label class="form-label" for="event-@i">Event</label>
                                            <input id="event-@i" name="Schedules[@i].Event" value="@Model.Schedules[i].Event" class="form-control" />
                                        </div>
                                        <div class="col-12 col-md-5">
                                            <label class="form-label" for="duration-@i">Duration</label>
                                            <input id="duration-@i" name="Schedules[@i].Duration" value="@Model.Schedules[i].Duration" class="form-control" placeholder="PT10S" />
                                        </div>
                                        <div class="col-12 col-md-2">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox" id="remove-@i" name="Schedules[@i].Remove" value="true" />
                                                <label class="form-check-label" for="remove-@i">Remove</label>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <p class="form-text">Leave the last row blank to ignore it. Check Remove to drop a row on save.</p>
                                <button type="submit" class="btn btn-au-action">@(Model.QueryDispatchExists ? "Save query dispatch" : "Add query dispatch")</button>
                            </form>
                            @if (Model.QueryDispatchExists)
                            {
                                <form method="post" asp-action="DeleteQueryDispatch" asp-route-id="@Model.FacilityId" class="mt-2" onsubmit="return confirm('Delete the query dispatch configuration?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete query dispatch</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <p class="text-muted small mt-3 mb-0">
            Data acquisition and normalization stay on the next slice. This page saves facility identity, census, and query dispatch.
        </p>
    }
}

@functions {
    private static bool HasReports(FacilityHubViewModel model) =>
        !string.IsNullOrWhiteSpace(model.DailyReports)
        || !string.IsNullOrWhiteSpace(model.WeeklyReports)
        || !string.IsNullOrWhiteSpace(model.MonthlyReports);
}
