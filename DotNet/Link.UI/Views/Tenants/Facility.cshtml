@model Link.UI.Models.FacilityHubViewModel
@{
    var heading = Model.IsCreate ? "New facility" : (Model.FacilityName ?? Model.FacilityId ?? "Facility");
    ViewData["Title"] = heading;
}

<div class="mb-3">
    <a asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back to tenants</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.NotFound)
{
    <div class="au-card card">
        <div class="card-header">Facility</div>
        <div class="card-body">
            <p class="mb-0">No facility named <code class="lu-facility-id">@Model.FacilityId</code> was found.</p>
        </div>
    </div>
}
else
{
    <div class="au-card card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@heading</span>
            @if (!Model.IsCreate)
            {
                <span class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="View" asp-route-id="@Model.FacilityId">View</a>
                    <span class="badge text-bg-secondary">LinkSDK</span>
                </span>
            }
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.FormError))
            {
                <div class="alert alert-warning">@Model.FormError</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.VendorWarning))
            {
                <div class="alert alert-warning">@Model.VendorWarning</div>
            }

            <form method="post" data-au-save asp-action="@(Model.IsCreate ? "Create" : "SaveFacility")" asp-route-id="@Model.FacilityId">
                @if (!Model.IsCreate)
                {
                    <input type="hidden" name="FacilityId" value="@Model.FacilityId" />
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="facilityId">Facility ID</label>
                        @if (Model.IsCreate)
                        {
                            <input id="facilityId" name="FacilityId" value="@Model.FacilityId" class="form-control" required maxlength="64" />
                        }
                        else
                        {
                            <input id="facilityId" class="form-control" value="@Model.FacilityId" readonly />
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="facilityName">Facility name</label>
                        <input id="facilityName" name="FacilityName" value="@Model.FacilityName" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="timeZone">Timezone</label>
                        <select id="timeZone" name="TimeZone" class="form-select" required>
                            <option value="">Select a timezone</option>
                            @foreach (var zone in Model.TimeZones)
                            {
                                if (string.Equals(zone, Model.TimeZone, StringComparison.Ordinal))
                                {
                                    <option value="@zone" selected>@zone</option>
                                }
                                else
                                {
                                    <option value="@zone">@zone</option>
                                }
                            }
                        </select>
                        <div class="form-text">IANA ids, for example America/Chicago.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <partial name="_VendorVersionPicker" model="Model" />
                    </div>
                </div>

                <div class="mt-3">
                    <partial name="_ReportingScheduleEditor" model="Model" />
                </div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-au-action">@(Model.IsCreate ? "Create facility" : "Save facility")</button>
                </div>
            </form>

            @if (!Model.IsCreate)
            {
                <form method="post" data-au-save asp-action="Remove" asp-route-id="@Model.FacilityId" class="mt-3" onsubmit="return confirm('Remove this facility?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove facility</button>
                </form>
            }
        </div>
    </div>

    @if (!Model.IsCreate)
    {
        <div class="accordion" id="facilityPanels">
            <partial name="_CensusEditor" model="Model" />

            <div class="accordion-item">
                <h2 class="accordion-header" id="dispatchHeading">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#dispatchPanel" aria-expanded="true" aria-controls="dispatchPanel">
                        Query dispatch configuration
                    </button>
                </h2>
                <div id="dispatchPanel" class="accordion-collapse collapse show" aria-labelledby="dispatchHeading">
                    <div class="accordion-body">
                        @if (!Model.QueryDispatchConfigured)
                        {
                            <p class="text-muted mb-0">Query dispatch service URL is not configured (ServiceRegistry:QueryDispatchServiceUrl).</p>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.QueryDispatchError))
                            {
                                <div class="alert alert-warning">@Model.QueryDispatchError</div>
                            }
                            else if (!Model.QueryDispatchExists)
                            {
                                <div class="alert alert-info">No query dispatch configuration for this facility.</div>
                            }
                            <form method="post" data-au-save asp-action="SaveQueryDispatch" asp-route-id="@Model.FacilityId">
                                <input type="hidden" name="queryDispatchExists" value="@(Model.QueryDispatchExists ? "true" : "false")" />
                                @for (var i = 0; i < Model.Schedules.Count; i++)
                                {
                                    <div class="row g-2 align-items-end mb-2">
                                        <div class="col-12 col-md-5">
                                            <label class="form-label" for="event-@i">Event</label>
                                            <input id="event-@i" name="Schedules[@i].Event" value="@Model.Schedules[i].Event" class="form-control" />
                                        </div>
                                        <div class="col-12 col-md-5">
                                            <label class="form-label" for="duration-@i">Duration</label>
                                            <input id="duration-@i" name="Schedules[@i].Duration" value="@Model.Schedules[i].Duration" class="form-control" placeholder="PT10S" />
                                        </div>
                                        <div class="col-12 col-md-2">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox" id="remove-@i" name="Schedules[@i].Remove" value="true" />
                                                <label class="form-check-label" for="remove-@i">Remove</label>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <p class="form-text">Leave the last row blank to ignore it. Check Remove to drop a row on save.</p>
                                <button type="submit" class="btn btn-au-action">@(Model.QueryDispatchExists ? "Save query dispatch" : "Add query dispatch")</button>
                            </form>
                            @if (Model.QueryDispatchExists)
                            {
                                <form method="post" data-au-save asp-action="DeleteQueryDispatch" asp-route-id="@Model.FacilityId" class="mt-2" onsubmit="return confirm('Delete the query dispatch configuration?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete query dispatch</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>

            <partial name="_FhirQueryEditor" model="Model" />
            <partial name="_NormalizationOperationEditor" model="Model" />
        </div>
        <p class="text-muted small mt-3 mb-0">
            This page saves facility identity, census, query dispatch, data acquisition, and normalization operations. View opens locations, reports, and reporting plans.
        </p>
    }
}
