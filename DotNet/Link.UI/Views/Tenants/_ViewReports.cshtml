@model FacilityViewModel
@using LantanaGroup.Link.Shared.Application.Enums
@using Link.UI.Services
@{
    var statuses = FacilityViewRules.ParseStatuses(Model.Query.Status);
    Dictionary<string, string> SortRoute(string column) => Model.Query.ToRoute(
        page: 1,
        sortBy: column,
        sortDir: FacilityViewRules.NextSortDirection(Model.Query.SortBy, Model.Query.SortDir, column));
    var sortId = SortRoute("Id");
    var sortPeriod = SortRoute("ReportStartDate");
    var sortCreated = SortRoute("CreateDate");
    var sortFrequency = SortRoute("Frequency");
    var sortStatus = SortRoute("Status");
}

<div class="au-card card">
    <div class="card-header">Facility reports</div>
    <div class="card-body">
        <form method="get" asp-action="View" asp-route-id="@Model.FacilityId" class="row g-2 align-items-end mb-3" data-au-filter="400" data-au-target="facilityReportResults">
            <input type="hidden" name="section" value="reports" />
            <div class="col-12 col-md-4 col-xl-3">
                <label class="form-label" for="reportId">Report ID</label>
                <input id="reportId" name="reportId" value="@Model.Query.ReportId" class="form-control" />
            </div>
            <div class="col-12 col-md-4 col-xl-2">
                <label class="form-label" for="frequency">Frequency</label>
                <select id="frequency" name="frequency" class="form-select">
                    <option value="">Any</option>
                    @foreach (var frequency in new[] { "Daily", "Weekly", "Monthly", "Adhoc", "Discharge" })
                    {
                        if (string.Equals(Model.Query.Frequency, frequency, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@frequency" selected>@frequency</option>
                        }
                        else
                        {
                            <option value="@frequency">@frequency</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="created">Created</label>
                <input id="created" name="created" type="date" value="@Model.Query.Created" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="periodFrom">Period from</label>
                <input id="periodFrom" name="periodFrom" type="date" value="@Model.Query.PeriodFrom" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="periodTo">Period to</label>
                <input id="periodTo" name="periodTo" type="date" value="@Model.Query.PeriodTo" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-xl-1">
                <label class="form-label" for="pageSize">Page</label>
                <select id="pageSize" name="pageSize" class="form-select">
                    @foreach (var size in FacilityViewRules.PageSizes)
                    {
                        if (Model.Query.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12">
                <span class="form-label d-block">Status</span>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var status in Enum.GetValues<ScheduleStatus>())
                    {
                        var selected = statuses.Contains(status);
                        <label class="form-check-label">
                            <input class="form-check-input me-1" type="checkbox" name="status" value="@status" @(selected ? "checked" : null) />
                            @FacilityViewRules.StatusLabel(status)
                        </label>
                    }
                    <label class="form-check-label">
                        <input class="form-check-input me-1" type="checkbox" name="showDeleted" value="true" @(Model.Query.ShowDeleted ? "checked" : null) />
                        Show deleted
                    </label>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-au-neutral"><i class="bi bi-search me-1"></i>Search</button>
                <a class="btn btn-au-neutral" asp-action="View" asp-route-id="@Model.FacilityId" asp-route-section="reports">Clear</a>
            </div>
        </form>

        <p class="lu-live-label mb-2">This list updates on its own.</p>
        <div id="facilityReportResults" data-au-refresh="12000">
        @if (!string.IsNullOrWhiteSpace(Model.SectionNote))
        {
            <div class="alert alert-info">@Model.SectionNote</div>
        }

        @if (Model.Reports.Count == 0)
        {
            <p class="au-empty mb-0">No reports found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th><a asp-action="View" asp-route-id="@Model.FacilityId" asp-all-route-data="@sortId">Report ID</a></th>
                            <th><a asp-action="View" asp-route-id="@Model.FacilityId" asp-all-route-data="@sortPeriod">Reporting period</a></th>
                            <th><a asp-action="View" asp-route-id="@Model.FacilityId" asp-all-route-data="@sortCreated">Created</a></th>
                            <th>Measures</th>
                            <th><a asp-action="View" asp-route-id="@Model.FacilityId" asp-all-route-data="@sortFrequency">Cadence</a></th>
                            <th class="text-end">Census</th>
                            <th class="text-end">IP</th>
                            <th><a asp-action="View" asp-route-id="@Model.FacilityId" asp-all-route-data="@sortStatus">Status</a></th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        <tr class="@(report.Deleted ? "table-secondary" : null)">
                            <td>
                                <partial name="_LabeledId" model="@(new LabeledId { Label = "Report ID", Value = report.Id.ToString(), Compact = true, CopyLabel = "Copy report id", LinkHref = report.Deleted ? null : Url.Action("Report", "Tenants", new { id = Model.FacilityId, reportId = report.Id }) })" />
                                @if (report.Deleted)
                                {
                                    <div class="small text-muted">Deleted</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <div>Start @report.PeriodStart</div>
                                <div>End @report.PeriodEnd</div>
                            </td>
                            <td class="text-nowrap">@report.Created</td>
                            <td>
                                <span class="lu-clip lu-clip-text" title="@report.Measures">@report.Measures</span>
                                @if (!string.IsNullOrWhiteSpace(report.Measures))
                                {
                                    <partial name="_CopyButton" model="@(new CopyTarget { Value = report.Measures, Label = "Copy measures" })" />
                                }
                            </td>
                            <td><span class="badge text-bg-light border">@report.Frequency</span></td>
                            <td class="text-end">@(report.CensusCount?.ToString() ?? "—")</td>
                            <td class="text-end">@(report.InitialPopulationCount?.ToString() ?? "—")</td>
                            <td>
                                <span class="badge @FacilityViewRules.StatusBadge(report.Status)">@report.StatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(report.Submitted))
                                {
                                    <div class="small text-muted">@report.Submitted</div>
                                }
                            </td>
                            <td>
                                <div class="lu-row-actions">
                                @if (report.CanResubmit)
                                {
                                    <div class="lu-row-action">
                                        <div class="d-none" data-resubmit-fields>
                                            <partial name="_ViewReturnFields" model="Model.Query" />
                                            <input type="hidden" name="targetId" value="@report.Id" />
                                        </div>
                                        <button type="button" class="btn btn-sm btn-warning lu-icon-btn" data-resubmit-open aria-haspopup="dialog" aria-controls="resubmitDialog" data-report-id="@report.Id" data-facility-id="@Model.FacilityId" data-period="Start @report.PeriodStart, end @report.PeriodEnd" title="Resubmit" aria-label="Resubmit"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></button>
                                    </div>
                                }
                                @if (report.CanAbort)
                                {
                                    <form method="post" data-au-save asp-action="AbortReport" asp-route-id="@Model.FacilityId" onsubmit="return confirm('Stop this in-progress report? Queued acquisition and normalization work for this report will be dropped. Other reports and census jobs for the facility are not affected. The report will be soft-deleted and can be restored later.');">
                                        <partial name="_ViewReturnFields" model="Model.Query" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger lu-icon-btn" title="Abort" aria-label="Abort"><i class="bi bi-stop-fill" aria-hidden="true"></i></button>
                                    </form>
                                }
                                @if (report.CanCleanUp)
                                {
                                    <form method="post" data-au-save asp-action="CleanUpReport" asp-route-id="@Model.FacilityId" onsubmit="return confirm('Remove this report and its associated acquisition logs? It can be restored later.');">
                                        <partial name="_ViewReturnFields" model="Model.Query" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger lu-icon-btn" title="Clean up" aria-label="Clean up"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </form>
                                }
                                @if (report.CanRestore)
                                {
                                    <form method="post" data-au-save asp-action="RestoreReport" asp-route-id="@Model.FacilityId" onsubmit="return confirm('Restore this report and its acquisition logs?');">
                                        <partial name="_ViewReturnFields" model="Model.Query" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-au-neutral lu-icon-btn" title="Restore" aria-label="Restore"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                    </form>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_ViewPager" model="Model" />
        }
        </div>
    </div>
</div>
<div class="modal fade" id="resubmitDialog" tabindex="-1" aria-labelledby="resubmitTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" id="resubmitForm" class="modal-content" data-au-save asp-action="ResubmitReport" asp-route-id="@Model.FacilityId">
            <div class="modal-header">
                <h2 class="modal-title h5" id="resubmitTitle">Resubmit report</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
            </div>
            <div class="modal-body">
                <p id="resubmitSummary" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-au-neutral" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-au-neutral" name="bypassSubmission" value="true">Regenerate without submitting</button>
                <button type="submit" class="btn btn-sm btn-warning">Resubmit</button>
            </div>
        </form>
    </div>
</div>
