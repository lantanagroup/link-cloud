@model Link.UI.Models.TenantListViewModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="au-card card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Tenants</span>
        <a class="btn btn-sm btn-au-action" asp-action="Create">New facility</a>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning">@error</div>
        }
        <form method="get" class="row g-2 mb-3 align-items-center">
            <div class="col-12 col-md-6">
                <label class="visually-hidden" for="tenantSearch">Search facilities</label>
                <input id="tenantSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search facilities..." />
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="includeDeleted" name="includeDeleted" value="true" @(Model.IncludeDeleted ? "checked" : null) />
                    <label class="form-check-label" for="includeDeleted">Include deleted</label>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-au-action">Search</button>
            </div>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.DeletedNote))
        {
            <div class="alert alert-warning">@Model.DeletedNote</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning">@Model.ErrorMessage</div>
        }
        else if (Model.LoadedSuccessfully && Model.Tenants.Count == 0)
        {
            <div class="alert alert-info mb-0">No tenants found.</div>
        }
        else if (Model.LoadedSuccessfully)
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Facility Id</th>
                            <th>Name</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr>
                            <td><a asp-action="Facility" asp-route-id="@tenant.FacilityId"><code class="lu-facility-id">@tenant.FacilityId</code></a></td>
                            <td>
                                <a asp-action="View" asp-route-id="@tenant.FacilityId">@tenant.DisplayName</a>
                                <div class="small"><a asp-action="Facility" asp-route-id="@tenant.FacilityId">Configuration</a></div>
                            </td>
                            <td>
                                @if (tenant.IsDeleted)
                                {
                                    <span class="badge text-bg-secondary">Deleted</span>
                                    <form method="post" asp-action="Restore" asp-route-id="@tenant.FacilityId" class="mt-2" onsubmit="return confirm('Restore this facility, its reports, and its logs?');">
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        @if (Model.IncludeDeleted)
                                        {
                                            <input type="hidden" name="includeDeleted" value="true" />
                                        }
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Restore</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2 mb-0">@Model.Tenants.Count tenant(s). The name opens the facility. Configuration opens the editor.</p>
        }
    </div>
</div>
