@model AutomationRunPage
@using LantanaGroup.Link.Automation.Link.Models
@* Automation-only part of the report page: the run that produced this report (test facilities, Automation on). *@
@{
    var run = Model.Run;
    var detail = Model.Detail;
    var liveRun = Model.LiveConfigured && Model.Found && detail?.Status.IsTerminal() != true && run?.Status is not ("Succeeded" or "Failed" or "Cancelled");
}
<section id="automation-run" class="mt-4" aria-label="Automation run">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h4 mb-0">Automation run</h2>
        @if (liveRun)
        {
            <span id="liveStatus" class="badge au-badge-active" data-live="yes" data-run-id="@Model.RequestedId">Connecting</span>
        }
    </div>
    @if (detail is not null)
    {
        @await Html.PartialAsync("~/Views/Automation/_RunDetail.cshtml", detail, new ViewDataDictionary(ViewData) { ["RunEmbedded"] = true })
    }
    else
    {
        <div class="au-card card mb-3" id="runSummary">
            <div class="card-header">Run</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Run</dt><dd class="col-sm-9" id="runTitle">@(run?.RunName ?? "\u2014")</dd>
                    <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span id="runStatus" class="badge @StatusPills.ForRun(run?.Status)">@(string.IsNullOrWhiteSpace(run?.StatusLabel) ? "Unknown" : run!.StatusLabel)</span></dd>
                    <dt class="col-sm-3">Scenario</dt><dd class="col-sm-9" id="runScenario">@(string.IsNullOrWhiteSpace(run?.Scenario) ? "\u2014" : run!.Scenario)</dd>
                    <dt class="col-sm-3">Patients</dt><dd class="col-sm-9" id="runPatients">@run?.PatientCount</dd>
                    <dt class="col-sm-3">Seed</dt><dd class="col-sm-9" id="runSeed">@run?.Seed</dd>
                    <dt class="col-sm-3">Started</dt><dd class="col-sm-9" id="runStarted">@(run?.StartedAt is null ? "\u2014" : LinkUiTime.Display(run.StartedAt.Value))</dd>
                    <dt class="col-sm-3">Finished</dt><dd class="col-sm-9" id="runFinished">@(run?.FinishedAt is null ? "\u2014" : LinkUiTime.Display(run.FinishedAt.Value))</dd>
                    <dt class="col-sm-3">Duration</dt><dd class="col-sm-9" id="runDuration">@(string.IsNullOrWhiteSpace(run?.Duration) ? "\u2014" : run!.Duration)</dd>
                    <dt class="col-sm-3">Templates</dt><dd class="col-sm-9" id="runTemplates">@(run?.TemplateVersion is int version ? $"v{version}" : "\u2014")</dd>
                </dl>
                <div id="runError" class="alert alert-danger mt-3 mb-0 @(string.IsNullOrWhiteSpace(run?.Error) ? "d-none" : "")">@run?.Error</div>
                @if (!string.IsNullOrWhiteSpace(run?.FacilityId)) { <div class="mt-3"><button type="button" class="btn btn-sm btn-au-link" data-bs-toggle="modal" data-bs-target="#dataAcqLogModal">Data acquisition logs</button></div> }
                <div id="runRetention" class="alert au-note mt-3 mb-0 @(string.IsNullOrWhiteSpace(run?.RetentionNotice) ? "d-none" : "")" role="status">@run?.RetentionNotice</div>
            </div>
        </div>
        <div class="au-card card mb-3">
            <div class="card-header">Live log</div>
            <div class="card-body"><pre id="liveLog" class="lu-live-log text-muted">No new lines yet.</pre></div>
        </div>
    }
    @{ var modalRunId = detail?.RunId ?? run?.RunId; }
    @if (modalRunId is Guid openRunId && openRunId != Guid.Empty)
    {
        <partial name="_DataAcquisitionLogsModal" model="@(new DataAcquisitionLogsModal { RunId = openRunId })" />
    }
</section>