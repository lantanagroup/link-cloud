@model PrequalPage
@{
    ViewData["Title"] = "Prequalification";
    ViewData["FacilityId"] = Model.FacilityId;
    ViewData["FacilityName"] = Model.FacilityName;
    ViewData["ReportId"] = Model.ReportId;
    ViewData["ReportSection"] = "prequal";
}

<div class="mb-3 d-flex flex-wrap gap-3">
    <a class="btn btn-sm btn-au-neutral" asp-controller="Tenants" asp-action="View" asp-route-id="@Model.FacilityId" asp-route-section="reports"><i class="bi bi-arrow-left me-1"></i>Back to facility</a>
</div>

@if (TempData["Error"] is string actionError)
{
    <div class="alert alert-warning">@actionError</div>
}

<h1 class="h3">Prequalification</h1>
<partial name="_ReportIdentity" />
<partial name="_ReportNav" />

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.NotFound || Model.Report is null)
{
    <div class="au-card card"><div class="card-body"><p class="mb-0">That report was not found.</p></div></div>
}
else
{
    @if (Model.TooLarge)
    {
        <div class="alert alert-warning">Validation results for this report are too large to list here. Open Validation for the count.</div>
    }
    else if (Model.Unacceptable.Count == 0 && Model.Acceptable.Count == 0)
    {
        <p>No validation issues at or above Information.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.CategorizeNote))
        {
            <div class="alert alert-info">Category rules were not reapplied. @Model.CategorizeNote</div>
        }
        var unacceptableData = new ViewDataDictionary(ViewData) { ["Heading"] = "Unacceptable" };
        var acceptableData = new ViewDataDictionary(ViewData) { ["Heading"] = "Acceptable" };
        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <partial name="_PrequalCategories" model="Model.Unacceptable" view-data="unacceptableData" />
            </div>
            <div class="col-12 col-lg-6">
                <partial name="_PrequalCategories" model="Model.Acceptable" view-data="acceptableData" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Category) || Model.Issues.Count > 0)
        {
            <div class="au-card card mt-3">
                <div class="card-header d-flex justify-content-between flex-wrap gap-2">
                    <span>@(string.IsNullOrWhiteSpace(Model.Category) ? "Issues" : Model.Category)</span>
                    <a asp-action="Prequal" asp-route-facilityId="@Model.FacilityId" asp-route-reportId="@Model.ReportId">All categories</a>
                </div>
                <div class="card-body">
                    @if (Model.IssuesTruncated)
                    {
                        <p class="small text-muted">Showing @Model.Issues.Count of @Model.IssueTotal.</p>
                    }
                    @if (Model.Issues.Count == 0)
                    {
                        <p class="mb-0">No issues in this category.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Patient</th>
                                        <th>Severity</th>
                                        <th>Code</th>
                                        <th>Message</th>
                                        <th>Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var issue in Model.Issues)
                                {
                                    <tr>
                                        <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Patient", Value = issue.PatientId, Compact = true, CopyLabel = "Copy patient id" })" /></td>
                                        <td>@issue.Severity</td>
                                        <td>@issue.Code</td>
                                        <td>@issue.Message</td>
                                        <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Location", Value = issue.Location, Compact = true, CopyLabel = "Copy location" })" /></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
}
