@model ReportsListModel
@using LantanaGroup.Link.Shared.Application.Enums
@using Link.UI.Services
@{
    ViewData["Title"] = "Reports";
    var statuses = FacilityViewRules.ParseStatuses(Model.Query.Status);
    Dictionary<string, string> SortRoute(string column) => Model.Query.ToRoute(
        page: 1,
        sortBy: column,
        sortDir: FacilityViewRules.NextSortDirection(Model.SortBy, Model.SortDir, column));
    var bar = Model.Paging;
}

<partial name="_BackButton" model="@(new BackLink(Url.Action("Index")!, "Back to reports"))" />

<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <h1 class="h3 mb-0 me-auto">Reports</h1>
    <a class="btn btn-au-link" asp-action="Generate">Generate report</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string actionError)
{
    <div class="alert alert-warning">@actionError</div>
}
@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<div class="au-card card">
    <div class="card-header">Report schedules</div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3" data-au-filter="300" data-au-target="reportResults">
            <div class="col-12 col-md-4 col-xl-3">
                <label class="form-label" for="facilityId">Facility ID</label>
                <input id="facilityId" name="facilityId" value="@Model.Query.FacilityId" class="form-control" />
            </div>
            <div class="col-12 col-md-4 col-xl-3">
                <label class="form-label" for="reportId">Report ID</label>
                <input id="reportId" name="reportId" value="@Model.Query.ReportId" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="frequency">Frequency</label>
                <select id="frequency" name="frequency" class="form-select">
                    <option value="">Any</option>
                    @foreach (var frequency in new[] { "Daily", "Weekly", "Monthly", "Adhoc", "Discharge" })
                    {
                        if (string.Equals(Model.Query.Frequency, frequency, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@frequency" selected>@frequency</option>
                        }
                        else
                        {
                            <option value="@frequency">@frequency</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="created">Created</label>
                <input id="created" name="created" type="date" value="@Model.Query.Created" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="periodFrom">Period from</label>
                <input id="periodFrom" name="periodFrom" type="date" value="@Model.Query.PeriodFrom" class="form-control" />
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label" for="periodTo">Period to</label>
                <input id="periodTo" name="periodTo" type="date" value="@Model.Query.PeriodTo" class="form-control" />
            </div>
            <div class="col-6 col-md-3 col-xl-1">
                <label class="form-label" for="pageSize">Page</label>
                <select id="pageSize" name="pageSize" class="form-select">
                    @foreach (var size in FacilityViewRules.PageSizes)
                    {
                        if (Model.Query.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12">
                <span class="form-label d-block">Status</span>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var status in Enum.GetValues<ScheduleStatus>())
                    {
                        var selected = statuses.Contains(status);
                        <label class="form-check-label">
                            <input class="form-check-input me-1" type="checkbox" name="status" value="@status" @(selected ? "checked" : null) />
                            @FacilityViewRules.StatusLabel(status)
                        </label>
                    }
                    <label class="form-check-label">
                        <input class="form-check-input me-1" type="checkbox" name="showDeleted" value="true" @(Model.Query.ShowDeleted ? "checked" : null) />
                        Show deleted
                    </label>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <partial name="_AutomationScope" model="Model.Query.Scope" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-au-execute"><i class="bi bi-search me-1"></i>Search</button>
                <a class="btn btn-warning" asp-action="Index">Clear</a>
            </div>
        </form>

        <p class="lu-live-label mb-2" data-au-refresh-label>This list updates on its own.</p>
        <div id="reportResults" data-au-refresh="12000">
        @if (!string.IsNullOrWhiteSpace(Model.ScopeNote))
        {
            <p class="small text-muted">@Model.ScopeNote</p>
        }
        @if (Model.Reports.Count == 0)
        {
            <p class="mb-0">@(
                !LinkUiFeatures.Value.AutomationEnabled ? "No reports found."
                : Link.UI.Services.AutomationMarkRules.IsAutomation(Model.Query.Scope) ? "No automation reports."
                : Link.UI.Services.AutomationMarkRules.IsReal(Model.Query.Scope) ? "No real reports."
                : "No reports found.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table au-table table-sm align-middle mb-0 lu-reports-table">
                    <thead>
                        <tr>
                            <th><a asp-all-route-data="@SortRoute("Id")">Report ID</a></th>
                            <th><a asp-all-route-data="@SortRoute("FacilityId")">Facility</a></th>
                            <th><a asp-all-route-data="@SortRoute("ReportStartDate")">Reporting period</a></th>
                            <th><a asp-all-route-data="@SortRoute("CreateDate")">Created</a></th>
                            <th class="lu-measures-col">Measures</th>
                            <th><a asp-all-route-data="@SortRoute("Frequency")">Cadence</a></th>
                            <th class="text-end">Census</th>
                            <th class="text-end">IP</th>
                            <th><a asp-all-route-data="@SortRoute("Status")">Status</a></th>
                            <th class="lu-col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        <tr class="@(report.Deleted ? "table-secondary" : null)" data-report-id="@report.Id">
                            <td>
                                <partial name="_LabeledId" model="@(new LabeledId { Label = "Report ID", Value = report.Id.ToString(), Compact = true, CopyLabel = "Copy report id", LinkHref = report.Deleted ? null : Url.Action("Report", "Tenants", new { id = report.FacilityId, reportId = report.Id }), ReturnUrl = ReturnUrlRules.Here(Context.Request) })" />
                                @if (report.Deleted)
                                {
                                    <div class="small text-muted">Deleted</div>
                                }
                            </td>
                            <td>
                                <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = report.FacilityId, Compact = true, CopyLabel = "Copy facility id", LinkHref = Url.Action("View", "Tenants", new { id = report.FacilityId }), ReturnUrl = ReturnUrlRules.Here(Context.Request) })" />
                                <partial name="_AutomationBadge" model="report.AutomationRunId" />
                            </td>
                            <td class="text-nowrap">
                                <div>Start @report.PeriodStart</div>
                                <div>End @report.PeriodEnd</div>
                            </td>
                            <td class="text-nowrap">@report.Created</td>
                            <td>
                                <span class="lu-measures">
                                    <span class="lu-clip lu-clip-text" title="@report.Measures">@report.Measures</span>
                                </span>
                            </td>
                            <td>@report.Frequency</td>
                            <td class="text-end" data-census="@report.Id">—</td>
                            <td class="text-end" data-population="@report.Id">—</td>
                            <td>
                                <span class="badge @StatusPills.ForSchedule(report.Status)">@report.StatusLabel</span>
                                @if (!string.IsNullOrWhiteSpace(report.Submitted))
                                {
                                    <div class="small text-muted">@report.Submitted</div>
                                }
                            </td>
                            <td>
                                <div class="lu-row-actions">
                                @if (report.CanResubmit)
                                {
                                    <div class="lu-row-action">
                                        <div class="d-none" data-resubmit-fields>
                                            <partial name="_ListReturn" model="Model.Query" />
                                            <input type="hidden" name="rowFacility" value="@report.FacilityId" />
                                            <input type="hidden" name="targetId" value="@report.Id" />
                                        </div>
                                        <button type="button" class="btn btn-sm btn-warning lu-icon-btn" data-resubmit-open aria-haspopup="dialog" aria-controls="resubmitDialog" data-report-id="@report.Id" data-facility-id="@report.FacilityId" data-period="Start @report.PeriodStart, end @report.PeriodEnd" title="Resubmit" aria-label="Resubmit"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span class="ms-1">Resubmit</span></button>
                                    </div>
                                }
                                @if (report.CanAbort)
                                {
                                    <form method="post" data-au-save asp-action="Abort" onsubmit="return confirm('Stop this in-progress report? Queued acquisition and normalization work for this report will be dropped. Other reports and census jobs for the facility are not affected. The report will be soft-deleted and can be restored later.');">
                                        <partial name="_ListReturn" model="Model.Query" />
                                        <input type="hidden" name="rowFacility" value="@report.FacilityId" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-warning lu-icon-btn" title="Abort" aria-label="Abort"><i class="bi bi-stop-fill" aria-hidden="true"></i><span class="ms-1">Abort</span></button>
                                    </form>
                                }
                                @if (report.CanCleanUp)
                                {
                                    <form method="post" data-au-save asp-action="CleanUp" onsubmit="return confirm('Remove this report and its associated acquisition logs? It can be restored later.');">
                                        <partial name="_ListReturn" model="Model.Query" />
                                        <input type="hidden" name="rowFacility" value="@report.FacilityId" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger lu-icon-btn" title="Clean up" aria-label="Clean up"><i class="bi bi-trash" aria-hidden="true"></i><span class="ms-1">Clean up</span></button>
                                    </form>
                                }
                                @if (report.CanRestore)
                                {
                                    <form method="post" data-au-save asp-action="Restore" onsubmit="return confirm('Restore this report and its acquisition logs?');">
                                        <partial name="_ListReturn" model="Model.Query" />
                                        <input type="hidden" name="rowFacility" value="@report.FacilityId" />
                                        <input type="hidden" name="targetId" value="@report.Id" />
                                        <button type="submit" class="btn btn-sm btn-success lu-icon-btn" title="Restore" aria-label="Restore"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span class="ms-1">Restore</span></button>
                                    </form>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="d-flex flex-wrap align-items-center gap-2 mt-2" aria-label="Report pages">
                @if (bar.HasPrevious)
                {
                    <a class="btn btn-sm btn-au-link" asp-all-route-data="@Model.Query.ToRoute(page: bar.Page - 1)">Previous</a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-au-link" disabled>Previous</button>
                }
                <span class="small text-muted">Page @bar.Page of @(bar.TotalPages == 0 ? 1 : bar.TotalPages) (@bar.TotalCount)</span>
                @if (bar.HasNext)
                {
                    <a class="btn btn-sm btn-au-link" asp-all-route-data="@Model.Query.ToRoute(page: bar.Page + 1)">Next</a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-au-link" disabled>Next</button>
                }
            </nav>
        }
        </div>
    </div>
</div>
<div class="modal fade" id="resubmitDialog" tabindex="-1" aria-labelledby="resubmitTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" id="resubmitForm" class="modal-content" data-au-save asp-action="Resubmit">
            <div class="modal-header">
                <h2 class="modal-title h5" id="resubmitTitle">Resubmit report</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
            </div>
            <div class="modal-body">
                <p id="resubmitSummary" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning" name="bypassSubmission" value="true">Regenerate without submitting</button>
                <button type="submit" class="btn btn-sm btn-warning">Resubmit</button>
            </div>
        </form>
    </div>
</div>
<script>
    (function () {
        var url = '@Url.Action("Counts")';
        function fill() {
            var rows = document.querySelectorAll("#reportResults [data-report-id]");
            if (!rows.length) return;
            var ids = Array.prototype.map.call(rows, function (row) { return row.getAttribute("data-report-id"); });
            fetch(url + "?ids=" + encodeURIComponent(ids.join(",")), { headers: { "X-Requested-With": "fetch" } })
                .then(function (res) { return res.ok ? res.json() : []; })
                .then(function (counts) {
                    (counts || []).forEach(function (row) {
                        var census = document.querySelector("[data-census='" + row.id + "']");
                        var population = document.querySelector("[data-population='" + row.id + "']");
                        if (census) census.textContent = row.census == null ? "—" : String(row.census);
                        if (population) population.textContent = row.population == null ? "—" : String(row.population);
                    });
                })
                .catch(function () { });
        }
        fill();
        if (!window.auReportCountsBound) {
            window.auReportCountsBound = true;
            document.addEventListener("au-refreshed", function (event) {
                if (!event.detail) return;
                if (event.detail.id === "reportResults" || event.detail.id === "lu-content") fill();
            });
        }
    })();
</script>
