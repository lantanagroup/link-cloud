@model ValidationPage
@{
    ViewData["Title"] = "Validation";
    ViewData["FacilityId"] = Model.FacilityId;
    ViewData["FacilityName"] = Model.FacilityName;
    ViewData["ReportId"] = Model.ReportId;
    ViewData["ReportSection"] = "validation";
    var query = Model.Query;
    var bar = Model.Paging;
    var origin = ReturnUrlRules.FromQuery(Context.Request);
    var selected = Model.Unacceptable.Concat(Model.AcceptableCategories)
        .FirstOrDefault(category => string.Equals(category.Id, query.Category, StringComparison.OrdinalIgnoreCase));
    string Href(int page, string? sort, bool descending, int pageSize, string? category) =>
        ReportsRules.PrequalHref(Model.FacilityId, Model.ReportId, origin, category, sort, descending, page, pageSize);
    Dictionary<string, string> IssueRoute(int page, int pageSize)
    {
        var href = Href(page, query.Sort, query.Descending, pageSize, query.Category);
        var start = href.IndexOf('?');
        var route = new Dictionary<string, string>(StringComparer.Ordinal);
        if (start < 0)
            return route;
        foreach (var part in href[(start + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var split = part.IndexOf('=');
            if (split < 0)
                continue;
            route[Uri.UnescapeDataString(part[..split])] = Uri.UnescapeDataString(part[(split + 1)..]);
        }
        return route;
    }
    string SortHref(string column) =>
        Href(1, column, ReportsRules.NextIssueDir(query.Sort, query.Descending, column) == "desc", query.PageSize, query.Category);
    string Mark(string column) => string.Equals(query.Sort, column, StringComparison.OrdinalIgnoreCase)
        ? (query.Descending ? " ↓" : " ↑")
        : "";
    var tables = new (string Heading, IReadOnlyList<StoredCategoryCount> Rows)[]
    {
        ("Unacceptable", Model.Unacceptable),
        ("Acceptable", Model.AcceptableCategories)
    };
    var csvHref = "/Reports/ValidationCsv?facilityId=" + Uri.EscapeDataString(Model.FacilityId ?? "")
        + "&reportId=" + Uri.EscapeDataString(Model.ReportId ?? "");
}

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("Report", "Tenants", new { id = Model.FacilityId, reportId = Model.ReportId })!, "Back to report"))" />
</div>

<partial name="_ReportNav" />
<h1 class="h3">Validation</h1>
<partial name="_ReportIdentity" />

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.NotFound || Model.Report is null)
{
    <div class="au-card card"><div class="card-body"><p class="mb-0">That report was not found.</p></div></div>
}
else
{
    @* Validation fills in while the report runs: this region refreshes until the report finishes, then stops. *@
    <div id="validation-live" data-au-refresh="8000" @(ReportProgressService.ValidationSettled(Model.Report, DateTime.UtcNow) ? "data-au-final" : null)>
    <div class="au-card card mb-3">
        <div class="card-header">Summary</div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.SummaryError))
            {
                <div class="alert alert-warning">@Model.SummaryError</div>
            }
            <dl class="row mb-0">
                <dt class="col-sm-4">Issues</dt>
                <dd class="col-sm-8">@(Model.IssueCount?.ToString() ?? "—")</dd>
                <dt class="col-sm-4">Minimum severity</dt>
                <dd class="col-sm-8">
                    @if (string.IsNullOrWhiteSpace(Model.Severity))
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <span class="badge @StatusPills.ForSeverity(Model.Severity)">@Model.Severity</span>
                    }
                </dd>
                <dt class="col-sm-4">Prequalification</dt>
                <dd class="col-sm-8">
                    @if (string.IsNullOrWhiteSpace(Model.PrequalStatus))
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <span class="badge @StatusPills.ForSeverity(Model.PrequalStatus)">@Model.PrequalStatus</span>
                    }
                </dd>
            </dl>
            @if (Model.SeverityCounts.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var count in Model.SeverityCounts)
                    {
                        <span class="badge @StatusPills.ForSeverity(count.Name)">@count.Name @count.Count</span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="au-card card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Prequalification</span>
            <a class="btn btn-au-execute btn-sm" href="@csvHref">Download CSV</a>
        </div>
        <div class="card-body">
            @if (Model.CountsInProgress)
            {
                <p class="mb-2">Validation is still running. These counts can change.</p>
            }
            @if (Model.CountsUnavailable)
            {
                <div class="alert alert-warning">Category counts are not available for this report.</div>
            }
            else if (Model.Unacceptable.Count == 0 && Model.AcceptableCategories.Count == 0 && !string.IsNullOrWhiteSpace(Model.IssuesError))
            {
                <div class="alert alert-warning mb-0">@Model.IssuesError</div>
            }
            else
            {
                @foreach (var table in tables)
                {
                    <h2 class="h6 mt-2">@table.Heading</h2>
                    @if (table.Rows.Count == 0)
                    {
                        <p class="au-empty">No @table.Heading.ToLowerInvariant() categories.</p>
                    }
                    else
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col"><a href="@SortHref("name")">Category@(Mark("name"))</a></th>
                                        <th scope="col"><a href="@SortHref("quantity")">Number of issues@(Mark("quantity"))</a></th>
                                        <th scope="col"><a href="@SortHref("guidance")">Guidance@(Mark("guidance"))</a></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var category in table.Rows)
                                {
                                    var title = string.IsNullOrWhiteSpace(category.Title) ? category.Id : category.Title;
                                    <tr>
                                        <td>
                                            @if (ReportsRules.CategoryDrilldown(category.Id))
                                            {
                                                <a href="@Href(1, query.Sort, query.Descending, query.PageSize, category.Id)">@title</a>
                                            }
                                            else
                                            {
                                                @title
                                            }
                                        </td>
                                        <td>@category.Issues</td>
                                        <td style="white-space:normal;overflow-wrap:anywhere">@category.Guidance</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }

            @if (!string.IsNullOrWhiteSpace(query.Category))
            {
                <div id="validationIssues" class="mt-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h2 class="h6 mb-0">@(selected?.Title ?? query.Category)</h2>
                        <a href="@Href(1, query.Sort, query.Descending, query.PageSize, null)">All categories</a>
                    </div>
                    @if (!Model.CountsUnavailable)
                    {
                        <p class="mb-1">Reported issues: @(selected?.Issues ?? 0)</p>
                    }
                    <p class="mb-2">Available saved issues: @bar.TotalCount</p>
                    @if (!string.IsNullOrWhiteSpace(Model.IssuesError) && (Model.Unacceptable.Count > 0 || Model.AcceptableCategories.Count > 0 || Model.CountsUnavailable))
                    {
                        <div class="alert alert-warning">@Model.IssuesError</div>
                    }
                    else if (bar.TotalCount == 0 && Model.Issues.Count == 0)
                    {
                        <p class="au-empty mb-0">No saved issues are available for this category. Reported counts can include findings that were not saved or have been deleted.</p>
                    }
                    else if (Model.Issues.Count == 0)
                    {
                        <p class="au-empty mb-0">No findings on this page.</p>
                    }
                    else if (Model.Issues.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                                <thead>
                                    <tr>
                                        <th scope="col">Message</th>
                                        <th scope="col">Patient</th>
                                        <th scope="col">Expression</th>
                                        <th scope="col">Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var issue in Model.Issues)
                                {
                                    <tr>
                                        <td class="w-100" style="white-space:normal;overflow:visible;max-width:none;text-overflow:clip;overflow-wrap:anywhere"><div class="lu-clamp-3" title="@issue.Message" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">@issue.Message</div></td>
                                        <td style="min-width:6.5rem"><partial name="_LabeledId" model="@(new LabeledId { Label = "Patient", Value = issue.PatientId, Compact = true, CopyLabel = "Copy patient id" })" /></td>
                                        <td style="white-space:normal;overflow-wrap:anywhere;min-width:8rem">@issue.Expression</td>
                                        <td style="white-space:normal;overflow:visible;max-width:none;text-overflow:clip;overflow-wrap:anywhere;min-width:8rem;max-width:16rem"><partial name="_LabeledId" model="@(new LabeledId { Label = "Location", Value = issue.Location, Compact = true, CopyLabel = "Copy location" })" /></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (bar.TotalCount > 0)
                    {
                        <partial name="_BottomPager" model="@(new BottomPager { Label = "Issue pages", Page = bar.Page, Pages = bar.TotalPages == 0 ? 1 : bar.TotalPages, Total = bar.TotalCount, PageSize = query.PageSize, Sizes = ReportsRules.IssuePageSizes, Path = "/Reports/Validation", Route = IssueRoute })" />
                    }
                </div>
            }
        </div>
    </div>
    </div>
}
