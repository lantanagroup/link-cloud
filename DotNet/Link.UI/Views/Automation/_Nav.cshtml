@{
    var active = ViewData["AutomationSection"] as string ?? "";
    string Btn(string section) => active == section ? "btn btn-sm btn-au-action" : "btn btn-sm btn-outline-secondary";
}
<nav class="lu-section-nav mb-3" aria-label="Automation">
    <a class="@Btn("runs")" asp-controller="Automation" asp-action="Index"><i class="bi bi-play-circle me-1"></i>Runs</a>
    <a class="@Btn("scenarios")" asp-controller="Scenarios" asp-action="Index"><i class="bi bi-collection me-1"></i>Scenarios</a>
</nav>
