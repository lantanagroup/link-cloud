@{
    var active = ViewData["AutomationSection"] as string ?? "";
    string Btn(string section) => active == section ? "btn btn-sm lu-nav-current" : "btn btn-sm btn-au-link";
}
<nav class="lu-section-nav" aria-label="Automation">
    <a class="@Btn("runs")" asp-controller="Automation" asp-action="Index"><i class="bi bi-play-circle me-1"></i>Runs</a>
    <a class="@Btn("scenarios")" asp-controller="Scenarios" asp-action="Index"><i class="bi bi-collection me-1"></i>Scenarios</a>
    <a class="@Btn("configurations")" asp-controller="AutomationConfigurations" asp-action="Index"><i class="bi bi-sliders me-1"></i>Configurations</a>
    <a class="@Btn("metrics")" asp-controller="Metrics" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Metrics</a>
    <a class="@Btn("api-health")" asp-controller="ApiHealth" asp-action="Index"><i class="bi bi-heart-pulse me-1"></i>API health</a>
    <a class="@Btn("cleanup")" asp-controller="Cleanup" asp-action="Index"><i class="bi bi-recycle me-1"></i>Cleanup</a>
</nav>
