@model AutomationDashboardPage
@using System.Text.Json
@using Link.UI.Services
@{
    var stats = Model.Stats;
    var success = (stats.Succeeded + stats.Failed) == 0
        ? "—"
        : $"{stats.SuccessRate}%";
}
@await Html.PartialAsync("_Nav")

<div class="au-dash">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-lightning-charge-fill me-2"></i>Automation Runs</h1>
        <p class="text-muted mb-0">Dashboard overview and run history. A new run stands up a throwaway facility, runs, and tears it down.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a class="btn btn-sm btn-au-neutral" asp-action="New">Ad hoc</a>
        <span id="liveStatus" class="badge au-badge-muted" data-live="@(Model.LiveConfigured ? "yes" : "no")">@(Model.LiveConfigured ? "Connecting" : "Live updates are off")</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning" id="storageMessage">@Model.Message</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="au-kpi-card">
            <div class="au-kpi-value" id="kpiActive">@(stats.Running + stats.Queued)</div>
            <div class="au-kpi-label">Currently active</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="au-kpi-card">
            <div class="au-kpi-value" id="kpiTotal">@stats.TotalRuns</div>
            <div class="au-kpi-label">Total runs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="au-kpi-card">
            <div class="au-kpi-value" id="kpiSuccess">@success</div>
            <div class="au-kpi-label">Success rate</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="au-kpi-card">
            <div class="au-kpi-value" id="kpiDuration">@AutomationRules.FormatDuration(stats.AvgDurationSeconds)</div>
            <div class="au-kpi-label">Avg duration</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-4">
        <div class="au-card card h-100">
            <div class="card-header"><i class="bi bi-pie-chart-fill me-2"></i>Status Breakdown</div>
            <div class="card-body d-flex align-items-center justify-content-center position-relative">
                <div class="lu-chart-donut">
                    <canvas id="statusChart"></canvas>
                </div>
                <p id="statusEmpty" class="text-muted small mb-0 @(stats.TotalRuns == 0 ? "" : "d-none")">No runs yet</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-8">
        <div class="au-card card h-100">
            <div class="card-header"><i class="bi bi-bar-chart-fill me-2"></i>Runs Per Day (Last 14 Days)</div>
            <div class="card-body">
                <div class="lu-chart">
                    <canvas id="dayChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="recentRunsHost">
    @await Html.PartialAsync("_RecentRuns", Model)
</div>

<div class="au-card card mb-3" id="activeCard" style="@(Model.ActiveRuns.Count == 0 ? "display:none" : "")">
    <div class="card-header"><i class="bi bi-activity me-2"></i>Active Runs</div>
    <div class="card-body">
        <div class="row g-2" id="activeRuns">
            @foreach (var run in Model.ActiveRuns)
            {
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="fw-semibold">@run.RunName</div>
                        <div class="small text-muted">@run.PatientCount patients &middot; seed @run.Seed</div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="badge @StatusPills.ForRun(run.Status)">@run.StatusLabel</span>
                            <span class="small text-muted js-elapsed" data-created-at="@run.CreatedAt.ToString("o")"></span>
                        </div>
                        <a class="btn btn-sm btn-au-neutral mt-2 w-100" asp-action="Run" asp-route-id="@run.RunId" asp-route-returnUrl="@ReturnUrlRules.Here(Context.Request)">
                            <i class="bi bi-box-arrow-up-right me-1"></i>View Details
                        </a>
                    </div>
                </div>
            }
        </div>
        <p id="activeEmpty" class="text-muted mb-0 @(Model.ActiveRuns.Count == 0 ? "" : "d-none")">No run is in progress.</p>
    </div>
</div>

@if (Model.EngineReady)
{
    var customScenarios = Model.Scenarios.Where(s => !s.IsSystemScenario).OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToList();
    var systemScenarios = Model.Scenarios.Where(s => s.IsSystemScenario).OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase).ToList();
    <div class="au-card card mb-3" id="quickLaunchCard">
        <div class="card-header"><i class="bi bi-play-circle me-2"></i>Quick Launch</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold" for="quickLaunchDropdownButton">Select a saved scenario to run</label>
                    <div class="dropdown" id="quickLaunchDropdown">
                        <button class="form-select text-start" type="button" id="quickLaunchDropdownButton" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="dynamic" aria-expanded="false">
                            -- Select a scenario --
                        </button>
                        <div class="dropdown-menu w-100 p-2" aria-labelledby="quickLaunchDropdownButton" style="max-height: 360px; overflow-y: auto;">
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small mb-1" for="quickLaunchTypeFilter">Type</label>
                                    <select id="quickLaunchTypeFilter" class="form-select form-select-sm">
                                        <option value="">All types</option>
                                        <option value="Custom">Custom</option>
                                        <option value="System">System</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1" for="quickLaunchSort">Sort</label>
                                    <select id="quickLaunchSort" class="form-select form-select-sm">
                                        <option value="name">Alphabetical</option>
                                        <option value="updated">Recently Modified</option>
                                    </select>
                                </div>
                            </div>
                            <input type="text" id="quickLaunchSearch" class="form-control mb-2" placeholder="Search scenarios..." autocomplete="off" />
                            <div id="quickLaunchNoResults" class="text-muted text-center py-2" hidden>No matching scenarios found.</div>
                            <div class="quick-launch-group" data-group="Custom">
                                <h6 class="dropdown-header px-2">Custom</h6>
                                @foreach (var scenario in customScenarios)
                                {
                                    <button type="button" class="dropdown-item quick-launch-option" data-id="@scenario.Id" data-name="@scenario.Name" data-description="@scenario.Description" data-method="@scenario.ReportMethod" data-type="Custom" data-measures="@scenario.Measures" data-updated="@scenario.UpdatedAtUnixMs">@scenario.Name</button>
                                }
                            </div>
                            <div class="quick-launch-group" data-group="System">
                                <h6 class="dropdown-header px-2">System</h6>
                                @foreach (var scenario in systemScenarios)
                                {
                                    <button type="button" class="dropdown-item quick-launch-option" data-id="@scenario.Id" data-name="@scenario.Name" data-description="@scenario.Description" data-method="@scenario.ReportMethod" data-type="System" data-measures="@scenario.Measures" data-updated="@scenario.UpdatedAtUnixMs">@scenario.Name <span class="text-muted">[System]</span></button>
                                }
                            </div>
                        </div>
                    </div>
                    <select id="quickLaunchSelect" hidden>
                        <option value="">-- Select a scenario --</option>
                        @foreach (var scenario in customScenarios.Concat(systemScenarios))
                        {
                            <option value="@scenario.Id" data-name="@scenario.Name" data-description="@scenario.Description" data-method="@scenario.ReportMethod" data-type="@(scenario.IsSystemScenario ? "System" : "Custom")" data-measures="@scenario.Measures" data-updated="@scenario.UpdatedAtUnixMs">@scenario.Name@(scenario.IsSystemScenario ? " [System]" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <form asp-action="New" method="post" id="quickLaunchForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="choice" id="qlChoice" value="" />
                        <input type="hidden" name="runName" value="" />
                        <button type="submit" class="btn btn-au-run w-100" id="qlRunButton" disabled>
                            <i class="bi bi-play-fill me-1"></i> Run
                        </button>
                    </form>
                </div>
                <div class="col-6 col-md-2">
                    <button type="button" class="btn btn-success w-100" id="btnNewScenarioFromRuns">
                        <i class="bi bi-plus-lg me-1"></i> New Scenario
                    </button>
                </div>
                <div class="col-6 col-md-2">
                    <a asp-controller="Scenarios" asp-action="Index" class="btn btn-au-neutral w-100" id="btnManageScenario">
                        <i class="bi bi-journal-text me-1"></i> Manage
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.EngineReady)
{
    @await Html.PartialAsync("_ScenarioEditorModal")
}

</div>

<script id="automation-stats" type="application/json">@Html.Raw(JsonSerializer.Serialize(stats, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/au-data-table.js" asp-append-version="true"></script>
    <script src="~/js/automation-dashboard.js" asp-append-version="true"></script>
}
