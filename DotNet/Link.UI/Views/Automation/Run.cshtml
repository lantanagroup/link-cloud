@model AutomationRunPage
@{
    var run = Model.Run;
    var detail = Model.Detail;
    var liveRun = Model.LiveConfigured && Model.Found && detail?.Status.IsTerminal() != true && run?.Status is not ("Succeeded" or "Failed" or "Cancelled");
}
@await Html.PartialAsync("_Nav")

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    @if (detail is null)
    {
        <div>
            <h1 class="h3 mb-1" id="runTitle">@(run?.RunName ?? "Run")</h1>
            <p class="text-muted mb-0">Stored summary for this run. Lines that arrive while this page is open are shown below. Older log chunks stay in Automation storage.</p>
        </div>
    }
    <div class="d-flex flex-wrap gap-2 align-items-center ms-auto">
        @if (liveRun)
        {
            <span id="liveStatus" class="badge au-badge-active" data-live="yes" data-run-id="@Model.RequestedId">Connecting</span>
        }
        @if (detail is null)
        {
            <partial name="_BackButton" model="@(new BackLink(Url.Action("Index")!, "Back to runs"))" />
        }
    </div>
</div>

@if (detail is null && !string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning" id="runMessage">@Model.Message</div>
}

@if (detail is not null)
{
    @await Html.PartialAsync("_RunDetail", detail)
}
else
{
    <div id="runSummary" class="@(run is null ? "d-none" : "")">
        <div class="au-card card mb-3">
            <div class="card-header">Summary</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Status</div>
                        <div id="runStatus" class="badge @StatusPills.ForRun(run?.Status)">@(string.IsNullOrWhiteSpace(run?.StatusLabel) ? "Unknown" : run!.StatusLabel)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Scenario</div>
                        <div id="runScenario">@(string.IsNullOrWhiteSpace(run?.Scenario) ? "—" : run!.Scenario)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Patients</div>
                        <div id="runPatients">@run?.PatientCount</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Seed</div>
                        <div id="runSeed">@run?.Seed</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="small text-muted">Facility</div>
                        <div id="runFacility" class="d-flex flex-wrap align-items-center gap-1">
                            <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = run?.FacilityId, Compact = true, CopyLabel = "Copy facility id", ValueElementId = "facilityValue", LinkHref = string.IsNullOrWhiteSpace(run?.FacilityId) ? null : Url.Action("Facility", "Tenants", new { id = run!.FacilityId }) })" />
                            @if (run?.ThrowawayFacility == true)
                            {
                                <span class="badge au-badge-muted" id="runFacilityBadge">Automation facility</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="small text-muted">Report</div>
                        <div id="runReport">
                            <partial name="_LabeledId" model="@(new LabeledId { Label = "Report", Value = run?.ReportId, Compact = true, CopyLabel = "Copy report id", ValueElementId = "reportValue", LinkHref = string.IsNullOrWhiteSpace(run?.ReportId) ? null : Url.Action("Index", "Reports", new { facilityId = run!.FacilityId }) })" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Started</div>
                        <div id="runStarted">@(run?.StartedAt is null ? "—" : LinkUiTime.Display(run.StartedAt.Value))</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Finished</div>
                        <div id="runFinished">@(run?.FinishedAt is null ? "—" : LinkUiTime.Display(run.FinishedAt.Value))</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Duration</div>
                        <div id="runDuration">@(string.IsNullOrWhiteSpace(run?.Duration) ? "—" : run!.Duration)</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small text-muted">Templates</div>
                        <div id="runTemplates">@(run?.TemplateVersion is int version ? $"v{version}" : "—")</div>
                    </div>
                </div>
                <div id="runError" class="alert alert-danger mt-3 mb-0 @(string.IsNullOrWhiteSpace(run?.Error) ? "d-none" : "")">@run?.Error</div>
                <div id="runRetention" class="alert au-note mt-3 mb-0 @(string.IsNullOrWhiteSpace(run?.RetentionNotice) ? "d-none" : "")" role="status">@run?.RetentionNotice</div>
                <div class="mt-3 d-flex flex-wrap gap-2" id="runActions">
                    @if (run is not null && !string.IsNullOrWhiteSpace(run.FacilityId))
                    {
                        <button type="button" class="btn btn-sm btn-au-neutral" data-bs-toggle="modal" data-bs-target="#dataAcqLogModal">Data acquisition logs</button>
                    }
                </div>
            </div>
        </div>

        <div class="au-card card">
            <div class="card-header">Live log</div>
            <div class="card-body">
                <pre id="liveLog" class="lu-live-log text-muted">No new lines yet.</pre>
            </div>
        </div>
    </div>
}

@{
    var modalRunId = detail?.RunId ?? run?.RunId;
}
@if (modalRunId is Guid openRunId && openRunId != Guid.Empty)
{
    <partial name="_DataAcquisitionLogsModal" model="@(new DataAcquisitionLogsModal { RunId = openRunId })" />
}

@section Scripts {
    @if (detail is not null)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    @if (detail is not null)
    {
        @await Html.PartialAsync("_RunDetailScript", detail)
        @if (!detail.Status.IsTerminal())
        {
            <script src="~/js/live-utilization.js" asp-append-version="true"></script>
        }
    }
    <script src="~/js/automation-run.js" asp-append-version="true"></script>
}
