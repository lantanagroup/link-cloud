@model LantanaGroup.Link.Automation.Link.Models.AutomationRunSummary
@using LantanaGroup.Link.Automation.Link.Models
@using Automation.UI.Models
@using Automation.UI.Models.Metrics
@using LantanaGroup.Automation.Generation
@{
    ViewData["Title"] = "Run Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="fw-bold mb-0" id="runName">@Model.RunName</h3>
            <div class="small text-muted">
                Report ID: <code id="headerReportId">@(string.IsNullOrWhiteSpace(Model.ReportId) ? "-" : Model.ReportId)</code>
                <span class="badge rounded-pill ms-2 text-bg-primary"
                      title="Per-patient FHIR is generated by Thetis Engine.">
                    Thetis
                </span>
                @if (Model.IsMetricsRun && Model.Status.IsTerminal())
                {
                    <a href="#advancedPerformanceHost"
                       class="badge rounded-pill ms-2 text-bg-info text-decoration-none"
                       title="Open total time, speed, and per-step timings for this run.">Performance results</a>
                }
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center" id="runHeaderActions">
            @if (Model.Status.IsCancellable())
            {
                <button type="button" class="btn btn-warning btn-sm" id="btnCancelRun"><i class="bi bi-x-circle me-1"></i>Cancel</button>
            }
            @if (Model.Status is AutomationRunStatus.Succeeded or AutomationRunStatus.Failed or AutomationRunStatus.Cancelled)
            {
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteRun"><i class="bi bi-trash me-1"></i>Delete</button>
                <a asp-action="Export" asp-route-id="@Model.RunId" class="btn btn-sm" style="background:var(--au-accent);color:#fff;font-weight:600;">
                    <i class="bi bi-download me-1"></i>Export Diagnostics
                </a>
            }
            <a asp-action="Index" class="btn btn-sm btn-au-action"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>

    <div class="au-pulse mb-4" id="liveUtilizationCard" data-url="@Url.Action("LiveUtilization", "Automation")" title="CPU is percent of this machine. Polls Prometheus about every five seconds while this page is open. Not saved.">
        <div class="au-pulse-head">
            <div>
                <div class="au-pulse-kicker">Live fleet</div>
                <div class="au-pulse-title"><i class="bi bi-activity me-1"></i>CPU and RAM pulse</div>
                <div class="au-pulse-status" id="liveUtilizationStatus">Watching while this page is open. Not saved.</div>
                <div class="au-pulse-hottest" id="livePulseHottest"></div>
            </div>
            <div class="au-pulse-controls">
                <div class="au-pulse-seg" role="group" aria-label="View">
                    <button type="button" data-pulse-group="view" data-pulse-value="compact" class="is-on">Pulse</button>
                    <button type="button" data-pulse-group="view" data-pulse-value="expanded">Cards</button>
                </div>
                <div class="au-pulse-seg" role="group" aria-label="Filter">
                    <button type="button" data-pulse-group="filter" data-pulse-value="all">All</button>
                    <button type="button" data-pulse-group="filter" data-pulse-value="pipeline" class="is-on">Pipeline</button>
                    <button type="button" data-pulse-group="filter" data-pulse-value="hot">Hot</button>
                </div>
                <div class="au-pulse-seg" role="group" aria-label="Sort">
                    <button type="button" data-pulse-group="sort" data-pulse-value="heat" class="is-on">Hottest</button>
                    <button type="button" data-pulse-group="sort" data-pulse-value="name">A–Z</button>
                </div>
            </div>
        </div>
        <div id="livePulseStrip" class="au-pulse-strip">
            <div class="small px-2 py-2" style="color:rgba(255,255,255,.6)">Connecting to Prometheus…</div>
        </div>
        <div id="livePulseExpanded" class="au-pulse-expanded" hidden></div>
        <div class="au-pulse-detail" id="livePulseDetail">
            <p class="au-pulse-detail-empty mb-0">Click a service to pin CPU, RAM, and API p95.</p>
        </div>
    </div>

    <div class="au-card">
        <div class="card-header"><i class="bi bi-clipboard-data me-2"></i>Run Summary</div>
        <div class="card-body">
            <div class="row g-3" id="runSummaryGrid">
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Status</span><span class="au-value" id="status">@Model.Status.ToDisplayName()</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Facility</span><code class="au-value" id="facilityId">@(Model.FacilityId ?? "-")</code></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">NHSN Organization ID</span><code class="au-value" id="nhsnOrganizationIdSummary">-</code></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Started</span><span class="au-value" id="started">@(Model.StartedAt is null ? "-" : LinkUiTime.IsoUtc(Model.StartedAt.Value))</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Finished</span><span class="au-value" id="finished">@(Model.FinishedAt is null ? "-" : LinkUiTime.IsoUtc(Model.FinishedAt.Value))</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Pipeline Duration</span><span class="au-value" id="pipelineDuration">@(Model.Duration ?? "-")</span></div></div>
                <div class="col-md-3"><div class="au-summary-item"><span class="au-label">FHIR generator</span><span class="au-value" id="fhirGenerator">Thetis Engine</span></div></div>
                @{
                    var templateCacheVersion = ViewBag.TemplateCacheVersionNumber as int?;
                }
                @if (templateCacheVersion.HasValue)
                {
                    <div class="col-md-3"><div class="au-summary-item"><span class="au-label">Generation templates</span><span class="au-value" id="generationTemplateVersion">v@(templateCacheVersion.Value)</span></div></div>
                }
            </div>
            <div id="errorRow" class="mt-3" style="display:none;"><div class="alert alert-danger mb-0 py-2 small"><i class="bi bi-exclamation-triangle-fill me-1"></i><span id="error">@(Model.Error ?? "-")</span></div></div>
            <div id="runRetention" class="alert alert-info mt-3 mb-0 py-2 small @(string.IsNullOrWhiteSpace(Model.RetentionNotice) ? "d-none" : "")" role="status">@Model.RetentionNotice</div>
            <div id="validationHoldBanner" class="alert alert-info mt-3 mb-0 py-2 small" style="display:none;" role="status">
                <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                <span id="validationHoldText"></span>
            </div>
            <span id="finalizingBadge" class="badge rounded-pill bg-secondary text-white mt-2" style="display:none;">
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width:.7rem;height:.7rem;"></span>
                <span id="finalizingBadgeText">Finalizing…</span>
            </span>
        </div>
    </div>

    @if (Model.IsMetricsRun)
    {
        <div id="advancedPerformanceHost">
            @if (ViewBag.Performance is MetricsRunDetailViewModel performance)
            {
                @await Html.PartialAsync("~/Views/Automation/_AdvancedPerformance.cshtml", performance)
            }
            else
            {
                <div class="au-card">
                    <div class="card-header"><i class="bi bi-speedometer2 me-2"></i>Advanced performance</div>
                    <div class="card-body">
                        <p class="mb-0 text-muted">
                            This is a metrics run. Live counts and charts below update while the pipeline is working.
                            Typical / Slow / Slowest timings for each step are captured about a minute after the run finishes and will appear here.
                        </p>
                    </div>
                </div>
            }
        </div>
    }

    <div class="au-card au-live-panel" id="liveSimulationCard" style="display:none;">
        @Html.AntiForgeryToken()
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-broadcast me-2"></i>Live Scheduled Simulation</span>
            <div class="d-flex align-items-center gap-2">
                <span class="au-live-countdown" id="liveWindowCountdown" aria-live="polite">Window closed</span>
                <span class="badge au-badge-muted" id="liveAcceptingLabel">Injections closed</span>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3" id="liveMetrics">
                <div class="col-6 col-md">
                    <div class="au-summary-item">
                        <span class="au-label">Pool</span>
                        <span class="au-value" id="livePoolCount">0</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="au-summary-item">
                        <span class="au-label">Not admitted</span>
                        <span class="au-value" id="liveNotAdmittedCount">0</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="au-summary-item au-live-metric-accent">
                        <span class="au-label">Admitted</span>
                        <span class="au-value" id="liveAdmittedCount">0</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="au-summary-item">
                        <span class="au-label">Discharged</span>
                        <span class="au-value" id="liveDischargedCount">0</span>
                    </div>
                </div>
                <div class="col-6 col-md">
                    <div class="au-summary-item au-live-metric-accent">
                        <span class="au-label">Report expected</span>
                        <span class="au-value" id="liveExpectedCount">0</span>
                    </div>
                </div>
            </div>

            <div class="mb-3" id="liveInjectControls">
                <h6 class="text-uppercase text-muted small mb-2">Add to pool</h6>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLiveGenerate">Generate</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLiveUpload">Upload</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLiveReference">FHIR ID</button>
                </div>
                <input type="file" id="liveUploadFile" accept=".json,application/json" class="d-none" />
            </div>

            <details class="mb-3">
                <summary class="text-muted small">How this works</summary>
                <p class="small text-muted mb-0 mt-2">Patterns drive automatic census. Generate, Upload, and FHIR ID only add a patient to the pool — they are not expected in the report until Admit (and only if the predictor says they qualify). Discharge after Admit keeps them expected. Admit/Discharge does not rewrite generated clinical data.</p>
            </details>

            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <h6 class="text-uppercase text-muted small mb-0">Patient pool</h6>
                        <div class="small text-muted" id="livePoolShownCount">0 of 0</div>
                    </div>
                    <input class="form-control form-control-sm mb-2" id="livePoolFilter" placeholder="Filter by patient, origin, pattern, or state" />
                    <div class="table-responsive au-live-pool-wrap">
                        <table class="table au-table mb-0" id="livePoolTable">
                            <thead><tr><th>Patient</th><th>Origin</th><th>Pattern</th><th>State</th><th>Actions</th></tr></thead>
                            <tbody id="livePoolBody"><tr><td colspan="5" class="text-muted">No pool patients yet.</td></tr></tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-uppercase text-muted small mb-0">Report inclusion · <span id="liveExpectedHeaderCount">0</span></h6>
                        <div class="small text-muted" id="liveExpectedShownCount">0 of 0</div>
                    </div>
                    <input class="form-control form-control-sm mb-2" id="liveExpectedFilter" placeholder="Filter patient IDs" />
                    <div id="liveExpectedList" class="au-live-log border rounded p-2 mb-3"></div>
                    <h6 class="text-uppercase text-muted small mb-2">Census event log</h6>
                    <div id="liveEventLog" class="au-live-log border rounded p-2"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="au-card" id="testConfigCard" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-gear me-2"></i>Test Configuration</span>
            <a href="#" class="btn btn-sm" id="btnViewManifest" style="display:none; background:var(--au-accent); color:#fff; font-weight:600;">
                <i class="bi bi-card-checklist me-1"></i>Generation Manifest
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3" id="runConfigProps"></div>
            <div id="cohortSummaryCard" class="mt-3" style="display:none;">
                <div class="fw-semibold small mb-1"><i class="bi bi-people-fill me-1"></i>Cohorts</div>
                <div id="cohortSummaryBody"></div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="runDetailsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">Overview</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs-pane" type="button" role="tab" aria-controls="logs-pane" aria-selected="false">Logs</button>
        </li>
    </ul>

    <div class="tab-content" id="runDetailsTabContent">
        <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">
            <div class="au-card">
                <div class="card-header"><i class="bi bi-file-earmark-medical me-2"></i>Report</div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Milestones</div>
                        <div id="reportMilestones" class="d-flex flex-wrap justify-content-center gap-2" style="min-height: 42px;"></div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted mb-2">Report Schedule</div>
                                <div class="row g-2">
                                    <div class="col-md-12"><strong>Facility ID:</strong> <code id="scheduleFacilityId">@(Model.FacilityId ?? "-")</code></div>
                                    <div class="col-md-6"><strong>Report ID:</strong> <code id="scheduleReportName">@(string.IsNullOrWhiteSpace(Model.ReportId) ? "-" : Model.ReportId)</code></div>
                                    <div class="col-md-6"><strong>Frequency:</strong> <span id="scheduleFrequency">-</span></div>
                                    <div class="col-md-6"><strong>Start:</strong> <span id="scheduleStart">-</span></div>
                                    <div class="col-md-6"><strong>End:</strong> <span id="scheduleEnd">-</span></div>
                                    <div class="col-md-6"><strong>Adhoc Type:</strong> <span id="scheduleAdhoc">-</span></div>
                                    <div class="col-md-6"><strong>Status:</strong> <span id="scheduleStatusPill" class="badge bg-secondary">-</span></div>
                                    <div class="col-md-6"><strong>Report Created:</strong> <span id="scheduleCreated">-</span></div>
                                    <div class="col-md-6"><strong>Submitted:</strong> <span id="scheduleSubmitted">-</span></div>
                                    <div class="col-md-6"><strong>Duration:</strong> <span id="scheduleDuration" class="fw-semibold">-</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="small text-muted mb-2">Report Entries by Submission Status</div>
                                    <canvas id="entriesDonut" height="150" style="height:150px;max-height:150px;"></canvas>
                                <div id="entriesLegend" class="small mt-2"></div>
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mt-3">
                        <div class="small text-muted mb-1">Report Populations</div>
                        <div id="populationSummary">No population data yet.</div>
                    </div>
                </div>
            </div>

            <div class="au-card" id="validatorResultsCard" style="display:none;">
                <div class="card-header"><i class="bi bi-check2-square me-2"></i>Automation Validator Results</div>
                <div class="card-body">
                    <div id="validatorResultsSummary" class="small text-muted mb-2"></div>
                    <div class="row g-2" id="validatorResultsGrid"></div>
                </div>
            </div>

            <div class="au-card" id="serviceErrorSummaryCard">
                <div class="card-header"><i class="bi bi-bug me-2"></i>Service Error Summary</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Data Acquisition</div>
                                <button type="button" id="serviceErrorBtnDataAcq" class="btn w-100 text-center service-error-btn" data-service="Data Acquisition" disabled>
                                    <div id="serviceErrorCountDataAcq" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Normalization</div>
                                <button type="button" id="serviceErrorBtnNormalization" class="btn w-100 text-center service-error-btn" data-service="Normalization" disabled>
                                    <div id="serviceErrorCountNormalization" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Measure Eval</div>
                                <button type="button" id="serviceErrorBtnMeasureEval" class="btn w-100 text-center service-error-btn" data-service="Measure Eval" disabled>
                                    <div id="serviceErrorCountMeasureEval" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Validation</div>
                                <button type="button" id="serviceErrorBtnValidation" class="btn w-100 text-center service-error-btn" data-service="Validation" disabled>
                                    <div id="serviceErrorCountValidation" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                        <div class="col">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">Report</div>
                                <button type="button" id="serviceErrorBtnReport" class="btn w-100 text-center service-error-btn" data-service="Report" disabled>
                                    <div id="serviceErrorCountReport" class="display-5 fw-semibold text-muted">0</div>
                                    <div class="small text-muted">exceptions</div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header" role="button" data-bs-toggle="modal" data-bs-target="#dataAcqLogModal" style="cursor:pointer;">
                    <i class="bi bi-download me-2"></i>Data acquisition logs
                    <span class="badge bg-light text-dark ms-2" id="dataAcqTotalLogs">0</span>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="dataAcqResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="dataAcqResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="dataAcqRate">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Active duration</div><div class="fs-4 fw-semibold" id="dataAcqActiveDuration">—</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="dataAcqErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Logs by Status</div>
                            <canvas id="dataAcqDonut" height="160" style="height:160px;max-height:160px;max-width: 220px;"></canvas>
                            <div id="dataAcqLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="dataAcqTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="dataAcqResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-arrow-repeat me-2"></i>Normalization</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="normalizationResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="normalizationResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="normalizationRate">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Active duration</div><div class="fs-4 fw-semibold" id="normalizationActiveDuration">—</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="normalizationErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="normalizationTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="normalizationResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-bar-chart-line me-2"></i>Measure Eval</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Resource Count</div><div class="fs-4 fw-semibold" id="measureResourceCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Avg Resources/sec</div><div class="fs-4 fw-semibold" id="measureResPerSec">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Events/sec</div><div class="fs-4 fw-semibold" id="measureRate">0.00</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Active duration</div><div class="fs-4 fw-semibold" id="measureActiveDuration">—</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="measureErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Measure Report Patient States</div>
                            <canvas id="measureStageChart" height="170" style="height:170px;max-height:170px;"></canvas>
                            <div id="measureStageLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="measureTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                        <div class="col-md-4">
                            <div class="small text-muted mb-1">Top Resource Types</div>
                            <canvas id="measureResourceMixChart" height="170" style="height:170px;max-height:170px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="au-card">
                <div class="card-header"><i class="bi bi-shield-check me-2"></i>Validation <span class="badge text-bg-info ms-2" id="validationOngoingBadge" style="display:none;">In progress</span></div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Patients</div><div class="fs-4 fw-semibold" id="validationPatientCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Passed</div><div class="fs-4 fw-semibold text-success" id="validationPassedCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Failed</div><div class="fs-4 fw-semibold text-danger" id="validationFailedCount">0</div></div></div>
                        <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted">Active duration</div><div class="fs-4 fw-semibold" id="validationActiveDuration">—</div></div></div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <button type="button" id="validationErrorsBtn" class="btn btn-sm btn-outline-danger" style="display:none;">Errors Encountered</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Validation Patient States</div>
                            <canvas id="validationStageChart" height="170" style="height:170px;max-height:170px;"></canvas>
                            <div id="validationStageLegend" class="small mt-2"></div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted mb-1">Throughput Timeline (10s buckets)</div>
                            <canvas id="validationTimeline" height="90" style="height:90px;max-height:90px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="logs-pane" role="tabpanel" aria-labelledby="logs-tab" tabindex="0">
            <div class="au-card">
                <div class="card-header"><i class="bi bi-terminal me-2"></i>Console</div>
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                        <span class="small text-muted" id="logPageInfo">Loading stored log…</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-au-action" id="logOlder">Older</button>
                            <button type="button" class="btn btn-au-action" id="logNewer" disabled>Newer</button>
                        </div>
                    </div>
                    <pre id="logBox" class="au-log-console mb-0"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="errorFlyout" style="position:fixed; top:0; right:-480px; width:460px; height:100%; background:#fff; box-shadow:-4px 0 20px rgba(0,0,0,.2); z-index:1055; transition:right .2s ease;">
    <div class="d-flex justify-content-between align-items-center border-bottom p-3">
        <h6 class="mb-0" id="errorFlyoutTitle">Errors</h6>
        <button class="btn btn-sm btn-outline-secondary" id="closeFlyout">Close</button>
    </div>
    <div class="p-3" id="errorFlyoutBody" style="overflow:auto; height: calc(100% - 60px);"></div>
</div>

<div class="modal fade" id="serviceExceptionModal" tabindex="-1" aria-labelledby="serviceExceptionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:900px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="serviceExceptionModalLabel">Service Exceptions</h5>
                    <small class="text-muted" id="serviceExceptionSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="sticky-top bg-white border-bottom px-3 py-2" style="z-index:2;">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <input type="text" class="form-control form-control-sm" id="exModalSearch" placeholder="Search exceptions…">
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-secondary" id="exModalVisibleCount">0</span>
                            <span class="small text-muted">shown</span>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-2" id="exModalGroupChips"></div>
                </div>
                <div id="exModalAccordion" class="accordion accordion-flush" style="min-height:200px;"></div>
                <div id="exModalEmpty" class="text-center text-muted p-4" style="display:none;">No exceptions match the current filter.</div>
            </div>
        </div>
    </div>
</div>
