@model AutomationDashboardPage
@using Link.UI.Services
@{
    string SortDirFor(string column) =>
        Model.SortBy == column && Model.SortDir == "desc" ? "asc" : "desc";
    string SortMark(string column) =>
        Model.SortBy != column ? "" : Model.SortDir == "asc" ? " ▲" : " ▼";
    string Header(string column, string label) =>
        $"<a class=\"au-sort-header\" data-sort-col=\"{column}\" href=\"{Url.Action("Index", new { pageNumber = 1, pageSize = Model.PageSize, sortBy = column, sortDir = SortDirFor(column) })}\">{label}{SortMark(column)}</a>";
    string PageHref(int page) =>
        Url.Action("Index", new { pageNumber = page, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDir = Model.SortDir }) ?? "#";
    string Badge(AutomationRunRow run) => StatusPills.ForRun(run.Status);
}
<div class="au-card"
     data-page-number="@Model.PageNumber"
     data-page-size="@Model.PageSize"
     data-sort-by="@Model.SortBy"
     data-sort-dir="@Model.SortDir"
     id="recentRunsCard">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-2"></i>Recent Runs</span>
        <span class="small text-muted">
            @Model.TotalCount run@(Model.TotalCount == 1 ? "" : "s") &middot; page @Model.PageNumber of @Model.TotalPages
        </span>
    </div>
    <div data-au-table>
        <div class="table-responsive">
            <table class="table au-table mb-0">
                <thead>
                    <tr>
                        <th>@Html.Raw(Header("runName", "Run"))</th>
                        <th>@Html.Raw(Header("patientCount", "Patients"))</th>
                        <th>@Html.Raw(Header("seed", "Seed"))</th>
                        <th>@Html.Raw(Header("status", "Status"))</th>
                        <th>Duration</th>
                        <th>@Html.Raw(Header("createdAt", "Created"))</th>
                        <th>@Html.Raw(Header("finishedAt", "Finished"))</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="recentRunsBody">
                @if (Model.RecentRuns.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No runs yet. Pick a scenario in Quick Launch to start one.</td>
                    </tr>
                }
                @foreach (var run in Model.RecentRuns)
                {
                    <tr data-type="@run.StatusLabel" data-name="@run.RunName" data-search="@($"{run.RunName} {run.RunId} {run.Seed} {run.StatusLabel}")">
                        <td>
                            <div class="fw-semibold">@run.RunName</div>
                            <partial name="_LabeledId" model="@(new LabeledId { Label = "Run", Value = run.RunId.ToString(), Compact = true, CopyLabel = "Copy run id", LinkHref = Url.Action("Run", "Automation", new { id = run.RunId }), ReturnUrl = ReturnUrlRules.Here(Context.Request) })" />
                        </td>
                        <td>@run.PatientCount</td>
                        <td>@run.Seed</td>
                        <td>
                            <span class="badge run-status-badge @Badge(run)" data-run-id="@run.RunId">@run.StatusLabel</span>
                        </td>
                        <td class="small text-muted">@(run.Duration ?? "–")</td>
                        <td>@LinkUiTime.Display(run.CreatedAt)</td>
                        <td>@(run.FinishedAt is null ? "—" : LinkUiTime.Display(run.FinishedAt.Value))</td>
                        <td class="text-nowrap">
                            <div class="d-inline-flex gap-1 align-items-center run-actions" data-run-id="@run.RunId">
                                <a asp-action="Run" asp-route-id="@run.RunId" asp-route-returnUrl="@ReturnUrlRules.Here(Context.Request)" class="btn btn-sm btn-au-link lu-icon-btn" title="View details" aria-label="View details"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="ms-1">View</span></a>
                                @if (AutomationRules.IsCancellable(run.Status))
                                {
                                    <button type="button" class="btn btn-sm btn-warning btn-cancel-run lu-icon-btn" data-run-id="@run.RunId" title="Cancel" aria-label="Cancel"><i class="bi bi-x-circle" aria-hidden="true"></i><span class="ms-1">Cancel</span></button>
                                }
                                @if (AutomationRules.IsTerminal(run.Status))
                                {
                                    <a asp-action="Export" asp-route-id="@run.RunId" class="btn btn-sm btn-au-link lu-icon-btn" title="Export diagnostics ZIP" aria-label="Export diagnostics ZIP"><i class="bi bi-download" aria-hidden="true"></i><span class="ms-1">Export</span></a>
                                    <button type="button" class="btn btn-sm btn-danger btn-delete-run lu-icon-btn" data-run-id="@run.RunId" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i><span class="ms-1">Delete</span></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center p-2 border-top flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <label for="pageSizeSelect" class="form-label mb-0 small text-muted">Rows per page</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:auto;">
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    if (size == Model.PageSize)
                    {
                        <option value="@size" selected>@size</option>
                    }
                    else
                    {
                        <option value="@size">@size</option>
                    }
                }
            </select>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Recent runs pagination">
                <ul class="pagination pagination-sm mb-0">
                    @if (Model.PageNumber == 1)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" data-page="1" href="#" aria-label="First" tabindex="-1" aria-disabled="true">«</a>
                        </li>
                        <li class="page-item disabled">
                            <a class="page-link" data-page="@(Model.PageNumber - 1)" href="#" aria-label="Previous" tabindex="-1" aria-disabled="true">‹</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" data-page="1" href="@PageHref(1)" aria-label="First">«</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" data-page="@(Model.PageNumber - 1)" href="@PageHref(Model.PageNumber - 1)" aria-label="Previous">‹</a>
                        </li>
                    }
                    <li class="page-item disabled">
                        <span class="page-link">@Model.PageNumber / @Model.TotalPages</span>
                    </li>
                    @if (Model.PageNumber >= Model.TotalPages)
                    {
                        <li class="page-item disabled">
                            <a class="page-link" data-page="@(Model.PageNumber + 1)" href="#" aria-label="Next" tabindex="-1" aria-disabled="true">›</a>
                        </li>
                        <li class="page-item disabled">
                            <a class="page-link" data-page="@Model.TotalPages" href="#" aria-label="Last" tabindex="-1" aria-disabled="true">»</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" data-page="@(Model.PageNumber + 1)" href="@PageHref(Model.PageNumber + 1)" aria-label="Next">›</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" data-page="@Model.TotalPages" href="@PageHref(Model.TotalPages)" aria-label="Last">»</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
