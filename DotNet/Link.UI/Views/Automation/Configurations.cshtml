@await Html.PartialAsync("~/Views/Automation/_Nav.cshtml")

<div class="mb-3">
    <h1 class="h3 mb-1">Configurations</h1>
    <p class="text-muted mb-0">Templates a run applies to its facility. The same stored documents Automation already uses.</p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Facility templates</div>
            <div class="card-body">
                <p>Query plan, normalization suite, organization map, vendor, and the patient configurations a scenario may use.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="FacilityTemplates" asp-action="Index">Open facility templates</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Measures</div>
            <div class="card-body">
                <p>Measure bundles loaded when a run starts, including the generation type.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="Measures" asp-action="Index">Open measures</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Query plans</div>
            <div class="card-body">
                <p>Which FHIR resource types a run acquires, and the queries for each type.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="QueryPlans" asp-action="Index">Open query plans</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Normalization</div>
            <div class="card-body">
                <p>Operations, sequences, and suites. A suite is what a scenario selects. Bundle upload can propose a suite.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="Normalizations" asp-action="Index">Open normalization</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Organization maps</div>
            <div class="card-body">
                <p>Location and encounter conditions that find the organization for a run.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="OrganizationResourceMaps" asp-action="Index">Open organization maps</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="au-card card h-100">
            <div class="card-header">Patient configurations</div>
            <div class="card-body">
                <p>Named patient shapes. Scenario cohorts pick from this list. The editor is the same one the scenario form uses.</p>
                <a class="btn btn-sm btn-au-link" asp-controller="PatientConfigurations" asp-action="Index">Open patient configurations</a>
            </div>
        </div>
    </div>
</div>
