@model AcquisitionLogListPage
@using Link.UI.Services
@{
    var query = Model.Query;
    var search = Model.Search;
    var bar = Model.Paging;
    Dictionary<string, string> Route(int? page = null, string? sortBy = null, string? sortDir = null)
    {
        var route = query.ToRoute(page, sortBy, sortDir);
        if (Model.RunId is Guid runId)
            route["runId"] = runId.ToString("D");
        return route;
    }
    string Href(Dictionary<string, string> route)
    {
        var path = Model.Embedded ? "/Logs/Acquisition/panel" : "/Logs/Acquisition";
        if (route.Count == 0)
            return path;
        var query = string.Join("&", route.Select(pair =>
            Uri.EscapeDataString(pair.Key) + "=" + Uri.EscapeDataString(pair.Value)));
        return path + "?" + query;
    }
    Dictionary<string, string> SortRoute(string column, bool dateColumn) => Route(
        1,
        column,
        LogsRules.NextSort(search.SortBy, search.SortDir, column, dateColumn));
    string Mark(string column) => string.Equals(search.SortBy, column, StringComparison.OrdinalIgnoreCase)
        ? (search.SortDir == "asc" ? " ↑" : " ↓")
        : "";
}

@if (!string.IsNullOrWhiteSpace(Model.ScopeNote))
{
    <p class="small text-muted mt-3">@Model.ScopeNote</p>
}
@if (!string.IsNullOrWhiteSpace(search.FacilityId) && string.IsNullOrWhiteSpace(search.Error))
{
    <div class="au-card card mt-3">
        <div class="card-header">This facility</div>
        <div class="card-body">
            <p>These actions change every acquisition log for <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = search.FacilityId, CopyLabel = "Copy facility id" })" />, including logs outside this search.</p>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" data-au-save asp-action="DisableFacility" onsubmit="return confirm('Disable every acquisition log for this facility?');">
                    <partial name="_AcquisitionFields" model="query" />
                    <button type="submit" class="btn btn-sm btn-danger">Disable logs</button>
                </form>
                <form method="post" data-au-save asp-action="RestoreFacility" onsubmit="return confirm('Restore every acquisition log for this facility?');">
                    <partial name="_AcquisitionFields" model="query" />
                    <button type="submit" class="btn btn-sm btn-au-neutral">Restore logs</button>
                </form>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning mt-3">@Model.LoadError</div>
}
else
{
    @if (search.ReportId is not null)
    {
        <div class="au-card card mt-3">
            <div class="card-header">Status counts for this report</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.CountsNote))
                {
                    <p class="mb-0">@Model.CountsNote</p>
                }
                else if (Model.Counts.Count == 0)
                {
                    <p class="mb-0">No status counts.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var count in Model.Counts)
                        {
                            <li>@count.Name: @count.Count</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <div class="au-card card mt-3">
        <div class="card-header d-flex flex-wrap gap-2 align-items-center">
            <span class="me-auto">Logs</span>
            @if (search.HasFilter && !(AutomationMarkRules.IsAutomation(query.Scope) && string.IsNullOrWhiteSpace(query.FacilityId)))
            {
                <form method="post" data-au-save asp-action="ProcessMatching" class="d-inline" onsubmit="return confirm('Process every acquisition log that matches these filters?');">
                    <partial name="_AcquisitionFields" model="query" />
                    <button type="submit" class="btn btn-sm btn-success">Process matching</button>
                </form>
                <form method="post" data-au-save asp-action="CancelMatching" class="d-inline" onsubmit="return confirm('Cancel every matching log that is old enough? This cannot be undone.');">
                    <partial name="_AcquisitionFields" model="query" />
                    <button type="submit" class="btn btn-sm btn-danger">Cancel matching</button>
                </form>
            }
        </div>
        <div class="card-body">
            @if (Model.Logs.Count == 0)
            {
                <p class="au-empty mb-0">@(
                    !LinkUiFeatures.Value.AutomationEnabled ? "No acquisition logs found."
                    : AutomationMarkRules.IsAutomation(query.Scope) ? "No automation acquisition logs."
                    : AutomationMarkRules.IsReal(query.Scope) ? "No real acquisition logs."
                    : "No acquisition logs found.")</p>
            }
            else
            {
                <form method="post" data-au-save asp-action="Process" id="acquisition-logs">
                    <partial name="_AcquisitionFields" model="query" />
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-2">
                            <thead>
                                <tr>
                                    <th scope="col"><span class="visually-hidden">Select</span></th>
                                    <th scope="col"><a href="@Href(SortRoute("Id", false))" @(Model.Embedded ? "data-da-panel" : null)>Id@(Mark("Id"))</a></th>
                                    <th scope="col"><a href="@Href(SortRoute("FacilityId", false))" @(Model.Embedded ? "data-da-panel" : null)>Facility@(Mark("FacilityId"))</a></th>
                                    <th scope="col"><a href="@Href(SortRoute("PatientId", false))" @(Model.Embedded ? "data-da-panel" : null)>Patient@(Mark("PatientId"))</a></th>
                                    <th scope="col">Report</th>
                                    <th scope="col"><a href="@Href(SortRoute("Status", false))" @(Model.Embedded ? "data-da-panel" : null)>Status@(Mark("Status"))</a></th>
                                    <th scope="col"><a href="@Href(SortRoute("QueryPhase", false))" @(Model.Embedded ? "data-da-panel" : null)>Phase@(Mark("QueryPhase"))</a></th>
                                    <th scope="col"><a href="@Href(SortRoute("QueryType", false))" @(Model.Embedded ? "data-da-panel" : null)>Type@(Mark("QueryType"))</a></th>
                                    <th scope="col">Resources</th>
                                    <th scope="col"><a href="@Href(SortRoute("CreateDate", true))" @(Model.Embedded ? "data-da-panel" : null)>Created@(Mark("CreateDate"))</a></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.Logs)
                            {
                                <tr>
                                    <td>
                                        @if (row.CanProcess)
                                        {
                                            <input class="form-check-input" type="checkbox" name="ids" value="@row.Id" aria-label="Select log @row.Id" />
                                        }
                                    </td>
                                    <td>
                                        <partial name="_LabeledId" model="@(new LabeledId { Label = "Log", Value = row.Id.ToString(), Compact = true, CopyLabel = "Copy log id", LinkHref = Url.Action("AcquisitionDetail", new { id = row.Id }), ReturnUrl = Model.Embedded ? null : ReturnUrlRules.Here(Context.Request) })" />
                                        @(row.Deleted ? " (deleted)" : "")
                                    </td>
                                    <td>
                                        <partial name="_LabeledId" model="@(new LabeledId { Label = "Facility", Value = row.FacilityId, Compact = true, CopyLabel = "Copy facility id" })" />
                                        <partial name="_AutomationBadge" model="row.AutomationRunId" />
                                    </td>
                                    <td><partial name="_LabeledId" model="@(new LabeledId { Label = "Patient", Value = row.PatientId, Compact = true, CopyLabel = "Copy patient id" })" /></td>
                                    <td>
                                        <partial name="_LabeledId" model="@(new LabeledId { Label = "Report ID", Value = row.ReportId, Compact = true, CopyLabel = "Copy report id", LinkHref = row.ReportLink ? Url.Action("Acquisition", "Reports", new { facilityId = row.FacilityId, reportId = row.ReportId }) : null })" />
                                    </td>
                                    <td>@row.Status</td>
                                    <td>@row.Phase</td>
                                    <td>@row.QueryType</td>
                                    <td>@row.Resources</td>
                                    <td class="text-nowrap">@row.Created</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Process the selected acquisition logs?');">Process selected</button>
                        <button type="submit" class="btn btn-sm btn-danger" formaction="@Url.Action("Cancel")" formmethod="post" data-au-save onclick="return confirm('Cancel the selected logs that are old enough? This cannot be undone.');">Cancel selected</button>
                    </div>
                    <p class="small text-muted mt-2 mb-0">Cancel leaves logs that are newer than @search.MinAgeHours hours, and logs in a terminal status.</p>
                </form>
                <nav class="d-flex flex-wrap align-items-center gap-2 mt-3" aria-label="Log pages">
                    @if (bar.HasPrevious)
                    {
                        <a class="btn btn-sm btn-au-neutral" href="@Href(Route(bar.Page - 1))" @(Model.Embedded ? "data-da-panel" : null)>Previous</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-au-neutral" disabled>Previous</button>
                    }
                    <span class="small text-muted">Page @bar.Page of @(bar.TotalPages == 0 ? 1 : bar.TotalPages) (@bar.TotalCount)</span>
                    @if (bar.HasNext)
                    {
                        <a class="btn btn-sm btn-au-neutral" href="@Href(Route(bar.Page + 1))" @(Model.Embedded ? "data-da-panel" : null)>Next</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-au-neutral" disabled>Next</button>
                    }
                </nav>
            }
        </div>
    </div>
}
