@model KafkaPage
@{
    ViewData["Title"] = "Kafka";
    ViewData["LogsSection"] = "kafka";
}

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("Index")!, "Back to logs"))" />
</div>
<partial name="_Nav" />
<h1 class="h3">Kafka</h1>

<div class="au-card card">
    <div class="card-header">Kafka console</div>
    <div class="card-body">
        <p>The Kafka console is in this app, under Operations. It shows brokers, topics, consumer groups, and messages for this environment.</p>
        <a class="btn btn-au-link" href="@KafkaConsoleRoutes.Overview()">Open the Kafka console</a>
    </div>
</div>
