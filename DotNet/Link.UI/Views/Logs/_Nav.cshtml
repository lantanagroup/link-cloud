@{
    var active = ViewData["LogsSection"] as string ?? "";
    string Btn(string section) => active == section ? "btn btn-sm lu-nav-current" : "btn btn-sm btn-au-link";
}
<nav class="lu-section-nav" aria-label="Logs">
    <a class="@Btn("acquisition")" asp-controller="Logs" asp-action="Acquisition"><i class="bi bi-journal-text me-1"></i>Acquisition</a>
    <a class="@Btn("sftp")" asp-controller="Logs" asp-action="Sftp"><i class="bi bi-hdd-network me-1"></i>SFTP</a>
    <a class="@Btn("audit")" asp-controller="Logs" asp-action="Audit"><i class="bi bi-clipboard-check me-1"></i>Audit</a>
    <a class="@Btn("kafka")" asp-controller="Logs" asp-action="Kafka"><i class="bi bi-broadcast me-1"></i>Kafka</a>
</nav>
