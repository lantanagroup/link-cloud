@{
    var active = ViewData["LogsSection"] as string ?? "";
    string Btn(string section) => active == section ? "btn btn-sm btn-au-action" : "btn btn-sm btn-outline-secondary";
}
<nav class="lu-section-nav mb-3" aria-label="Logs">
    <a class="@Btn("acquisition")" asp-controller="Logs" asp-action="Acquisition">Acquisition</a>
    <a class="@Btn("sftp")" asp-controller="Logs" asp-action="Sftp">SFTP</a>
    <a class="@Btn("audit")" asp-controller="Logs" asp-action="Audit">Audit</a>
    <a class="@Btn("kafka")" asp-controller="Logs" asp-action="Kafka">Kafka</a>
</nav>
