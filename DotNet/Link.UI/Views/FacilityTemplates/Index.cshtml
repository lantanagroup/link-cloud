@model List<FacilityTemplate>
@{
    ViewData["Title"] = "Facility Templates";
    var queryPlans = (List<QueryPlanTemplate>?)ViewBag.QueryPlanTemplates ?? [];
    var suites = (List<NormalizationSuiteDefinition>?)ViewBag.NormalizationSuites ?? [];
    var maps = (List<OrganizationResourceMapTemplate>?)ViewBag.OrganizationResourceMaps ?? [];
    var patients = (List<PatientConfiguration>?)ViewBag.PatientConfigurations ?? [];
    var currentPage = (int)ViewBag.CurrentPage;
    var pageSize = (int)ViewBag.PageSize;
    var totalCount = (long)ViewBag.TotalCount;
    var totalPages = (int)ViewBag.TotalPages;
    var firstRecord = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastRecord = Math.Min((long)currentPage * pageSize, totalCount);
    Dictionary<string, string> PageRoute(int page, int size) => new()
    {
        ["page"] = page.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ["pageSize"] = size.ToString(System.Globalization.CultureInfo.InvariantCulture)
    };
    string PieceName<T>(IEnumerable<T> items, Guid? id, Func<T, Guid> idOf, Func<T, string> nameOf) where T : class
    {
        if (!id.HasValue) return "Not configured";
        var match = items.FirstOrDefault(i => idOf(i) == id.Value);
        return match == null ? "Missing" : nameOf(match);
    }
}
@await Html.PartialAsync("~/Views/Automation/_Nav.cshtml")


<div class="container mt-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-hospital me-2"></i>Facility Templates</h2>
    <p class="text-muted mb-3">A facility template owns the query plan, normalization suite, organization resource map, vendor, and which patient configurations a scenario may use. System Default is what system scenarios run. Epic and Cerner are convenience copies of those customer shapes. Create your own for anything else.</p>

    <div class="au-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>All templates</span>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-danger" id="btnDeleteSelectedFacilities" disabled>Delete selected (0)</button>
                <button type="button" class="btn btn-sm btn-success" id="btnNewFacility">New</button>
            </div>
        </div>
        <div id="facilityBulkResult" class="alert mx-3 mt-3 mb-0" role="status" aria-live="polite" style="white-space: pre-line" hidden></div>
        <div class="card-body p-0" data-au-table>
            <table class="table au-table mb-0">
                <thead>
                    <tr>
                        <th data-nocopy style="width:2.5rem">
                            <input type="checkbox" class="form-check-input" id="facilitySelectAll" aria-label="Select all deletable templates on this page" />
                        </th>
                        <th data-sort="name">Name</th>
                        <th data-sort="vendor">Vendor</th>
                        <th>Pieces</th>
                        <th data-sort="type">Kind</th>
                        <th style="width:220px"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr data-name="@t.Name" data-vendor="@(t.VendorName ?? "")" data-type="@(t.IsSystem ? "System" : "Custom")">
                        <td data-nocopy>
                            @if (!t.IsSystem && !t.IsDefault)
                            {
                                <input type="checkbox" class="form-check-input facility-select" value="@t.Id" data-name="@t.Name" aria-label="Select @t.Name" />
                            }
                        </td>
                        <td>
                            <strong>@t.Name</strong>
                            @if (t.IsDefault)
                            {
                                <span class="badge au-badge-success ms-1">System config</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <br /><small class="text-muted">@t.Description</small>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(t.VendorName) ? "None" : t.VendorName)</td>
                        <td class="small">
                            Query plan: @PieceName(queryPlans, t.QueryPlanTemplateId, q => q.Id, q => q.Name)<br />
                            Normalization: @PieceName(suites, t.NormalizationSuiteId, s => s.Id, s => s.Name)<br />
                            Org map: @(t.EnableOrganizationLocationMapping ? PieceName(maps, t.OrganizationResourceMapTemplateId, m => m.Id, m => m.Name) : "Off")<br />
                            Other patient configs: @(t.AllowPatientConfigurationsOutsideSet ? "Allowed" : "Not allowed")
                        </td>
                        <td>
                            @if (t.IsSystem)
                            {
                                <text>System</text>
                            }
                            else
                            {
                                <text>Custom</text>
                            }
                        </td>
                        <td class="text-nowrap">
                            <div class="lu-row-actions">
                                <button type="button" class="btn btn-sm btn-au-link lu-icon-btn btn-facility-open" data-id="@t.Id" data-mode="@(t.IsSystem ? "view" : "edit")" title="@(t.IsSystem ? "View" : "Edit")" aria-label="@(t.IsSystem ? "View" : "Edit")"><i class="bi @(t.IsSystem ? "bi-eye" : "bi-pencil")" aria-hidden="true"></i><span class="ms-1">@(t.IsSystem ? "View" : "Edit")</span></button>
                                <button type="button" class="btn btn-sm btn-success lu-icon-btn btn-facility-clone" data-id="@t.Id" title="Clone" aria-label="Clone"><i class="bi bi-copy" aria-hidden="true"></i><span class="ms-1">Clone</span></button>
                                @if (!t.IsSystem && !t.IsDefault)
                                {
                                    <button type="button" class="btn btn-sm btn-danger lu-icon-btn btn-facility-delete" data-id="@t.Id" data-name="@t.Name" title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i><span class="ms-1">Delete</span></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <p class="small text-muted mb-2">Showing @firstRecord–@lastRecord of @totalCount facility templates</p>
            <partial name="_BottomPager" model="@(new BottomPager { Label = "Facility template pages", Page = currentPage, Pages = totalPages, Total = totalCount, PageSize = pageSize, Sizes = FacilityTemplateListRules.PageSizes, Route = PageRoute })" />
        </div>
    </div>
</div>

<div id="facilityBackdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1040;"></div>
<div id="facilityModal" class="card shadow" style="display:none;position:fixed;z-index:1050;top:4vh;left:50%;transform:translateX(-50%);width:min(820px,96vw);max-height:92vh;overflow:auto;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong id="facilityModalTitle">Facility template</strong>
        <button type="button" class="btn-close" id="facilityModalClose" aria-label="Close"></button>
    </div>
    <div class="card-body">
        <div id="facilityFormErrors" class="alert alert-danger" style="display:none;"></div>
        <input type="hidden" id="facilityId" />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label" for="facilityName">Name</label>
                <input class="form-control" id="facilityName" maxlength="120" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="facilityVendor">Vendor</label>
                <input class="form-control" id="facilityVendor" maxlength="80" placeholder="Blank sends no vendor" />
            </div>
            <div class="col-12">
                <label class="form-label" for="facilityDescription">Description</label>
                <textarea class="form-control" id="facilityDescription" rows="2"></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="facilityQueryPlan">Query plan</label>
                <select class="form-select" id="facilityQueryPlan">
                    <option value="">(not configured)</option>
                    @foreach (var qp in queryPlans)
                    {
                        <option value="@qp.Id">@qp.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="facilityNormalization">Normalization suite</label>
                <select class="form-select" id="facilityNormalization">
                    <option value="">(not configured)</option>
                    @foreach (var suite in suites)
                    {
                        <option value="@suite.Id">@suite.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="facilityOrm">Organization resource map</label>
                <select class="form-select" id="facilityOrm">
                    <option value="">(not configured)</option>
                    @foreach (var map in maps)
                    {
                        <option value="@map.Id">@map.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="facilityOrgMapping" />
                    <label class="form-check-label" for="facilityOrgMapping">Organization location mapping on</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="facilityAllowOutside" checked />
                    <label class="form-check-label" for="facilityAllowOutside">Allow patient configurations outside the set</label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label" for="facilityPatients">Available patient configurations</label>
                <select class="form-select" id="facilityPatients" multiple size="6">
                    @foreach (var patient in patients)
                    {
                        <option value="@patient.Id">@patient.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="card-footer text-end">
        <button type="button" class="btn btn-warning" id="facilityCancel">Cancel</button>
        <button type="button" class="btn btn-success" id="facilitySave">Save</button>
    </div>
</div>

@Html.AntiForgeryToken()
<script>
(function () {
    const modal = document.getElementById('facilityModal');
    const backdrop = document.getElementById('facilityBackdrop');
    const errors = document.getElementById('facilityFormErrors');
    const saveUrl = '@Url.Action("SaveInline", "FacilityTemplates")';
    const getUrl = '@Url.Action("GetJson", "FacilityTemplates")';
    const cloneUrl = '@Url.Action("CloneInline", "FacilityTemplates")';
    const deleteUrl = '@Url.Action("DeleteInline", "FacilityTemplates")';
    const bulkDeleteUrl = '@Url.Action("DeleteBulk", "FacilityTemplates")';
    function token() {
        const field = document.querySelector('input[name="__RequestVerificationToken"]');
        return field ? field.value : '';
    }
    function show() { modal.style.display = ''; backdrop.style.display = ''; }
    function hide() { modal.style.display = 'none'; backdrop.style.display = 'none'; errors.style.display = 'none'; }
    async function post(url, body) {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error((await response.text()) || ('Server ' + response.status));
        return response.headers.get('content-type')?.includes('json') ? response.json() : null;
    }
    function setEditable(editable) {
        modal.querySelectorAll('input, select, textarea').forEach(function (el) {
            if (el.id === 'facilityId') return;
            el.disabled = !editable;
        });
        document.getElementById('facilitySave').style.display = editable ? '' : 'none';
    }
    function selectedPatients() {
        return Array.prototype.filter.call(document.getElementById('facilityPatients').options, function (option) {
            return option.selected;
        }).map(function (option) { return option.value; });
    }
    function applyPatients(ids) {
        const wanted = new Set((ids || []).map(function (id) { return String(id).toLowerCase(); }));
        Array.prototype.forEach.call(document.getElementById('facilityPatients').options, function (option) {
            option.selected = wanted.has(String(option.value).toLowerCase());
        });
    }
    function blank() {
        document.getElementById('facilityId').value = '';
        document.getElementById('facilityName').value = '';
        document.getElementById('facilityVendor').value = '';
        document.getElementById('facilityDescription').value = '';
        document.getElementById('facilityQueryPlan').value = '';
        document.getElementById('facilityNormalization').value = '';
        document.getElementById('facilityOrm').value = '';
        document.getElementById('facilityOrgMapping').checked = false;
        document.getElementById('facilityAllowOutside').checked = true;
        applyPatients([]);
    }
    function fill(model) {
        document.getElementById('facilityId').value = model.id || '';
        document.getElementById('facilityName').value = model.name || '';
        document.getElementById('facilityVendor').value = model.vendorName || '';
        document.getElementById('facilityDescription').value = model.description || '';
        document.getElementById('facilityQueryPlan').value = model.queryPlanTemplateId || '';
        document.getElementById('facilityNormalization').value = model.normalizationSuiteId || '';
        document.getElementById('facilityOrm').value = model.organizationResourceMapTemplateId || '';
        document.getElementById('facilityOrgMapping').checked = !!model.enableOrganizationLocationMapping;
        document.getElementById('facilityAllowOutside').checked = model.allowPatientConfigurationsOutsideSet !== false;
        applyPatients(model.allowedPatientConfigurationIds || []);
    }
    document.getElementById('btnNewFacility').addEventListener('click', function () {
        blank();
        setEditable(true);
        document.getElementById('facilityModalTitle').textContent = 'New facility template';
        show();
    });
    document.getElementById('facilityModalClose').addEventListener('click', hide);
    document.getElementById('facilityCancel').addEventListener('click', hide);
    document.getElementById('facilityBackdrop').addEventListener('click', hide);
    document.getElementById('facilitySave').addEventListener('click', async function () {
        errors.style.display = 'none';
        if (!document.getElementById('facilityQueryPlan').value) {
            errors.textContent = 'A facility template needs a query plan.';
            errors.style.display = '';
            return;
        }
        if (document.getElementById('facilityOrgMapping').checked && !document.getElementById('facilityOrm').value) {
            errors.textContent = 'Organization location mapping is on, so an organization resource map is required.';
            errors.style.display = '';
            return;
        }
        if (!document.getElementById('facilityAllowOutside').checked && selectedPatients().length === 0) {
            errors.textContent = 'A closed patient configuration set needs at least one patient configuration.';
            errors.style.display = '';
            return;
        }
        const body = {
            id: document.getElementById('facilityId').value || '00000000-0000-0000-0000-000000000000',
            name: document.getElementById('facilityName').value,
            description: document.getElementById('facilityDescription').value,
            vendorName: document.getElementById('facilityVendor').value,
            queryPlanTemplateId: document.getElementById('facilityQueryPlan').value || null,
            normalizationSuiteId: document.getElementById('facilityNormalization').value || null,
            organizationResourceMapTemplateId: document.getElementById('facilityOrm').value || null,
            enableOrganizationLocationMapping: document.getElementById('facilityOrgMapping').checked,
            allowPatientConfigurationsOutsideSet: document.getElementById('facilityAllowOutside').checked,
            allowedPatientConfigurationIds: selectedPatients()
        };
        if (!body.id || body.id === '00000000-0000-0000-0000-000000000000')
            body.id = crypto.randomUUID();
        try {
            await post(saveUrl, body);
            auRefreshPage();
        } catch (err) {
            errors.textContent = err.message || 'Save failed';
            errors.style.display = '';
        }
    });
    document.querySelectorAll('.btn-facility-open').forEach(function (button) {
        button.addEventListener('click', async function () {
            const response = await fetch(getUrl + '?id=' + encodeURIComponent(button.dataset.id));
            if (!response.ok) { alert(await response.text()); return; }
            fill(await response.json());
            const view = button.dataset.mode === 'view';
            setEditable(!view);
            document.getElementById('facilityModalTitle').textContent = view ? 'View facility template' : 'Edit facility template';
            show();
        });
    });
    document.querySelectorAll('.btn-facility-clone').forEach(function (button) {
        button.addEventListener('click', async function () {
            try {
                await post(cloneUrl, { id: button.dataset.id });
                auRefreshPage('Cloned.');
            } catch (err) {
                alert(err.message || 'Clone failed');
            }
        });
    });
    document.querySelectorAll('.btn-facility-delete').forEach(function (button) {
        button.addEventListener('click', async function () {
            if (!window.luHoldConfirm) return;
            window.luHoldConfirm.ask(button, "Delete this facility template", "Delete this facility template?", ["The facility template is removed."], async function () {
            try {
                await post(deleteUrl, { id: button.dataset.id });
                auRefreshPage('Deleted.');
            } catch (err) {
                alert(err.message || 'Delete failed');
            }
            });
        });
    });

    const selectAll = document.getElementById('facilitySelectAll');
    const deleteSelectedButton = document.getElementById('btnDeleteSelectedFacilities');
    const bulkResult = document.getElementById('facilityBulkResult');
    const bulkResultStorageKey = 'facilityTemplatesBulkDeleteResult';
    const selectionBoxes = Array.prototype.slice.call(document.querySelectorAll('.facility-select'));
    let bulkDeleting = false;

    function rowVisible(box) {
        const row = box.closest('tr');
        return box.isConnected && (!row || !row.classList.contains('au-row-hidden'));
    }
    function visibleBoxes() {
        return selectionBoxes.filter(rowVisible);
    }
    function selectedBoxes() {
        return visibleBoxes().filter(function (box) { return box.checked; });
    }
    function updateBulkSelection() {
        const active = visibleBoxes();
        const selected = active.filter(function (box) { return box.checked; });
        deleteSelectedButton.textContent = 'Delete selected (' + selected.length + ')';
        deleteSelectedButton.disabled = bulkDeleting || selected.length === 0;
        selectAll.checked = active.length > 0 && selected.length === active.length;
        selectAll.indeterminate = selected.length > 0 && selected.length < active.length;
        selectAll.disabled = bulkDeleting || active.length === 0;
    }
    function showBulkResult(message, isError) {
        bulkResult.textContent = message;
        bulkResult.className = 'alert mx-3 mt-3 mb-0 ' + (isError ? 'alert-warning' : 'alert-success');
        bulkResult.hidden = false;
    }
    function restoreBulkDeleteResult() {
        const saved = sessionStorage.getItem(bulkResultStorageKey);
        if (!saved) return;
        sessionStorage.removeItem(bulkResultStorageKey);
        try {
            const result = JSON.parse(saved);
            showBulkResult(result.message, true);
            const failedIds = new Set((result.failedIds || []).map(function (id) { return String(id).toLowerCase(); }));
            selectionBoxes.forEach(function (box) {
                box.checked = failedIds.has(box.value.toLowerCase());
            });
            updateBulkSelection();
        } catch (err) {
            // A stale browser value is not a reason to block the page.
        }
    }
    async function runBulkDelete(selected) {
        bulkDeleting = true;
        selectionBoxes.forEach(function (box) { box.disabled = true; });
        updateBulkSelection();
        bulkResult.hidden = true;
        try {
            const result = await post(bulkDeleteUrl, {
                ids: selected.map(function (box) { return box.value; })
            }) || {};
            const deletedIds = new Set((result.deletedIds || []).map(function (id) { return String(id).toLowerCase(); }));
            const failures = result.failures || [];
            if (failures.length === 0) {
                await auRefreshPage('Deleted.');
                return;
            }
            const failureDetails = failures.map(function (failure) {
                const matching = selectionBoxes.find(function (box) {
                    return box.value.toLowerCase() === String(failure.id).toLowerCase();
                });
                const name = (matching && matching.dataset.name) || failure.id;
                return name + ': ' + failure.reason;
            });
            const message = deletedIds.size + ' deleted; ' + failures.length + ' failed.\n' + failureDetails.join('\n');
            if (deletedIds.size > 0) {
                sessionStorage.setItem(bulkResultStorageKey, JSON.stringify({
                    message: message,
                    failedIds: failures.map(function (failure) { return String(failure.id); })
                }));
                await auRefreshPage('Some templates could not be deleted.');
                return;
            }
            const failedIds = new Set(failures.map(function (failure) { return String(failure.id).toLowerCase(); }));
            selectionBoxes.forEach(function (box) {
                box.checked = failedIds.has(box.value.toLowerCase());
            });
            showBulkResult(message, true);
        } catch (err) {
            showBulkResult(err.message || 'Bulk deletion failed. Please retry.', true);
        } finally {
            bulkDeleting = false;
            selectionBoxes.forEach(function (box) {
                if (box.isConnected) box.disabled = false;
            });
            updateBulkSelection();
        }
    }

    selectAll.addEventListener('change', function () {
        visibleBoxes().forEach(function (box) { box.checked = selectAll.checked; });
        updateBulkSelection();
    });
    selectionBoxes.forEach(function (box) {
        box.addEventListener('change', updateBulkSelection);
    });
    const tableShell = document.querySelector('[data-au-table]');
    if (tableShell) {
        tableShell.addEventListener('input', updateBulkSelection);
        tableShell.addEventListener('change', updateBulkSelection);
    }
    deleteSelectedButton.addEventListener('click', function () {
        const selected = selectedBoxes();
        if (selected.length === 0 || bulkDeleting || !window.luHoldConfirm) return;
        const names = selected.map(function (box) { return box.dataset.name; });
        const noun = selected.length === 1 ? 'facility template' : 'facility templates';
        window.luHoldConfirm.ask(
            deleteSelectedButton,
            'Delete selected facility templates',
            'Delete ' + selected.length + ' selected ' + noun + '?',
            ['These facility templates are removed.'].concat(names),
            function () { runBulkDelete(selected); });
    });
    if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', updateBulkSelection);
    updateBulkSelection();
    restoreBulkDeleteResult();
})();
</script>
<script src="~/js/au-data-table.js" asp-append-version="true"></script>
<script src="~/js/configuration-deep-link.js" asp-append-version="true"></script>
