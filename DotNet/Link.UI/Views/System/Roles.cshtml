@model RoleListPage

<div class="mb-3">
    <a asp-action="Index"><i class="bi bi-arrow-left me-1"></i>System</a>
</div>
<h1 class="h3">Roles</h1>
<partial name="_Nav" />
<partial name="_Alerts" />
<p class="text-muted">Saving a role name keeps its existing claims. Assign claims in the section below.</p>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<div class="au-card card mb-3 d-none" id="roleCreate" data-lu-panel data-lu-hide-on-cancel>
    <div class="card-header">New role</div>
    <div class="card-body">
        <form method="post" data-au-save asp-action="SaveRole" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="name">Name</label>
                <input id="name" name="name" class="form-control" maxlength="255" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="description">Description</label>
                <input id="description" name="description" class="form-control" maxlength="1000" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-success">Save</button>
                <button type="button" class="btn btn-outline-secondary" data-lu-cancel>Cancel</button>
            </div>
        </form>
    </div>
</div>

<div class="au-card card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Roles</span>
        <span class="d-flex align-items-center gap-2">
            <span class="lu-live-label">This list updates on its own.</span>
            <button type="button" class="btn btn-sm btn-success" data-lu-reveal="roleCreate">+ Add</button>
        </span>
    </div>
    <div class="card-body">
        <div id="roleResults" data-au-refresh="20000">
        @if (Model.Roles.Count == 0)
        {
            <p class="mb-0">No roles yet. Add one to assign claims.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 lu-wide-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col"><span class="visually-hidden">Save</span></th>
                            <th scope="col"><span class="visually-hidden">Delete</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        var formId = "role-" + role.Id;
                        <tr>
                            <td>
                                <input form="@formId" name="name" value="@role.Name" class="form-control form-control-sm" maxlength="255" aria-label="Name for @role.Name" />
                            </td>
                            <td>
                                <input form="@formId" name="description" value="@role.Description" class="form-control form-control-sm" maxlength="1000" aria-label="Description for @role.Name" />
                            </td>
                            <td>
                                <form id="@formId" method="post" data-au-save asp-action="SaveRole">
                                    <input type="hidden" name="id" value="@role.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" data-au-save asp-action="DeleteRole" asp-route-id="@role.Id" onsubmit="return confirm('Delete this role?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </div>
</div>

<div class="au-card card mt-3">
    <div class="card-header">Claims</div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ClaimsError))
        {
            <div class="alert alert-warning mb-0">@Model.ClaimsError</div>
        }
        else if (Model.Roles.Count == 0)
        {
            <p class="mb-0">Create a role before assigning claims.</p>
        }
        else
        {
            foreach (var role in Model.Roles)
            {
                var assigned = new HashSet<string>(role.Claims, StringComparer.Ordinal);
                var claimIndex = 0;
                <form method="post" data-au-save asp-action="SaveRoleClaims" asp-route-id="@role.Id" class="mb-3">
                    <fieldset>
                        <legend class="form-label">@role.Name</legend>
                        @foreach (var claim in Model.ClaimCatalog)
                        {
                            var inputId = "role-claim-" + role.Id + "-" + claimIndex++;
                            <div class="form-check">
                                @if (assigned.Contains(claim))
                                {
                                    <input class="form-check-input" type="checkbox" id="@inputId" name="Claims" value="@claim" checked />
                                }
                                else
                                {
                                    <input class="form-check-input" type="checkbox" id="@inputId" name="Claims" value="@claim" />
                                }
                                <label class="form-check-label" for="@inputId">@claim</label>
                            </div>
                        }
                    </fieldset>
                    <button type="submit" class="btn btn-sm btn-outline-secondary mt-2">Save claims</button>
                </form>
            }
            <p class="text-muted small mb-0">Clear every box and save to remove that role's claims.</p>
        }
    </div>
</div>
