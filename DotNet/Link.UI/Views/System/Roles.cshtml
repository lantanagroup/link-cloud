@model RoleListPage

<div class="mb-3">
    <a asp-action="Index"><i class="bi bi-arrow-left me-1"></i>System</a>
</div>
<h1 class="h3">Roles</h1>
<partial name="_Nav" />
<partial name="_Alerts" />
<p class="text-muted">Saving a role keeps its existing claims. Claim assignment is not on this page.</p>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<div class="au-card card mb-3">
    <div class="card-header">New role</div>
    <div class="card-body">
        <form method="post" asp-action="SaveRole" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="name">Name</label>
                <input id="name" name="name" class="form-control" maxlength="255" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" for="description">Description</label>
                <input id="description" name="description" class="form-control" maxlength="1000" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-au-action">Create role</button>
            </div>
        </form>
    </div>
</div>

<div class="au-card card">
    <div class="card-header">Roles</div>
    <div class="card-body">
        @if (Model.Roles.Count == 0)
        {
            <p class="mb-0">No roles found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 lu-wide-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Description</th>
                            <th scope="col"><span class="visually-hidden">Save</span></th>
                            <th scope="col"><span class="visually-hidden">Delete</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        var formId = "role-" + role.Id;
                        <tr>
                            <td>
                                <input form="@formId" name="name" value="@role.Name" class="form-control form-control-sm" maxlength="255" aria-label="Name for @role.Name" />
                            </td>
                            <td>
                                <input form="@formId" name="description" value="@role.Description" class="form-control form-control-sm" maxlength="1000" aria-label="Description for @role.Name" />
                            </td>
                            <td>
                                <form id="@formId" method="post" asp-action="SaveRole">
                                    <input type="hidden" name="id" value="@role.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-action="DeleteRole" asp-route-id="@role.Id" onsubmit="return confirm('Delete this role?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
