@model HealthPage
@using Link.UI.Services

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("Index")!, "Back to system"))" />
</div>
<partial name="_Nav" />
<h1 class="h3">Service health</h1>
<partial name="_Alerts" />
<p class="text-muted">Admin.BFF collects each service health report. Leave the service blank to load every report.</p>

@if (!string.IsNullOrWhiteSpace(Model.HealthError))
{
    <div class="alert alert-warning">@Model.HealthError</div>
}
@if (!string.IsNullOrWhiteSpace(Model.InfoError))
{
    <div class="alert alert-warning">@Model.InfoError</div>
}

<div class="au-card card mb-3">
    <div class="card-header">Check one service</div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label" for="service">Service</label>
                <input id="service" name="service" value="@Model.Service" class="form-control" maxlength="64" placeholder="account" />
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-success">Check</button>
            </div>
            <div class="col-12 col-md-3">
                <a class="btn btn-au-link" asp-action="Health">All services</a>
            </div>
        </form>
        <p class="text-muted small mb-0 mt-2">@string.Join(", ", SystemRules.HealthServices)</p>
    </div>
</div>

<div class="au-card card mb-3" id="healthCard" data-health-url="@Url.Action("HealthStatus", new { service = Model.Service })">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Health</span>
        <span class="lu-live-label" id="healthLive">Checking on its own</span>
    </div>
    <div class="card-body">
        <p class="text-danger small mb-2" id="healthError" @(string.IsNullOrWhiteSpace(Model.HealthError) ? "hidden" : null)>@Model.HealthError</p>
        @if (Model.Reports.Count == 0)
        {
            <p class="mb-0" id="healthEmpty">No health reports.</p>
        }
        else
        {
            <p class="mb-0" id="healthEmpty" hidden>No health reports.</p>
        }
        <div class="table-responsive" id="healthTable" @(Model.Reports.Count == 0 ? "hidden" : null)>
                <table class="table au-table table-sm align-middle mb-0 lu-wide-table">
                    <thead>
                        <tr>
                            <th scope="col">Service</th>
                            <th scope="col">Status</th>
                            <th scope="col">Duration</th>
                            <th scope="col">Checks</th>
                        </tr>
                    </thead>
                    <tbody id="healthBody">
                    @foreach (var report in Model.Reports)
                    {
                        <tr>
                            <td>@report.Service</td>
                            <td><span class="badge @StatusPills.ForHealth(report.Status)">@report.Status</span></td>
                            <td>@report.Duration</td>
                            <td>
                                @if (report.Entries.Count == 0)
                                {
                                    <span class="text-muted">None</span>
                                }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var entry in report.Entries)
                                        {
                                            <li>@entry.Name: @entry.Status @entry.Duration @entry.Description</li>
                                        }
                                    </ul>
                                    @if (report.HiddenEntries > 0)
                                    {
                                        <span class="text-muted small">@report.HiddenEntries more</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
    </div>
</div>
<script>
    (function () {
        var card = document.getElementById("healthCard");
        if (!card) return;
        var url = card.getAttribute("data-health-url");
        function badge(status) {
            return window.luStatusPills.forHealth(status);
        }
        function text(value) {
            return document.createTextNode(value == null ? "" : String(value));
        }
        function paint(data) {
            var error = document.getElementById("healthError");
            var empty = document.getElementById("healthEmpty");
            var table = document.getElementById("healthTable");
            var body = document.getElementById("healthBody");
            var label = document.getElementById("healthLive");
            if (error) {
                error.textContent = data.error || "";
                error.hidden = !data.error;
            }
            var reports = data.reports || [];
            if (empty) empty.hidden = reports.length > 0;
            if (table) table.hidden = reports.length === 0;
            if (!body) return;
            body.replaceChildren();
            reports.forEach(function (report) {
                var row = document.createElement("tr");
                var service = document.createElement("td");
                service.append(text(report.service));
                var statusCell = document.createElement("td");
                var chip = document.createElement("span");
                chip.className = "badge " + badge(report.status);
                chip.append(text(report.status));
                statusCell.append(chip);
                var duration = document.createElement("td");
                duration.append(text(report.duration));
                var checks = document.createElement("td");
                var entries = report.entries || [];
                if (!entries.length) {
                    var none = document.createElement("span");
                    none.className = "text-muted";
                    none.textContent = "None";
                    checks.append(none);
                } else {
                    var list = document.createElement("ul");
                    list.className = "mb-0";
                    entries.forEach(function (entry) {
                        var item = document.createElement("li");
                        item.textContent = [entry.name, entry.status, entry.duration, entry.description].filter(Boolean).join(" ");
                        list.append(item);
                    });
                    checks.append(list);
                    if (report.hidden > 0) {
                        var more = document.createElement("span");
                        more.className = "text-muted small";
                        more.textContent = report.hidden + " more";
                        checks.append(more);
                    }
                }
                row.append(service, statusCell, duration, checks);
                body.append(row);
            });
            if (label) label.textContent = "Updated just now";
        }
        async function tick() {
            if (document.hidden) return;
            try {
                var res = await fetch(url, { headers: { "X-Requested-With": "fetch" } });
                if (!res.ok) return;
                paint(await res.json());
            } catch (e) { /* keep the last table */ }
        }
        // The health call talks to every service. Wait until it finishes, then
        // wait again, so a slow report cannot stack on top of itself.
        async function loop() {
            await tick();
            setTimeout(loop, 20000);
        }
        setTimeout(loop, 20000);
    })();
</script>

@if (string.IsNullOrWhiteSpace(Model.Service))
{
    <div class="au-card card">
        <div class="card-header">Versions</div>
        <div class="card-body">
            @if (Model.Services.Count == 0)
            {
                <p class="mb-0">No service information.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 lu-wide-table">
                        <thead>
                            <tr>
                                <th scope="col">Service</th>
                                <th scope="col">Version</th>
                                <th scope="col">Product</th>
                                <th scope="col">Commit</th>
                                <th scope="col">Build</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var info in Model.Services)
                        {
                            <tr>
                                <td>@info.ServiceName</td>
                                <td>@info.Version</td>
                                <td>@info.ProductVersion</td>
                                <td>@info.Commit</td>
                                <td>@info.Build</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
