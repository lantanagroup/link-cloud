@model UserEditPage

<div class="mb-3">
    <partial name="_BackButton" model="@(new BackLink(Url.Action("Users")!, "Accounts"))" />
</div>
<partial name="_Nav" />
<h1 class="h3">Account</h1>
<partial name="_Alerts" />

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

@if (Model.Found)
{
    <div class="au-card card mb-3">
        <div class="card-header">@Model.Form.Username</div>
        <div class="card-body">
            @if (Model.IsDeleted)
            {
                <p>This account is deleted.</p>
                <form method="post" data-au-save asp-action="RestoreUser" asp-route-id="@Model.Id" class="mb-3" onsubmit="return confirm('Restore this account?');">
                    <button type="submit" class="btn btn-success">Restore account</button>
                </form>
                <dl class="row mb-0">
                    <dt class="col-12 col-md-3">Username</dt>
                    <dd class="col-12 col-md-9">@Model.Form.Username</dd>
                    <dt class="col-12 col-md-3">Name</dt>
                    <dd class="col-12 col-md-9">@Model.Form.FirstName @Model.Form.MiddleName @Model.Form.LastName</dd>
                    <dt class="col-12 col-md-3">Email</dt>
                    <dd class="col-12 col-md-9">@Model.Form.Email</dd>
                    <dt class="col-12 col-md-3">Roles</dt>
                    <dd class="col-12 col-md-9">@string.Join(", ", Model.Form.Roles ?? [])</dd>
                </dl>
            }
            else
            {
                var selected = new HashSet<string>(Model.Form.Roles ?? [], StringComparer.OrdinalIgnoreCase);
                var roleIndex = 0;
                if (!Model.IsActive)
                {
                    <p class="text-muted">This account is deactivated.</p>
                }
                <form method="post" data-au-save data-lu-panel asp-action="UpdateUser" asp-route-id="@Model.Id" class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="username">Username</label>
                        <input id="username" name="username" value="@Model.Form.Username" class="form-control" maxlength="255" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="firstName">First name</label>
                        <input id="firstName" name="firstName" value="@Model.Form.FirstName" class="form-control" maxlength="255" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="middleName">Middle name</label>
                        <input id="middleName" name="middleName" value="@Model.Form.MiddleName" class="form-control" maxlength="255" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="lastName">Last name</label>
                        <input id="lastName" name="lastName" value="@Model.Form.LastName" class="form-control" maxlength="255" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="email">Email</label>
                        <input id="email" name="email" value="@Model.Form.Email" class="form-control" maxlength="255" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <fieldset>
                            <legend class="form-label">Roles</legend>
                            @if (Model.KnownRoles.Count == 0)
                            {
                                <p class="text-muted mb-0">No roles are available.</p>
                            }
                            else
                            {
                                foreach (var role in Model.KnownRoles)
                                {
                                    var inputId = "role-" + roleIndex++;
                                    <div class="form-check">
                                        @if (selected.Contains(role))
                                        {
                                            <input class="form-check-input" type="checkbox" id="@inputId" name="roles" value="@role" checked />
                                        }
                                        else
                                        {
                                            <input class="form-check-input" type="checkbox" id="@inputId" name="roles" value="@role" />
                                        }
                                        <label class="form-check-label" for="@inputId">@role</label>
                                    </div>
                                }
                            }
                        </fieldset>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-warning" data-lu-cancel>Cancel</button>
                    </div>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.ClaimsError))
                {
                    <div class="alert alert-warning mt-3 mb-0">@Model.ClaimsError</div>
                }
                else
                {
                    var assigned = new HashSet<string>(Model.Claims ?? [], StringComparer.Ordinal);
                    var claimIndex = 0;
                    <form method="post" data-au-save asp-action="SaveUserClaims" asp-route-id="@Model.Id" class="mt-3">
                        <fieldset>
                            <legend class="form-label">Claims</legend>
                            @foreach (var claim in Model.ClaimCatalog)
                            {
                                var inputId = "claim-" + claimIndex++;
                                <div class="form-check">
                                    @if (assigned.Contains(claim))
                                    {
                                        <input class="form-check-input" type="checkbox" id="@inputId" name="Claims" value="@claim" checked />
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="checkbox" id="@inputId" name="Claims" value="@claim" />
                                    }
                                    <label class="form-check-label" for="@inputId">@claim</label>
                                </div>
                            }
                        </fieldset>
                        <button type="submit" class="btn btn-success mt-2">Save</button>
                        <p class="text-muted small mt-2 mb-0">Saving the account above keeps these claims. Clear every box to remove them.</p>
                    </form>
                }
            }
        </div>
    </div>
    @if (!Model.IsDeleted)
    {
        <form method="post" data-au-save asp-action="DeleteUser" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this account?');">
            <button type="submit" class="btn btn-danger">Delete account</button>
        </form>
    }
}
