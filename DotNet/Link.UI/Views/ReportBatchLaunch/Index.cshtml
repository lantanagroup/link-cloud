@using Link.UI.Services.ReportBatches
@model ReportBatchLaunchPage
@{
    ViewData["Title"] = "Launch a batch";
    var selected = Model.EhrSystems.FirstOrDefault(system => system.Name == Model.SelectedEhr);
    var selectedReady = selected?.Ready == true;
}

@await Html.PartialAsync("~/Views/Automation/_Nav.cshtml")

<div class="mb-3">
    <h1 class="h3 mb-1">Launch a batch</h1>
    <p class="text-muted mb-0">Start several report runs against one EHR system. Ad-hoc and scheduled scenarios can run in the same batch. Each run starts on its own, up to the concurrency set here, and each copy gets its own facility.</p>
</div>

@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (!Model.Ready)
{
    @if (Model.EhrSystems.Count > 0)
    {
        <div class="au-card card">
            <div class="card-header">EHR systems</div>
            <ul class="list-group list-group-flush">
                @foreach (var ehr in Model.EhrSystems)
                {
                    <li class="list-group-item">
                        <span class="fw-semibold">@ehr.Name</span>
                        <span class="text-muted">@ehr.FhirServerBase</span>
                        @if (ehr.Ready)
                        {
                            <span class="badge au-badge-success ms-2">Ready</span>
                        }
                        else
                        {
                            <span class="badge au-badge-warning ms-2">Not ready</span>
                            @if (!string.IsNullOrWhiteSpace(ehr.ReadinessError))
                            {
                                <div class="small text-danger">@ehr.ReadinessError</div>
                            }
                        }
                    </li>
                }
            </ul>
        </div>
    }
}
else
{
    <form method="post" id="launchBatchForm">
        @Html.AntiForgeryToken()
        <div class="au-card card mb-3">
            <div class="card-header">EHR system</div>
            <div class="card-body">
                <label class="form-label" for="ehrSystem">EHR system</label>
                <select class="form-select w-auto" id="ehrSystem" name="ehrSystem" required>
                    @foreach (var ehr in Model.EhrSystems)
                    {
                        if (ehr.Name == Model.SelectedEhr)
                        {
                            <option value="@ehr.Name" selected data-ready="@(ehr.Ready ? "yes" : "no")" data-name="@ehr.Name" data-error="@ehr.ReadinessError">@ehr.Name — @ehr.FhirServerBase</option>
                        }
                        else
                        {
                            <option value="@ehr.Name" data-ready="@(ehr.Ready ? "yes" : "no")" data-name="@ehr.Name" data-error="@ehr.ReadinessError">@ehr.Name — @ehr.FhirServerBase</option>
                        }
                    }
                </select>
                <p id="ehrReadyNote" class="@(selectedReady ? "form-text" : "form-text text-danger")">
                    @if (selected is null)
                    {
                        @:Choose an EHR system. Every run in this batch uses it.
                    }
                    else if (selectedReady)
                    {
                        @:@selected.Name is ready. Every run in this batch uses it.
                    }
                    else
                    {
                        @:@selected.Name is not ready. @selected.ReadinessError
                    }
                </p>
            </div>
        </div>

        <div class="au-card card mb-3">
            <div class="card-header">Scenarios</div>
            <div class="card-body">
                <p class="text-muted">Parameters come from the saved scenario. <a asp-controller="Scenarios" asp-action="Index">Edit scenarios</a> before launching. Copies of a scenario share that configuration.</p>
                @if (Model.Scenarios.Count == 0)
                {
                    <p class="mb-0">No scenarios yet.</p>
                }
                else
                {
                    <div class="border rounded p-2" style="max-height: 360px; overflow-y: auto;">
                        @foreach (var group in Model.Scenarios.GroupBy(scenario => scenario.Group))
                        {
                            <h2 class="h6 mt-2">@group.Key</h2>
                            @foreach (var scenario in group)
                            {
                                var inputId = "scenario-" + scenario.Id.ToString("N");
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="scenarioIds" value="@scenario.Id" id="@inputId" @(Model.SelectedScenarioIds.Contains(scenario.Id) ? "checked" : null) />
                                    <label class="form-check-label" for="@inputId">
                                        @scenario.Name
                                        <span class="text-muted">@scenario.ReportMethodLabel</span>
                                        @if (scenario.IsSystemScenario)
                                        {
                                            <span class="text-muted">[System]</span>
                                        }
                                    </label>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div class="au-card card mb-3">
            <div class="card-header">Run concurrency</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="copies">Copies</label>
                        <input class="form-control w-auto" type="number" id="copies" name="copies" min="1" max="@ReportBatchConcurrencyPolicy.MaxScenariosPerBatch" step="1" required value="@Model.Copies" />
                        <div class="form-text">How many times to run each selected scenario. The batch can hold at most @ReportBatchConcurrencyPolicy.MaxScenariosPerBatch runs.</div>
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label" for="maxConcurrency">Max concurrent runs</label>
                        <input class="form-control w-auto" type="number" id="maxConcurrency" name="maxConcurrency" min="1" max="@Model.SavedCap" step="1" required value="@Model.MaxConcurrency" />
                        <div class="form-text">Defaults to the saved cap of @Model.SavedCap. This batch can use that or a lower number. <a asp-controller="ReportBatchSettings" asp-action="Index">Change the saved cap</a>.</div>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-au-run" id="startBatch" @(selectedReady ? null : "disabled")>Start batch</button>
    </form>
    <script>
        (function () {
            var select = document.getElementById("ehrSystem");
            var button = document.getElementById("startBatch");
            var note = document.getElementById("ehrReadyNote");
            if (!select || !button || !note) return;
            function sync() {
                var option = select.options[select.selectedIndex];
                if (!option) return;
                var ready = option.getAttribute("data-ready") === "yes";
                var name = option.getAttribute("data-name") || option.value;
                var error = option.getAttribute("data-error") || "";
                button.disabled = !ready;
                note.textContent = ready
                    ? name + " is ready. Every run in this batch uses it."
                    : name + " is not ready. " + error;
                note.className = ready ? "form-text" : "form-text text-danger";
            }
            select.addEventListener("change", sync);
        })();
    </script>
}
