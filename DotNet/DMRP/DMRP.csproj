<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>LantanaGroup.Link.DMRP</RootNamespace>
		<Configurations>Debug;Release;Debug IIS</Configurations>
		<PredefinedCulturesOnly>false</PredefinedCulturesOnly>
		<Version>0.1.0</Version>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<!-- DMRP is hosted in-process by the Tenant service rather than deployed on its own, so it
	     builds as a class library. These usings mirror the ones Microsoft.NET.Sdk.Web supplies
	     implicitly. -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.AspNetCore.Http" />
		<Using Include="Microsoft.AspNetCore.Routing" />
		<Using Include="Microsoft.Extensions.Configuration" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Microsoft.Extensions.Hosting" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<!-- Composes the optional filters on the reporting plan reads into one predicate, the way
		     Report's managers already do, so a filter the caller did not supply contributes no SQL
		     rather than a null test the database has to evaluate. -->
		<PackageReference Include="LinqKit.Core" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LinkSdk\LinkSdk.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

</Project>
