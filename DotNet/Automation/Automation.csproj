<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LantanaGroup.Automation</RootNamespace>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ThetisEngineProjectPath Condition="'$(ThetisEngineProjectPath)' == ''">..\..\..\thetis\Thetis.Generation.Engine\Thetis.Generation.Engine.csproj</ThetisEngineProjectPath>
    <ThetisAbstractionsProjectPath Condition="'$(ThetisAbstractionsProjectPath)' == ''">..\..\..\thetis\Thetis.Generation.Abstractions\Thetis.Generation.Abstractions.csproj</ThetisAbstractionsProjectPath>
    <!-- Default: local Thetis project refs for the PoC. Set UseThetisProjectReference=false
         (or omit the local Thetis repo) to restore LantanaGroup.Thetis.Generation.* from NuGet. -->
    <UseThetisProjectReference Condition="'$(UseThetisProjectReference)' == ''">true</UseThetisProjectReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="RestSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseThetisProjectReference)' == 'true' And Exists('$(ThetisEngineProjectPath)')">
    <ProjectReference Include="$(ThetisAbstractionsProjectPath)" />
    <ProjectReference Include="$(ThetisEngineProjectPath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseThetisProjectReference)' != 'true' Or !Exists('$(ThetisEngineProjectPath)')">
    <PackageReference Include="LantanaGroup.Thetis.Generation.Abstractions" />
    <PackageReference Include="LantanaGroup.Thetis.Generation.Engine" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="measures\*.json" />
    <EmbeddedResource Include="measures\*.json" />
  </ItemGroup>

</Project>
