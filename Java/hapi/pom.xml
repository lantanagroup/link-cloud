        <groupId>ca.uhn.hapi.fhir</groupId>
        <artifactId>hapi-fhir</artifactId>
        <version>5.6.0</version>
        <relativePath/>
    </parent>

    <groupId>com.lantanagroup.link</groupId>
    <artifactId>hapi</artifactId>
    <version>0.4.1</version>
</project>
