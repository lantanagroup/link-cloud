{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Measure Evaluation Service Database Schema",
  "description": "Persistence schema for the Measure Eval Service (MongoDB and Azure Blob Storage)",
  "type": "object",
  "properties": {
    "Resource": {
      "description": "MongoDB collection for FHIR resources used during evaluation",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "facilityId": { "type": "string" },
          "correlationId": { "type": "string" },
          "patientId": { "type": "string" },
          "resourceType": { "type": "string" },
          "resourceId": { "type": "string" },
          "resource": { "type": "string", "description": "Serialized FHIR resource content" },
          "createdDate": { "type": "string" }
        },
        "required": ["_id", "facilityId", "correlationId", "patientId", "resourceType", "resourceId", "resource", "createdDate"]
      }
    },
    "PatientReportingEvaluationStatus": {
      "description": "MongoDB collection tracking evaluation status for patients",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "facilityId": { "type": "string" },
          "patientId": { "type": "string" },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reportTrackingId": { "type": "string" },
                "reportType": { "type": "string" },
                "status": { "type": "string" }
              },
              "required": ["reportTrackingId", "reportType", "status"]
            }
          }
        },
        "required": ["_id", "facilityId", "patientId", "reports"]
      }
    },
    "BlobStorage": {
      "description": "Azure Blob Storage for evaluated MeasureReports",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ContainerName": { "type": "string", "description": "Name of the blob container" },
          "BlobName": { "type": "string", "description": "Path/name of the blob (e.g., facility/report/patient.mr)" },
          "Content": { "type": "string", "description": "Content of the MeasureReport (NDJSON/FHIR)" }
        },
        "required": ["ContainerName", "BlobName", "Content"]
      }
    }
  }
}