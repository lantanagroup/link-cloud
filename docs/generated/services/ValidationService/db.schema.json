{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation Service Database Schema",
  "description": "Persistence schema for the Validation Service (Azure Blob Storage)",
  "type": "object",
  "properties": {
    "ValidationResults": {
      "description": "Storage for validation outcome reports",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ContainerName": { "type": "string" },
          "BlobName": { "type": "string" },
          "Content": { "type": "string", "description": "FHIR OperationOutcome or custom validation report" }
        },
        "required": ["ContainerName", "BlobName", "Content"]
      }
    }
  }
}