{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Account Service Database Schema",
  "description": "Persistence schema for the Account Service (SQL Server)",
  "type": "object",
  "properties": {
    "Users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "UserName": { "type": "string" },
          "Email": { "type": "string" },
          "PasswordHash": { "type": ["string", "null"] }
        },
        "required": ["Id", "UserName", "Email"]
      }
    },
    "Roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "Name": { "type": "string" }
        },
        "required": ["Id", "Name"]
      }
    },
    "UserRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "UserId": { "type": "string" },
          "RoleId": { "type": "string" }
        },
        "required": ["UserId", "RoleId"]
      }
    },
    "RefreshTokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "Token": { "type": "string" },
          "UserId": { "type": "string" },
          "Expires": { "type": "string" }
        },
        "required": ["Id", "Token", "UserId", "Expires"]
      }
    }
  }
}