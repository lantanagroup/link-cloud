{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report Service Database Schema",
  "description": "Persistence schema for the Report Service (MongoDB)",
  "type": "object",
  "properties": {
    "ReportSchedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "ReportTypes": { "type": "array", "items": { "type": "string" } },
          "StartDate": { "type": "string" },
          "EndDate": { "type": "string" },
          "Status": { "type": "string" },
          "PayloadRootUri": { "type": ["string", "null"] }
        },
        "required": ["_id", "FacilityId", "ReportTypes", "StartDate", "EndDate", "Status"]
      }
    },
    "ReportEntry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "ReportScheduleId": { "type": "string" },
          "PatientId": { "type": "string" },
          "Status": { "type": "string" },
          "PayloadUri": { "type": "string" }
        },
        "required": ["_id", "ReportScheduleId", "PatientId", "Status", "PayloadUri"]
      }
    }
  }
}