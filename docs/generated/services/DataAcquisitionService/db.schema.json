{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data Acquisition Service Database Schema",
  "description": "Persistence schema for the Data Acquisition Service (SQL Server)",
  "type": "object",
  "properties": {
    "FhirQueryConfigurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "FhirServerBaseUrl": { "type": "string" },
          "Authentication": { "type": ["string", "null"] }
        },
        "required": ["Id", "FacilityId", "FhirServerBaseUrl"]
      }
    },
    "DataAcquisitionLogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "CorrelationId": { "type": ["string", "null"] },
          "Status": { "type": "string" },
          "ExecutionDate": { "type": "string" }
        },
        "required": ["Id", "FacilityId", "Status", "ExecutionDate"]
      }
    },
    "QueryPlans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "PlanName": { "type": "string" },
          "InitialQueries": { "type": "string" },
          "SupplementalQueries": { "type": ["string", "null"] }
        },
        "required": ["Id", "PlanName", "InitialQueries"]
      }
    }
  }
}