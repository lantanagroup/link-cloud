{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Submission Service Database Schema",
  "description": "Persistence schema for the Submission Service (Azure Blob Storage)",
  "type": "object",
  "properties": {
    "InternalBlobStorage": {
      "description": "Internal storage for bundles before submission",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ContainerName": { "type": "string" },
          "BlobName": { "type": "string" },
          "Content": { "type": "string" }
        },
        "required": ["ContainerName", "BlobName", "Content"]
      }
    },
    "ExternalBlobStorage": {
      "description": "External storage for final submissions to public health agencies",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ContainerName": { "type": "string" },
          "BlobName": { "type": "string" },
          "Content": { "type": "string" }
        },
        "required": ["ContainerName", "BlobName", "Content"]
      }
    }
  }
}