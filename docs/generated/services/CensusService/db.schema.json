{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Census Service Database Schema",
  "description": "Persistence schema for the Census Service (SQL Server)",
  "type": "object",
  "properties": {
    "CensusConfigs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "ScheduledCensuses": { "type": ["string", "null"] }
        },
        "required": ["Id", "FacilityId"]
      }
    },
    "PatientEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "CorrelationId": { "type": "string" },
          "SourcePatientId": { "type": "string" },
          "EventDate": { "type": "string" },
          "Payload": { "type": "string" }
        },
        "required": ["Id", "FacilityId", "CorrelationId", "SourcePatientId", "EventDate", "Payload"]
      }
    },
    "PatientEncounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "CorrelationId": { "type": "string" },
          "AdmitDate": { "type": ["string", "null"] },
          "DischargeDate": { "type": ["string", "null"] }
        },
        "required": ["Id", "FacilityId", "CorrelationId"]
      }
    }
  }
}