{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tenant Service Database Schema",
  "description": "Persistence schema for the Tenant Service (SQL Server)",
  "type": "object",
  "properties": {
    "Facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": "string" },
          "Name": { "type": "string" },
          "ScheduledReports": { "type": ["string", "null"] }
        },
        "required": ["Id", "FacilityId", "Name"]
      }
    }
  }
}