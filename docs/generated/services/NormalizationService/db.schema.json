{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalization Service Database Schema",
  "description": "Persistence schema for the Normalization Service (SQL Server)",
  "type": "object",
  "properties": {
    "Operation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "FacilityId": { "type": ["string", "null"] },
          "OperationJson": { "type": "string" },
          "OperationType": { "type": "string" },
          "Name": { "type": ["string", "null"] },
          "Description": { "type": ["string", "null"] },
          "IsDisabled": { "type": "boolean" },
          "CreateDate": { "type": "string", "format": "date-time" },
          "ModifyDate": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["Id", "OperationJson", "OperationType", "IsDisabled", "CreateDate"]
      }
    },
    "OperationSequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "OperationResourceTypeId": { "type": "string" },
          "FacilityId": { "type": ["string", "null"] },
          "Sequence": { "type": ["integer", "null"] },
          "CreateDate": { "type": "string", "format": "date-time" },
          "ModifyDate": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["Id", "OperationResourceTypeId", "CreateDate"]
      }
    },
    "ResourceType": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "Name": { "type": ["string", "null"] }
        },
        "required": ["Id"]
      }
    },
    "OperationResourceTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "OperationId": { "type": "string" },
          "ResourceTypeId": { "type": "string" }
        },
        "required": ["Id", "OperationId", "ResourceTypeId"]
      }
    },
    "Vendor": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "Name": { "type": "string" }
        },
        "required": ["Id", "Name"]
      }
    },
    "VendorVersion": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "VendorId": { "type": "string" },
          "Version": { "type": ["string", "null"] }
        },
        "required": ["Id", "VendorId"]
      }
    },
    "VendorVersionOperationPreset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": { "type": "string" },
          "VendorVersionId": { "type": "string" },
          "OperationResourceTypeId": { "type": "string" },
          "CreateDate": { "type": "string", "format": "date-time" },
          "ModifyDate": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["Id", "VendorVersionId", "OperationResourceTypeId", "CreateDate"]
      }
    }
  }
}
