{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceNormalized",
  "type": "object",
  "properties": {
    "patientId": { "type": ["string", "null"] },
    "queryType": { "type": ["string", "null"] },
    "resource": { "type": ["object", "null"] },
    "reportTrackingId": { "type": ["string", "null"] },
    "processingTime": {
      "type": "integer",
      "description": "The time taken (in milliseconds) for a single resource to be normalized."
    }
  },
  "required": [
    "processingTime"
  ],
  "additionalProperties": false
}
