{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditableEventOccurred",
  "type": "object",
  "properties": {
    "facilityId": { "type": ["string", "null"] },
    "serviceName": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "eventDate": { "type": ["string", "null"], "format": "date-time" },
    "userId": { "type": ["string", "null"] },
    "user": { "type": ["string", "null"] },
    "action": {
      "type": ["string", "null"],
      "enum": ["Create", "Update", "Delete", "Query", "Submit", "Restore", null]
    },
    "resource": { "type": ["string", "null"] },
    "propertyChanges": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "propertyName": { "type": "string" },
          "initialPropertyValue": { "type": "string" },
          "newPropertyValue": { "type": "string" }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
