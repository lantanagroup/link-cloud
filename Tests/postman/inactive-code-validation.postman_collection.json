    },
    {
      "key": "profileUrl",
      "value": "http://hl7.org/fhir/us/core/StructureDefinition/us-core-encounter"
    },
    {
      "key": "bindingValueSetUrl",
      "value": "http://hl7.org/fhir/us/core/ValueSet/detailed-race"
    },
    {
      "key": "expectedCategoryId",
      "value": "missing_active_encounter_type_code"
    }
  ]
}