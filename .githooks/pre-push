#!/bin/sh
#
# Refuses to push history that touches files moved out of this repository under LEGLINK-912.
# A clone made before that cleanup must be re-cloned, not pulled; this catches it when it was
# not. .github/workflows/purged-history-guard.yml checks the repository on a schedule as a
# backstop.
#
# Git for Windows runs it through its own bundled sh, whichever shell started the push. The
# recovery steps it prints work unchanged in PowerShell, cmd and Git Bash.
#
# Enable for your clone with:
#     git config core.hooksPath .githooks
#
# Bypass with `git push --no-verify`. Do not, unless you are certain.

set -e

PURGED_PATHS="Config/ .env"

# 40 zeros: git uses this for "no such ref" on branch creation and deletion.
ZERO="0000000000000000000000000000000000000000"

remote_name="$1"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Nothing to inspect when the push deletes a remote branch.
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: everything not already published on this remote is being pushed.
        range="$local_sha --not --remotes=$remote_name"
    else
        # Existing branch: only what the remote does not already have.
        range="$remote_sha..$local_sha"
    fi

    # --full-history follows every parent of a merge, not only one that matches at these paths.
    # shellcheck disable=SC2086
    offenders=$(git rev-list --full-history $range -- $PURGED_PATHS 2>/dev/null || true)

    if [ -n "$offenders" ]; then
        blocked=1
        count=$(printf '%s\n' "$offenders" | wc -l | tr -d ' ')
        echo ""
        echo "pre-push: BLOCKED -- $local_ref carries $count commit(s) that reintroduce the"
        echo "pre-push: files removed from this repository's history by LEGLINK-912:"
        echo ""
        printf '%s\n' "$offenders" | head -5 | while read -r c; do
            echo "    $(git log -1 --format='%h %ad %s' --date=short "$c" 2>/dev/null | cut -c1-72)"
        done
        if [ "$count" -gt 5 ]; then
            echo "    ... and $((count - 5)) more"
        fi
    fi
done

if [ "$blocked" -eq 1 ]; then
    echo ""
    echo "pre-push: This almost always means your clone predates the history rewrite and you"
    echo "pre-push: ran 'git pull' instead of re-cloning. Your working tree will look normal;"
    echo "pre-push: the files are in your history, not your files."
    echo ""
    echo "pre-push: Fix it by cloning again. To keep commits that never reached GitHub:"
    echo "pre-push:   1. Rename this folder to link-cloud-old and clone link-cloud fresh beside it."
    echo "pre-push:   2. In the new clone, run these, replacing <branch> and <n>, the number of"
    echo "pre-push:      your commits that never reached GitHub:"
    echo "pre-push:          git fetch ../link-cloud-old <branch>"
    echo "pre-push:          git switch -c <branch> origin/dev"
    echo "pre-push:          git cherry-pick FETCH_HEAD~<n>..FETCH_HEAD"
    echo "pre-push:   3. Copy .env from link-cloud-old into the new clone."
    echo "pre-push:   4. Delete link-cloud-old. Never push from it."
    exit 1
fi

exit 0
