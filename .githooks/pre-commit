#!/bin/sh
#
# Checks what is being committed:
#
#   secrets            TruffleHog v3 on the staged files; blocks any likely secret on a line this
#                      commit adds, and blocks if the scan cannot run
#   app-config.yaml    checked against its own embedded schema
#
# The first commit downloads TruffleHog into .git/tools/ and checks it against the SHA-256 in
# .githooks/trufflehog.pins. See dev-docs/secret-scanning.md.
#
# The per-environment exports the catalog describes used to be scanned here too. LEGLINK-912 moved
# them to the private link-cac repository, so nothing under Config/ can be staged in this one any
# more. That repository has no hook of its own - scanning there would need a clone of this one
# on every machine - so its CI is what runs validate_aac_secrets.py against them.
#
# Enable for your clone with:
#     git config core.hooksPath .githooks
#
# Both checks read the STAGED content, not the working tree, so a problem cannot slip through by
# being fixed in the file after `git add`.
#
# CI runs the catalog check and the same TruffleHog scan on every pull request.

set -e

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

PINS="$(git rev-parse --show-toplevel)/.githooks/trufflehog.pins"

# Prints one value from the pins file: the version, or a platform's SHA-256.
trufflehog_pin() {
    sed -n "s/^$1=//p" "$PINS" 2>/dev/null
}

TRUFFLEHOG_VERSION=$(trufflehog_pin version)

trufflehog_platform() {
    case "$(uname -s)" in
        Linux) os=linux ;;
        Darwin) os=darwin ;;
        MINGW*|MSYS*|CYGWIN*) os=windows ;;
        *) return 1 ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) return 1 ;;
    esac
    echo "${os}_$arch"
}

file_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    else
        return 1
    fi
}

# Probe that the interpreter actually runs. On Windows, `python3` often resolves
# to the Microsoft Store alias, which exists on PATH but exits non-zero -- so
# `command -v` alone picks an interpreter that cannot execute anything.
PYTHON=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c "import sys" >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done

# Sets TRUFFLEHOG to the pinned binary, downloading it on first use.
install_trufflehog() {
    if ! platform=$(trufflehog_platform); then
        echo "pre-commit: TruffleHog has no build for $(uname -s) $(uname -m)."
        return 1
    fi
    expected=$(trufflehog_pin "$platform")
    if [ -z "$TRUFFLEHOG_VERSION" ] || [ -z "$expected" ]; then
        echo "pre-commit: $PINS has no TruffleHog version or no SHA-256 for $platform."
        return 1
    fi
    exe=""
    case "$platform" in
        windows_*) exe=".exe" ;;
    esac

    install_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd)/tools/trufflehog-$TRUFFLEHOG_VERSION"
    TRUFFLEHOG="$install_dir/trufflehog$exe"
    if [ -x "$TRUFFLEHOG" ]; then
        return 0
    fi

    if ! command -v curl >/dev/null 2>&1; then
        echo "pre-commit: curl is needed to download TruffleHog $TRUFFLEHOG_VERSION."
        return 1
    fi

    asset="trufflehog_${TRUFFLEHOG_VERSION}_$platform.tar.gz"
    url="https://github.com/trufflesecurity/trufflehog/releases/download/v$TRUFFLEHOG_VERSION/$asset"
    echo "pre-commit: downloading TruffleHog $TRUFFLEHOG_VERSION into $install_dir (first commit only)..."
    if ! curl -fsSL --retry 2 -o "$tmpdir/$asset" "$url"; then
        echo "pre-commit: could not download $url"
        return 1
    fi

    if ! actual=$(file_sha256 "$tmpdir/$asset"); then
        echo "pre-commit: sha256sum or shasum is needed to check the TruffleHog download."
        return 1
    fi
    if [ "$actual" != "$expected" ]; then
        echo "pre-commit: the TruffleHog download does not match its pinned SHA-256. Not installing it."
        return 1
    fi

    # Relative to tmpdir: GNU tar reads "C:/..." as a remote host.
    if ! (cd "$tmpdir" && tar -xzf "$asset" "trufflehog$exe"); then
        echo "pre-commit: could not unpack $asset"
        return 1
    fi
    if ! { mkdir -p "$install_dir" && mv "$tmpdir/trufflehog$exe" "$TRUFFLEHOG" && chmod +x "$TRUFFLEHOG"; }; then
        echo "pre-commit: could not install TruffleHog into $install_dir"
        return 1
    fi

    # Drop the versions this hook no longer pins.
    for old in "$(dirname "$install_dir")"/trufflehog-*; do
        if [ "$old" != "$install_dir" ]; then
            rm -rf "$old"
        fi
    done
}

# Called as `scan_staged_secrets || status=1`, where `set -e` does not apply, so every step that can
# fail has to be checked here. A partial copy of the staged files must block, not pass.
scan_staged_secrets() {
    staged="$tmpdir/staged"
    mkdir -p "$staged"
    if ! git diff --cached --name-only -z --diff-filter=ACMR > "$tmpdir/staged-files"; then
        echo "pre-commit: BLOCKED -- could not list the staged files."
        return 1
    fi
    if [ ! -s "$tmpdir/staged-files" ]; then
        return 0
    fi

    if [ -z "$PYTHON" ]; then
        echo "pre-commit: BLOCKED -- the secret scan needs a working python to read TruffleHog's results."
        echo "pre-commit: Install Python 3 (https://www.python.org/downloads/; on Windows, not the Microsoft"
        echo "pre-commit: Store alias) and commit again."
        return 1
    fi
    if ! install_trufflehog; then
        echo "pre-commit: BLOCKED -- TruffleHog $TRUFFLEHOG_VERSION is not available, so the staged files"
        echo "pre-commit: could not be scanned for secrets."
        return 1
    fi

    if ! git checkout-index -z --stdin --prefix="$staged/" < "$tmpdir/staged-files"; then
        echo "pre-commit: BLOCKED -- could not write the staged files out for scanning."
        return 1
    fi

    # No verification: it would send each candidate to its provider, and a database that is not
    # reachable from here would read as an invalid credential and be dropped.
    if ! (cd "$staged" && "$TRUFFLEHOG" filesystem . --json --no-verification --no-update \
            --results=verified,unknown,unverified) > "$tmpdir/findings.jsonl" 2> "$tmpdir/trufflehog.err"; then
        echo "pre-commit: BLOCKED -- TruffleHog failed while scanning the staged files:"
        tail -5 "$tmpdir/trufflehog.err"
        return 1
    fi

    # TruffleHog reports whole files, so keep only findings on lines this commit adds. Secrets
    # already committed are not this commit's to fix. Never print the secret itself.
    if ! hits=$(PYTHONIOENCODING=utf-8 "$PYTHON" - "$tmpdir/findings.jsonl" <<'PY'
import json, re, subprocess, sys

added = {}

def added_lines(path):
    if path not in added:
        diff = subprocess.run(["git", "diff", "--cached", "--unified=0", "--no-color", "--no-ext-diff", "--", path],
                              capture_output=True, text=True, encoding="utf-8", errors="replace").stdout
        lines = set()
        for hunk in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, re.M):
            start, count = int(hunk.group(1)), int(hunk.group(2) or 1)
            lines.update(range(start, start + count))
        added[path] = lines
    return added[path]

reported = set()
for line in open(sys.argv[1], encoding="utf-8"):
    if not line.startswith("{"):
        continue
    finding = json.loads(line)
    location = finding["SourceMetadata"]["Data"]["Filesystem"]
    path = location["file"].replace("\\", "/").removeprefix("./")
    number = location.get("line")
    # Without a line number there is no telling whether this commit added it, so report it.
    if number is not None and number not in added_lines(path):
        continue
    key = (path, number, finding["DetectorName"])
    if key in reported:
        continue
    reported.add(key)
    print(f"    {path}:{number if number is not None else '?'}  {finding['DetectorName']}")
PY
    ); then
        echo "pre-commit: BLOCKED -- could not read TruffleHog's results."
        return 1
    fi

    if [ -n "$hits" ]; then
        echo ""
        echo "pre-commit: BLOCKED -- TruffleHog found likely secrets on lines this commit adds:"
        echo "$hits"
        echo ""
        echo "pre-commit: The values are not shown. Remove each one from the staged file and rotate any"
        echo "pre-commit: real credential."
        return 1
    fi
}

check_catalog() {
    staged_catalog=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '^app-config\.yaml$' || true)

    if [ -z "$staged_catalog" ]; then
        return 0
    fi

    if [ -z "$PYTHON" ]; then
        echo "pre-commit: no working python found, skipping the App Config catalog check."
        echo "pre-commit: CI will still run it."
        return 0
    fi

    # Without PyYAML the validator crashes, which would read as a schema failure.
    if ! "$PYTHON" -c "import yaml" >/dev/null 2>&1; then
        echo "pre-commit: skipping the App Config catalog check: $PYTHON has no PyYAML."
        echo "pre-commit: Install it with: $PYTHON -m pip install \"pyyaml==6.0.*\""
        echo "pre-commit: CI will still run it."
        return 0
    fi

    # Materialize the staged blob so the check sees exactly what is being committed.
    catalog="$tmpdir/$(basename "$staged_catalog")"
    git show ":$staged_catalog" > "$catalog"

    if ! "$PYTHON" Scripts/AzureAppConfig/validate_app_config_schema.py "$catalog"; then
        echo ""
        echo "pre-commit: BLOCKED -- staged app-config.yaml does not match its own schema."
        echo "pre-commit: Fix the entries above."
        return 1
    fi

    # The required-key check is deliberately NOT run here. It compares the catalog against every
    # store's export, which now means reading a second repository - and it would fail on gaps a
    # commit did not introduce and cannot fix. link-cac's CI reports it instead: this repository
    # never reads that one.
}

status=0
scan_staged_secrets || status=1
check_catalog || status=1
exit $status
